@model MarketLink.ViewModels.AdminMarketsPageViewModel

@{
    ViewData["Title"] = "Markets";
    Layout = "~/Views/Shared/_AdminDashboardLayout.cshtml";
}

<section class="admin-market-header">
    <div>
        <span class="market-page-label">
            <i class="bi bi-shop"></i>
            MARKET MANAGEMENT
        </span>

        <h2>Markets</h2>

        <p>
            Manage market locations, schedules and markets available
            to farmers and customers.
        </p>
    </div>

    <a asp-controller="AdminMarkets"
       asp-action="Create"
       class="market-primary-button">
        <i class="bi bi-plus-lg"></i>
        Add Market
    </a>
</section>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-warning">
        @TempData["ErrorMessage"]
    </div>
}

<section class="market-summary-grid">
    <div class="market-summary-card">
        <span>Total Markets</span>
        <strong>@Model.TotalMarkets</strong>
    </div>

    <div class="market-summary-card">
        <span>Active</span>
        <strong>@Model.ActiveMarkets</strong>
    </div>

    <div class="market-summary-card">
        <span>Inactive</span>
        <strong>@Model.InactiveMarkets</strong>
    </div>
</section>

<section class="market-management-card">

    <div class="market-toolbar">
        <div class="market-search">
            <i class="bi bi-search"></i>

            <input type="text"
                   id="marketSearch"
                   placeholder="Search market or address..." />
        </div>
    </div>

    @if (!Model.Markets.Any())
    {
        <div class="market-empty-state">
            No markets created yet.
        </div>
    }
    else
    {
        <div class="market-list">

            @foreach (var market in Model.Markets)
            {
                <article class="market-row"
                         data-search="@($"{market.MarketName} {market.Address}".ToLowerInvariant())">

                    <div class="market-icon-box">
                        <i class="bi bi-shop"></i>
                    </div>

                    <div class="market-info">

                        <div class="market-title-row">
                            <div>
                                <h3>
                                    <a asp-controller="AdminMarkets"
                                       asp-action="Details"
                                       asp-route-id="@market.MarketId"
                                       class="market-name-link">
                                        @market.MarketName
                                    </a>
                                </h3>

                                <span>
                                    <i class="bi bi-geo-alt"></i>
                                    @market.Address
                                </span>
                            </div>

                            <span class="market-status @(market.IsActive ? "active" : "inactive")">
                                @(market.IsActive ? "Active" : "Inactive")
                            </span>
                        </div>

                        <div class="market-meta">

                            <div>
                                <span>Operating Days</span>
                                <strong>@market.OperatingDaysText</strong>
                            </div>

                            <div>
                                <span>Assigned Farmers</span>
                                <strong>@market.FarmerCount</strong>
                            </div>

                            <div>
                                <span>Map Provider</span>
                                <strong>OpenStreetMap</strong>
                            </div>

                            <div>
                                <span>Coordinates</span>

                                <strong>
                                    @if (market.Latitude.HasValue &&
                                         market.Longitude.HasValue)
                                    {
                                        @($"{market.Latitude}, {market.Longitude}")
                                    }
                                    else
                                    {
                                        @:Not set
                                    }
                                </strong>
                            </div>

                        </div>
                    </div>

                    <div class="market-actions">

                        <a asp-controller="AdminMarkets"
                           asp-action="Details"
                           asp-route-id="@market.MarketId"
                           class="market-action-btn map">
                            <i class="bi bi-map"></i>
                            View Map
                        </a>

                        <a asp-controller="AdminMarkets"
                           asp-action="Days"
                           asp-route-id="@market.MarketId"
                           class="market-action-btn schedule">
                            <i class="bi bi-calendar-week"></i>
                            Operating Days
                        </a>

                        <a asp-controller="AdminMarkets"
                           asp-action="Edit"
                           asp-route-id="@market.MarketId"
                           class="market-action-btn">
                            <i class="bi bi-pencil"></i>
                            Edit
                        </a>

                        <form asp-controller="AdminMarkets"
                              asp-action="ToggleStatus"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@market.MarketId" />

                            <button type="submit"
                                    class="market-action-btn @(market.IsActive ? "danger" : "success")">
                                @(market.IsActive
                                    ? "Deactivate"
                                    : "Activate")
                            </button>
                        </form>

                    </div>

                </article>
            }

        </div>
    }

</section>

@section Styles {
<style>
.admin-market-header{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:22px}
.market-page-label{color:#14836f;font-size:12px;font-weight:800;letter-spacing:.08em}
.admin-market-header h2{margin:7px 0 5px;font-size:28px;font-weight:800}
.admin-market-header p{margin:0;color:#667085}
.market-primary-button{display:inline-flex;align-items:center;gap:8px;background:#13836e;color:#fff;text-decoration:none;padding:10px 15px;border-radius:10px;font-weight:700}
.market-summary-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-bottom:18px}
.market-summary-card{background:#fff;border:1px solid #e7ebef;border-radius:16px;padding:17px}
.market-summary-card span{display:block;color:#667085;font-size:12px}
.market-summary-card strong{display:block;margin-top:4px;font-size:27px}
.market-management-card{background:#fff;border:1px solid #e7ebef;border-radius:18px;overflow:hidden}
.market-toolbar{padding:15px 17px;border-bottom:1px solid #edf0f4}
.market-search{max-width:470px;position:relative}
.market-search i{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#98a2b3}
.market-search input{width:100%;padding:10px 12px 10px 40px;border:1px solid #d8dee6;border-radius:11px}
.market-list{padding:12px}
.market-row{display:grid;grid-template-columns:58px 1fr 175px;gap:15px;align-items:center;padding:16px;border:1px solid #e8ebef;border-radius:14px;margin-bottom:10px}
.market-icon-box{width:50px;height:50px;border-radius:13px;background:#e8f5ef;color:#13836e;display:grid;place-items:center}
.market-title-row{display:flex;justify-content:space-between;gap:12px}
.market-title-row h3{margin:0;font-size:17px;font-weight:800}
.market-name-link{color:#172033;text-decoration:none}
.market-name-link:hover{color:#13836e;text-decoration:underline}
.market-title-row span{color:#667085;font-size:12px}
.market-status{padding:5px 9px;border-radius:999px;font-size:10px;font-weight:800;height:max-content}
.market-status.active{background:#dcfae6;color:#067647}
.market-status.inactive{background:#f2f4f7;color:#475467}
.market-meta{display:flex;gap:28px;flex-wrap:wrap;margin-top:14px}
.market-meta span{display:block;color:#98a2b3;font-size:10px;text-transform:uppercase;font-weight:800}
.market-meta strong{display:block;margin-top:2px;color:#344054;font-size:12px}
.market-actions{display:flex;flex-direction:column;gap:7px}
.market-action-btn{width:100%;border:1px solid #d9dfe5;background:#fff;color:#344054;padding:8px 10px;border-radius:9px;text-decoration:none;font-size:11px;font-weight:700;text-align:center}
.market-action-btn.map{color:#067647;border-color:#abefc6;background:#ecfdf3}
.market-action-btn.schedule{color:#175cd3;border-color:#b2ccff}
.market-action-btn.danger{color:#b42318;border-color:#f3c8c5}
.market-action-btn.success{color:#067647;border-color:#b7e4cd}
.market-empty-state{text-align:center;padding:60px;color:#667085}
@@media(max-width:950px){.market-row{grid-template-columns:50px 1fr}.market-actions{grid-column:1/-1;display:grid;grid-template-columns:repeat(2,1fr)}}
@@media(max-width:650px){.admin-market-header{flex-direction:column;align-items:stretch}.market-summary-grid{grid-template-columns:1fr}.market-row{grid-template-columns:1fr}.market-actions{display:flex;flex-direction:column}}
</style>
}

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    const search = document.getElementById("marketSearch");
    const rows = document.querySelectorAll(".market-row");

    search?.addEventListener("input", function () {
        const value = search.value.trim().toLowerCase();

        rows.forEach(row => {
            row.style.display =
                (row.dataset.search || "").includes(value)
                    ? ""
                    : "none";
        });
    });
});
</script>
}
