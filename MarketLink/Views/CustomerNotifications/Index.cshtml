@model MarketLink.ViewModels.CustomerNotificationsPageViewModel

@{
    ViewData["Title"] = "Notifications";
    Layout = "~/Views/Shared/_CustomerDashboardLayout.cshtml";
}

@section Styles {
<style>
.notif-header{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:18px}
.notif-label{color:#14836f;font-size:12px;font-weight:800;letter-spacing:.08em}
.notif-header h2{margin:7px 0 5px;font-size:28px;font-weight:800}
.notif-header p{margin:0;color:#667085}
.mark-all{border:1px solid #b7e4cd;background:#ecfdf3;color:#067647;padding:9px 12px;border-radius:9px;font-size:11px;font-weight:800}
.notif-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px}
.notif-stats>div{background:#fff;border:1px solid #e7ebef;border-radius:15px;padding:15px}
.notif-stats span{display:block;color:#667085;font-size:11px}
.notif-stats strong{display:block;margin-top:3px;font-size:22px}
.notif-card{background:#fff;border:1px solid #e7ebef;border-radius:18px;overflow:hidden}
.notif-tabs{display:flex;gap:7px;padding:14px 16px;border-bottom:1px solid #edf0f4}
.notif-tab{padding:7px 10px;border-radius:8px;text-decoration:none;color:#667085;font-size:10px;font-weight:800}
.notif-tab.active{background:#e8f5ef;color:#067647}
.notif-list{padding:12px}
.notif-row{display:grid;grid-template-columns:46px 1fr 125px;gap:14px;align-items:center;padding:14px;border:1px solid #e8ebef;border-radius:13px;margin-bottom:10px}
.notif-row.unread{background:#fbfffd;border-color:#cdebdc}
.notif-icon{width:42px;height:42px;border-radius:11px;background:#f2f4f7;display:grid;place-items:center;color:#475467}
.notif-title{display:flex;justify-content:space-between;gap:10px}
.notif-title h3{font-size:14px;margin:0}
.notif-title span{font-size:9px;color:#98a2b3}
.notif-main p{margin:7px 0;color:#475467;font-size:11px}
.notif-type{display:inline-block;padding:4px 7px;border-radius:999px;background:#f8fafc;color:#667085;font-size:9px;font-weight:700}
.new-badge{display:inline-block;background:#dcfae6;color:#067647;padding:4px 7px;border-radius:999px;font-size:9px;font-weight:800}
.notif-actions{display:flex;flex-direction:column;gap:6px}
.notif-btn{width:100%;border:1px solid #d0d5dd;background:#fff;color:#344054;text-decoration:none;padding:7px;border-radius:8px;font-size:10px;font-weight:700;text-align:center}
.notif-btn.primary{background:#13836e;color:#fff;border-color:#13836e}
.notif-btn.danger{color:#b42318;border-color:#f2c8c5}
.empty{padding:60px;text-align:center;color:#667085}
.notice{margin-bottom:14px}
.customer-notification-bell{position:relative}
.customer-notification-badge{position:absolute;top:-5px;right:-5px;min-width:17px;height:17px;padding:0 4px;border-radius:999px;background:#d92d20;color:#fff;font-size:9px;font-weight:800;display:flex;align-items:center;justify-content:center;border:2px solid #fff}
@@media(max-width:700px){.notif-header{align-items:flex-start;flex-direction:column}.notif-row{grid-template-columns:42px 1fr}.notif-actions{grid-column:1/-1;display:grid;grid-template-columns:repeat(3,1fr)}}
@@media(max-width:520px){.notif-stats{grid-template-columns:1fr}.notif-actions{display:flex}}
</style>
}

<section class="notif-header">
    <div>
        <span class="notif-label">
            <i class="bi bi-bell"></i>
            CUSTOMER ALERTS
        </span>

        <h2>Notifications</h2>

        <p>
            Order confirmations, farmer updates, pickup alerts and other activity.
        </p>
    </div>

    @if (Model.UnreadNotifications > 0)
    {
        <form asp-controller="CustomerNotifications"
              asp-action="MarkAllRead"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="mark-all">
                <i class="bi bi-check2-all"></i>
                Mark All Read
            </button>
        </form>
    }
</section>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success notice">
        @TempData["SuccessMessage"]
    </div>
}

<section class="notif-stats">
    <div>
        <span>Total</span>
        <strong>@Model.TotalNotifications</strong>
    </div>

    <div>
        <span>Unread</span>
        <strong>@Model.UnreadNotifications</strong>
    </div>

    <div>
        <span>Read</span>
        <strong>@Model.ReadNotifications</strong>
    </div>
</section>

<section class="notif-card">

    <div class="notif-tabs">
        @foreach (var tab in new[] { "All", "Unread", "Read" })
        {
            <a asp-controller="CustomerNotifications"
               asp-action="Index"
               asp-route-filter="@(tab == "All" ? null : tab)"
               class="notif-tab @(Model.CurrentFilter == tab ? "active" : "")">
                @tab
            </a>
        }
    </div>

    <div class="notif-list">

        @if (!Model.Notifications.Any())
        {
            <div class="empty">
                <i class="bi bi-bell"
                   style="font-size:34px;color:#13836e;"></i>

                <h3 style="margin-top:10px;">
                    No notifications
                </h3>

                <p>
                    Your order and pickup updates will appear here.
                </p>
            </div>
        }
        else
        {
            @foreach (var item in Model.Notifications)
            {
                <article class="notif-row @(item.IsRead ? "" : "unread")">

                    <div class="notif-icon">
                        @switch (item.NotificationType)
                        {
                            case "OrderUpdate":
                                <i class="bi bi-receipt"></i>
                                break;

                            case "PickupReminder":
                                <i class="bi bi-clock"></i>
                                break;

                            case "ReviewResponse":
                                <i class="bi bi-star"></i>
                                break;

                            case "Restock":
                                <i class="bi bi-box-seam"></i>
                                break;

                            default:
                                <i class="bi bi-bell"></i>
                                break;
                        }
                    </div>

                    <div class="notif-main">

                        <div class="notif-title">
                            <div>
                                <h3>@item.Title</h3>

                                <span>
                                    @item.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                                </span>
                            </div>

                            @if (!item.IsRead)
                            {
                                <span class="new-badge">New</span>
                            }
                        </div>

                        <p>@item.Message</p>

                        <span class="notif-type">
                            @item.NotificationType
                        </span>
                    </div>

                    <div class="notif-actions">

                        @if (!string.IsNullOrWhiteSpace(item.ActionUrl))
                        {
                            <a asp-controller="CustomerNotifications"
                               asp-action="Open"
                               asp-route-id="@item.NotificationId"
                               class="notif-btn primary">
                                Open
                            </a>
                        }

                        @if (!item.IsRead)
                        {
                            <form asp-controller="CustomerNotifications"
                                  asp-action="MarkRead"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@item.NotificationId" />

                                <button type="submit"
                                        class="notif-btn">
                                    Mark Read
                                </button>
                            </form>
                        }

                        <form asp-controller="CustomerNotifications"
                              asp-action="Delete"
                              method="post"
                              onsubmit="return confirm('Remove this notification?');">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@item.NotificationId" />

                            <button type="submit"
                                    class="notif-btn danger">
                                Delete
                            </button>
                        </form>

                    </div>

                </article>
            }
        }

    </div>

</section>
