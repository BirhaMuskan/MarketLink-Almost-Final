@model MarketLink.ViewModels.FarmerDetailsViewModel

@{
    ViewData["Title"] = Model.BusinessName + " - Farmer Details";
}

<!-- =========================================================
     FARMER DETAILS HERO
========================================================= -->
<section class="farmer-details-hero">

    <div class="container">

        <!-- Breadcrumb -->
        <div class="farmer-breadcrumb">

            <a asp-controller="Home" asp-action="Index">
                Home
            </a>

            <i class="bi bi-chevron-right"></i>

            <a asp-controller="Farmers" asp-action="Index">
                Farmers
            </a>

            <i class="bi bi-chevron-right"></i>

            <span>Farmer Details</span>

        </div>


        <div class="row align-items-center g-5">

            <!-- Farmer Image -->
            <div class="col-lg-5">

                <div class="farmer-profile-image">

                    @if (!string.IsNullOrWhiteSpace(Model.ProfileImageUrl))
                    {
                        <img src="@Model.ProfileImageUrl"
                             alt="@Model.BusinessName" />
                    }
                    else
                    {
                        <div class="farmer-image-placeholder">
                            <i class="bi bi-person-fill"></i>
                        </div>
                    }

                    @if (Model.IsApproved)
                    {
                        <span class="verified-profile">
                            <i class="bi bi-patch-check-fill"></i>
                            Verified Farmer
                        </span>
                    }

                </div>

            </div>


            <!-- Farmer Information -->
            <div class="col-lg-7">

                <div class="farmer-profile-content">

                    <span class="profile-label">
                        LOCAL FARMER
                    </span>

                    <h1>
                        @Model.BusinessName
                    </h1>

                    <h3>
                        <i class="bi bi-flower1"></i>
                        Local Farm
                    </h3>


                    <!-- Rating -->
                    <div class="profile-rating">

                        <span class="rating-stars">

                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Round(Model.Rating))
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star"></i>
                                }
                            }

                        </span>

                        <strong>
                            @Model.Rating.ToString("0.0")
                        </strong>

                        <span>
                            @Model.ReviewCount Reviews
                        </span>

                    </div>


                    <!-- Description -->
                    <p>
                        @(string.IsNullOrWhiteSpace(Model.Description)
                            ? "This farmer provides fresh and quality local produce through MarketLink."
                            : Model.Description)
                    </p>


                    <!-- Location -->
                    <div class="profile-location">

                        <i class="bi bi-geo-alt-fill"></i>

                        <span>
                            @(string.IsNullOrWhiteSpace(Model.Address)
                                ? "Location not available"
                                : Model.Address)
                        </span>

                    </div>


                    <!-- Actions -->
                    <div class="profile-actions">

                        <button type="button"
                                class="btn btn-farmer-contact">

                            <i class="bi bi-chat-dots-fill"></i>
                            Contact Farmer

                        </button>


                        <button type="button"
                                class="btn btn-farmer-favorite @(Model.IsFavorite ? "active" : "")"
                                id="favoriteFarmer">

                            <i class="bi @(Model.IsFavorite ? "bi-heart-fill" : "bi-heart")"></i>

                            <span>
                                @(Model.IsFavorite ? "Saved" : "Save Farmer")
                            </span>

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     FARMER STATS
========================================================= -->
<section class="farmer-stats-section">

    <div class="container">

        <div class="farmer-stat-wrapper">

            <!-- Products -->
            <div class="farmer-stat">

                <div class="stat-icon">
                    <i class="bi bi-basket2-fill"></i>
                </div>

                <div>
                    <strong>
                        @Model.ProductCount
                    </strong>

                    <span>
                        Products
                    </span>
                </div>

            </div>


            <!-- Rating -->
            <div class="farmer-stat">

                <div class="stat-icon">
                    <i class="bi bi-star-fill"></i>
                </div>

                <div>
                    <strong>
                        @Model.Rating.ToString("0.0")
                    </strong>

                    <span>
                        Average Rating
                    </span>
                </div>

            </div>


            <!-- Reviews -->
            <div class="farmer-stat">

                <div class="stat-icon">
                    <i class="bi bi-chat-square-text-fill"></i>
                </div>

                <div>
                    <strong>
                        @Model.ReviewCount
                    </strong>

                    <span>
                        Reviews
                    </span>
                </div>

            </div>


            <!-- Status -->
            <div class="farmer-stat">

                <div class="stat-icon">
                    <i class="bi bi-patch-check-fill"></i>
                </div>

                <div>
                    <strong>
                        @(Model.IsApproved ? "Verified" : "Pending")
                    </strong>

                    <span>
                        Farmer Status
                    </span>
                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     ABOUT FARMER
========================================================= -->
<section class="about-farmer-section">

    <div class="container">

        <div class="row g-5">

            <!-- About -->
            <div class="col-lg-7">

                <div class="details-section-heading">

                    <span>
                        ABOUT THE FARMER
                    </span>

                    <h2>
                        Growing With
                        <strong>Care &amp; Purpose</strong>
                    </h2>

                </div>


                <p>
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "This farmer is committed to providing fresh, quality produce to customers through MarketLink."
                        : Model.Description)
                </p>

                <p>
                    This farmer is part of the MarketLink platform,
                    helping customers discover fresh local products
                    and connect with trusted farmers.
                </p>


                <div class="farmer-values">

                    <div>
                        <i class="bi bi-check-circle-fill"></i>
                        Fresh Local Produce
                    </div>

                    <div>
                        <i class="bi bi-check-circle-fill"></i>
                        Quality Focused
                    </div>

                    <div>
                        <i class="bi bi-check-circle-fill"></i>
                        Community Support
                    </div>

                    <div>
                        <i class="bi bi-check-circle-fill"></i>
                        Responsible Farming
                    </div>

                </div>

            </div>


            <!-- Farmer Information -->
            <div class="col-lg-5">

                <div class="farm-information-card">

                    <div class="card-heading">

                        <div class="heading-icon">
                            <i class="bi bi-info-circle-fill"></i>
                        </div>

                        <div>

                            <h3>
                                Farmer Information
                            </h3>

                            <span>
                                @Model.BusinessName
                            </span>

                        </div>

                    </div>


                    <!-- Location -->
                    <div class="information-row">

                        <div class="info-icon">
                            <i class="bi bi-geo-alt-fill"></i>
                        </div>

                        <div>

                            <small>
                                Location
                            </small>

                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.Address)
                                    ? "Not available"
                                    : Model.Address)
                            </strong>

                        </div>

                    </div>


                    <!-- Products -->
                    <div class="information-row">

                        <div class="info-icon">
                            <i class="bi bi-basket2-fill"></i>
                        </div>

                        <div>

                            <small>
                                Products
                            </small>

                            <strong>
                                @Model.ProductCount
                            </strong>

                        </div>

                    </div>


                    <!-- Rating -->
                    <div class="information-row">

                        <div class="info-icon">
                            <i class="bi bi-star-fill"></i>
                        </div>

                        <div>

                            <small>
                                Rating
                            </small>

                            <strong>
                                @Model.Rating.ToString("0.0") / 5
                            </strong>

                        </div>

                    </div>


                    <!-- Reviews -->
                    <div class="information-row">

                        <div class="info-icon">
                            <i class="bi bi-chat-square-text-fill"></i>
                        </div>

                        <div>

                            <small>
                                Customer Reviews
                            </small>

                            <strong>
                                @Model.ReviewCount
                            </strong>

                        </div>

                    </div>


                    <!-- Status -->
                    <div class="information-row">

                        <div class="info-icon">
                            <i class="bi bi-patch-check-fill"></i>
                        </div>

                        <div>

                            <small>
                                MarketLink Status
                            </small>

                            <strong>
                                @(Model.IsApproved
                                    ? "Approved Farmer"
                                    : "Pending Approval")
                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     FARMER PRODUCTS
========================================================= -->
<section class="farmer-products-section">

    <div class="container">

        <div class="details-section-heading text-center">

            <span>
                FARMER'S PRODUCTS
            </span>

            <h2>
                Fresh From
                <strong>@Model.BusinessName</strong>
            </h2>

            <p>
                Explore fresh products currently offered by this farmer.
            </p>

        </div>


        @if (Model.Products != null && Model.Products.Any())
        {
            <div class="row g-4">

                @foreach (var product in Model.Products)
                {
                    <div class="col-md-6 col-lg-3">

                        <div class="farmer-product-card">

                            <!-- Product Image -->
                            <div class="product-image">

                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl"
                                         alt="@product.ProductName" />
                                }
                                else
                                {
                                    <div class="product-image-placeholder">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }


                                @if (product.IsAvailable)
                                {
                                    <span>
                                        Available
                                    </span>
                                }
                                else
                                {
                                    <span class="product-unavailable">
                                        Unavailable
                                    </span>
                                }

                            </div>


                            <!-- Product Content -->
                            <div class="product-content">

                                <small>
                                    @(string.IsNullOrWhiteSpace(product.CategoryName)
                                        ? "Fresh Produce"
                                        : product.CategoryName)
                                </small>

                                <h3>
                                    @product.ProductName
                                </h3>


                                @if (!string.IsNullOrWhiteSpace(product.Description))
                                {
                                    <p class="product-description">
                                        @product.Description
                                    </p>
                                }


                                <div class="product-bottom">

                                    <strong>
                                        Rs. @product.Price.ToString("N0")
                                        @(string.IsNullOrWhiteSpace(product.UnitName)
                                            ? ""
                                            : "/" + product.UnitName)
                                    </strong>

                                    <a asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@product.ProductId"
                                       aria-label="View @product.ProductName">

                                        <i class="bi bi-arrow-right"></i>

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="no-products-box text-center">

                <div class="no-products-icon">
                    <i class="bi bi-basket2"></i>
                </div>

                <h3>
                    No Products Available
                </h3>

                <p>
                    This farmer has not added any active products yet.
                </p>

            </div>
        }


        @if (Model.Products != null && Model.Products.Any())
        {
            <div class="text-center products-more-btn">

                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-view-products">

                    View All Products
                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>
        }

    </div>

</section>


<!-- =========================================================
     AVAILABLE MARKET
========================================================= -->
<section class="farmer-market-section">

    <div class="container">

        <div class="row align-items-center g-5">

            <!-- Market Image -->
            <div class="col-lg-6">

                <div class="market-image-wrapper">

                    <img src="https://images.unsplash.com/photo-1488459716781-31db52582fe9?auto=format&fit=crop&w=1000&q=85"
                         alt="Local Farmers Market" />

                    <div class="market-image-badge">

                        <i class="bi bi-shop"></i>

                        <div>

                            <strong>
                                MarketLink
                            </strong>

                            <span>
                                Local Farmers Market
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Market Information -->
            <div class="col-lg-6">

                <div class="market-details">

                    <span class="profile-label">
                        MARKET INFORMATION
                    </span>

                    <h2>
                        Find This Farmer
                        <strong>At Local Markets</strong>
                    </h2>

                    <p>
                        Check MarketLink for markets where
                        @Model.BusinessName is available.
                    </p>


                    <div class="market-info-list">

                        <div>

                            <i class="bi bi-person-badge-fill"></i>

                            <div>

                                <small>
                                    Farmer
                                </small>

                                <strong>
                                    @Model.BusinessName
                                </strong>

                            </div>

                        </div>


                        <div>

                            <i class="bi bi-geo-alt-fill"></i>

                            <div>

                                <small>
                                    Location
                                </small>

                                <strong>
                                    @(string.IsNullOrWhiteSpace(Model.Address)
                                        ? "Not available"
                                        : Model.Address)
                                </strong>

                            </div>

                        </div>


                        <div>

                            <i class="bi bi-shop"></i>

                            <div>

                                <small>
                                    MarketLink
                                </small>

                                <strong>
                                    Available Through MarketLink
                                </strong>

                            </div>

                        </div>

                    </div>


                    <a asp-controller="Markets"
                       asp-action="Index"
                       class="btn btn-market">

                        Explore Markets

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     CTA
========================================================= -->
<section class="farmer-details-cta">

    <div class="container">

        <div class="cta-content">

            <div>

                <span>
                    SUPPORT LOCAL FARMING
                </span>

                <h2>
                    Fresh Food Starts
                    With Local Farmers
                </h2>

                <p>
                    Discover more farmers and fresh products through
                    MarketLink.
                </p>

            </div>


            <div class="cta-actions">

                <a asp-controller="Farmers"
                   asp-action="Index"
                   class="btn btn-light">

                    <i class="bi bi-people"></i>
                    All Farmers

                </a>


                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-outline-light">

                    Explore Products
                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     PAGE CSS
========================================================= -->
@section Styles {

    <style>

        /* =========================================================
               HERO
            ========================================================= */

        .farmer-details-hero {
            padding: 45px 0 80px;
            background: linear-gradient(135deg, #f4fbf5, #ffffff);
        }

        .farmer-breadcrumb {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 45px;
            color: #839087;
            font-size: 13px;
        }

            .farmer-breadcrumb a {
                color: #378050;
                text-decoration: none;
                font-weight: 600;
            }

                .farmer-breadcrumb a:hover {
                    color: #216f3d;
                }

            .farmer-breadcrumb i {
                font-size: 10px;
            }


        /* =========================================================
               FARMER PROFILE IMAGE
            ========================================================= */

        .farmer-profile-image {
            position: relative;
            overflow: hidden;
            border-radius: 28px;
            background: #e8f3eb;
            box-shadow: 0 20px 50px rgba(30, 75, 45, .15);
        }

            .farmer-profile-image img {
                width: 100%;
                height: 510px;
                display: block;
                object-fit: cover;
            }

        .farmer-image-placeholder {
            width: 100%;
            height: 510px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #e8f3eb;
            color: #72a17f;
            font-size: 100px;
        }

        .verified-profile {
            position: absolute;
            left: 20px;
            bottom: 20px;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 10px 15px;
            color: #216d3d;
            background: #e9f7ed;
            border-radius: 30px;
            font-size: 13px;
            font-weight: 800;
        }


        /* =========================================================
               PROFILE CONTENT
            ========================================================= */

        .farmer-profile-content {
            padding-left: 20px;
        }

        .profile-label {
            display: inline-block;
            margin-bottom: 12px;
            color: #2b9653;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1.8px;
        }

        .farmer-profile-content h1 {
            margin-bottom: 8px;
            color: #193d29;
            font-size: clamp(40px, 5vw, 60px);
            font-weight: 800;
        }

        .farmer-profile-content h3 {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 18px;
            color: #63806d;
            font-size: 19px;
            font-weight: 600;
        }

            .farmer-profile-content h3 i {
                color: #2d9955;
            }


        /* =========================================================
               RATING
            ========================================================= */

        .profile-rating {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 20px;
        }

        .rating-stars {
            color: #e7a82e;
            font-size: 15px;
        }

        .profile-rating strong {
            color: #304b39;
        }

        .profile-rating > span:last-child {
            color: #89958d;
            font-size: 13px;
        }


        /* =========================================================
               DESCRIPTION / LOCATION
            ========================================================= */

        .farmer-profile-content > p {
            max-width: 620px;
            margin-bottom: 20px;
            color: #68776e;
            font-size: 16px;
            line-height: 1.85;
        }

        .profile-location {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 27px;
            color: #3d7952;
            font-size: 14px;
            font-weight: 600;
        }


        /* =========================================================
               ACTION BUTTONS
            ========================================================= */

        .profile-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn-farmer-contact,
        .btn-farmer-favorite {
            min-height: 50px;
            padding: 13px 21px;
            border-radius: 11px;
            font-weight: 700;
        }

        .btn-farmer-contact {
            color: #fff;
            background: #2d9955;
            border-color: #2d9955;
        }

            .btn-farmer-contact:hover {
                color: #fff;
                background: #237c44;
                border-color: #237c44;
            }

            .btn-farmer-contact.contact-sent {
                background: #216f3d;
                border-color: #216f3d;
            }

        .btn-farmer-favorite {
            color: #36714a;
            background: #fff;
            border: 1px solid #d3e6d9;
        }

            .btn-farmer-favorite:hover,
            .btn-farmer-favorite.active {
                color: #d84d61;
                background: #fff3f5;
                border-color: #f0ccd2;
            }


        /* =========================================================
               STATS
            ========================================================= */

        .farmer-stats-section {
            padding: 25px 0;
            background: #fff;
        }

        .farmer-stat-wrapper {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            padding: 20px;
            border: 1px solid #e2ece5;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(34, 75, 47, .06);
        }

        .farmer-stat {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 12px 18px;
            border-right: 1px solid #e8eee9;
        }

            .farmer-stat:last-child {
                border-right: 0;
            }

        .stat-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            width: 48px;
            height: 48px;
            color: #2d9955;
            background: #e8f6eb;
            border-radius: 13px;
            font-size: 19px;
        }

        .farmer-stat strong {
            display: block;
            color: #234430;
            font-size: 21px;
        }

        .farmer-stat span {
            color: #829087;
            font-size: 12px;
        }


        /* =========================================================
               ABOUT FARMER
            ========================================================= */

        .about-farmer-section {
            padding: 95px 0;
            background: #fff;
        }

        .details-section-heading {
            margin-bottom: 25px;
        }

            .details-section-heading > span {
                display: block;
                margin-bottom: 9px;
                color: #2b9653;
                font-size: 12px;
                font-weight: 800;
                letter-spacing: 1.7px;
            }

            .details-section-heading h2 {
                margin: 0;
                color: #193d29;
                font-size: clamp(31px, 4vw, 44px);
                font-weight: 800;
                line-height: 1.2;
            }

                .details-section-heading h2 strong {
                    color: #2d9955;
                }

        .about-farmer-section p {
            color: #6e7d74;
            line-height: 1.85;
            font-size: 15px;
        }


        /* =========================================================
               VALUES
            ========================================================= */

        .farmer-values {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-top: 28px;
        }

            .farmer-values div {
                display: flex;
                align-items: center;
                gap: 9px;
                color: #42674f;
                font-size: 13px;
                font-weight: 700;
            }

            .farmer-values i {
                color: #2d9955;
                font-size: 17px;
            }


        /* =========================================================
               FARM INFORMATION
            ========================================================= */

        .farm-information-card {
            padding: 28px;
            background: #f6faf7;
            border: 1px solid #dfebe2;
            border-radius: 20px;
        }

        .card-heading {
            display: flex;
            align-items: center;
            gap: 13px;
            padding-bottom: 20px;
            margin-bottom: 5px;
            border-bottom: 1px solid #e0ebe3;
        }

        .heading-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 47px;
            height: 47px;
            color: #2d9955;
            background: #e4f4e8;
            border-radius: 12px;
        }

        .card-heading h3 {
            margin: 0 0 3px;
            color: #294936;
            font-size: 17px;
            font-weight: 800;
        }

        .card-heading span {
            color: #859188;
            font-size: 12px;
        }

        .information-row {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 17px 0;
            border-bottom: 1px solid #e0ebe3;
        }

            .information-row:last-child {
                border-bottom: 0;
            }

        .info-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            flex-shrink: 0;
            color: #398355;
            background: #eaf6ed;
            border-radius: 10px;
        }

        .information-row small {
            display: block;
            margin-bottom: 3px;
            color: #8a968e;
            font-size: 11px;
        }

        .information-row strong {
            color: #36523f;
            font-size: 13px;
            word-break: break-word;
        }


        /* =========================================================
               PRODUCTS
            ========================================================= */

        .farmer-products-section {
            padding: 95px 0;
            background: #f5faf6;
        }

        .details-section-heading.text-center {
            max-width: 700px;
            margin: 0 auto 45px;
        }

        .details-section-heading p {
            margin: 12px 0 0;
            color: #77847c;
