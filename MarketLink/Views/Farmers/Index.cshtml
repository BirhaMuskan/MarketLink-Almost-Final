<!-- =========================
     WHY SUPPORT FARMERS
========================= -->
<section class="support-farmers">

    <div class="container">

        <div class="section-heading text-center">
            <span>WHY SHOP LOCAL?</span>

            <h2>
                Support Your <strong>Local Farmers</strong>
            </h2>

            <p>
                Every purchase helps strengthen local communities and
                supports the people who grow our food.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-6 col-lg-3">
                <div class="support-card">
                    <div class="support-icon">
                        <i class="bi bi-basket2-fill"></i>
                    </div>

                    <h3>Fresh Produce</h3>

                    <p>
                        Get fresh products sourced directly from local farms.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="support-card">
                    <div class="support-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>

                    <h3>Support Farmers</h3>

                    <p>
                        Help local farmers grow their businesses and
                        communities.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="support-card">
                    <div class="support-icon">
                        <i class="bi bi-geo-alt-fill"></i>
                    </div>

                    <h3>Shop Locally</h3>

                    <p>
                        Discover quality food from farms around your area.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="support-card">
                    <div class="support-icon">
                        <i class="bi bi-heart-fill"></i>
                    </div>

                    <h3>Build Community</h3>

                    <p>
                        Create stronger connections between farmers and
                        families.
                    </p>
                </div>
            </div>

        </div>

    </div>

</section>


<!-- =========================
     CTA
========================= -->
<section class="farmer-cta">

    <div class="container">

        <div class="farmer-cta-inner">

            <div>
                <span>GROW LOCAL. SHOP LOCAL.</span>

                <h2>
                    Discover Freshness<br />
                    From Local Farms
                </h2>

                <p>
                    Find farmers near you and explore their fresh products.
                </p>
            </div>

            <div class="cta-buttons">

                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-light">
                    <i class="bi bi-basket2"></i>
                    Browse Products
                </a>

                <a asp-controller="Markets"
                   asp-action="Index"
                   class="btn btn-outline-light">
                    Find Markets
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>

        </div>

    </div>

</section>


@section Styles {

    <style>

        /* =========================================================
                       FARMERS HERO
                    ========================================================= */

        .farmers-hero {
            position: relative;
            width: 100%;
            overflow: hidden;
            margin: 0;
            padding: 0;
        }


        /* =========================================================
                       HERO BACKGROUND
                    ========================================================= */

        .farmers-hero-image {
            position: relative;
            width: min(calc(100% - 48px), 1400px);
            min-height: 445px;
            margin: 20px auto 0;
            overflow: hidden;
            border-radius: 0 0 28px 28px;
            background-image: url("https://images.unsplash.com/photo-1500937386664-56d1dfef3854?auto=format&fit=crop&w=1600&q=85");
            background-size: cover;
            background-position: center center;
            background-attachment: fixed;
            display: flex;
            align-items: center;
        }


        /* =========================================================
                       HERO OVERLAY
                    ========================================================= */

        .farmers-hero-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient( 90deg, rgba(5, 67, 40, 0.92) 0%, rgba(8, 78, 48, 0.78) 40%, rgba(8, 78, 48, 0.40) 72%, rgba(8, 78, 48, 0.12) 100% );
            z-index: 1;
        }


        /* =========================================================
                       HERO CONTAINER
                    ========================================================= */

        .farmers-hero .container {
            position: relative;
            z-index: 2;
            width: 100%;
        }


        /* =========================================================
                       HERO CONTENT
                    ========================================================= */

        .farmers-hero-content {
            width: 100%;
            max-width: 720px;
            padding: 82px 0 78px;
        }


        /* =========================================================
                       BREADCRUMB
                    ========================================================= */

        .farmers-breadcrumb {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 11px;
            margin-bottom: 30px;
            font-size: 14px;
        }


            .farmers-breadcrumb a {
                color: #ffffff;
                text-decoration: none;
                font-weight: 600;
                transition: 0.3s ease;
            }


                .farmers-breadcrumb a:hover {
                    color: #d8f52d;
                }


            .farmers-breadcrumb i {
                color: #d8f52d;
                font-size: 10px;
            }


            .farmers-breadcrumb span {
                color: rgba(255, 255, 255, 0.78);
            }


        /* =========================================================
                       CATEGORY
                    ========================================================= */

        .farmers-category {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 18px;
            color: #d8f52d;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }


            .farmers-category i {
                font-size: 19px;
            }


        /* =========================================================
                       HERO TITLE
                    ========================================================= */

        .farmers-hero h1 {
            margin: 0 0 18px;
            color: #ffffff;
            font-size: clamp(42px, 5vw, 68px);
            line-height: 1.06;
            font-weight: 800;
            letter-spacing: -1.5px;
        }


        /* =========================================================
                       HERO DESCRIPTION
                    ========================================================= */

        .farmers-hero-description {
            max-width: 680px;
            margin: 0;
            color: rgba(255, 255, 255, 0.91);
            font-size: 17px;
            line-height: 1.8;
        }



        /* =========================================================
                       TABLET
                       992px and below
                    ========================================================= */

        @@media (max-width: 991.98px) {

            .farmers-hero-image {
                width: calc(100% - 36px);
                min-height: 430px;
                margin-top: 18px;
                background-attachment: scroll;
                background-position: center center;
                border-radius: 0 0 24px 24px;
            }


            .farmers-hero-content {
                max-width: 680px;
                padding: 75px 0 70px;
            }


            .farmers-breadcrumb {
                margin-bottom: 27px;
            }


            .farmers-hero h1 {
                font-size: clamp(40px, 6vw, 58px);
            }


            .farmers-hero-description {
                font-size: 16px;
                line-height: 1.75;
            }
        }



        /* =========================================================
                       MOBILE / TABLET
                       768px and below
                    ========================================================= */

        @@media (max-width: 767.98px) {

            .farmers-hero-image {
                width: calc(100% - 28px);
                min-height: 430px;
                margin-top: 14px;
                border-radius: 0 0 22px 22px;
                background-attachment: scroll;
                background-position: center center;
            }


            .farmers-hero-content {
                max-width: 100%;
                padding: 65px 0 62px;
            }


            .farmers-breadcrumb {
                gap: 9px;
                margin-bottom: 25px;
                font-size: 13px;
            }


            .farmers-category {
                gap: 7px;
                margin-bottom: 15px;
                font-size: 11px;
                letter-spacing: 1.3px;
            }


                .farmers-category i {
                    font-size: 17px;
                }


            .farmers-hero h1 {
                margin-bottom: 16px;
                font-size: 42px;
                line-height: 1.08;
                letter-spacing: -0.8px;
            }


            .farmers-hero-description {
                font-size: 15.5px;
                line-height: 1.7;
            }
        }



        /* =========================================================
                       SMALL MOBILE
                       576px and below
                    ========================================================= */

        @@media (max-width: 575.98px) {

            .farmers-hero-image {
                width: calc(100% - 20px);
                min-height: 420px;
                margin-top: 10px;
                border-radius: 0 0 20px 20px;
                background-position: 58% center;
            }


            .farmers-hero-content {
                padding: 52px 0 52px;
            }


            .farmers-breadcrumb {
                gap: 8px;
                margin-bottom: 23px;
                font-size: 12px;
            }


                .farmers-breadcrumb i {
                    font-size: 9px;
                }


            .farmers-category {
                margin-bottom: 13px;
                font-size: 10.5px;
                letter-spacing: 1.1px;
            }


                .farmers-category i {
                    font-size: 16px;
                }


            .farmers-hero h1 {
                margin-bottom: 15px;
                font-size: 35px;
                line-height: 1.08;
                letter-spacing: -0.6px;
            }


            .farmers-hero-description {
                font-size: 15px;
                line-height: 1.68;
            }
        }



        /* =========================================================
                       VERY SMALL MOBILE
                       400px and below
                    ========================================================= */

        @@media (max-width: 400px) {

            .farmers-hero-image {
                width: calc(100% - 14px);
                min-height: 405px;
                margin-top: 7px;
                background-position: 60% center;
            }


            .farmers-hero-content {
                padding: 47px 0 48px;
            }


            .farmers-breadcrumb {
                margin-bottom: 21px;
                font-size: 11.5px;
            }


            .farmers-category {
                font-size: 10px;
                letter-spacing: 0.9px;
            }


            .farmers-hero h1 {
                font-size: 32px;
                line-height: 1.08;
            }


            .farmers-hero-description {
                font-size: 14px;
                line-height: 1.65;
            }
        }



        /* =========================================================
                       FARMERS SECTION
                    ========================================================= */

        .farmers-section {
            padding: 95px 0;
            background: #fff;
        }


        .section-heading {
            max-width: 720px;
            margin: 0 auto 45px;
        }


            .section-heading span {
                display: block;
                margin-bottom: 10px;
                color: #2b9653;
                font-size: 12px;
                font-weight: 800;
                letter-spacing: 1.8px;
            }


            .section-heading h2 {
                margin-bottom: 14px;
                color: #193d29;
                font-size: clamp(30px, 4vw, 44px);
                font-weight: 800;
            }


                .section-heading h2 strong {
                    color: #2c9955;
                }


            .section-heading p {
                margin: 0;
                color: #758078;
                line-height: 1.8;
