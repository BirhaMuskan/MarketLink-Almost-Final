    </style>
}


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            const searchInput = document.getElementById("farmerSearch");
            const locationFilter = document.getElementById("farmerLocation");
            const resetButton = document.getElementById("resetFarmers");

            const farmerItems =
                document.querySelectorAll(".farmer-item");

            const noFarmers =
                document.getElementById("noFarmers");


            function filterFarmers() {

                const searchValue =
                    searchInput.value.toLowerCase().trim();

                const locationValue =
                    locationFilter.value.toLowerCase();

                let visibleCount = 0;


                farmerItems.forEach(function(farmer) {

                    const name =
                        farmer.dataset.name.toLowerCase();

                    const location =
                        farmer.dataset.location.toLowerCase();


                    const matchesSearch =
                        name.includes(searchValue);

                    const matchesLocation =
                        locationValue === "" ||
                        location === locationValue;


                    if (matchesSearch && matchesLocation) {

                        farmer.classList.remove("d-none");

                        visibleCount++;

                    } else {

                        farmer.classList.add("d-none");

                    }

                });


                if (visibleCount === 0) {

                    noFarmers.classList.remove("d-none");

                } else {

                    noFarmers.classList.add("d-none");

                }

            }


            searchInput.addEventListener(
                "input",
                filterFarmers
            );


            locationFilter.addEventListener(
                "change",
                filterFarmers
            );


            resetButton.addEventListener(
                "click",
                function() {

                    searchInput.value = "";
                    locationFilter.value = "";

                    filterFarmers();

                }
            );


            /* Favorite Farmer */

            document
                .querySelectorAll(".favorite-farmer")
                .forEach(function(button) {

                    button.addEventListener(
                        "click",
                        function() {

                            const icon =
                                this.querySelector("i");

                            this.classList.toggle("active");

                            if (this.classList.contains("active")) {

                                icon.classList.remove("bi-heart");
                                icon.classList.add("bi-heart-fill");

                            } else {

                                icon.classList.remove("bi-heart-fill");
                                icon.classList.add("bi-heart");

                            }

                        }
                    );

                });

        });

    </script>

}