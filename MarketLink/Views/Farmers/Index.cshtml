@{
    ViewData["Title"] = "Farmers";
}

<!-- =========================================================
     FARMERS HERO
========================================================= -->

<section class="farmers-hero">

    <div class="farmers-hero-image">

        <!-- HERO OVERLAY -->
        <div class="farmers-hero-overlay"></div>

        <div class="container">

            <div class="farmers-hero-content">

                <!-- BREADCRUMB -->
                <div class="farmers-breadcrumb">

                    <a asp-controller="Home"
                       asp-action="Index">
                        Home
                    </a>

                    <i class="bi bi-chevron-right"></i>

                    <span>Farmers</span>

                </div>


                <!-- CATEGORY LABEL -->
                <div class="farmers-category">

                    <i class="bi bi-person-heart"></i>

                    Our Local Farmers

                </div>


                <!-- TITLE -->
                <h1>
                    Meet Our Local Farmers
                </h1>


                <!-- DESCRIPTION -->
                <p class="farmers-hero-description">

                    Get to know the local farmers who grow fresh and quality
                    produce for our communities. Discover their farms,
                    products, and the people behind the food you enjoy.

                </p>

            </div>

        </div>

    </div>

</section>



<!-- =========================
     FARMERS SECTION
========================= -->
<section class="farmers-section" id="farmers">

    <div class="container">

        <div class="section-heading text-center">
            <span>OUR FARMING COMMUNITY</span>

            <h2>
                Meet Our <strong>Local Farmers</strong>
            </h2>

            <p>
                Get to know the hardworking people growing fresh and healthy
                food for your community.
            </p>
        </div>


        <!-- Search & Filter -->
        <div class="farmers-filter-box">

            <div class="row g-3 align-items-center">

                <div class="col-lg-6">
                    <div class="farmer-search">
                        <i class="bi bi-search"></i>

                        <input type="text"
                               id="farmerSearch"
                               class="form-control"
                               placeholder="Search farmer by name or farm..." />
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <select id="farmerLocation" class="form-select">
                        <option value="">All Locations</option>
                        <option value="karachi">Karachi</option>
                        <option value="lahore">Lahore</option>
                        <option value="islamabad">Islamabad</option>
                        <option value="hyderabad">Hyderabad</option>
                    </select>
                </div>

                <div class="col-md-6 col-lg-3">
                    <button type="button"
                            id="resetFarmers"
                            class="btn btn-reset w-100">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        Reset Filters
                    </button>
                </div>

            </div>

        </div>


        <!-- Farmers Grid -->
        <div class="row g-4" id="farmersGrid">


            <!-- Farmer 1 -->
            <div class="col-md-6 col-lg-4 farmer-item"
                 data-name="ahmed khan"
                 data-location="karachi">

                <div class="farmer-card">

                    <div class="farmer-image">
                        <img src="https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=700&q=85"
                             alt="Ahmed Khan">

                        <span class="verified-badge">
                            <i class="bi bi-patch-check-fill"></i>
                            Verified
                        </span>
                    </div>

                    <div class="farmer-content">

                        <div class="farmer-name-row">
                            <div>
                                <h3>Ahmed Khan</h3>
                                <span>Green Valley Farm</span>
                            </div>

                            <button class="favorite-farmer"
                                    type="button"
                                    aria-label="Favorite farmer">
                                <i class="bi bi-heart"></i>
                            </button>
                        </div>

                        <div class="farmer-location">
                            <i class="bi bi-geo-alt-fill"></i>
                            Karachi, Sindh
                        </div>

                        <p>
                            Growing fresh vegetables and seasonal produce
                            using responsible farming practices.
                        </p>

                        <div class="farmer-meta">
                            <span>
                                <i class="bi bi-star-fill"></i>
                                4.9
                            </span>

                            <span>
                                <i class="bi bi-basket2"></i>
                                24 Products
                            </span>
                        </div>

                        <a asp-controller="Farmers"
                           asp-action="Details"
                           asp-route-id="1"
                           class="farmer-view-btn">
                            View Farmer
                            <i class="bi bi-arrow-right"></i>
                        </a>

                    </div>

                </div>

            </div>


            <!-- Farmer 2 -->
            <div class="col-md-6 col-lg-4 farmer-item"
                 data-name="fatima bibi"
                 data-location="lahore">

                <div class="farmer-card">

                    <div class="farmer-image">
                        <img src="https://images.unsplash.com/photo-1592982537447-6f2a6a0a1d8b?auto=format&fit=crop&w=700&q=85"
                             alt="Fatima Bibi">

                        <span class="verified-badge">
                            <i class="bi bi-patch-check-fill"></i>
                            Verified
