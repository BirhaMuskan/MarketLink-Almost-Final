@model MarketLink.ViewModels.AdminReportsPageViewModel

@{
    ViewData["Title"] = "Reports & Analytics";
    Layout = "~/Views/Shared/_AdminDashboardLayout.cshtml";
}

@section Styles {
<style>
.report-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:18px}
.report-label{color:#14836f;font-size:12px;font-weight:800;letter-spacing:.08em}
.report-head h2{margin:7px 0 5px;font-size:28px;font-weight:800}
.report-head p{margin:0;color:#667085}
.filter-card{background:#fff;border:1px solid #e7ebef;border-radius:16px;padding:14px;margin-bottom:18px}
.filter-form{display:flex;gap:10px;align-items:end;flex-wrap:wrap}
.filter-field label{display:block;color:#667085;font-size:9px;font-weight:800;margin-bottom:5px;text-transform:uppercase}
.filter-field input{border:1px solid #d0d5dd;border-radius:9px;padding:9px 10px;font-size:11px}
.primary-btn,.secondary-btn{display:inline-flex;align-items:center;gap:6px;padding:9px 12px;border-radius:9px;font-size:10px;font-weight:800;text-decoration:none}
.primary-btn{border:0;background:#13836e;color:#fff}
.secondary-btn{border:1px solid #d0d5dd;background:#fff;color:#344054}
.kpis{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-bottom:18px}
.kpi{background:#fff;border:1px solid #e7ebef;border-radius:15px;padding:15px}
.kpi span{display:block;color:#667085;font-size:10px}
.kpi strong{display:block;margin-top:4px;font-size:21px}
.grid-two{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:18px}
.card{background:#fff;border:1px solid #e7ebef;border-radius:18px;overflow:hidden}
.card-head{padding:15px 17px;border-bottom:1px solid #edf0f4}
.card-head span{color:#13836e;font-size:9px;font-weight:800;letter-spacing:.08em}
.card-head h3{margin:3px 0 0;font-size:16px}
.card-body{padding:14px}
.metric-row{margin-bottom:12px}
.metric-top{display:flex;justify-content:space-between;gap:10px;margin-bottom:5px;font-size:10px}
.metric-bar{height:8px;border-radius:999px;background:#eef2f4;overflow:hidden}
.metric-fill{height:100%;background:#13836e;border-radius:999px}
.table-wrap{overflow:auto}
.report-table{width:100%;border-collapse:collapse}
.report-table th{background:#f8fafc;color:#667085;padding:10px 12px;font-size:9px;text-transform:uppercase;white-space:nowrap}
.report-table td{padding:12px;border-top:1px solid #edf0f4;font-size:10px;white-space:nowrap}
.rank{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;background:#e8f5ef;color:#067647;font-size:9px;font-weight:900}
.revenue{font-weight:800}
.month-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:10px}
.month-card{background:#f8fafc;border-radius:11px;padding:11px}
.month-card span{display:block;color:#667085;font-size:9px}
.month-card strong{display:block;margin-top:3px;font-size:14px}
.empty{text-align:center;padding:35px;color:#667085}
@@media(max-width:1200px){.kpis{grid-template-columns:repeat(3,1fr)}}
@@media(max-width:900px){.grid-two{grid-template-columns:1fr}}
@@media(max-width:600px){.report-head{flex-direction:column;align-items:stretch}.kpis{grid-template-columns:repeat(2,1fr)}.filter-field,.filter-field input,.primary-btn,.secondary-btn{width:100%}}
</style>
}

<section class="report-head">
    <div>
        <span class="report-label">
            <i class="bi bi-bar-chart-line"></i>
            PLATFORM PERFORMANCE
        </span>

        <h2>Reports & Analytics</h2>

        <p>
            Platform-wide order, revenue, farmer, market and product performance.
        </p>
    </div>
</section>

<section class="filter-card">

    <form asp-controller="AdminReports"
          asp-action="Index"
          method="get"
          class="filter-form">

        <div class="filter-field">
            <label>From Date</label>
            <input type="date"
                   name="fromDate"
                   value="@Model.FromDate.ToString("yyyy-MM-dd")" />
        </div>

        <div class="filter-field">
            <label>To Date</label>
            <input type="date"
                   name="toDate"
                   value="@Model.ToDate.ToString("yyyy-MM-dd")" />
        </div>

        <button type="submit"
                class="primary-btn">
            <i class="bi bi-funnel"></i>
            Apply
        </button>

        <a asp-controller="AdminReports"
           asp-action="ExportCsv"
           asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")"
           asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")"
           class="secondary-btn">

            <i class="bi bi-download"></i>
            Export Orders CSV
        </a>

    </form>

</section>

<section class="kpis">

    <div class="kpi">
        <span>Total Orders</span>
        <strong>@Model.TotalOrders</strong>
    </div>

    <div class="kpi">
        <span>Completed</span>
        <strong>@Model.CompletedOrders</strong>
    </div>

    <div class="kpi">
        <span>Cancelled</span>
        <strong>@Model.CancelledOrders</strong>
    </div>

    <div class="kpi">
        <span>Revenue</span>
        <strong>Rs. @Model.Revenue.ToString("N2")</strong>
    </div>

    <div class="kpi">
        <span>Avg. Order Value</span>
        <strong>Rs. @Model.AverageOrderValue.ToString("N2")</strong>
    </div>

    <div class="kpi">
        <span>Active Farmers</span>
        <strong>@Model.ActiveFarmers</strong>
    </div>

</section>

<div class="grid-two">

    <section class="card">

        <div class="card-head">
            <span>ORDER LIFECYCLE</span>
            <h3>Order Status Mix</h3>
        </div>

        <div class="card-body">

            @if (!Model.OrderStatusMix.Any())
            {
                <div class="empty">
                    No orders in this date range.
                </div>
            }
            else
            {
                @foreach (var item in Model.OrderStatusMix)
                {
                    <div class="metric-row">

                        <div class="metric-top">
                            <strong>@item.Status</strong>
                            <span>
                                @item.Count · @item.Percentage.ToString("N1")%
                            </span>
                        </div>

                        <div class="metric-bar">
                            <div class="metric-fill"
                                 style="width:@item.Percentage.ToString(System.Globalization.CultureInfo.InvariantCulture)%">
                            </div>
                        </div>

                    </div>
                }
            }

        </div>

    </section>

    <section class="card">

        <div class="card-head">
            <span>MONTHLY TREND</span>
            <h3>Orders & Revenue</h3>
        </div>

        <div class="card-body">

            @if (!Model.MonthlyPerformance.Any())
            {
                <div class="empty">
                    No monthly data available.
                </div>
            }
            else
            {
                <div class="month-grid">

                    @foreach (var month in Model.MonthlyPerformance)
                    {
                        <div class="month-card">
                            <span>@month.MonthLabel</span>
                            <strong>
                                Rs. @month.Revenue.ToString("N0")
                            </strong>
                            <span>
                                @month.OrderCount orders ·
                                @month.CompletedOrders completed
                            </span>
                        </div>
                    }

                </div>
            }

        </div>

    </section>

</div>

<div class="grid-two">

    <section class="card">

        <div class="card-head">
            <span>FARMERS</span>
            <h3>Most Active Farmers</h3>
        </div>

        @if (!Model.TopFarmers.Any())
        {
            <div class="empty">
                No farmer activity in this range.
            </div>
        }
        else
        {
            <div class="table-wrap">

                <table class="report-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Farmer</th>
                            <th>Orders</th>
                            <th>Completed</th>
                            <th>Revenue</th>
                        </tr>
                    </thead>

                    <tbody>

                        @{
                            var rank = 1;
                        }

                        @foreach (var item in Model.TopFarmers)
                        {
                            <tr>
                                <td>
                                    <span class="rank">@rank</span>
                                </td>

                                <td>
                                    <strong>@item.FarmerName</strong>
                                </td>

                                <td>@item.OrderCount</td>

                                <td>@item.CompletedOrders</td>

                                <td class="revenue">
                                    Rs. @item.Revenue.ToString("N2")
                                </td>
                            </tr>

                            rank++;
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>

    <section class="card">

        <div class="card-head">
            <span>MARKETS</span>
            <h3>Market Performance</h3>
        </div>

        @if (!Model.MarketPerformance.Any())
        {
            <div class="empty">
                No market activity in this range.
            </div>
        }
        else
        {
            <div class="table-wrap">

                <table class="report-table">
                    <thead>
                        <tr>
                            <th>Market</th>
                            <th>Orders</th>
                            <th>Completed</th>
                            <th>Revenue</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.MarketPerformance)
                        {
                            <tr>
                                <td>
                                    <strong>@item.MarketName</strong>
                                </td>

                                <td>@item.OrderCount</td>

                                <td>@item.CompletedOrders</td>

                                <td class="revenue">
                                    Rs. @item.Revenue.ToString("N2")
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>

</div>

<section class="card">

    <div class="card-head">
        <span>PRODUCTS</span>
        <h3>Top Products</h3>
    </div>

    @if (!Model.TopProducts.Any())
    {
        <div class="empty">
            No completed product sales in this range.
        </div>
    }
    else
    {
        <div class="table-wrap">

            <table class="report-table">

                <thead>
                    <tr>
                        <th>#</th>
                        <th>Product</th>
                        <th>Orders</th>
                        <th>Quantity Sold</th>
                        <th>Revenue</th>
                    </tr>
                </thead>

                <tbody>

                    @{
                        var productRank = 1;
                    }

                    @foreach (var item in Model.TopProducts)
                    {
                        <tr>

                            <td>
                                <span class="rank">
                                    @productRank
                                </span>
                            </td>

                            <td>
                                <strong>@item.ProductName</strong>
                            </td>

                            <td>@item.OrderCount</td>

                            <td>
                                @item.QuantitySold.ToString("N3")
                            </td>

                            <td class="revenue">
                                Rs. @item.Revenue.ToString("N2")
                            </td>

                        </tr>

                        productRank++;
                    }

                </tbody>

            </table>

        </div>
    }

</section>
