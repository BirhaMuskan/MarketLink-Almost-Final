@{
    ViewData["Title"] = "About Us";
}

<!-- =========================================================
     ABOUT HERO
========================================================= -->

<section class="about-hero">

    <div class="about-hero-image">

        <div class="about-hero-overlay"></div>

        <div class="container">

            <div class="about-hero-content">

                <!-- Breadcrumb -->
                <div class="about-breadcrumb">

                    <a asp-controller="Home"
                       asp-action="Index">
                        Home
                    </a>

                    <i class="bi bi-chevron-right"></i>

                    <span>About Us</span>

                </div>

                <!-- Hero Content -->
                <div class="about-hero-text">

                    <span class="about-label">
                        <i class="bi bi-info-circle-fill"></i>
                        ABOUT MARKETLINK
                    </span>

                    <h1>
                        About
                        <strong>MarketLink</strong>
                    </h1>

                    <p>
                        Connecting local farmers, fresh products and
                        communities through one simple marketplace.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     OUR STORY
========================================================= -->

<section class="our-story-section">

    <div class="container">

        <div class="row align-items-center g-5">

            <!-- Image -->
            <div class="col-lg-6">

                <div class="story-image-wrapper">

                    <img src="https://images.unsplash.com/photo-1500937386664-56d1dfef3854?auto=format&fit=crop&w=900&q=85"
                         alt="Local Farmer Working on Farm">

                    <div class="story-experience-card">

                        <strong>Local</strong>

                        <span>Community First</span>

                    </div>

                </div>

            </div>


            <!-- Content -->
            <div class="col-lg-6">

                <div class="story-content">

                    <span class="about-label">
                        OUR STORY
                    </span>

                    <h2>
                        Making Local Food
                        <strong>Easier to Discover.</strong>
                    </h2>

                    <p>
                        Finding fresh local food should not be complicated.
                        MarketLink was created to make it easier for customers
                        to discover nearby farmers, products and farmers markets
                        through one convenient digital platform.
                    </p>

                    <p>
                        Local farmers work hard to grow fresh produce for their
                        communities. At the same time, customers want useful
                        information about available products, farmers, markets,
                        prices and pickup options before visiting.
                    </p>

                    <p>
                        MarketLink brings customers and local farmers together
                        by making product discovery, pre-ordering and pickup
                        information easier to access.
                    </p>


                    <div class="story-points">

                        <div>
                            <i class="bi bi-check-circle-fill"></i>
                            Discover local farmers
                        </div>

                        <div>
                            <i class="bi bi-check-circle-fill"></i>
                            Explore nearby markets
                        </div>

                        <div>
                            <i class="bi bi-check-circle-fill"></i>
                            Browse fresh products
                        </div>

                        <div>
                            <i class="bi bi-check-circle-fill"></i>
                            Pre-order for pickup
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     MISSION / VISION
========================================================= -->

<section class="mission-section">

    <div class="container">

        <div class="about-section-heading text-center">

            <span>WHAT DRIVES US</span>

            <h2>
                Our Mission &
                <strong>Vision</strong>
            </h2>

            <p>
                MarketLink is designed to make local food discovery simpler
                while helping farmers and customers build stronger connections.
            </p>

        </div>


        <div class="row g-4">

            <!-- Mission -->
            <div class="col-md-6">

                <div class="mission-card">

                    <div class="mission-icon">
                        <i class="bi bi-bullseye"></i>
                    </div>

                    <span>OUR MISSION</span>

                    <h3>
                        Connecting Local Communities
                    </h3>

                    <p>
                        Our mission is to create a simple platform where
                        customers can discover local farmers, fresh products
                        and nearby markets while helping farmers present their
                        available stock and reach their communities.
                    </p>

                </div>

            </div>


            <!-- Vision -->
            <div class="col-md-6">

                <div class="mission-card vision-card">

                    <div class="mission-icon">
                        <i class="bi bi-eye-fill"></i>
                    </div>

                    <span>OUR VISION</span>

                    <h3>
                        A Stronger Local Food Network
                    </h3>

                    <p>
                        We envision a connected local food network where
                        customers can easily discover fresh products and
                        farmers can maintain a useful digital presence within
                        the markets they serve.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     VALUES
========================================================= -->

<section class="values-section">

    <div class="container">

        <div class="about-section-heading text-center">

            <span>OUR VALUES</span>

            <h2>
                What
                <strong>We Believe In</strong>
            </h2>

            <p>
                These principles guide the way MarketLink connects farmers,
                customers and local communities.
            </p>

        </div>


        <div class="row g-4">

            <!-- Freshness -->
            <div class="col-md-6 col-lg-3">

                <div class="value-card">

                    <div class="value-icon">
                        <i class="bi bi-leaf-fill"></i>
                    </div>

                    <h3>Freshness</h3>

                    <p>
                        Helping customers discover fresh products from local
                        farms and farmers markets.
                    </p>

                </div>

            </div>


            <!-- Community -->
            <div class="col-md-6 col-lg-3">

                <div class="value-card">

                    <div class="value-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>

                    <h3>Community</h3>

                    <p>
                        Building stronger connections between farmers,
                        customers and local communities.
                    </p>

                </div>

            </div>


            <!-- Trust -->
            <div class="col-md-6 col-lg-3">

                <div class="value-card">

                    <div class="value-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>

                    <h3>Trust</h3>

                    <p>
                        Making useful information about farmers, products,
                        markets and orders easier to access.
                    </p>

                </div>

            </div>


            <!-- Local Support -->
            <div class="col-md-6 col-lg-3">

                <div class="value-card">

                    <div class="value-icon">
                        <i class="bi bi-hand-thumbs-up-fill"></i>
                    </div>

                    <h3>Local Support</h3>

                    <p>
                        Helping customers discover and support local farmers
                        and businesses.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     MARKETLINK PLATFORM
========================================================= -->

<section class="platform-section">

    <div class="container">

        <div class="about-section-heading text-center">

            <span>THE MARKETLINK PLATFORM</span>

            <h2>
                Built Around
                <strong>Local Food Discovery</strong>
            </h2>

            <p>
                MarketLink brings the main parts of the local farmers market
                experience together in one web application.
            </p>

        </div>


        <div class="platform-grid">

            <!-- Markets -->
            <div class="platform-card">

                <div class="platform-card-icon">
                    <i class="bi bi-shop-window"></i>
                </div>

                <div>

                    <span>01</span>

                    <h3>Discover Markets</h3>

                    <p>
                        Customers can explore farmers markets, their locations,
                        operating information and available farmers.
                    </p>

                </div>

            </div>


            <!-- Farmers -->
            <div class="platform-card">

                <div class="platform-card-icon">
                    <i class="bi bi-person-badge-fill"></i>
                </div>

                <div>

                    <span>02</span>

                    <h3>Find Farmers</h3>

                    <p>
                        Customers can discover farmer profiles and learn more
                        about their products and market availability.
                    </p>

                </div>

            </div>


            <!-- Products -->
            <div class="platform-card">

                <div class="platform-card-icon">
                    <i class="bi bi-basket2-fill"></i>
                </div>

                <div>

                    <span>03</span>

                    <h3>Browse Products</h3>

                    <p>
                        Customers can search and explore products according
                        to categories, prices, markets and availability.
                    </p>

                </div>

            </div>


            <!-- Pre-orders -->
            <div class="platform-card">

                <div class="platform-card-icon">
                    <i class="bi bi-cart-check-fill"></i>
                </div>

                <div>

                    <span>04</span>

                    <h3>Pre-Order for Pickup</h3>

                    <p>
                        Customers can place orders in advance and arrange
                        pickup according to the available pickup options.
                    </p>

                </div>

            </div>


            <!-- Maps -->
            <div class="platform-card">

                <div class="platform-card-icon">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>

                <div>

                    <span>05</span>

                    <h3>Location Discovery</h3>

                    <p>
                        MarketLink can provide location information to help
                        customers find markets and farmer pickup points.
                    </p>

                </div>

            </div>


            <!-- Reviews -->
            <div class="platform-card">

                <div class="platform-card-icon">
                    <i class="bi bi-star-fill"></i>
                </div>

                <div>

                    <span>06</span>

                    <h3>Reviews & Ratings</h3>

                    <p>
                        Customers can provide feedback and ratings after
                        completing their purchases.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     HOW WE HELP
========================================================= -->

<section class="help-section">

    <div class="container">

        <div class="row align-items-center g-5">

            <!-- Image -->
            <div class="col-lg-5">

                <div class="help-image">

                    <img src="https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=900&q=85"
                         alt="Fresh Vegetables">

                    <div class="help-image-badge">

                        <i class="bi bi-basket-fill"></i>

                        <div>

                            <strong>Fresh Choices</strong>

                            <span>From Local Sources</span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Content -->
            <div class="col-lg-7">

                <div class="help-content">

                    <span class="about-label">
                        WHAT MARKETLINK DOES
                    </span>

                    <h2>
                        One Platform,
                        <strong>Many Local Connections.</strong>
                    </h2>

                    <p>
                        MarketLink is designed around the needs of both
                        customers and local farmers.
                    </p>


                    <div class="help-list">

                        <!-- Customers -->
                        <div class="help-item">

                            <div class="help-icon">
                                <i class="bi bi-search"></i>
                            </div>

                            <div>

                                <h4>For Customers</h4>

                                <p>
                                    Discover products, farmers and markets
                                    in one place, place pre-orders and
                                    prepare for pickup.
                                </p>

                            </div>

                        </div>


                        <!-- Farmers -->
                        <div class="help-item">

                            <div class="help-icon">
                                <i class="bi bi-person-vcard-fill"></i>
                            </div>

                            <div>

                                <h4>For Farmers</h4>

                                <p>
                                    Manage farmer information, showcase
                                    products, update stock and manage
                                    customer pre-orders.
                                </p>

                            </div>

                        </div>


                        <!-- Markets -->
                        <div class="help-item">

                            <div class="help-icon">
                                <i class="bi bi-shop"></i>
                            </div>

                            <div>

                                <h4>For Markets</h4>

                                <p>
                                    Help customers discover market locations,
                                    operating information and participating
                                    farmers.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     TEAM / PLATFORM INFORMATION
     SRS: ABOUT US
========================================================= -->

<section class="team-section">

    <div class="container">

        <div class="about-section-heading text-center">

            <span>ABOUT OUR PROJECT</span>

            <h2>
                The People Behind
                <strong>MarketLink</strong>
            </h2>

            <p>
                MarketLink is a full-stack web application designed to connect
                local farmers, farmers markets and customers through a
                centralized digital platform.
            </p>

        </div>


        <div class="row g-4">

            <!-- Project -->
            <div class="col-md-6 col-lg-4">

                <div class="team-info-card">

                    <div class="team-info-icon">
                        <i class="bi bi-laptop"></i>
                    </div>

                    <span>THE PROJECT</span>

                    <h3>
                        Full-Stack Web Solution
                    </h3>

                    <p>
                        MarketLink combines a responsive user interface,
                        application logic and database functionality to
                        provide a complete web-based marketplace experience.
                    </p>

                </div>

            </div>


            <!-- Customers -->
            <div class="col-md-6 col-lg-4">

                <div class="team-info-card">

                    <div class="team-info-icon">
                        <i class="bi bi-person-heart"></i>
                    </div>

                    <span>FOR CUSTOMERS</span>

                    <h3>
                        Simple Food Discovery
                    </h3>

                    <p>
                        Customers can browse markets, farmers and products,
                        manage favorites, place pre-orders and keep track
                        of their order history.
                    </p>

                </div>

            </div>


            <!-- Farmers -->
            <div class="col-md-6 col-lg-4">

                <div class="team-info-card">

                    <div class="team-info-icon">
                        <i class="bi bi-tree-fill"></i>
                    </div>

                    <span>FOR FARMERS</span>

                    <h3>
                        Digital Farmer Presence
                    </h3>

                    <p>
                        Farmers can present their products, manage stock
                        information and handle customer pre-orders through
                        the platform.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     COMMUNITY
========================================================= -->

<section class="community-section">

    <div class="container">

        <div class="community-box">

            <div class="community-content">

                <span>OUR COMMUNITY</span>

                <h2>
                    Better Food Starts
                    With Better Connections.
                </h2>

                <p>
                    MarketLink is built around the idea that local farmers,
                    customers and communities can benefit when they are
                    easier to connect.
                </p>

                <a asp-controller="Contact"
                   asp-action="Index"
                   class="btn btn-community">

                    Get In Touch

                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>


            <div class="community-icon">

                <i class="bi bi-globe2"></i>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     CTA
========================================================= -->

<section class="about-cta">

    <div class="container">

        <div class="about-cta-content">

            <span>DISCOVER MARKETLINK</span>

            <h2>
                Discover What's Growing
                Around You.
            </h2>

            <p>
                Explore local farmers, fresh products and nearby markets.
            </p>


            <div class="about-cta-buttons">

                <a asp-controller="Markets"
                   asp-action="Index"
                   class="btn btn-light">

                    Explore Markets

                    <i class="bi bi-arrow-right"></i>

                </a>


                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-outline-light">

                    Browse Products

                </a>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     COMPLETE ABOUT PAGE CSS
========================================================= -->
@section Styles {

    <style>

        /* =========================================================
                   GLOBAL ABOUT PAGE
                ========================================================= */

        .about-hero,
        .our-story-section,
        .mission-section,
        .values-section,
        .platform-section,
        .help-section,
        .team-section,
        .community-section,
        .about-cta {
            overflow: hidden;
        }


        /* =========================================================
                   ABOUT HERO
                ========================================================= */

        .about-hero {
            position: relative;
            min-height: 460px;
        }


        .about-hero-image {
            position: relative;
            display: flex;
            align-items: center;
            width: min(100% - 48px, 1400px);
            min-height: 445px;
            margin: 20px auto 0;
            overflow: hidden;
            background-image: url("https://images.unsplash.com/photo-1464226184884-fa280b87c399?auto=format&fit=crop&w=1800&q=85");
            background-size: cover;
            background-position: center center;
            background-attachment: fixed;
            border-radius: 0 0 28px 28px;
        }


        .about-hero-overlay {
            position: absolute;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            background: linear-gradient( 90deg, rgba(5, 67, 40, .94) 0%, rgba(8, 78, 48, .80) 42%, rgba(8, 78, 48, .45) 72%, rgba(8, 78, 48, .18) 100% );
        }


        .about-hero-image .container {
            position: relative;
            z-index: 2;
            width: 100%;
        }


        .about-hero-content {
            max-width: 720px;
            padding: 85px 0 80px;
        }


        /* =========================================================
                   BREADCRUMB
                ========================================================= */

        .about-breadcrumb {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 38px;
            font-size: 14px;
        }


            .about-breadcrumb a {
                color: #ffffff;
                text-decoration: none;
                font-weight: 600;
                transition: .3s ease;
            }


                .about-breadcrumb a:hover {
                    color: #d8f52d;
                }


            .about-breadcrumb i {
                color: #d8f52d;
                font-size: 11px;
            }


            .about-breadcrumb span {
                color: rgba(255,255,255,.78);
            }


        /* =========================================================
                   LABEL
                ========================================================= */

        .about-label {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 17px;
            color: #c8e83a;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }


            .about-label i {
                color: #c8e83a;
                font-size: 14px;
            }


        /* =========================================================
                   HERO TEXT
                ========================================================= */

        .about-hero-text {
            max-width: 720px;
        }


            .about-hero-text h1 {
                margin: 0 0 18px;
                color: #ffffff;
                font-size: clamp(44px, 5vw, 72px);
                line-height: 1.05;
                font-weight: 800;
                letter-spacing: -1.5px;
            }


                .about-hero-text h1 strong {
                    color: #d8f52d;
                    font-weight: 800;
                }


            .about-hero-text p {
                max-width: 650px;
                margin: 0;
                color: rgba(255,255,255,.90);
                font-size: 17px;
                line-height: 1.75;
            }


        /* =========================================================
                   COMMON SECTION HEADING
                ========================================================= */

        .about-section-heading {
            max-width: 720px;
            margin: 0 auto 50px;
        }


            .about-section-heading > span {
                display: block;
                margin-bottom: 9px;
                color: #2b9653;
                font-size: 12px;
                font-weight: 800;
                letter-spacing: 1.7px;
            }


            .about-section-heading h2 {
                margin: 0;
                color: #193d29;
                font-size: clamp(32px, 4vw, 45px);
                font-weight: 800;
                line-height: 1.2;
            }


                .about-section-heading h2 strong {
                    color: #2d9955;
                }


            .about-section-heading p {
                max-width: 680px;
                margin: 13px auto 0;
                color: #78857d;
                line-height: 1.8;
            }


        /* =========================================================
                   OUR STORY
                ========================================================= */

        .our-story-section {
            padding: 100px 0;
            background: #ffffff;
        }


        .story-image-wrapper {
            position: relative;
            padding-right: 25px;
        }


            .story-image-wrapper > img {
                display: block;
                width: 100%;
                height: 500px;
                object-fit: cover;
                border-radius: 25px;
                box-shadow: 0 20px 45px rgba(32,71,45,.12);
            }


        .story-experience-card {
            position: absolute;
            right: 0;
            bottom: 30px;
            padding: 16px 20px;
            background: #2d9955;
            border-radius: 14px;
            box-shadow: 0 14px 30px rgba(32,71,45,.16);
        }


            .story-experience-card strong,
            .story-experience-card span {
                display: block;
            }


            .story-experience-card strong {
                color: #ffffff;
                font-size: 20px;
            }


            .story-experience-card span {
                margin-top: 2px;
                color: #d7f0dd;
                font-size: 10px;
            }


        .story-content {
            padding-left: 25px;
        }


            .story-content .about-label,
            .help-content .about-label {
                color: #2d9955;
            }


            .story-content h2 {
                max-width: 600px;
                margin: 0 0 20px;
                color: #193d29;
                font-size: clamp(32px,4vw,44px);
                line-height: 1.2;
                font-weight: 800;
            }


                .story-content h2 strong {
                    display: block;
                    color: #2d9955;
                }


            .story-content > p {
                color: #6f7d75;
                font-size: 15px;
                line-height: 1.85;
            }


        .story-points {
            display: grid;
            grid-template-columns: repeat(2,1fr);
            gap: 13px;
            margin-top: 28px;
        }


            .story-points div {
                color: #42674f;
                font-size: 13px;
                font-weight: 700;
            }


            .story-points i {
                margin-right: 7px;
                color: #2d9955;
            }


        /* =========================================================
                   MISSION
                ========================================================= */

        .mission-section {
            padding: 100px 0;
            background: #f5faf6;
        }


        .mission-card {
            height: 100%;
            padding: 38px;
            background: #ffffff;
            border: 1px solid #e0ebe3;
            border-radius: 20px;
            transition: .3s ease;
        }


            .mission-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 18px 40px rgba(32,71,45,.08);
            }


        .mission-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 58px;
            height: 58px;
            margin-bottom: 22px;
            color: #2d9955;
            background: #e6f5e9;
            border-radius: 15px;
            font-size: 23px;
        }


        .mission-card > span {
            color: #2d9955;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1.5px;
        }


        .mission-card h3 {
            margin: 10px 0 13px;
            color: #294936;
            font-size: 22px;
            font-weight: 800;
        }


        .mission-card p {
            margin: 0;
            color: #75827a;
            line-height: 1.8;
            font-size: 14px;
        }


        /* =========================================================
                   VALUES
                ========================================================= */

        .values-section {
            padding: 100px 0;
            background: #ffffff;
        }


        .value-card {
            height: 100%;
            padding: 30px 23px;
            text-align: center;
            background: #f7fbf8;
            border: 1px solid #e2ece5;
            border-radius: 18px;
            transition: .3s ease;
        }


            .value-card:hover {
                transform: translateY(-6px);
                background: #ffffff;
                box-shadow: 0 16px 35px rgba(32,71,45,.08);
            }


        .value-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 58px;
            height: 58px;
            margin: 0 auto 20px;
            color: #2d9955;
            background: #e6f5e9;
            border-radius: 15px;
            font-size: 22px;
        }


        .value-card h3 {
            margin-bottom: 10px;
            color: #294936;
            font-size: 18px;
            font-weight: 800;
        }


        .value-card p {
            margin: 0;
            color: #7b8780;
            font-size: 13px;
            line-height: 1.75;
        }


        /* =========================================================
                   PLATFORM SECTION
                ========================================================= */

        .platform-section {
            padding: 100px 0;
            background: #f5faf6;
        }


        .platform-grid {
            display: grid;
