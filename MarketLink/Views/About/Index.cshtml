@{
    ViewData["Title"] = "About Us";
}

<section class="about-hero">

    <div class="about-hero-image">

        <div class="about-hero-overlay"></div>

        <div class="container">

            <div class="about-hero-content">

                <div class="about-breadcrumb">

                    <a asp-controller="Home"
                       asp-action="Index">
                        Home
                    </a>

                    <i class="bi bi-chevron-right"></i>

                    <span>About Us</span>

                </div>

                <div class="about-hero-text">

                    <span class="about-label">
                        <i class="bi bi-file-earmark-person"></i>
                        ABOUT MARKETLINK
                    </span>

                    <h1>
                        About 
                        <strong>MarketLink</strong>
                    </h1>

                    <p>
                        Connecting local farmers, fresh products and communities
                        through one simple marketplace.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- =========================================================
     OUR STORY
========================================================= -->

<section class="our-story-section">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-6">

                <div class="story-image-wrapper">

                    <img src="https://images.unsplash.com/photo-1500937386664-56d1dfef3854?auto=format&fit=crop&w=900&q=85"
                         alt="Farmer Working on Farm">

                    <div class="story-experience-card">

                        <strong>Local</strong>
                        <span>Community First</span>

                    </div>

                </div>

            </div>


            <div class="col-lg-6">

                <div class="story-content">

                    <span class="about-label">
                        OUR STORY
                    </span>

                    <h2>
                        Making Local Food
                        <strong>Easier to Discover.</strong>
                    </h2>

                    <p>
                        Finding fresh local food should not be complicated.
                        MarketLink was created to make it easier for people
                        to discover nearby farmers, products and markets.
                    </p>

                    <p>
                        Local farmers work hard to grow fresh produce for
                        their communities. At the same time, customers often
                        want to know where their food comes from and where
                        they can find it.
                    </p>

                    <p>
                        MarketLink brings both sides together through one
                        simple digital platform.
                    </p>

                    <div class="story-points">

                        <div>
                            <i class="bi bi-check-circle-fill"></i>
                            Discover local farmers
                        </div>

                        <div>
                            <i class="bi bi-check-circle-fill"></i>
                            Find nearby farmers markets
                        </div>

                        <div>
                            <i class="bi bi-check-circle-fill"></i>
                            Explore fresh products
                        </div>

                        <div>
                            <i class="bi bi-check-circle-fill"></i>
                            Support local communities
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     MISSION / VISION
========================================================= -->

<section class="mission-section">

    <div class="container">

        <div class="about-section-heading text-center">

            <span>WHAT DRIVES US</span>

            <h2>
                Our Mission &
                <strong>Vision</strong>
            </h2>

            <p>
                We want to make local food discovery simple while helping
                communities build stronger connections with farmers.
            </p>

        </div>

        <div class="row g-4">

            <!-- MISSION -->
            <div class="col-md-6">

                <div class="mission-card">

                    <div class="mission-icon">
                        <i class="bi bi-bullseye"></i>
                    </div>

                    <span>OUR MISSION</span>

                    <h3>
                        Connecting Local Communities
                    </h3>

                    <p>
                        Our mission is to create a simple platform where
                        customers can discover local farmers, fresh products
                        and nearby markets while making it easier for farmers
                        to reach their communities.
                    </p>

                </div>

            </div>


            <!-- VISION -->
            <div class="col-md-6">

                <div class="mission-card vision-card">

                    <div class="mission-icon">
                        <i class="bi bi-eye-fill"></i>
                    </div>

                    <span>OUR VISION</span>

                    <h3>
                        A Stronger Local Food Network
                    </h3>

                    <p>
                        We envision communities where people can easily
                        discover fresh local food and farmers have a clear
                        digital presence within the markets they serve.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     VALUES
========================================================= -->

<section class="values-section">

    <div class="container">

        <div class="about-section-heading text-center">

            <span>OUR VALUES</span>

            <h2>
                What
                <strong>We Believe In</strong>
            </h2>

            <p>
                These principles guide the way MarketLink connects farmers,
                customers and local communities.
            </p>

        </div>

        <div class="row g-4">

            <div class="col-md-6 col-lg-3">

                <div class="value-card">

                    <div class="value-icon">
                        <i class="bi bi-leaf-fill"></i>
                    </div>

                    <h3>Freshness</h3>

                    <p>
                        Helping people discover fresh products from local
                        farms and markets.
                    </p>

                </div>

            </div>


            <div class="col-md-6 col-lg-3">

                <div class="value-card">

                    <div class="value-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>

                    <h3>Community</h3>

                    <p>
                        Building stronger relationships between farmers
                        and the people around them.
                    </p>

                </div>

            </div>


            <div class="col-md-6 col-lg-3">

                <div class="value-card">

                    <div class="value-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>

                    <h3>Trust</h3>

                    <p>
                        Making useful information about farmers, products
                        and markets easier to access.
                    </p>

                </div>

            </div>


            <div class="col-md-6 col-lg-3">

                <div class="value-card">

                    <div class="value-icon">
                        <i class="bi bi-hand-thumbs-up-fill"></i>
                    </div>

                    <h3>Local Support</h3>

                    <p>
                        Helping customers discover and support local
                        farmers and businesses.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     NUMBERS
========================================================= -->

<section class="about-numbers-section">

    <div class="container">

        <div class="about-numbers">

            <div class="number-item">

                <i class="bi bi-people-fill"></i>

                <strong>500+</strong>

                <span>Community Members</span>

            </div>


            <div class="number-item">

                <i class="bi bi-person-badge-fill"></i>

                <strong>100+</strong>

                <span>Local Farmers</span>

            </div>


            <div class="number-item">

                <i class="bi bi-shop"></i>

                <strong>50+</strong>

                <span>Markets</span>

            </div>


            <div class="number-item">

                <i class="bi bi-basket2-fill"></i>

                <strong>1,000+</strong>

                <span>Fresh Products</span>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     HOW WE HELP
========================================================= -->

<section class="help-section">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-5">

                <div class="help-image">

                    <img src="https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=900&q=85"
                         alt="Fresh Vegetables">

                    <div class="help-image-badge">

                        <i class="bi bi-basket-fill"></i>

                        <div>

                            <strong>Fresh Choices</strong>
                            <span>From Local Sources</span>

                        </div>

                    </div>

                </div>

            </div>


            <div class="col-lg-7">

                <div class="help-content">

                    <span class="about-label">
                        WHAT MARKETLINK DOES
                    </span>

                    <h2>
                        One Platform,
                        <strong>Many Local Connections.</strong>
                    </h2>

                    <p>
                        MarketLink is designed around the needs of both
                        customers and local farmers.
                    </p>

                    <div class="help-list">

                        <div class="help-item">

                            <div class="help-icon">
                                <i class="bi bi-search"></i>
                            </div>

                            <div>

                                <h4>For Customers</h4>

                                <p>
                                    Discover products, farmers and markets
                                    in one place.
                                </p>

                            </div>

                        </div>


                        <div class="help-item">

                            <div class="help-icon">
                                <i class="bi bi-person-vcard-fill"></i>
                            </div>

                            <div>

                                <h4>For Farmers</h4>

                                <p>
                                    Showcase your farm, products and market
                                    availability.
                                </p>

                            </div>

                        </div>


                        <div class="help-item">

                            <div class="help-icon">
                                <i class="bi bi-shop"></i>
                            </div>

                            <div>

                                <h4>For Markets</h4>

                                <p>
                                    Help people discover your market,
                                    location and opening information.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     COMMUNITY
========================================================= -->

<section class="community-section">

    <div class="container">

        <div class="community-box">

            <div class="community-content">

                <span>OUR COMMUNITY</span>

                <h2>
                    Better Food Starts
                    With Better Connections.
                </h2>

                <p>
                    MarketLink is built around the idea that local farmers,
                    customers and communities can benefit when they are
                    easier to connect.
                </p>

                <a asp-controller="Contact"
                   asp-action="Index"
                   class="btn btn-community">

                    Get In Touch
                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>


            <div class="community-icon">

                <i class="bi bi-globe2"></i>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     CTA
========================================================= -->

<section class="about-cta">

    <div class="container">

        <div class="about-cta-content">

            <span>DISCOVER MARKETLINK</span>

            <h2>
                Discover What's Growing
                Around You.
            </h2>

            <p>
                Explore local farmers, fresh products and nearby markets.
            </p>

            <div class="about-cta-buttons">

                <a asp-controller="Markets"
                   asp-action="Index"
                   class="btn btn-light">

                    Explore Markets
                    <i class="bi bi-arrow-right"></i>

                </a>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-outline-light">

                    Browse Products

                </a>

            </div>

        </div>

    </div>

</section>


@section Styles {

    <style>

        /* =========================================================
           ABOUT HERO
        ========================================================= */

        .about-hero {
            position: relative;
            min-height: 460px;
            overflow: hidden;
        }


        /* =========================================================
           HERO BACKGROUND IMAGE
        ========================================================= */

        .about-hero-image {
            position: relative;
            min-height: 445px;
            margin: 20px auto 0;
            width: min(100% - 48px, 1400px);
            border-radius: 0 0 28px 28px;
            overflow: hidden;
            background-image: url("https://images.unsplash.com/photo-1464226184884-fa280b87c399?auto=format&fit=crop&w=1800&q=85");
            background-size: cover;
            background-position: center center;
            /* THIS MAKES THE BACKGROUND STAY FIXED */
            background-attachment: fixed;
            display: flex;
            align-items: center;
        }


        /* =========================================================
           HERO OVERLAY
        ========================================================= */

        .about-hero-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient( 90deg, rgba(5, 67, 40, 0.92) 0%, rgba(8, 78, 48, 0.78) 42%, rgba(8, 78, 48, 0.42) 72%, rgba(8, 78, 48, 0.18) 100% );
            z-index: 1;
            pointer-events: none;
        }


        /* =========================================================
           HERO CONTAINER
        ========================================================= */

        .about-hero-image .container {
            position: relative;
            z-index: 2;
            width: 100%;
        }


        /* =========================================================
           HERO CONTENT
        ========================================================= */

        .about-hero-content {
            padding: 85px 0 80px;
            max-width: 720px;
        }


        /* =========================================================
           BREADCRUMB
        ========================================================= */

        .about-breadcrumb {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 38px;
            font-size: 14px;
        }

            .about-breadcrumb a {
                color: #ffffff;
                text-decoration: none;
                font-weight: 600;
                transition: 0.3s ease;
            }

                .about-breadcrumb a:hover {
                    color: #d8f52d;
                }

            .about-breadcrumb i {
                color: #d8f52d;
                font-size: 11px;
            }

            .about-breadcrumb span {
                color: rgba(255, 255, 255, 0.78);
            }


        /* =========================================================
           HERO LABEL
        ========================================================= */

        .about-label {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 17px;
            color: #c8e83a;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

            .about-label i {
                font-size: 14px;
                color: #c8e83a;
            }

        /* =========================================================
           HERO TEXT
        ========================================================= */

        .about-hero-text {
            max-width: 720px;
        }

            .about-hero-text h1 {
                margin: 0 0 18px;
                color: #ffffff;
                font-size: clamp(44px, 5vw, 72px);
                line-height: 1.05;
                font-weight: 800;
                letter-spacing: -1.5px;
            }

                .about-hero-text h1 strong {
                    color: #d8f52d;
                    font-weight: 800;
                }

            .about-hero-text p {
                max-width: 650px;
                margin: 0;
                color: rgba(255, 255, 255, 0.90);
                font-size: 17px;
                line-height: 1.75;
            }


        /* =========================================================
           TABLET
        ========================================================= */

        @@media (max-width: 991.98px) {

            .about-hero,
            .about-hero-image {
                min-height: 430px;
            }

            .about-hero-image {
                width: min(100% - 32px, 1400px);
                /* Same responsive behavior as Contact page */
                background-attachment: scroll;
            }

            .about-hero-content {
                padding: 80px 0 70px;
            }

            .about-hero-text h1 {
                font-size: 56px;
            }
        }


        /* =========================================================
           MOBILE
        ========================================================= */

        @@media (max-width: 576px) {

            .about-hero,
            .about-hero-image {
                min-height: 420px;
            }

            .about-hero-image {
                width: min(100% - 24px, 1400px);
                border-radius: 0 0 22px 22px;
            }

            .about-hero-content {
                padding: 65px 0 60px;
            }

            .about-breadcrumb {
                margin-bottom: 30px;
                gap: 9px;
                font-size: 13px;
            }

            .about-label {
                margin-bottom: 14px;
                font-size: 11px;
            }

            .about-hero-text h1 {
                margin-bottom: 15px;
                font-size: 42px;
            }

            .about-hero-text p {
                font-size: 15px;
                line-height: 1.7;
            }
        }


        /* =========================================================
               STORY
            ========================================================= */

        .our-story-section {
            padding: 100px 0;
            background: #ffffff;
        }

        .story-image-wrapper {
            position: relative;
            padding-right: 25px;
        }

            .story-image-wrapper > img {
                width: 100%;
                height: 500px;
                object-fit: cover;
                border-radius: 25px;
                box-shadow: 0 20px 45px rgba(32, 71, 45, .12);
            }

        .story-experience-card {
            position: absolute;
            right: 0;
            bottom: 30px;
            padding: 16px 20px;
            background: #2d9955;
            border-radius: 14px;
            box-shadow: 0 14px 30px rgba(32, 71, 45, .16);
        }

            .story-experience-card strong,
            .story-experience-card span {
                display: block;
            }

            .story-experience-card strong {
                color: #fff;
                font-size: 20px;
            }

            .story-experience-card span {
                margin-top: 2px;
                color: #d7f0dd;
                font-size: 10px;
            }

        .story-content {
            padding-left: 25px;
        }

            .story-content .about-label,
            .help-content .about-label {
                color: #2d9955;
            }

            .story-content h2 {
                max-width: 600px;
                margin-bottom: 20px;
                color: #193d29;
                font-size: clamp(32px, 4vw, 44px);
                line-height: 1.2;
                font-weight: 800;
            }

                .story-content h2 strong {
                    display: block;
                    color: #2d9955;
                }

            .story-content > p {
                color: #6f7d75;
                font-size: 15px;
                line-height: 1.85;
            }

        .story-points {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 13px;
            margin-top: 28px;
        }

            .story-points div {
                color: #42674f;
                font-size: 13px;
                font-weight: 700;
            }

            .story-points i {
                margin-right: 7px;
                color: #2d9955;
            }


        /* =========================================================
               SECTION HEADINGS
            ========================================================= */

        .about-section-heading {
            max-width: 720px;
            margin: 0 auto 50px;
        }

            .about-section-heading > span {
                display: block;
                margin-bottom: 9px;
                color: #2b9653;
                font-size: 12px;
                font-weight: 800;
                letter-spacing: 1.7px;
            }

            .about-section-heading h2 {
                margin: 0;
                color: #193d29;
                font-size: clamp(32px, 4vw, 45px);
                font-weight: 800;
            }

                .about-section-heading h2 strong {
                    color: #2d9955;
                }

            .about-section-heading p {
                margin: 13px auto 0;
                color: #78857d;
                line-height: 1.8;
            }


        /* =========================================================
               MISSION
            ========================================================= */

        .mission-section {
            padding: 100px 0;
            background: #f5faf6;
        }

        .mission-card {
            height: 100%;
            padding: 38px;
            background: #fff;
            border: 1px solid #e0ebe3;
            border-radius: 20px;
            transition: .3s;
        }

            .mission-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 18px 40px rgba(32, 71, 45, .08);
            }

        .mission-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 58px;
            height: 58px;
            margin-bottom: 22px;
            color: #2d9955;
            background: #e6f5e9;
            border-radius: 15px;
            font-size: 23px;
        }

        .mission-card > span {
            color: #2d9955;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1.5px;
        }

        .mission-card h3 {
            margin: 10px 0 13px;
            color: #294936;
            font-size: 22px;
            font-weight: 800;
        }

        .mission-card p {
            margin: 0;
            color: #75827a;
            line-height: 1.8;
            font-size: 14px;
        }


        /* =========================================================
               VALUES
            ========================================================= */

        .values-section {
            padding: 100px 0;
            background: #fff;
        }

        .value-card {
            height: 100%;
            padding: 30px 23px;
            text-align: center;
            background: #f7fbf8;
            border: 1px solid #e2ece5;
            border-radius: 18px;
            transition: .3s;
        }

            .value-card:hover {
                transform: translateY(-6px);
                background: #fff;
                box-shadow: 0 16px 35px rgba(32, 71, 45, .08);
            }

        .value-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 58px;
            height: 58px;
            margin: 0 auto 20px;
            color: #2d9955;
            background: #e6f5e9;
            border-radius: 15px;
            font-size: 22px;
        }

        .value-card h3 {
            margin-bottom: 10px;
            color: #294936;
            font-size: 18px;
            font-weight: 800;
        }

        .value-card p {
            margin: 0;
            color: #7b8780;
            font-size: 13px;
            line-height: 1.75;
        }


        /* =========================================================
               NUMBERS
            ========================================================= */

        .about-numbers-section {
            padding: 28px 0;
            background: #fff;
        }

        .about-numbers {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            padding: 25px;
            border: 1px solid #e0ebe3;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(34, 75, 47, .05);
        }

        .number-item {
            padding: 10px 20px;
            text-align: center;
            border-right: 1px solid #e7eee9;
        }

            .number-item:last-child {
                border-right: 0;
            }

            .number-item > i {
                display: block;
                margin-bottom: 9px;
                color: #2d9955;
                font-size: 21px;
            }

            .number-item strong {
                display: block;
                color: #294936;
                font-size: 25px;
                font-weight: 800;
            }

            .number-item span {
                color: #89958d;
                font-size: 11px;
            }


        /* =========================================================
               HELP
            ========================================================= */

        .help-section {
            padding: 100px 0;
            background: #f5faf6;
        }

        .help-image {
            position: relative;
            padding-right: 20px;
        }

            .help-image > img {
                width: 100%;
                height: 470px;
                object-fit: cover;
                border-radius: 25px;
                box-shadow: 0 20px 45px rgba(32, 71, 45, .12);
            }

        .help-image-badge {
            position: absolute;
            right: 0;
            bottom: 25px;
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 14px 17px;
            background: #fff;
            border-radius: 13px;
            box-shadow: 0 13px 30px rgba(32, 71, 45, .14);
        }

            .help-image-badge > i {
                color: #2d9955;
                font-size: 21px;
            }

            .help-image-badge strong,
            .help-image-badge span {
                display: block;
            }

            .help-image-badge strong {
                color: #294936;
                font-size: 12px;
            }

            .help-image-badge span {
                color: #89958d;
                font-size: 10px;
            }

        .help-content {
            padding-left: 25px;
        }

            .help-content h2 {
                max-width: 600px;
                margin-bottom: 17px;
                color: #193d29;
                font-size: clamp(32px, 4vw, 44px);
                line-height: 1.2;
                font-weight: 800;
            }

                .help-content h2 strong {
                    display: block;
                    color: #2d9955;
                }

            .help-content > p {
                max-width: 620px;
                color: #738078;
                line-height: 1.8;
            }

        .help-list {
            margin-top: 30px;
        }

        .help-item {
            display: flex;
            gap: 13px;
            margin-bottom: 22px;
        }

        .help-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 45px;
            height: 45px;
            flex-shrink: 0;
            color: #2d9955;
            background: #e6f5e9;
            border-radius: 11px;
        }

        .help-item h4 {
            margin: 2px 0 4px;
            color: #31503d;
            font-size: 15px;
            font-weight: 800;
        }

        .help-item p {
            margin: 0;
            color: #87928b;
