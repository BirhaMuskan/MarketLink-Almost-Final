@model MarketLink.ViewModels.FarmerPickupSlotsPageViewModel

@{
    ViewData["Title"] = "Pickup Slots";
    Layout = "~/Views/Shared/_FarmerDashboardLayout.cshtml";
}


<section class="ps-header">
    <div>
        <span class="ps-label">
            <i class="bi bi-clock"></i>
            ORDERS & PICKUP
        </span>

        <h2>Pickup Slots</h2>

        <p>
            Create actual pickup dates and time slots that customers
            can select when placing pre-orders.
        </p>
    </div>

    <a asp-controller="FarmerPickupSlots"
       asp-action="Create"
       class="ps-primary-btn">
        <i class="bi bi-plus-lg"></i>
        Add Pickup Slot
    </a>
</section>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-warning">
        @TempData["ErrorMessage"]
    </div>
}

<section class="ps-stats">
    <div>
        <span>Total Slots</span>
        <strong>@Model.TotalSlots</strong>
    </div>

    <div>
        <span>Available</span>
        <strong>@Model.AvailableSlots</strong>
    </div>

    <div>
        <span>Full</span>
        <strong>@Model.FullSlots</strong>
    </div>

    <div>
        <span>Bookings / Capacity</span>
        <strong>
            @Model.TotalBooked / @Model.TotalCapacity
        </strong>
    </div>
</section>

<section class="ps-card">

    <div class="ps-toolbar">
        <div class="ps-search">
            <i class="bi bi-search"></i>

            <input type="text"
                   id="pickupSearch"
                   placeholder="Search market or date..." />
        </div>
    </div>

    @if (!Model.Slots.Any())
    {
        <div class="ps-empty">
            <i class="bi bi-calendar-plus"></i>

            <h3>No pickup slots yet</h3>

            <p>
                Create a pickup slot after configuring your market
                pickup schedule.
            </p>

            <a asp-controller="FarmerPickupSlots"
               asp-action="Create"
               class="ps-primary-btn">
                Add First Slot
            </a>
        </div>
    }
    else
    {
        <div class="ps-list">

            @foreach (var slot in Model.Slots)
            {
                var startText =
                    DateTime.Today
                        .Add(slot.StartTime)
                        .ToString("hh:mm tt");

                var endText =
                    DateTime.Today
                        .Add(slot.EndTime)
                        .ToString("hh:mm tt");

                <article class="ps-row"
                         data-search="@($"{slot.MarketName} {slot.PickupDate:yyyy-MM-dd} {slot.PickupDate:dddd}".ToLowerInvariant())">

                    <div class="date-box">
                        <span>
                            @slot.PickupDate.ToString("MMM")
                        </span>

                        <strong>
                            @slot.PickupDate.Day
                        </strong>
                    </div>

                    <div class="ps-main">

                        <div class="ps-title-row">
                            <div>
                                <h3>@slot.MarketName</h3>

                                <span>
                                    @slot.PickupDate.ToString("dddd, dd MMM yyyy")
                                    · @startText - @endText
                                </span>
                            </div>

                            @if (slot.IsFull)
                            {
                                <span class="ps-status full">
                                    Full
                                </span>
                            }
                            else if (!slot.IsAvailable)
                            {
                                <span class="ps-status closed">
                                    Unavailable
                                </span>
                            }
                            else
                            {
                                <span class="ps-status open">
                                    Available
                                </span>
                            }
                        </div>

                        <div class="ps-meta">
                            <div>
                                <span>Stall</span>

                                <strong>
                                    @(string.IsNullOrWhiteSpace(slot.StallNumber)
                                        ? "Not set"
                                        : slot.StallNumber)
                                </strong>
                            </div>

                            <div>
                                <span>Booked</span>
                                <strong>
                                    @slot.BookedOrders / @slot.MaximumOrders
                                </strong>
                            </div>

                            <div>
                                <span>Remaining</span>
                                <strong>
                                    @slot.RemainingCapacity
                                </strong>
                            </div>
                        </div>

                        <div class="capacity-track">
                            @{
                                var pct =
                                    slot.MaximumOrders <= 0
                                        ? 0
                                        : Math.Min(
                                            100,
                                            (slot.BookedOrders * 100.0)
                                            / slot.MaximumOrders);
                            }

                            <div class="capacity-fill"
                                 style="width:@pct.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%">
                            </div>
                        </div>

                    </div>

                    <div class="ps-actions">

                        <a asp-controller="FarmerPickupSlots"
                           asp-action="Edit"
                           asp-route-id="@slot.PickupSlotId"
                           class="ps-action-btn">
                            <i class="bi bi-pencil"></i>
                            Edit
                        </a>

                        <form asp-controller="FarmerPickupSlots"
                              asp-action="ToggleAvailability"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@slot.PickupSlotId" />

                            <button type="submit"
                                    class="ps-action-btn">
                                @(slot.IsAvailable
                                    ? "Close Slot"
                                    : "Open Slot")
                            </button>
                        </form>

                        <form asp-controller="FarmerPickupSlots"
                              asp-action="Delete"
                              method="post"
                              onsubmit="return confirm('Delete this pickup slot?');">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@slot.PickupSlotId" />

                            <button type="submit"
                                    class="ps-action-btn danger">
                                Delete
                            </button>
                        </form>

                    </div>

                </article>
            }

        </div>
    }

</section>

@section Styles {
<style>
.ps-header{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:22px}
.ps-label{color:#14836f;font-size:12px;font-weight:800;letter-spacing:.08em}
.ps-header h2{margin:7px 0 5px;font-size:28px;font-weight:800}
.ps-header p{margin:0;color:#667085}
.ps-primary-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:#13836e;color:#fff;text-decoration:none;padding:10px 15px;border-radius:10px;font-weight:700}
.ps-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:18px}
.ps-stats>div{background:#fff;border:1px solid #e7ebef;border-radius:16px;padding:17px}
.ps-stats span{display:block;color:#667085;font-size:12px}
.ps-stats strong{display:block;margin-top:4px;font-size:24px}
.ps-card{background:#fff;border:1px solid #e7ebef;border-radius:18px;overflow:hidden}
.ps-toolbar{padding:15px 17px;border-bottom:1px solid #edf0f4}
.ps-search{max-width:460px;position:relative}
.ps-search i{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#98a2b3}
.ps-search input{width:100%;padding:10px 12px 10px 40px;border:1px solid #d8dee6;border-radius:11px}
.ps-list{padding:12px}
.ps-row{display:grid;grid-template-columns:70px 1fr 150px;gap:15px;align-items:center;padding:15px;border:1px solid #e8ebef;border-radius:14px;margin-bottom:10px}
.date-box{width:62px;height:68px;border-radius:13px;background:#e8f5ef;color:#13836e;display:flex;flex-direction:column;align-items:center;justify-content:center}
.date-box span{font-size:10px;font-weight:800;text-transform:uppercase}
.date-box strong{font-size:23px;line-height:1}
.ps-title-row{display:flex;justify-content:space-between;gap:12px}
.ps-title-row h3{margin:0;font-size:16px;font-weight:800}
.ps-title-row>div>span{color:#667085;font-size:11px}
.ps-status{padding:5px 8px;border-radius:999px;font-size:10px;font-weight:800;height:max-content}
.ps-status.open{background:#dcfae6;color:#067647}
.ps-status.full{background:#fee4e2;color:#b42318}
.ps-status.closed{background:#f2f4f7;color:#475467}
.ps-meta{display:flex;gap:28px;margin-top:12px;flex-wrap:wrap}
.ps-meta span{display:block;color:#98a2b3;font-size:9px;text-transform:uppercase;font-weight:800}
.ps-meta strong{display:block;margin-top:2px;font-size:12px;color:#344054}
.capacity-track{height:6px;border-radius:999px;background:#eef1f3;overflow:hidden;margin-top:12px}
.capacity-fill{height:100%;background:#13836e;border-radius:999px}
.ps-actions{display:flex;flex-direction:column;gap:7px}
.ps-action-btn{width:100%;border:1px solid #d9dfe5;background:#fff;color:#344054;padding:8px 10px;border-radius:9px;text-decoration:none;font-size:11px;font-weight:700;text-align:center}
.ps-action-btn.danger{color:#b42318;border-color:#f3c8c5}
.ps-empty{text-align:center;padding:65px 20px;color:#667085}
.ps-empty>i{font-size:35px;color:#13836e}
@@media(max-width:900px){.ps-row{grid-template-columns:65px 1fr}.ps-actions{grid-column:1/-1;display:grid;grid-template-columns:repeat(3,1fr)}}
@@media(max-width:650px){.ps-header{align-items:stretch;flex-direction:column}.ps-stats{grid-template-columns:1fr 1fr}.ps-row{grid-template-columns:1fr}.date-box{width:100%;height:55px}.ps-title-row{flex-direction:column}.ps-actions{display:flex;flex-direction:column}}
</style>
}

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    const search = document.getElementById("pickupSearch");
    const rows = document.querySelectorAll(".ps-row");

    search?.addEventListener("input", function () {
        const value = search.value.trim().toLowerCase();

        rows.forEach(row => {
            row.style.display =
                (row.dataset.search || "").includes(value)
                    ? ""
                    : "none";
        });
    });
});
</script>
}
