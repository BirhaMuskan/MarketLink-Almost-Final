@model MarketLink.ViewModels.EditPickupSlotViewModel

@{
    ViewData["Title"] = "Edit Pickup Slot";
    Layout = "~/Views/Shared/_FarmerDashboardLayout.cshtml";
}

<section class="slot-header">

    <div>
        <span class="slot-label">
            <i class="bi bi-clock"></i>
            PICKUP SLOTS
        </span>

        <h2>Edit Pickup Slot</h2>

        <p>
            Update the pickup date, time, capacity or availability.
        </p>
    </div>

    <a asp-controller="FarmerPickupSlots"
       asp-action="Index"
       class="back-link">
        <i class="bi bi-arrow-left"></i>
        Back to Pickup Slots
    </a>

</section>

<section class="slot-card">

    <form asp-controller="FarmerPickupSlots"
          asp-action="Edit"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="PickupSlotId" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="market-summary">
            <strong>@Model.MarketName</strong>

            <span>
                @(string.IsNullOrWhiteSpace(Model.StallNumber)
                    ? "No stall number"
                    : "Stall " + Model.StallNumber)
            </span>
        </div>

        <div class="form-grid">

            <div class="form-field">
                <label asp-for="PickupDate"></label>

                <input asp-for="PickupDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="PickupDate"
                      class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="MaximumOrders"></label>

                <input asp-for="MaximumOrders"
                       type="number"
                       min="1"
                       max="500"
                       class="form-control" />

                <span asp-validation-for="MaximumOrders"
                      class="text-danger"></span>

                <span class="booked-note">
                    Already booked: @Model.BookedOrders order(s).
                    Capacity cannot be reduced below this number.
                </span>
            </div>

            <div class="form-field">
                <label asp-for="StartTime"></label>

                <input asp-for="StartTime"
                       type="time"
                       class="form-control" />

                <span asp-validation-for="StartTime"
                      class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="EndTime"></label>

                <input asp-for="EndTime"
                       type="time"
                       class="form-control" />

                <span asp-validation-for="EndTime"
                      class="text-danger"></span>
            </div>

        </div>

        <div class="available-box">
            <label>
                <input asp-for="IsAvailable" />
                <span>Available for customers</span>
            </label>
        </div>

        <div class="info-note">
            <i class="bi bi-info-circle"></i>

            <span>
                The date must be one of your enabled market days and
                the time must fall inside your pickup window configured
                under My Markets.
            </span>
        </div>

        <div class="slot-actions">

            <a asp-controller="FarmerPickupSlots"
               asp-action="Index"
               class="btn btn-light">
                Cancel
            </a>

            <button type="submit"
                    class="primary-btn border-0">
                <i class="bi bi-check-lg"></i>
                Save Changes
            </button>

        </div>

    </form>

</section>

@section Styles {
<style>
.slot-header{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:22px}
.slot-label{color:#14836f;font-size:12px;font-weight:800;letter-spacing:.08em}
.slot-header h2{margin:7px 0 5px;font-size:28px;font-weight:800}
.slot-header p{margin:0;color:#667085}
.back-link{text-decoration:none;color:#475467;font-weight:700;font-size:13px}
.slot-card{background:#fff;border:1px solid #e7ebef;border-radius:18px;padding:24px;max-width:900px}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.form-field{margin-bottom:18px}
.form-field label{display:block;margin-bottom:7px;color:#344054;font-size:12px;font-weight:800}
.available-box{padding:13px 14px;background:#f8fafc;border:1px solid #e7ebef;border-radius:11px}
.available-box label{display:flex;align-items:center;gap:8px;margin:0;font-weight:700}
.info-note{display:flex;gap:8px;padding:12px 14px;background:#eff8ff;color:#175cd3;border-radius:10px;margin-top:14px;font-size:12px}
.slot-actions{display:flex;justify-content:flex-end;gap:10px;border-top:1px solid #edf0f3;margin-top:22px;padding-top:18px}
.primary-btn{background:#13836e;color:#fff;padding:10px 15px;border-radius:10px;font-weight:700}
.market-summary{padding:13px 14px;background:#f8fafc;border:1px solid #e7ebef;border-radius:11px;margin-bottom:18px}
.market-summary strong{display:block}
.market-summary span{display:block;color:#667085;font-size:11px;margin-top:2px}
.booked-note{display:block;margin-top:6px;color:#667085;font-size:11px}
@@media(max-width:700px){.slot-header{align-items:flex-start;flex-direction:column}.form-grid{grid-template-columns:1fr}}
</style>
}
