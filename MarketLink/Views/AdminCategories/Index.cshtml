@model MarketLink.ViewModels.AdminCategoriesPageViewModel

@{
    ViewData["Title"] = "Categories";
    Layout = "~/Views/Shared/_AdminDashboardLayout.cshtml";
}

<section class="admin-category-header">
    <div>
        <span class="category-page-label">
            <i class="bi bi-tags"></i>
            MASTER DATA
        </span>

        <h2>Product Categories</h2>

        <p>
            Create and maintain product categories used by farmers
            when adding products.
        </p>
    </div>

    <a asp-controller="AdminCategories"
       asp-action="Create"
       class="category-primary-button">

        <i class="bi bi-plus-lg"></i>
        Add Category

    </a>
</section>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success category-alert">
        <i class="bi bi-check-circle-fill"></i>
        @TempData["SuccessMessage"]
    </div>
}

<section class="category-summary-grid">

    <div class="category-summary-card">
        <span>Total Categories</span>
        <strong>@Model.TotalCategories</strong>
    </div>

    <div class="category-summary-card">
        <span>Active</span>
        <strong>@Model.ActiveCategories</strong>
    </div>

    <div class="category-summary-card">
        <span>Inactive</span>
        <strong>@Model.InactiveCategories</strong>
    </div>

</section>

<section class="category-card">

    <div class="category-toolbar">

        <div class="category-search">
            <i class="bi bi-search"></i>

            <input type="text"
                   id="categorySearch"
                   placeholder="Search category..." />
        </div>

    </div>

    @if (!Model.Categories.Any())
    {
        <div class="category-empty-state">

            <div class="category-empty-icon">
                <i class="bi bi-tags"></i>
            </div>

            <h3>No categories yet</h3>

            <p>
                Add the first category so farmers can classify
                their products.
            </p>

            <a asp-controller="AdminCategories"
               asp-action="Create"
               class="category-primary-button">

                Add First Category

            </a>

        </div>
    }
    else
    {
        <div class="category-table-wrap">

            <table class="category-table">

                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Products</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.Categories)
                    {
                        <tr data-search="@($"{item.CategoryName} {item.Description}".ToLowerInvariant())">

                            <td>
                                <div class="category-name">
                                    <div class="category-icon">
                                        <i class="bi bi-tag"></i>
                                    </div>

                                    <strong>
                                        @item.CategoryName
                                    </strong>
                                </div>
                            </td>

                            <td>
                                <span class="category-description">
                                    @(string.IsNullOrWhiteSpace(item.Description)
                                        ? "No description"
                                        : item.Description)
                                </span>
                            </td>

                            <td>
                                <strong>@item.ProductCount</strong>
                            </td>

                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="category-status active">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="category-status inactive">
                                        Inactive
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="category-actions">

                                    <a asp-controller="AdminCategories"
                                       asp-action="Edit"
                                       asp-route-id="@item.CategoryId"
                                       class="category-action-btn">

                                        <i class="bi bi-pencil"></i>
                                        Edit

                                    </a>

                                    <form asp-controller="AdminCategories"
                                          asp-action="ToggleStatus"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@item.CategoryId" />

                                        <button type="submit"
                                                class="category-action-btn @(item.IsActive ? "danger" : "success")">

                                            <i class="bi @(item.IsActive ? "bi-eye-slash" : "bi-check-circle")"></i>

                                            @(item.IsActive
                                                ? "Deactivate"
                                                : "Activate")

                                        </button>

                                    </form>

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</section>

@section Styles {
<style>
.admin-category-header{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:22px}
.category-page-label{color:#14836f;font-size:12px;font-weight:800;letter-spacing:.08em}
.admin-category-header h2{margin:7px 0 5px;font-size:28px;font-weight:800}
.admin-category-header p{margin:0;color:#667085}
.category-primary-button{display:inline-flex;align-items:center;gap:8px;background:#13836e;color:white;text-decoration:none;padding:10px 15px;border-radius:10px;font-weight:700}
.category-primary-button:hover{background:#0e715e;color:white}
.category-summary-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-bottom:18px}
.category-summary-card{background:white;border:1px solid #e7ebef;border-radius:16px;padding:17px;box-shadow:0 8px 24px rgba(16,24,40,.05)}
.category-summary-card span{display:block;color:#667085;font-size:12px}
.category-summary-card strong{display:block;margin-top:4px;font-size:27px;color:#172033}
.category-card{background:white;border:1px solid #e7ebef;border-radius:18px;overflow:hidden;box-shadow:0 10px 30px rgba(16,24,40,.06)}
.category-toolbar{padding:15px 17px;border-bottom:1px solid #edf0f4}
.category-search{max-width:460px;position:relative}
.category-search i{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#98a2b3}
.category-search input{width:100%;padding:10px 12px 10px 40px;border:1px solid #d8dee6;border-radius:11px;outline:none}
.category-table-wrap{overflow-x:auto}
.category-table{width:100%;border-collapse:collapse}
.category-table th{padding:13px 16px;background:#f8fafc;color:#667085;font-size:11px;text-transform:uppercase;letter-spacing:.05em}
.category-table td{padding:15px 16px;border-top:1px solid #edf0f4;vertical-align:middle}
.category-name{display:flex;align-items:center;gap:10px}
.category-icon{width:36px;height:36px;border-radius:10px;background:#e8f5ef;color:#13836e;display:grid;place-items:center}
.category-description{color:#667085;font-size:12px}
.category-status{display:inline-flex;padding:5px 9px;border-radius:999px;font-size:10px;font-weight:800}
.category-status.active{background:#dcfae6;color:#067647}
.category-status.inactive{background:#f2f4f7;color:#475467}
.category-actions{display:flex;justify-content:flex-end;gap:7px}
.category-action-btn{border:1px solid #d9dfe5;background:white;color:#344054;padding:7px 10px;border-radius:8px;text-decoration:none;font-size:11px;font-weight:700}
.category-action-btn.danger{color:#b42318;border-color:#f3c8c5}
.category-action-btn.success{color:#067647;border-color:#b7e4cd}
.category-alert{display:flex;align-items:center;gap:8px}
.category-empty-state{text-align:center;padding:70px 20px}
.category-empty-icon{width:62px;height:62px;border-radius:16px;display:grid;place-items:center;margin:0 auto 14px;background:#e8f5ef;color:#13836e;font-size:26px}
@@media(max-width:700px){.admin-category-header{align-items:stretch;flex-direction:column}.category-summary-grid{grid-template-columns:1fr}.category-actions{flex-direction:column}}
</style>
}

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    const search = document.getElementById("categorySearch");
    const rows = document.querySelectorAll("tbody tr[data-search]");

    search?.addEventListener("input", function () {
        const value = search.value.trim().toLowerCase();

        rows.forEach(row => {
            row.style.display =
                (row.dataset.search || "").includes(value)
                    ? ""
                    : "none";
        });
    });
});
</script>
}
