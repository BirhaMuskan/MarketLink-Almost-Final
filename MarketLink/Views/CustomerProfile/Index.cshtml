@model MarketLink.ViewModels.CustomerProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_CustomerDashboardLayout.cshtml";
}

@section Styles {
<style>
.profile-header{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:18px}
.profile-label{color:#14836f;font-size:12px;font-weight:800;letter-spacing:.08em}
.profile-header h2{margin:7px 0 5px;font-size:28px;font-weight:800}
.profile-header p{margin:0;color:#667085}
.profile-grid{display:grid;grid-template-columns:.72fr 1.28fr;gap:18px}
.profile-card{background:#fff;border:1px solid #e7ebef;border-radius:18px;overflow:hidden}
.profile-summary{padding:24px;text-align:center}
.profile-avatar{width:92px;height:92px;margin:0 auto 13px;border-radius:50%;display:grid;place-items:center;background:#e8f5ef;color:#067647;font-size:28px;font-weight:900}
.profile-summary h3{margin:0;font-size:20px}
.profile-summary>p{margin:4px 0 0;color:#667085;font-size:11px}
.account-badge{display:inline-flex;margin-top:10px;padding:5px 9px;border-radius:999px;background:#dcfae6;color:#067647;font-size:9px;font-weight:800}
.profile-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:20px}
.profile-stat{padding:11px 7px;background:#f8fafc;border-radius:10px}
.profile-stat strong{display:block;font-size:18px}
.profile-stat span{display:block;color:#667085;font-size:9px}
.account-info{margin-top:18px;text-align:left;border-top:1px solid #edf0f4;padding-top:14px}
.info-row{display:flex;justify-content:space-between;gap:10px;padding:7px 0}
.info-row span{color:#667085;font-size:10px}
.info-row strong{font-size:10px;text-align:right}
.card-head{padding:15px 18px;border-bottom:1px solid #edf0f4}
.card-head span{color:#13836e;font-size:10px;font-weight:800;letter-spacing:.08em}
.card-head h3{margin:3px 0 0;font-size:17px}
.profile-form{padding:20px}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.form-field{margin-bottom:16px}
.form-field.full{grid-column:1/-1}
.form-field label{display:block;margin-bottom:6px;color:#344054;font-size:11px;font-weight:800}
.form-field input,.form-field textarea{width:100%;border:1px solid #d0d5dd;border-radius:10px;padding:10px 11px;font-size:12px}
.form-field textarea{min-height:100px;resize:vertical}
.form-field input:focus,.form-field textarea:focus{outline:none;border-color:#13836e;box-shadow:0 0 0 3px rgba(19,131,110,.08)}
.form-field small{display:block;margin-top:5px;color:#98a2b3;font-size:9px}
.form-actions{display:flex;justify-content:flex-end;gap:8px;border-top:1px solid #edf0f4;padding-top:17px;margin-top:4px}
.save-btn{border:0;background:#13836e;color:#fff;padding:9px 14px;border-radius:9px;font-size:11px;font-weight:800}
.password-card{margin-top:18px}
.password-form{padding:20px}
.password-note{padding:11px 13px;background:#eff8ff;color:#175cd3;border-radius:10px;font-size:11px;margin-bottom:16px}
.password-btn{border:0;background:#344054;color:#fff;padding:9px 14px;border-radius:9px;font-size:11px;font-weight:800}
.notice{margin-bottom:14px}
@@media(max-width:900px){.profile-grid{grid-template-columns:1fr}}
@@media(max-width:550px){.form-grid{grid-template-columns:1fr}.form-field.full{grid-column:auto}.profile-stats{grid-template-columns:1fr}}
</style>
}

<section class="profile-header">
    <div>
        <span class="profile-label">
            <i class="bi bi-person-circle"></i>
            CUSTOMER ACCOUNT
        </span>

        <h2>My Profile</h2>

        <p>Keep your contact and security information up to date.</p>
    </div>
</section>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success notice">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ProfileRefreshMessage"] != null)
{
    <div class="alert alert-info notice">
        @TempData["ProfileRefreshMessage"]
    </div>
}

@if (TempData["PasswordSuccess"] != null)
{
    <div class="alert alert-success notice">
        @TempData["PasswordSuccess"]
    </div>
}

@if (TempData["PasswordError"] != null)
{
    <div class="alert alert-danger notice">
        @TempData["PasswordError"]
    </div>
}

<div class="profile-grid">

    <aside class="profile-card">

        <div class="profile-summary">

            <div class="profile-avatar">
                @Model.Initials
            </div>

            <h3>@Model.FullName</h3>
            <p>@Model.Email</p>

            @if (Model.IsActive)
            {
                <span class="account-badge">
                    <i class="bi bi-check-circle"></i>
                    Active Customer
                </span>
            }

            <div class="profile-stats">

                <div class="profile-stat">
                    <strong>@Model.TotalOrders</strong>
                    <span>Total Orders</span>
                </div>

                <div class="profile-stat">
                    <strong>@Model.CompletedOrders</strong>
                    <span>Completed</span>
                </div>

                <div class="profile-stat">
                    <strong>@Model.FavoriteProducts</strong>
                    <span>Favorite Products</span>
                </div>

            </div>

            <div class="account-info">

                <div class="info-row">
                    <span>Customer since</span>
                    <strong>@Model.CustomerSince.ToString("dd MMM yyyy")</strong>
                </div>

                <div class="info-row">
                    <span>Account created</span>
                    <strong>@Model.AccountCreatedAt.ToString("dd MMM yyyy")</strong>
                </div>

                <div class="info-row">
                    <span>Last login</span>
                    <strong>
                        @(Model.LastLoginAt.HasValue
                            ? Model.LastLoginAt.Value.ToString("dd MMM yyyy, hh:mm tt")
                            : "Not recorded")
                    </strong>
                </div>

            </div>

        </div>

    </aside>

    <div>

        <section class="profile-card">

            <div class="card-head">
                <span>PERSONAL DETAILS</span>
                <h3>Edit Profile</h3>
            </div>

            <form asp-controller="CustomerProfile"
                  asp-action="Save"
                  method="post"
                  class="profile-form">

                @Html.AntiForgeryToken()

                <input asp-for="CustomerId" type="hidden" />
                <input asp-for="UserId" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="form-grid">

                    <div class="form-field">
                        <label asp-for="FullName"></label>

                        <input asp-for="FullName"
                               autocomplete="name" />

                        <span asp-validation-for="FullName"
                              class="text-danger"></span>
                    </div>

                    <div class="form-field">
                        <label asp-for="Email"></label>

                        <input asp-for="Email"
                               type="email"
                               autocomplete="email" />

                        <span asp-validation-for="Email"
                              class="text-danger"></span>

                        <small>
                            Email must be unique across MarketLink accounts.
                        </small>
                    </div>

                    <div class="form-field">
                        <label asp-for="Phone"></label>

                        <input asp-for="Phone"
                               autocomplete="tel"
                               placeholder="Phone number" />

                        <span asp-validation-for="Phone"
                              class="text-danger"></span>
                    </div>

                    <div class="form-field full">
                        <label asp-for="Address"></label>

                        <textarea asp-for="Address"
                                  autocomplete="street-address"
                                  placeholder="Your address"></textarea>

                        <span asp-validation-for="Address"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="form-actions">
                    <button type="submit"
                            class="save-btn">
                        <i class="bi bi-check2"></i>
                        Save Changes
                    </button>
                </div>

            </form>

        </section>

        <section class="profile-card password-card">

            <div class="card-head">
                <span>SECURITY</span>
                <h3>Change Password</h3>
            </div>

            <form asp-controller="CustomerProfile"
                  asp-action="ChangePassword"
                  method="post"
                  class="password-form">

                @Html.AntiForgeryToken()

                <div class="password-note">
                    <i class="bi bi-shield-lock"></i>
                    Your current password is verified before a new PBKDF2 password hash is stored.
                </div>

                <div class="form-field">
                    <label for="CurrentPassword">
                        Current Password
                    </label>

                    <input type="password"
                           id="CurrentPassword"
                           name="CurrentPassword"
                           autocomplete="current-password"
                           required />
                </div>

                <div class="form-grid">

                    <div class="form-field">
                        <label for="NewPassword">
                            New Password
                        </label>

                        <input type="password"
                               id="NewPassword"
                               name="NewPassword"
                               minlength="8"
                               autocomplete="new-password"
                               required />

                        <small>Minimum 8 characters.</small>
                    </div>

                    <div class="form-field">
                        <label for="ConfirmNewPassword">
                            Confirm New Password
                        </label>

                        <input type="password"
                               id="ConfirmNewPassword"
                               name="ConfirmNewPassword"
                               minlength="8"
                               autocomplete="new-password"
                               required />
                    </div>

                </div>

                <div class="form-actions">
                    <button type="submit"
                            class="password-btn">
                        <i class="bi bi-key"></i>
                        Change Password
                    </button>
                </div>

            </form>

        </section>

    </div>

</div>
