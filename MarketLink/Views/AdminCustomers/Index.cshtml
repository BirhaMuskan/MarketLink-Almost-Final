@model MarketLink.ViewModels.AdminCustomersPageViewModel

@{
    ViewData["Title"] = "Customers";
    Layout = "~/Views/Shared/_AdminDashboardLayout.cshtml";
}

@section Styles {
<style>
.admin-page-header{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:18px}
.admin-page-label{color:#14836f;font-size:12px;font-weight:800;letter-spacing:.08em}
.admin-page-header h2{margin:7px 0 5px;font-size:28px;font-weight:800}
.admin-page-header p{margin:0;color:#667085}
.admin-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:18px}
.admin-stat{background:#fff;border:1px solid #e7ebef;border-radius:16px;padding:16px}
.admin-stat span{display:block;color:#667085;font-size:11px}
.admin-stat strong{display:block;margin-top:4px;font-size:24px}
.admin-card{background:#fff;border:1px solid #e7ebef;border-radius:18px;overflow:hidden}
.admin-toolbar{display:flex;justify-content:space-between;gap:12px;padding:15px 17px;border-bottom:1px solid #edf0f4;flex-wrap:wrap}
.search-wrap{display:flex;gap:8px;flex-wrap:wrap}
.search-wrap input,.search-wrap select{border:1px solid #d0d5dd;border-radius:9px;padding:9px 10px;font-size:11px}
.search-wrap input{min-width:250px}
.admin-btn{border:0;background:#13836e;color:#fff;padding:9px 12px;border-radius:9px;font-size:10px;font-weight:800}
.table-wrap{overflow:auto}
.admin-table{width:100%;border-collapse:collapse}
.admin-table th{background:#f8fafc;color:#667085;padding:11px 13px;font-size:9px;text-transform:uppercase;white-space:nowrap}
.admin-table td{padding:13px;border-top:1px solid #edf0f4;font-size:11px;vertical-align:middle;white-space:nowrap}
.customer-main strong{display:block}
.customer-main span{display:block;color:#98a2b3;font-size:9px;margin-top:2px}
.status-badge{display:inline-flex;padding:5px 8px;border-radius:999px;font-size:9px;font-weight:800}
.status-badge.active{background:#dcfae6;color:#067647}
.status-badge.inactive{background:#fee4e2;color:#b42318}
.row-actions{display:flex;gap:6px}
.row-btn{border:1px solid #d0d5dd;background:#fff;color:#344054;text-decoration:none;padding:6px 8px;border-radius:7px;font-size:9px;font-weight:800}
.row-btn.danger{color:#b42318;border-color:#f2c8c5}
.row-btn.activate{color:#067647;border-color:#b7e4cd}
.notice{margin-bottom:14px}
.empty{text-align:center;padding:50px;color:#667085}
@@media(max-width:700px){.admin-stats{grid-template-columns:1fr}.search-wrap{width:100%}.search-wrap input,.search-wrap select,.admin-btn{width:100%}}
</style>
}

<section class="admin-page-header">
    <div>
        <span class="admin-page-label">
            <i class="bi bi-people"></i>
            USER MANAGEMENT
        </span>

        <h2>Customers</h2>

        <p>
            View customer activity and activate or deactivate customer accounts.
        </p>
    </div>
</section>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success notice">
        @TempData["SuccessMessage"]
    </div>
}

<section class="admin-stats">
    <div class="admin-stat">
        <span>Total Customers</span>
        <strong>@Model.TotalCustomers</strong>
    </div>

    <div class="admin-stat">
        <span>Active</span>
        <strong>@Model.ActiveCustomers</strong>
    </div>

    <div class="admin-stat">
        <span>Inactive</span>
        <strong>@Model.InactiveCustomers</strong>
    </div>
</section>

<section class="admin-card">

    <form asp-controller="AdminCustomers"
          asp-action="Index"
          method="get"
          class="admin-toolbar">

        <div class="search-wrap">

            <input type="text"
                   name="search"
                   value="@Model.Search"
                   placeholder="Search name, email or phone..." />

            <select name="status">
                <option value="All" selected="@(Model.Status == "All")">All</option>
                <option value="Active" selected="@(Model.Status == "Active")">Active</option>
                <option value="Inactive" selected="@(Model.Status == "Inactive")">Inactive</option>
            </select>

            <button type="submit"
                    class="admin-btn">
                <i class="bi bi-search"></i>
                Search
            </button>

        </div>

    </form>

    @if (!Model.Customers.Any())
    {
        <div class="empty">
            <i class="bi bi-person-x" style="font-size:32px;color:#13836e;"></i>
            <h3>No customers found</h3>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="admin-table">

                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Phone</th>
                        <th>Orders</th>
                        <th>Completed</th>
                        <th>Spent</th>
                        <th>Joined</th>
                        <th>Last Login</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.Customers)
                    {
                        <tr>

                            <td class="customer-main">
                                <strong>@item.FullName</strong>
                                <span>@item.Email</span>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.Phone)
                                    ? "-"
                                    : item.Phone)
                            </td>

                            <td>@item.TotalOrders</td>

                            <td>@item.CompletedOrders</td>

                            <td>
                                Rs. @item.TotalSpent.ToString("N2")
                            </td>

                            <td>
                                @item.CustomerCreatedAt.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @(item.LastLoginAt.HasValue
                                    ? item.LastLoginAt.Value.ToString("dd MMM yyyy")
                                    : "Never")
                            </td>

                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="status-badge active">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge inactive">
                                        Inactive
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="row-actions">

                                    <a asp-controller="AdminCustomers"
                                       asp-action="Details"
                                       asp-route-id="@item.CustomerId"
                                       class="row-btn">
                                        View
                                    </a>

                                    <form asp-controller="AdminCustomers"
                                          asp-action="ToggleStatus"
                                          method="post"
                                          onsubmit="return confirm('@(item.IsActive ? "Deactivate this customer account?" : "Activate this customer account?")');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@item.CustomerId" />

                                        <button type="submit"
                                                class="row-btn @(item.IsActive ? "danger" : "activate")">

                                            @(item.IsActive
                                                ? "Deactivate"
                                                : "Activate")
                                        </button>

                                    </form>

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        </div>
    }

</section>
