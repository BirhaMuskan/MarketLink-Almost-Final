
@{
    ViewData["Title"] = "How It Works";
}

<!-- ========================================================= HOW IT WORKS HERO ========================================================= --> <section class="how-hero"> <div class="how-hero-image"> <!-- DARK OVERLAY --> <div class="how-hero-overlay"></div> <div class="container"> <div class="how-hero-content"> <!-- BREADCRUMB --> <div class="how-breadcrumb"> <a asp-controller="Home" asp-action="Index"> Home </a> <i class="bi bi-chevron-right"></i> <span>How It Works</span> </div> <!-- CATEGORY --> <div class="how-category"> <i class="bi bi-lightning-charge-fill"></i> SIMPLE & LOCAL </div> <!-- TITLE --> <h1> How It <span>Works</span> </h1> <!-- SHORT DESCRIPTION --> <p class="how-hero-description"> Discover local farmers, fresh products and nearby markets through MarketLink. </p> </div> </div> </div> </section>


<!-- =========================================================
     MAIN STEPS
========================================================= -->
<section class="how-steps-section">

    <div class="container">

        <div class="how-heading text-center">

            <span>HOW MARKETLINK WORKS</span>

            <h2>
                From Farm to
                <strong>Your Table</strong>
            </h2>

            <p>
                Everything you need to discover fresh local products
                and connect with farmers is just a few simple steps away.
            </p>

        </div>


        <div class="steps-wrapper">

            <!-- STEP 01 -->
            <div class="how-step">

                <div class="step-number">
                    01
                </div>

                <div class="step-icon">
                    <i class="bi bi-search"></i>
                </div>

                <div class="step-content">

                    <span>STEP ONE</span>

                    <h3>Discover Local Markets</h3>

                    <p>
                        Find farmers markets near you and explore the
                        different local communities available through
                        MarketLink.
                    </p>

                    <a asp-controller="Markets"
                       asp-action="Index">
                        Explore Markets
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>

            </div>


            <!-- STEP 02 -->
            <div class="how-step">

                <div class="step-number">
                    02
                </div>

                <div class="step-icon">
                    <i class="bi bi-basket2-fill"></i>
                </div>

                <div class="step-content">

                    <span>STEP TWO</span>

                    <h3>Explore Fresh Products</h3>

                    <p>
                        Browse fresh vegetables, fruits, dairy products,
                        herbs and other products offered by local farmers.
                    </p>

                    <a asp-controller="Products"
                       asp-action="Index">
                        Browse Products
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>

            </div>


            <!-- STEP 03 -->
            <div class="how-step">

                <div class="step-number">
                    03
                </div>

                <div class="step-icon">
                    <i class="bi bi-person-heart"></i>
                </div>

                <div class="step-content">

                    <span>STEP THREE</span>

                    <h3>Meet Local Farmers</h3>

                    <p>
                        Learn about farmers, their farms, products and
                        farming practices before choosing what you want.
                    </p>

                    <a asp-controller="Farmers"
                       asp-action="Index">
                        Meet Farmers
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>

            </div>


            <!-- STEP 04 -->
            <div class="how-step">

                <div class="step-number">
                    04
                </div>

                <div class="step-icon">
                    <i class="bi bi-chat-dots-fill"></i>
                </div>

                <div class="step-content">

                    <span>STEP FOUR</span>

                    <h3>Connect & Plan</h3>

                    <p>
                        Connect with local sellers and use MarketLink
                        information to plan your visit or purchase.
                    </p>

                    <a asp-controller="Contact"
                       asp-action="Index">
                        Get Connected
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     WHY MARKETLINK
========================================================= -->
<section class="why-marketlink-section">

    <div class="container">

        <div class="row align-items-center g-5">

            <!-- IMAGE -->
            <div class="col-lg-5">

                <div class="why-image">

                    <img src="https://images.unsplash.com/photo-1464226184884-fa280b87c399?auto=format&fit=crop&w=900&q=85"
                         alt="Fresh Farm Produce">

                    <div class="why-badge">

                        <i class="bi bi-heart-fill"></i>

                        <div>
                            <strong>Support Local</strong>
                            <span>Grow together</span>
                        </div>

                    </div>

                </div>

            </div>


            <!-- CONTENT -->
            <div class="col-lg-7">

                <div class="why-content">

                    <span class="section-label">
                        WHY MARKETLINK
                    </span>

                    <h2>
                        More Than a Marketplace.
                        <strong>A Local Connection.</strong>
                    </h2>

                    <p>
                        MarketLink brings farmers, customers and local
                        markets together in one simple platform.
                    </p>

                    <p>
                        Instead of searching in different places, you can
                        discover products, learn about farmers and find
                        nearby markets from one convenient platform.
                    </p>


                    <div class="benefit-grid">

                        <!-- BENEFIT 01 -->
                        <div class="benefit-item">

                            <div class="benefit-icon">
                                <i class="bi bi-geo-alt-fill"></i>
                            </div>

                            <div>
                                <h4>Find Nearby</h4>
                                <p>
                                    Discover local markets around you.
                                </p>
                            </div>

                        </div>


                        <!-- BENEFIT 02 -->
                        <div class="benefit-item">

                            <div class="benefit-icon">
                                <i class="bi bi-patch-check-fill"></i>
                            </div>

                            <div>
                                <h4>Verified Farmers</h4>
                                <p>
                                    Learn more about local farmers.
                                </p>
                            </div>

                        </div>


                        <!-- BENEFIT 03 -->
                        <div class="benefit-item">

                            <div class="benefit-icon">
                                <i class="bi bi-basket-fill"></i>
                            </div>

                            <div>
                                <h4>Fresh Products</h4>
                                <p>
                                    Explore locally available produce.
                                </p>
                            </div>

                        </div>


                        <!-- BENEFIT 04 -->
                        <div class="benefit-item">

                            <div class="benefit-icon">
                                <i class="bi bi-people-fill"></i>
                            </div>

                            <div>
                                <h4>Local Community</h4>
                                <p>
                                    Build stronger local connections.
                                </p>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     FOR FARMERS
========================================================= -->
<section class="for-farmers-section">

    <div class="container">

        <div class="row align-items-center g-5">

            <!-- CONTENT -->
            <div class="col-lg-7">

                <span class="section-label light-label">
                    FOR LOCAL FARMERS
                </span>

                <h2>
                    Bring Your Farm
                    <strong>Closer to Customers.</strong>
                </h2>

                <p>
                    MarketLink helps local farmers showcase their farms,
                    products and market locations so customers can discover
                    them more easily.
                </p>


                <div class="farmer-features">

                    <div>
                        <i class="bi bi-check-circle-fill"></i>
                        Create your farmer profile
                    </div>

                    <div>
                        <i class="bi bi-check-circle-fill"></i>
                        Showcase your products
                    </div>

                    <div>
                        <i class="bi bi-check-circle-fill"></i>
                        Share your market locations
                    </div>

                    <div>
                        <i class="bi bi-check-circle-fill"></i>
                        Connect with local customers
                    </div>

                </div>


                <a asp-controller="Account"
                   asp-action="Register"
                   class="btn btn-farmer-start">

                    Join MarketLink
                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>


            <!-- ILLUSTRATION -->
            <div class="col-lg-5">

                <div class="farmer-illustration">

                    <div class="illustration-circle circle-one"></div>
                    <div class="illustration-circle circle-two"></div>

                    <i class="bi bi-flower1 main-farm-icon"></i>


                    <div class="mini-card mini-card-one">

                        <i class="bi bi-basket-fill"></i>

                        Fresh Products

                    </div>


                    <div class="mini-card mini-card-two">

                        <i class="bi bi-people-fill"></i>

                        Local Customers

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     FAQ
========================================================= -->
<section class="how-faq-section">

    <div class="container">

        <div class="how-heading text-center">

            <span>COMMON QUESTIONS</span>

            <h2>
                Frequently Asked
                <strong>Questions</strong>
            </h2>

        </div>


        <div class="faq-wrapper">

            <!-- FAQ 01 -->
            <div class="faq-item">

                <button type="button"
                        class="faq-question">

                    <span>
                        What is MarketLink?
                    </span>

                    <i class="bi bi-plus-lg"></i>

                </button>


                <div class="faq-answer">

                    <p>
                        MarketLink is a platform designed to connect local
                        farmers, customers and farmers markets in one place.
                    </p>

                </div>

            </div>


            <!-- FAQ 02 -->
            <div class="faq-item">

                <button type="button"
                        class="faq-question">

                    <span>
                        Can I find markets near me?
                    </span>

                    <i class="bi bi-plus-lg"></i>

                </button>


                <div class="faq-answer">

                    <p>
                        Yes. You can explore available markets and view
                        their locations, market days and opening hours.
                    </p>

                </div>

            </div>


            <!-- FAQ 03 -->
            <div class="faq-item">

                <button type="button"
                        class="faq-question">

                    <span>
                        Can I learn about a farmer?
                    </span>

                    <i class="bi bi-plus-lg"></i>

                </button>


                <div class="faq-answer">

                    <p>
                        Yes. Farmer profiles can provide information about
                        the farm, products, location and available markets.
                    </p>

                </div>

            </div>


            <!-- FAQ 04 -->
            <div class="faq-item">

                <button type="button"
                        class="faq-question">

                    <span>
                        Can farmers join MarketLink?
                    </span>

                    <i class="bi bi-plus-lg"></i>

                </button>


                <div class="faq-answer">

                    <p>
                        Farmers can register and create their presence on
                        MarketLink so customers can discover their farms
                        and products.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     CTA
========================================================= -->
<section class="how-cta-section">

    <div class="container">

        <div class="how-cta-content">

            <span>
                START EXPLORING
            </span>

            <h2>
                Your Local Food Journey
                Starts Here.
            </h2>

            <p>
                Discover fresh products, local farmers and nearby markets
                with MarketLink.
            </p>


            <div class="cta-buttons">

                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-light">

                    Explore Products
                    <i class="bi bi-arrow-right"></i>

                </a>


                <a asp-controller="Farmers"
                   asp-action="Index"
                   class="btn btn-outline-light">

                    Meet Farmers

                </a>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     PAGE STYLES
========================================================= -->
@section Styles {

    <style>

        /* ========================================================= HOW IT WORKS HERO ========================================================= */ .how-hero {
            position: relative;
            min-height: 460px;
            overflow: hidden;
        }
        /* ========================================================= HERO BACKGROUND IMAGE ========================================================= */

        .how-hero-image {
            position: relative;
            min-height: 445px;
            margin: 20px auto 0;
            width: min(100% - 48px, 1400px);
            border-radius: 0 0 28px 28px;
            overflow: hidden;
            background-image: url("https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=1600&q=85");
            background-size: cover;
            background-position: center center; /* FIXED BACKGROUND */
            background-attachment: fixed;
            display: flex;
            align-items: center;
        }
        /* ========================================================= DARK GREEN OVERLAY ========================================================= */

        .how-hero-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient( 90deg, rgba(5, 67, 40, 0.90) 0%, rgba(8, 78, 48, 0.72) 42%, rgba(8, 78, 48, 0.30) 75%, rgba(8, 78, 48, 0.10) 100% );
            z-index: 1;
        }
        /* ========================================================= HERO CONTENT ========================================================= */

        .how-hero .container {
            position: relative;
            z-index: 2;
            width: 100%;
        }

        .how-hero-content {
            padding: 80px 0 75px;
            max-width: 650px;
        }
        /* ========================================================= BREADCRUMB ========================================================= */

        .how-breadcrumb {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 36px;
            font-size: 14px;
        }

            .how-breadcrumb a {
                color: #ffffff;
                text-decoration: none;
                font-weight: 600;
                transition: 0.3s ease;
            }

                .how-breadcrumb a:hover {
                    color: #d8f52d;
                }

            .how-breadcrumb i {
                color: #d8f52d;
                font-size: 11px;
            }

            .how-breadcrumb span {
                color: rgba(255, 255, 255, 0.78);
            }
        /* ========================================================= CATEGORY ========================================================= */

        .how-category {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 18px;
            color: #d8f52d;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

            .how-category i {
                font-size: 18px;
            }
        /* ========================================================= HERO TITLE ========================================================= */

        .how-hero h1 {
            margin: 0 0 18px;
            color: #ffffff;
            font-size: clamp(44px, 5vw, 68px);
            line-height: 1.05;
            font-weight: 800;
            letter-spacing: -1.5px;
        }

            .how-hero h1 span {
                color: #d8f52d;
            }
        /* ========================================================= HERO DESCRIPTION ========================================================= */

        .how-hero-description {
            max-width: 570px;
            margin: 0;
            color: rgba(255, 255, 255, 0.90);
            font-size: 17px;
            line-height: 1.75;
        }
        /* ========================================================= TABLET ========================================================= */

        @@media (max-width: 991px) {
            .how-hero, .how-hero-image {
                min-height: 430px;
            }

            .how-hero-image {
                background-attachment: scroll;
            }

            .how-hero-content {
                padding: 75px 0 65px;
            }
        }
        /* ========================================================= MOBILE ========================================================= */

        @@media (max-width: 576px) {
            .how-hero, .how-hero-image {
                min-height: 420px;
            }

            .how-hero-image {
                width: min(100% - 24px, 1400px);
                border-radius: 0 0 22px 22px;
            }

            .how-hero-content {
                padding: 62px 0 55px;
            }

            .how-breadcrumb {
                margin-bottom: 28px;
                gap: 9px;
                font-size: 13px;
            }

            .how-category {
                margin-bottom: 15px;
                font-size: 11px;
            }

                .how-category i {
                    font-size: 16px;
                }

            .how-hero h1 {
                margin-bottom: 15px;
                font-size: 42px;
            }

            .how-hero-description {
                font-size: 15px;
                line-height: 1.7;
            }
        }


        /* =====================================================
                   SECTION HEADING
                ===================================================== */

        .section-label {
            display: inline-block;
            margin-bottom: 13px;
            color: #2d9955;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1.8px;
        }


        /* =====================================================
                   STEPS
                ===================================================== */

        .how-steps-section {
            padding: 100px 0;
            background: #fff;
        }

        .how-heading {
            max-width: 720px;
            margin: 0 auto 55px;
        }

            .how-heading > span {
                display: block;
                margin-bottom: 9px;
                color: #2b9653;
                font-size: 12px;
                font-weight: 800;
                letter-spacing: 1.7px;
            }

            .how-heading h2 {
                margin: 0;
                color: #193d29;
                font-size: clamp(32px, 4vw, 45px);
                font-weight: 800;
            }

                .how-heading h2 strong {
                    color: #2d9955;
                }

            .how-heading p {
                margin: 14px auto 0;
                color: #78857d;
                line-height: 1.8;
            }

        .steps-wrapper {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .how-step {
            position: relative;
            padding: 30px 23px;
            background: #f7fbf8;
            border: 1px solid #e2ece5;
            border-radius: 19px;
            transition: .3s ease;
        }

            .how-step:hover {
                transform: translateY(-7px);
                background: #fff;
                box-shadow: 0 18px 40px rgba(32, 71, 45, .09);
            }

        .step-number {
            position: absolute;
            top: 18px;
            right: 20px;
            color: #dbe9df;
            font-size: 26px;
            font-weight: 800;
        }

        .step-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 57px;
            height: 57px;
            margin-bottom: 25px;
            color: #2d9955;
            background: #e5f4e9;
            border-radius: 15px;
            font-size: 22px;
        }

        .step-content > span {
            color: #2d9955;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1.5px;
        }

        .step-content h3 {
            margin: 8px 0 12px;
            color: #294936;
            font-size: 19px;
            font-weight: 800;
        }

        .step-content p {
            min-height: 95px;
            margin-bottom: 18px;
            color: #77847c;
            font-size: 13px;
            line-height: 1.75;
        }

        .step-content a {
            color: #2b8b4d;
            text-decoration: none;
            font-size: 13px;
            font-weight: 800;
        }

            .step-content a i {
                margin-left: 5px;
            }


        /* =====================================================
                   WHY MARKETLINK
                ===================================================== */

        .why-marketlink-section {
            padding: 100px 0;
            background: #f5faf6;
        }

        .why-image {
            position: relative;
            padding-right: 25px;
        }

            .why-image > img {
                width: 100%;
                height: 500px;
                object-fit: cover;
                border-radius: 25px;
                box-shadow: 0 20px 45px rgba(32, 71, 45, .13);
            }

        .why-badge {
            position: absolute;
            right: 0;
            bottom: 30px;
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 14px 18px;
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 15px 35px rgba(32, 71, 45, .15);
        }

            .why-badge > i {
                color: #2d9955;
                font-size: 21px;
            }

            .why-badge strong,
            .why-badge span {
                display: block;
            }

            .why-badge strong {
                color: #294936;
                font-size: 13px;
            }

            .why-badge span {
                margin-top: 3px;
                color: #89958d;
                font-size: 10px;
            }

        .why-content {
            padding-left: 25px;
        }

            .why-content h2 {
                max-width: 600px;
                margin-bottom: 18px;
                color: #193d29;
                font-size: clamp(32px, 4vw, 44px);
                line-height: 1.2;
                font-weight: 800;
            }

                .why-content h2 strong {
                    display: block;
                    color: #2d9955;
                }

            .why-content > p {
                max-width: 620px;
                color: #718078;
                line-height: 1.8;
            }

        .benefit-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 18px;
            margin-top: 30px;
        }

        .benefit-item {
            display: flex;
            gap: 12px;
        }

        .benefit-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 43px;
            height: 43px;
            flex-shrink: 0;
            color: #2d9955;
            background: #e5f4e9;
            border-radius: 11px;
        }

        .benefit-item h4 {
            margin: 2px 0 4px;
            color: #31503d;
            font-size: 14px;
            font-weight: 800;
        }

        .benefit-item p {
            margin: 0;
            color: #87928c;
            font-size: 11px;
            line-height: 1.5;
        }


        /* =====================================================
                   FARMERS
                ===================================================== */

        .for-farmers-section {
            padding: 100px 0;
            background: #216f3d;
        }

        .light-label {
            color: #a9ddb8;
        }

        .for-farmers-section h2 {
            max-width: 650px;
            margin-bottom: 18px;
            color: #fff;
            font-size: clamp(32px, 4vw, 47px);
            line-height: 1.2;
            font-weight: 800;
        }

            .for-farmers-section h2 strong {
                display: block;
                color: #a8ddb7;
            }

        .for-farmers-section > .container .row > .col-lg-7 > p {
            max-width: 650px;
            color: #d0ead7;
            line-height: 1.85;
        }

        .farmer-features {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 13px;
            margin: 30px 0;
        }

            .farmer-features div {
                color: #e4f4e8;
                font-size: 13px;
                font-weight: 600;
            }

            .farmer-features i {
                margin-right: 7px;
                color: #9cdbac;
            }

        .btn-farmer-start {
            padding: 13px 22px;
            color: #216f3d;
            background: #fff;
            border-radius: 10px;
            font-weight: 800;
            text-decoration: none;
        }

            .btn-farmer-start:hover {
                color: #216f3d;
                background: #edf8ef;
            }

        .farmer-illustration {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 360px;
            overflow: hidden;
            border-radius: 25px;
            background: rgba(255, 255, 255, .08);
        }

        .illustration-circle {
            position: absolute;
            border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, .15);
        }

        .circle-one {
            width: 260px;
            height: 260px;
        }

        .circle-two {
            width: 190px;
            height: 190px;
        }

        .main-farm-icon {
            position: relative;
            z-index: 2;
            color: #b7e4c1;
            font-size: 105px;
        }

        .mini-card {
            position: absolute;
            z-index: 3;
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 11px 14px;
            color: #31503d;
            background: #fff;
            border-radius: 11px;
            box-shadow: 0 12px 25px rgba(0, 0, 0, .12);
            font-size: 11px;
            font-weight: 800;
        }

            .mini-card i {
                color: #2d9955;
                font-size: 16px;
            }

        .mini-card-one {
            top: 55px;
            left: 25px;
        }

        .mini-card-two {
            right: 20px;
            bottom: 55px;
        }


        /* =====================================================
                   FAQ
                ===================================================== */

        .how-faq-section {
            padding: 100px 0;
            background: #fff;
        }

        .faq-wrapper {
            max-width: 850px;
            margin: auto;
        }

        .faq-item {
            margin-bottom: 12px;
