@model MarketLink.ViewModels.HowItWorksViewModel

@{
    ViewData["Title"] = "How It Works";
}


<!-- =========================================================
     HOW IT WORKS HERO
========================================================= -->

<section class="how-hero">

    <div class="how-hero-image">

        <div class="how-hero-overlay"></div>

        <div class="container">

            <div class="how-hero-content">

                <!-- BREADCRUMB -->

                <div class="how-breadcrumb">

                    <a asp-controller="Home"
                       asp-action="Index">
                        Home
                    </a>

                    <i class="bi bi-chevron-right"></i>

                    <span>How It Works</span>

                </div>


                <!-- CATEGORY -->

                <div class="how-category">

                    <i class="bi bi-lightning-charge-fill"></i>

                    SIMPLE & LOCAL

                </div>


                <!-- TITLE -->

                <h1>
                    How It
                    <span>Works</span>
                </h1>


                <!-- DESCRIPTION -->

                <p class="how-hero-description">

                    Discover local farmers, fresh products and nearby
                    markets, then place your pre-order for convenient
                    market pickup through MarketLink.

                </p>

            </div>

        </div>

    </div>

</section>

<!-- =========================================================
     PLATFORM STATISTICS
========================================================= -->

<section class="how-stats-section">

    <div class="container">

        <div class="how-stats-grid">

            <!-- FARMERS -->

            <div class="how-stat-card">

                <div class="how-stat-icon">
                    <i class="bi bi-person-heart"></i>
                </div>

                <div>

                    <strong>
                        @Model.TotalFarmers
                    </strong>

                    <span>
                        Local Farmers
                    </span>

                </div>

            </div>


            <!-- CUSTOMERS -->

            <div class="how-stat-card">

                <div class="how-stat-icon">
                    <i class="bi bi-people-fill"></i>
                </div>

                <div>

                    <strong>
                        @Model.TotalCustomers
                    </strong>

                    <span>
                        Customers
                    </span>

                </div>

            </div>


            <!-- PRODUCTS -->

            <div class="how-stat-card">

                <div class="how-stat-icon">
                    <i class="bi bi-basket-fill"></i>
                </div>

                <div>

                    <strong>
                        @Model.TotalProducts
                    </strong>

                    <span>
                        Products
                    </span>

                </div>

            </div>


            <!-- MARKETS -->

            <div class="how-stat-card">

                <div class="how-stat-icon">
                    <i class="bi bi-shop"></i>
                </div>

                <div>

                    <strong>
                        @Model.TotalMarkets
                    </strong>

                    <span>
                        Markets
                    </span>

                </div>

            </div>


            <!-- CATEGORIES -->

            <div class="how-stat-card">

                <div class="how-stat-icon">
                    <i class="bi bi-grid-fill"></i>
                </div>

                <div>

                    <strong>
                        @Model.TotalCategories
                    </strong>

                    <span>
                        Categories
                    </span>

                </div>

            </div>


            <!-- ORDERS -->

            <div class="how-stat-card">

                <div class="how-stat-icon">
                    <i class="bi bi-receipt-cutoff"></i>
                </div>

                <div>

                    <strong>
                        @Model.TotalOrders
                    </strong>

                    <span>
                        Pre-Orders
                    </span>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- =========================================================
     CUSTOMER JOURNEY
========================================================= -->

<section class="how-steps-section">

    <div class="container">


        <div class="how-heading text-center">

            <span>
                CUSTOMER JOURNEY
            </span>

            <h2>
                From Local Farm to
                <strong>Your Table</strong>
            </h2>

            <p>

                MarketLink makes it easier to discover local markets,
                compare available products and reserve items for pickup.

            </p>

        </div>



        <div class="steps-wrapper">


            <!-- STEP 01 -->

            <div class="how-step">

                <div class="step-number">
                    01
                </div>

                <div class="step-icon">

                    <i class="bi bi-shop-window"></i>

                </div>

                <div class="step-content">

                    <span>
                        STEP ONE
                    </span>

                    <h3>
                        Discover Markets & Farmers
                    </h3>

                    <p>

                        Browse nearby farmers markets and discover the
                        farmers participating in those markets. View
                        market days, locations and available information.

                    </p>

                    <a asp-controller="Markets"
                       asp-action="Index">

                        Explore Markets

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>



            <!-- STEP 02 -->

            <div class="how-step">

                <div class="step-number">
                    02
                </div>

                <div class="step-icon">

                    <i class="bi bi-search"></i>

                </div>

                <div class="step-content">

                    <span>
                        STEP TWO
                    </span>

                    <h3>
                        Browse & Filter Products
                    </h3>

                    <p>

                        Explore vegetables, fruits, dairy, baked goods
                        and other products. Search and filter products
                        by category, price, market and market day.

                    </p>

                    <a asp-controller="Products"
                       asp-action="Index">

                        Browse Products

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>



            <!-- STEP 03 -->

            <div class="how-step">

                <div class="step-number">
                    03
                </div>

                <div class="step-icon">

                    <i class="bi bi-cart-check-fill"></i>

                </div>

                <div class="step-content">

                    <span>
                        STEP THREE
                    </span>

                    <h3>
                        Add to Cart & Pre-Order
                    </h3>

                    <p>

                        Add available products to your cart, select
                        the required quantities and place a pre-order
                        against the farmer's available stock.

                    </p>

                    <a asp-controller="Products"
                       asp-action="Index">

                        Start Shopping

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>



            <!-- STEP 04 -->

            <div class="how-step">

                <div class="step-number">
                    04
                </div>

                <div class="step-icon">

                    <i class="bi bi-calendar-check-fill"></i>

                </div>

                <div class="step-content">

                    <span>
                        STEP FOUR
                    </span>

                    <h3>
                        Select Pickup Slot
                    </h3>

                    <p>

                        Select an available pickup date and time slot.
                        Your order can then be prepared by the farmer
                        for collection at the market.

                    </p>

                    <a asp-controller="Orders"
                       asp-action="Index">

                        View Orders

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>



        </div>

    </div>

</section>



<!-- =========================================================
     ORDER FLOW
========================================================= -->

<section class="order-flow-section">

    <div class="container">


        <div class="row align-items-center g-5">


            <!-- CONTENT -->

            <div class="col-lg-6">

                <span class="section-label">
                    SIMPLE PRE-ORDERING
                </span>

                <h2>

                    Know What's Available
                    <strong>Before You Visit.</strong>

                </h2>

                <p>

                    MarketLink helps customers see available stock before
                    visiting the market. Instead of relying only on
                    word of mouth or arriving after popular items are
                    sold out, customers can check product availability
                    and place a pre-order.

                </p>


                <div class="order-flow-list">


                    <div class="order-flow-item">

                        <div class="flow-icon">
                            <i class="bi bi-box-seam"></i>
                        </div>

                        <div>

                            <h4>
                                Check Availability
                            </h4>

                            <p>
                                View products and current available quantities.
                            </p>

                        </div>

                    </div>



                    <div class="order-flow-item">

                        <div class="flow-icon">
                            <i class="bi bi-cart-plus"></i>
                        </div>

                        <div>

                            <h4>
                                Reserve Products
                            </h4>

                            <p>
                                Add products to your cart and place a pre-order.
                            </p>

                        </div>

                    </div>



                    <div class="order-flow-item">

                        <div class="flow-icon">
                            <i class="bi bi-clock-history"></i>
                        </div>

                        <div>

                            <h4>
                                Track Order Status
                            </h4>

                            <p>
                                Follow your order from placed to ready for pickup.
                            </p>

                        </div>

                    </div>



                    <div class="order-flow-item">

                        <div class="flow-icon">
                            <i class="bi bi-handbag-fill"></i>
                        </div>

                        <div>

                            <h4>
                                Pickup at Market
                            </h4>

                            <p>
                                Collect your order from the selected pickup point.
                            </p>

                        </div>

                    </div>


                </div>

            </div>



            <!-- VISUAL -->

            <div class="col-lg-6">

                <div class="order-visual">

                    <div class="visual-card main-order-card">

                        <div class="visual-card-header">

                            <span>
                                MARKETLINK ORDER
                            </span>

                            <i class="bi bi-check-circle-fill"></i>

                        </div>


                        <div class="visual-product">

                            <div class="visual-product-icon">
                                <i class="bi bi-basket-fill"></i>
                            </div>

                            <div>

                                <strong>
                                    Fresh Local Produce
                                </strong>

                                <span>
                                    Pickup at Farmers Market
                                </span>

                            </div>

                        </div>


                        <div class="visual-status">

                            <div class="status-line active">
                                <span></span>
                                Order Placed
                            </div>

                            <div class="status-line active">
                                <span></span>
                                Accepted by Farmer
                            </div>

                            <div class="status-line active">
                                <span></span>
                                Ready for Pickup
                            </div>

                            <div class="status-line">
                                <span></span>
                                Completed
                            </div>

                        </div>

                    </div>


                    <div class="floating-order-card pickup-card">

                        <i class="bi bi-calendar-event"></i>

                        <div>

                            <strong>
                                Pickup Slot
                            </strong>

                            <span>
                                Selected by Customer
                            </span>

                        </div>

                    </div>


                    <div class="floating-order-card payment-card">

                        <i class="bi bi-wallet2"></i>

                        <div>

                            <strong>
                                Pay at Pickup
                            </strong>

                            <span>
                                No online payment gateway
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- =========================================================
     WHY MARKETLINK
========================================================= -->

<section class="why-marketlink-section">

    <div class="container">

        <div class="row align-items-center g-5">


            <!-- IMAGE -->

            <div class="col-lg-5">

                <div class="why-image">

                    <img src="https://images.unsplash.com/photo-1464226184884-fa280b87c399?auto=format&fit=crop&w=900&q=85"
                         alt="Fresh local farm produce"
                         loading="lazy" />


                    <div class="why-badge">

                        <i class="bi bi-heart-fill"></i>

                        <div>

                            <strong>
                                Support Local
                            </strong>

                            <span>
                                Connect with your community
                            </span>

                        </div>

                    </div>

                </div>

            </div>



            <!-- CONTENT -->

            <div class="col-lg-7">

                <div class="why-content">

                    <span class="section-label">
                        WHY MARKETLINK
                    </span>


                    <h2>

                        More Than a Marketplace.
                        <strong>A Local Connection.</strong>

                    </h2>


                    <p>

                        MarketLink brings farmers, customers and local
                        markets together through one centralized platform.

                    </p>


                    <p>

                        Customers can discover available products and
                        markets before visiting, while farmers can publish
                        their weekly stock and manage incoming pre-orders.

                    </p>



                    <div class="benefit-grid">


                        <!-- BENEFIT 01 -->

                        <div class="benefit-item">

                            <div class="benefit-icon">
                                <i class="bi bi-geo-alt-fill"></i>
                            </div>

                            <div>

                                <h4>
                                    Find Nearby Markets
                                </h4>

                                <p>
                                    Discover market locations and pickup points.
                                </p>

                            </div>

                        </div>



                        <!-- BENEFIT 02 -->

                        <div class="benefit-item">

                            <div class="benefit-icon">
                                <i class="bi bi-basket-fill"></i>
                            </div>

                            <div>

                                <h4>
                                    View Available Stock
                                </h4>

                                <p>
                                    See products and quantities before visiting.
                                </p>

                            </div>

                        </div>



                        <!-- BENEFIT 03 -->

                        <div class="benefit-item">

                            <div class="benefit-icon">
                                <i class="bi bi-cart-check-fill"></i>
                            </div>

                            <div>

                                <h4>
                                    Pre-Order for Pickup
                                </h4>

                                <p>
                                    Reserve available products in advance.
                                </p>

                            </div>

                        </div>



                        <!-- BENEFIT 04 -->

                        <div class="benefit-item">

                            <div class="benefit-icon">
                                <i class="bi bi-star-fill"></i>
                            </div>

                            <div>

                                <h4>
                                    Reviews & Ratings
                                </h4>

                                <p>
                                    Share feedback after completed orders.
                                </p>

                            </div>

                        </div>


                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- =========================================================
     FARMER SECTION
========================================================= -->

<section class="for-farmers-section">

    <div class="container">

        <div class="row align-items-center g-5">


            <!-- CONTENT -->

            <div class="col-lg-7">

                <span class="section-label light-label">
                    FOR LOCAL FARMERS
                </span>


                <h2>

                    Bring Your Farm
                    <strong>Closer to Customers.</strong>

                </h2>


                <p>

                    MarketLink gives farmers a centralized place to
                    manage their profile, market locations, weekly
                    products, prices, inventory and customer pre-orders.

                </p>



                <div class="farmer-features">


                    <div>
                        <i class="bi bi-check-circle-fill"></i>
                        Create your farmer profile
                    </div>


                    <div>
                        <i class="bi bi-check-circle-fill"></i>
                        Add your market locations
                    </div>


                    <div>
                        <i class="bi bi-check-circle-fill"></i>
                        Manage weekly stock and pricing
                    </div>


                    <div>
                        <i class="bi bi-check-circle-fill"></i>
                        Manage customer pre-orders
                    </div>


                    <div>
                        <i class="bi bi-check-circle-fill"></i>
                        Manage pickup slots
                    </div>


                    <div>
                        <i class="bi bi-check-circle-fill"></i>
                        Respond to customer reviews
                    </div>


                </div>


                <a asp-controller="Auth"
                   asp-action="Register"
                   class="btn btn-farmer-start">

                    Join MarketLink

                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>



            <!-- ILLUSTRATION -->

            <div class="col-lg-5">

                <div class="farmer-illustration">

                    <div class="illustration-circle circle-one"></div>

                    <div class="illustration-circle circle-two"></div>


                    <i class="bi bi-flower1 main-farm-icon"></i>


                    <div class="mini-card mini-card-one">

                        <i class="bi bi-box-seam"></i>

                        Weekly Stock

                    </div>


                    <div class="mini-card mini-card-two">

                        <i class="bi bi-cart-check"></i>

                        Pre-Orders

                    </div>


                </div>

            </div>


        </div>

    </div>

</section>

<!-- =========================================================
     OPTIONAL AI ASSISTANT
========================================================= -->

<section class="ai-how-section">

    <div class="container">

        <div class="row align-items-center g-5">


            <div class="col-lg-7">

                <span class="section-label">
                    OPTIONAL AI ASSISTANT
                </span>


                <h2>

                    Need Help Finding
                    <strong>Something Fresh?</strong>

                </h2>


                <p>

                    MarketLink can include an optional AI assistant to
                    help customers find products across markets and
                    farmers and answer common questions about market
                    timings, farmer availability, pickup windows and
                    product details.

                </p>


                <div class="ai-features">


                    <div>

                        <i class="bi bi-check-circle-fill"></i>

                        Find products across available listings

                    </div>


                    <div>

                        <i class="bi bi-check-circle-fill"></i>

                        Answer common market questions

                    </div>


                    <div>

                        <i class="bi bi-check-circle-fill"></i>

                        Provide pickup and availability information

                    </div>


                </div>

            </div>



            <div class="col-lg-5">

                <div class="ai-card">

                    <div class="ai-card-header">

                        <div class="ai-avatar">
                            <i class="bi bi-stars"></i>
                        </div>

                        <div>

                            <strong>
                                MarketLink Assistant
                            </strong>

                            <span>
                                AI-powered assistance
                            </span>

                        </div>

                    </div>


                    <div class="ai-message customer-message">

                        Find fresh vegetables available today.

                    </div>


                    <div class="ai-message assistant-message">

                        I can help you find available products,
                        markets and pickup information.

                    </div>


                    <div class="ai-input">

                        <span>
                            Ask MarketLink...
                        </span>

                        <i class="bi bi-send-fill"></i>

                    </div>

                </div>

            </div>


        </div>

    </div>

</section>

<!-- =========================================================
     FAQ
========================================================= -->

<section class="how-faq-section">

    <div class="container">


        <div class="how-heading text-center">

            <span>
                COMMON QUESTIONS
            </span>

            <h2>

                Frequently Asked
                <strong>Questions</strong>

            </h2>

            <p>

                Find answers to common questions about shopping,
                pre-orders, pickup and MarketLink features.

            </p>

        </div>



        <div class="faq-wrapper">


            @if (Model.FAQs != null && Model.FAQs.Any())
            {

                foreach (var faq in Model.FAQs)
                {

                    <div class="faq-item">

                        <button type="button"
                                class="faq-question">

                            <span>
                                @faq.Question
                            </span>

                            <i class="bi bi-plus-lg"></i>

                        </button>


                        <div class="faq-answer">

                            <p>
                                @faq.Answer
                            </p>

                        </div>

                    </div>

                }

            }
            else
            {

                <div class="empty-faq">

                    <i class="bi bi-info-circle"></i>

                    <p>
                        No frequently asked questions are available.
                    </p>

                </div>

            }

        </div>

    </div>

</section>

<!-- =========================================================
     CTA
========================================================= -->

<section class="how-cta-section">

    <div class="container">

        <div class="how-cta-content">


            <span>
                START EXPLORING
            </span>


            <h2>

                Your Local Food Journey
                Starts Here.

            </h2>


            <p>

                Discover local farmers, fresh products and nearby
                markets through MarketLink.

            </p>


            <div class="cta-buttons">


                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-light">

                    Explore Products

                    <i class="bi bi-arrow-right"></i>

                </a>


                <a asp-controller="Farmers"
                   asp-action="Index"
                   class="btn btn-outline-light">

                    Meet Farmers

                </a>


            </div>

        </div>

    </div>

</section>

<!-- =========================================================
     HOW IT WORKS - PAGE STYLES
========================================================= -->

@section Styles {

    <style>

        /* =========================================================
           HERO
        ========================================================= */

        .how-hero {
            position: relative;
            min-height: 460px;
            overflow: hidden;
        }

        .how-hero-image {
            position: relative;
            min-height: 445px;
            width: min(100% - 48px, 1400px);
            margin: 20px auto 0;
            overflow: hidden;

            border-radius: 0 0 28px 28px;

            background-image: url("https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=1600&q=85");
            background-size: cover;
            background-position: center center;
            background-attachment: fixed;

            display: flex;
            align-items: center;
        }

        .how-hero-overlay {
            position: absolute;
            inset: 0;
            z-index: 1;

            background: linear-gradient(
                90deg,
                rgba(5, 67, 40, 0.92) 0%,
                rgba(8, 78, 48, 0.74) 45%,
                rgba(8, 78, 48, 0.25) 100%
            );
        }

        .how-hero .container {
            position: relative;
            z-index: 2;
            width: 100%;
        }

        .how-hero-content {
            max-width: 690px;
            padding: 80px 0 75px;
        }

        /* =========================================================
           BREADCRUMB
        ========================================================= */

        .how-breadcrumb {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;

            margin-bottom: 35px;

            font-size: 14px;
        }

        .how-breadcrumb a {
            color: #ffffff;
            text-decoration: none;
            font-weight: 600;

            transition: 0.3s ease;
        }

        .how-breadcrumb a:hover {
            color: #d8f52d;
        }

        .how-breadcrumb i {
            color: #d8f52d;
            font-size: 11px;
        }

        .how-breadcrumb span {
            color: rgba(255, 255, 255, 0.78);
        }

        /* =========================================================
           HERO CATEGORY
        ========================================================= */

        .how-category {
            display: inline-flex;
            align-items: center;
            gap: 9px;

            margin-bottom: 18px;

            color: #d8f52d;

            font-size: 13px;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .how-category i {
            font-size: 18px;
        }

        /* =========================================================
           HERO TITLE
        ========================================================= */

        .how-hero h1 {
            margin: 0 0 18px;

            color: #ffffff;

            font-size: clamp(44px, 5vw, 68px);
            line-height: 1.05;
            font-weight: 800;
            letter-spacing: -1.5px;
        }

        .how-hero h1 span {
            color: #d8f52d;
        }

        /* =========================================================
           HERO DESCRIPTION
        ========================================================= */

        .how-hero-description {
            max-width: 610px;
            margin: 0;

            color: rgba(255, 255, 255, 0.90);

            font-size: 17px;
            line-height: 1.75;
        }


        /* =========================================================
           STATISTICS
        ========================================================= */

        .how-stats-section {
            padding: 35px 0;
            background: #ffffff;
        }

        .how-stats-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 15px;
        }

        .how-stat-card {
            display: flex;
            align-items: center;
            gap: 12px;

            padding: 20px 15px;

            background: #f7fbf8;
            border: 1px solid #e1ebe4;
            border-radius: 15px;

            transition: 0.3s ease;
        }

        .how-stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(32, 71, 45, 0.08);
        }

        .how-stat-icon {
            display: flex;
            align-items: center;
            justify-content: center;

            width: 45px;
            height: 45px;

            flex-shrink: 0;

            color: #2d9955;
            background: #e5f4e9;

            border-radius: 12px;
        }

        .how-stat-card strong,
        .how-stat-card span {
            display: block;
        }

        .how-stat-card strong {
            color: #193d29;

            font-size: 22px;
            line-height: 1;
        }

        .how-stat-card span {
            margin-top: 5px;

            color: #78857d;

            font-size: 11px;
        }


        /* =========================================================
           COMMON SECTION HEADING
        ========================================================= */

        .how-heading {
            max-width: 720px;
            margin: 0 auto 55px;

            text-align: center;
        }

        .how-heading > span,
        .section-label {
            display: inline-block;

            margin-bottom: 13px;

            color: #2d9955;

            font-size: 12px;
            font-weight: 800;
