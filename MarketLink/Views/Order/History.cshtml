@{
    ViewData["Title"] = "My Orders";
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>My Orders | MarketLink</title>

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

            /* =========================================================
                       GLOBAL
                    ========================================================= */

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
                background: #f5f8f5;
                color: #243128;
            }

            a {
                text-decoration: none;
            }

            .orders-page {
                min-height: 100vh;
                background: #f5f8f5;
            }


            /* =========================================================
                       HERO / BANNER
                    ========================================================= */

            .orders-hero {
                position: relative;
                min-height: 390px;
                display: flex;
                align-items: center;
                overflow: hidden;
                background-image: linear-gradient( 90deg, rgba(18, 57, 39, 0.95) 0%, rgba(24, 75, 48, 0.84) 42%, rgba(24, 75, 48, 0.45) 72%, rgba(24, 75, 48, 0.20) 100% ), url('/images/order-banner.jpg');
                background-size: cover;
                background-position: center;
                background-attachment: fixed;
            }

            .orders-hero-pattern {
                position: absolute;
                inset: 0;
                background-image: radial-gradient( circle at 82% 25%, rgba(142, 227, 168, 0.14), transparent 25% ), radial-gradient( circle at 92% 88%, rgba(255, 255, 255, 0.08), transparent 25% );
                pointer-events: none;
            }

            .orders-hero-container {
                width: 100%;
                max-width: 1200px;
                margin: auto;
                padding: 70px 30px;
                position: relative;
                z-index: 2;
            }


            /* =========================================================
                       BREADCRUMB
                    ========================================================= */

            .orders-breadcrumb {
                display: flex;
                align-items: center;
                flex-wrap: wrap;
                gap: 9px;
                color: #c8ded0;
                font-size: 13px;
                margin-bottom: 22px;
            }

                .orders-breadcrumb a {
                    color: #d8e9df;
                    transition: 0.2s ease;
                }

                    .orders-breadcrumb a:hover {
                        color: #8ee3a8;
                    }

                .orders-breadcrumb i {
                    font-size: 11px;
                    color: #8ee3a8;
                }


            /* =========================================================
                       HERO BADGE
                    ========================================================= */

            .orders-hero-badge {
                display: inline-flex;
                align-items: center;
                gap: 9px;
                padding: 8px 14px;
                border: 1px solid rgba(142, 227, 168, 0.25);
                border-radius: 30px;
                background: rgba(142, 227, 168, 0.10);
                color: #9ae9b1;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 1.2px;
                margin-bottom: 18px;
            }

                .orders-hero-badge i {
                    font-size: 14px;
                }


            /* =========================================================
                       HERO TITLE
                    ========================================================= */

            .orders-hero h1 {
                color: white;
                font-size: 48px;
                line-height: 1.1;
                font-weight: 700;
                margin-bottom: 17px;
            }

                .orders-hero h1 span {
                    color: #8ee3a8;
                }

            .orders-hero-description {
                max-width: 620px;
                color: #d4e5da;
                font-size: 16px;
                line-height: 1.7;
            }


            /* =========================================================
                       MAIN CONTENT
                    ========================================================= */

            .orders-content {
                max-width: 1100px;
                margin: -55px auto 0;
                padding: 0 25px 80px;
                position: relative;
                z-index: 5;
            }


            /* =========================================================
                       TOP SUMMARY
                    ========================================================= */

            .orders-overview {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 18px;
                margin-bottom: 25px;
            }

            .overview-card {
                background: white;
                border-radius: 17px;
                padding: 22px;
                box-shadow: 0 12px 35px rgba(30, 60, 42, 0.07);
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .overview-icon {
                width: 48px;
                height: 48px;
                flex-shrink: 0;
                border-radius: 13px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #eaf7ed;
                color: #267542;
                font-size: 20px;
            }

            .overview-info span {
                display: block;
                color: #7b887f;
                font-size: 12px;
                margin-bottom: 4px;
            }

            .overview-info strong {
                display: block;
                color: #1e3326;
                font-size: 20px;
            }


            /* =========================================================
                       ORDERS HEADER
                    ========================================================= */

            .orders-section-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 17px;
            }

            .orders-section-title {
                display: flex;
                align-items: center;
                gap: 11px;
            }

            .orders-section-title-icon {
                width: 40px;
                height: 40px;
                border-radius: 11px;
                background: #eaf7ed;
                color: #267542;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 17px;
            }

            .orders-section-title h2 {
                color: #1d3024;
                font-size: 21px;
                font-weight: 700;
                margin: 0;
            }

            .orders-section-title p {
                color: #7d8981;
                font-size: 12px;
                margin: 3px 0 0;
            }


            /* =========================================================
                       FILTER
                    ========================================================= */

            .orders-filter {
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .orders-filter select {
                    height: 40px;
                    padding: 0 35px 0 12px;
                    border: 1px solid #dce6df;
                    border-radius: 9px;
                    background: white;
                    color: #405047;
                    font-size: 12px;
                    outline: none;
                    cursor: pointer;
                }

                    .orders-filter select:focus {
                        border-color: #5a9a6c;
                    }


            /* =========================================================
                       ORDER CARD
                    ========================================================= */

            .order-history-card {
                background: white;
                border-radius: 18px;
                margin-bottom: 18px;
                overflow: hidden;
                box-shadow: 0 12px 40px rgba(30, 60, 42, 0.07);
                border: 1px solid #edf2ee;
            }


            /* =========================================================
                       ORDER CARD HEADER
                    ========================================================= */

            .history-card-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 20px;
                padding: 21px 24px;
                border-bottom: 1px solid #edf1ee;
            }

            .history-order-info {
                display: flex;
                align-items: center;
                gap: 13px;
            }

            .history-order-icon {
                width: 43px;
                height: 43px;
                border-radius: 11px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #eaf7ed;
                color: #267542;
                font-size: 18px;
            }

            .history-order-info h3 {
                color: #203228;
                font-size: 15px;
                font-weight: 700;
                margin-bottom: 4px;
            }

            .history-order-info p {
                color: #89948d;
                font-size: 11px;
                margin: 0;
            }


            /* =========================================================
                       STATUS
                    ========================================================= */

            .order-status {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                padding: 7px 11px;
                border-radius: 30px;
                font-size: 11px;
                font-weight: 700;
            }

                .order-status i {
                    font-size: 10px;
                }

            .status-confirmed {
                background: #e9f7ed;
                color: #267542;
            }

            .status-pending {
                background: #fff7e8;
                color: #a46b16;
            }

            .status-completed {
                background: #edf2f5;
                color: #536672;
            }


            /* =========================================================
                       ORDER BODY
                    ========================================================= */

            .history-card-body {
                padding: 22px 24px;
            }

            .history-main {
                display: grid;
                grid-template-columns: 1fr auto;
                gap: 25px;
                align-items: center;
            }
            /* =========================================================
               CUSTOMER ORDER DETAILS
            ========================================================= */

            .customer-order-details {
                margin-top: 22px;
                padding-top: 22px;
                border-top: 1px solid #edf1ee;
            }


            /* HEADING */

            .customer-details-heading {
                display: flex;
                align-items: center;
                gap: 11px;
                margin-bottom: 18px;
            }

            .customer-details-icon {
                width: 38px;
                height: 38px;
                border-radius: 10px;
                background: #eaf7ed;
                color: #267542;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 16px;
                flex-shrink: 0;
            }

            .customer-details-heading h4 {
                color: #26382c;
                font-size: 14px;
                font-weight: 700;
                margin: 0 0 3px;
            }

            .customer-details-heading p {
                color: #89948d;
                font-size: 11px;
                margin: 0;
            }


            /* CUSTOMER INFORMATION */

            .customer-details-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 12px;
            }

            .customer-detail-item {
                padding: 13px 15px;
                background: #f8faf8;
                border: 1px solid #edf2ee;
                border-radius: 10px;
            }

                .customer-detail-item span {
                    display: flex;
                    align-items: center;
                    gap: 6px;
                    color: #87928b;
                    font-size: 10px;
                    margin-bottom: 5px;
                }

                    .customer-detail-item span i {
                        color: #579368;
                        font-size: 11px;
                    }

                .customer-detail-item strong {
                    display: block;
                    color: #2b3c31;
                    font-size: 12px;
                    font-weight: 600;
                    word-break: break-word;
                }


            /* PICKUP DETAILS */

            .customer-pickup-details {
                display: grid;
                grid-template-columns: 1.4fr 1fr 1fr;
                gap: 12px;
                margin-top: 12px;
                padding: 15px;
                background: #f3f8f4;
                border: 1px solid #dfece2;
                border-radius: 11px;
            }

            .customer-pickup-item {
                display: flex;
                align-items: flex-start;
                gap: 9px;
            }

                .customer-pickup-item > i {
                    color: #579368;
                    font-size: 15px;
                    margin-top: 2px;
                }

                .customer-pickup-item span {
                    display: block;
                    color: #89948d;
                    font-size: 10px;
                    margin-bottom: 4px;
                }

                .customer-pickup-item strong {
                    display: block;
                    color: #2c3d32;
                    font-size: 11px;
                    line-height: 1.4;
                }


            /* =========================================================
               CUSTOMER DETAILS RESPONSIVE
            ========================================================= */

            @@media (max-width: 700px) {

                .customer-details-grid {
                    grid-template-columns: 1fr;
                }

                .customer-pickup-details {
                    grid-template-columns: 1fr;
                }
            }

            @@media (max-width: 430px) {

                .customer-order-details {
                    margin-top: 18px;
                    padding-top: 18px;
                }

                .customer-detail-item {
                    padding: 12px;
                }

                .customer-pickup-details {
                    padding: 13px;
                }
            }

            /* =========================================================
                       PRODUCTS
                    ========================================================= */

            .history-products {
                display: flex;
                flex-direction: column;
                gap: 13px;
            }

            .history-product {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .history-product-image {
                width: 55px;
                height: 55px;
                flex-shrink: 0;
                border-radius: 11px;
                overflow: hidden;
                background: #edf5ef;
            }

                .history-product-image img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

            .history-product-info {
                min-width: 0;
            }

                .history-product-info h4 {
                    color: #29392f;
                    font-size: 13px;
                    font-weight: 600;
                    margin-bottom: 4px;
                }

                .history-product-info p {
                    color: #87928b;
                    font-size: 11px;
                    margin: 0;
                }


            /* =========================================================
                       ORDER TOTAL
                    ========================================================= */

            .history-total {
                text-align: right;
                min-width: 130px;
            }

                .history-total span {
                    display: block;
                    color: #8a958e;
                    font-size: 11px;
                    margin-bottom: 5px;
                }

                .history-total strong {
                    display: block;
                    color: #267542;
                    font-size: 20px;
                }


            /* =========================================================
                       ORDER FOOTER
                    ========================================================= */

            .history-card-footer {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 20px;
                padding: 16px 24px;
                background: #fafcf9;
                border-top: 1px solid #edf1ee;
            }

            .pickup-preview {
                display: flex;
                align-items: center;
                gap: 8px;
                color: #66746c;
                font-size: 11px;
            }

                .pickup-preview i {
                    color: #579368;
                    font-size: 14px;
                }

            .view-order-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                min-height: 38px;
                padding: 0 15px;
                border-radius: 9px;
                background: white;
                border: 1px solid #d4e2d8;
                color: #267542;
                font-size: 11px;
                font-weight: 700;
                transition: 0.2s ease;
            }

                .view-order-btn:hover {
                    background: #eaf7ed;
                    color: #267542;
                    border-color: #c3d9c9;
                }


            /* =========================================================
                       EMPTY STATE
                    ========================================================= */

            .empty-orders {
                display: none;
                background: white;
                border-radius: 18px;
                padding: 55px 25px;
                text-align: center;
                box-shadow: 0 12px 40px rgba(30, 60, 42, 0.06);
            }

            .empty-orders-icon {
                width: 68px;
                height: 68px;
                margin: 0 auto 18px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #eaf7ed;
                color: #267542;
                font-size: 28px;
            }

            .empty-orders h3 {
                color: #24362b;
                font-size: 21px;
                margin-bottom: 8px;
            }

            .empty-orders p {
                max-width: 480px;
                margin: 0 auto 20px;
                color: #7c8881;
                font-size: 13px;
                line-height: 1.7;
            }

            .shop-now-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                min-height: 45px;
                padding: 0 20px;
                border-radius: 10px;
                background: #267542;
                color: white;
                font-size: 12px;
                font-weight: 700;
                transition: 0.2s ease;
            }

                .shop-now-btn:hover {
                    background: #1d6135;
                    color: white;
                    transform: translateY(-1px);
                }


            /* =========================================================
                       RESPONSIVE
                    ========================================================= */

            @@media (max-width: 900px) {

                .orders-hero {
                    min-height: 350px;
                }

                    .orders-hero h1 {
                        font-size: 40px;
                    }

                .orders-overview {
                    grid-template-columns: 1fr;
                }

                .history-main {
                    grid-template-columns: 1fr;
                }

                .history-total {
                    text-align: left;
                }
            }


            @@media (max-width: 650px) {

                .orders-hero {
                    min-height: 330px;
                    background-attachment: scroll;
                }

                .orders-hero-container {
                    padding: 55px 22px;
                }

                .orders-hero h1 {
                    font-size: 34px;
                }

                .orders-hero-description {
                    font-size: 14px;
                }

                .orders-content {
                    padding: 0 15px 55px;
                    margin-top: -35px;
                }

                .orders-section-header {
                    align-items: flex-start;
                    flex-direction: column;
                    gap: 14px;
                }

                .orders-filter {
                    width: 100%;
                }

                    .orders-filter select {
                        width: 100%;
                    }

                .history-card-header {
                    align-items: flex-start;
                    flex-direction: column;
                    padding: 19px;
                }

                .history-card-body {
                    padding: 19px;
                }

                .history-card-footer {
                    align-items: flex-start;
                    flex-direction: column;
                    padding: 15px 19px;
                }

                .view-order-btn {
                    width: 100%;
                }

                .pickup-preview {
                    line-height: 1.5;
                }
            }


            @@media (max-width: 430px) {

                .orders-hero h1 {
                    font-size: 30px;
                }

                .overview-card {
                    padding: 18px;
                }

                .history-product-image {
                    width: 48px;
                    height: 48px;
                }

                .history-product-info h4 {
                    font-size: 12px;
                }

                .history-total strong {
                    font-size: 18px;
                }
            }

    </style>

</head>

<body>

    <div class="orders-page">


        <!-- =========================================================
         HERO
    ========================================================== -->

        <section class="orders-hero">

            <div class="orders-hero-pattern"></div>

            <div class="orders-hero-container">

                <div class="orders-breadcrumb">

                    <a href="/">
                        Home
                    </a>

                    <i class="bi bi-chevron-right"></i>

                    <a href="/Order/Index">
                        Order Confirmation
                    </a>

                    <i class="bi bi-chevron-right"></i>

                    <span>
                        My Orders
                    </span>

                </div>


                <span class="orders-hero-badge">

                    <i class="bi bi-clock-history"></i>

                    ORDER HISTORY

                </span>


                <h1>
                    My <span>Orders.</span>
                </h1>


                <p class="orders-hero-description">

                    Keep track of your MarketLink pre-orders,
                    pickup details, order status, and previous purchases
                    from local farmers.

                </p>

            </div>

        </section>



        <!-- =========================================================
         MAIN CONTENT
    ========================================================== -->

        <main class="orders-content">


            <!-- =====================================================
             OVERVIEW
        ====================================================== -->

            <section class="orders-overview">


                <div class="overview-card">

                    <div class="overview-icon">

                        <i class="bi bi-bag-check-fill"></i>

                    </div>

                    <div class="overview-info">

                        <span>
                            Total Orders
                        </span>

                        <strong>
                            3
                        </strong>

                    </div>

                </div>


                <div class="overview-card">

                    <div class="overview-icon">

                        <i class="bi bi-hourglass-split"></i>

                    </div>

                    <div class="overview-info">

                        <span>
                            Active Orders
                        </span>

                        <strong>
                            1
                        </strong>

                    </div>

                </div>


                <div class="overview-card">

                    <div class="overview-icon">

                        <i class="bi bi-check2-circle"></i>

                    </div>

                    <div class="overview-info">

                        <span>
                            Completed
                        </span>

                        <strong>
                            2
                        </strong>

                    </div>

                </div>

            </section>



            <!-- =====================================================
             SECTION HEADER
        ====================================================== -->

            <div class="orders-section-header">

                <div class="orders-section-title">

                    <div class="orders-section-title-icon">

                        <i class="bi bi-receipt"></i>

                    </div>

                    <div>

                        <h2>
                            Your Orders
                        </h2>

                        <p>
                            Recent and previous pre-orders
                        </p>

                    </div>

                </div>


                <div class="orders-filter">

                    <select id="orderFilter">

                        <option value="all">
                            All Orders
                        </option>

                        <option value="confirmed">
                            Confirmed
                        </option>

                        <option value="pending">
                            Pending
                        </option>

                        <option value="completed">
                            Completed
                        </option>

                    </select>

                </div>

            </div>



            <!-- =====================================================
             ORDER 1
        ====================================================== -->

            <article class="order-history-card"
                     data-status="confirmed">


                <div class="history-card-header">

                    <div class="history-order-info">

                        <div class="history-order-icon">

                            <i class="bi bi-basket3-fill"></i>

                        </div>

                        <div>

                            <h3>
                                Order #ML-2026-00125
                            </h3>

                            <p>
                                Placed on 26 September 2026
                            </p>

                        </div>

                    </div>


                    <span class="order-status status-confirmed">

                        <i class="bi bi-check-circle-fill"></i>

                        Confirmed

                    </span>

                </div>



                <div class="history-card-body">

                    <div class="history-main">


                        <div class="history-products">


                            <div class="history-product">

                                <div class="history-product-image">

                                    <img src="/images/products/tomatoes.jpg"
                                         alt="Fresh Tomatoes" />

                                </div>

                                <div class="history-product-info">

                                    <h4>
                                        Fresh Tomatoes
                                    </h4>

                                    <p>
                                        2 kg × Rs. 250 / kg
                                    </p>

                                </div>

                            </div>


                            <div class="history-product">

                                <div class="history-product-image">

                                    <img src="/images/products/apples.jpg"
                                         alt="Fresh Apples" />

                                </div>

                                <div class="history-product-info">

                                    <h4>
                                        Fresh Apples
                                    </h4>

                                    <p>
                                        1 kg × Rs. 450 / kg
                                    </p>

                                </div>

                            </div>


                            <div class="history-product">

                                <div class="history-product-image">

                                    <img src="/images/products/spinach.jpg"
                                         alt="Fresh Spinach" />

                                </div>

                                <div class="history-product-info">

                                    <h4>
                                        Fresh Spinach
                                    </h4>

                                    <p>
                                        2 bunches × Rs. 100
                                    </p>

                                </div>

                            </div>


                        </div>


                        <div class="history-total">

                            <span>
                                Order Total
                            </span>

                            <strong>
                                Rs. 1,150
                            </strong>

                        </div>

                    </div>
                    <!-- =====================================================
     CUSTOMER DETAILS
====================================================== -->

                    <div class="customer-order-details">

                        <div class="customer-details-heading">

                            <div class="customer-details-icon">
                                <i class="bi bi-person-vcard"></i>
                            </div>

                            <div>
                                <h4>Customer Details</h4>
                                <p>Information provided for this order</p>
                            </div>

                        </div>


                        <div class="customer-details-grid">

                            <div class="customer-detail-item">

                                <span>
                                    <i class="bi bi-person"></i>
                                    Customer Name
                                </span>

                                <strong>
                                    Hooriya Jameel
                                </strong>

                            </div>


                            <div class="customer-detail-item">

                                <span>
                                    <i class="bi bi-envelope"></i>
                                    Email Address
                                </span>

                                <strong>
                                    hooriya@example.com
                                </strong>

                            </div>


                            <div class="customer-detail-item">

                                <span>
                                    <i class="bi bi-telephone"></i>
                                    Phone Number
                                </span>

                                <strong>
                                    +92 300 1234567
                                </strong>

                            </div>


                            <div class="customer-detail-item">

                                <span>
