@model MarketLink.ViewModels.FarmerOrderDetailsViewModel

@{
    ViewData["Title"] = "Order Details";
    Layout = "~/Views/Shared/_FarmerDashboardLayout.cshtml";

    var pickupStart =
        Model.PickupStartTime.HasValue
            ? DateTime.Today
                .Add(Model.PickupStartTime.Value)
                .ToString("hh:mm tt")
            : "";

    var pickupEnd =
        Model.PickupEndTime.HasValue
            ? DateTime.Today
                .Add(Model.PickupEndTime.Value)
                .ToString("hh:mm tt")
            : "";
}

<section class="details-header">

    <div>
        <span class="details-label">
            <i class="bi bi-receipt"></i>
            ORDER DETAILS
        </span>

        <h2>@Model.OrderNo</h2>

        <p>
            Placed @Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt")
        </p>
    </div>

    <a asp-controller="FarmerOrders"
       asp-action="Index"
       class="back-link">
        <i class="bi bi-arrow-left"></i>
        Back to Orders
    </a>

</section>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-warning">
        @TempData["ErrorMessage"]
    </div>
}

<div class="order-status-banner">

    <div>
        <span>Current Status</span>

        <strong>
            @Model.OrderStatus
        </strong>
    </div>

    <div>
        <span>Order Total</span>

        <strong>
            Rs. @Model.TotalAmount.ToString("N2")
        </strong>
    </div>

</div>

<div class="details-grid">

    <section class="details-card">

        <div class="card-heading">
            <span>ORDER ITEMS</span>
            <h3>Products</h3>
        </div>

        <div class="items-table-wrap">

            <table class="items-table">

                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Qty</th>
                        <th>Unit Price</th>
                        <th>Total</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <strong>@item.ProductName</strong>
                                <span>@item.UnitName</span>
                            </td>

                            <td>
                                @item.Quantity.ToString("N3")
                            </td>

                            <td>
                                Rs. @item.UnitPrice.ToString("N2")
                            </td>

                            <td>
                                <strong>
                                    Rs. @item.TotalPrice.ToString("N2")
                                </strong>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </section>

    <aside class="side-column">

        <section class="details-card">

            <div class="card-heading">
                <span>CUSTOMER</span>
                <h3>Customer Details</h3>
            </div>

            <div class="info-list">

                <div>
                    <span>Name</span>
                    <strong>@Model.CustomerName</strong>
                </div>

                <div>
                    <span>Email</span>
                    <strong>@Model.CustomerEmail</strong>
                </div>

                <div>
                    <span>Phone</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.CustomerPhone)
                            ? "Not provided"
                            : Model.CustomerPhone)
                    </strong>
                </div>

            </div>

        </section>

        <section class="details-card">

            <div class="card-heading">
                <span>PICKUP</span>
                <h3>Pickup Details</h3>
            </div>

            <div class="info-list">

                <div>
                    <span>Market</span>
                    <strong>@Model.MarketName</strong>
                </div>

                <div>
                    <span>Stall</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.StallNumber)
                            ? "Not set"
                            : Model.StallNumber)
                    </strong>
                </div>

                <div>
                    <span>Date</span>
                    <strong>
                        @Model.PickupDate.ToString("dddd, dd MMM yyyy")
                    </strong>
                </div>

                <div>
                    <span>Time</span>
                    <strong>
                        @if (!string.IsNullOrWhiteSpace(pickupStart))
                        {
                            @pickupStart

                            if (!string.IsNullOrWhiteSpace(pickupEnd))
                            {
                                @: - @pickupEnd
                            }
                        }
                        else
                        {
                            @:Not set
                        }
                    </strong>
                </div>

            </div>

        </section>

    </aside>

</div>

@if (!string.IsNullOrWhiteSpace(Model.CustomerNotes))
{
    <section class="notes-card">
        <span>CUSTOMER NOTES</span>
        <p>@Model.CustomerNotes</p>
    </section>
}

<section class="action-card">

    <div class="card-heading">
        <span>ORDER ACTION</span>
        <h3>Update Order</h3>
    </div>

    @if (Model.OrderStatus == "Placed")
    {
        <div class="action-grid">

            <form asp-controller="FarmerOrders"
                  asp-action="Accept"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="OrderId"
                       value="@Model.OrderId" />

                <label>Farmer Notes (optional)</label>

                <textarea name="FarmerNotes"
                          class="form-control"
                          rows="3"
                          placeholder="Notes for this order"></textarea>

                <button type="submit"
                        class="action-btn accept">
                    <i class="bi bi-check-lg"></i>
                    Accept Order
                </button>

            </form>

            <form asp-controller="FarmerOrders"
                  asp-action="Decline"
                  method="post"
                  onsubmit="return confirm('Decline this order and release its reserved inventory?');">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="OrderId"
                       value="@Model.OrderId" />

                <label>Reason / Notes</label>

                <textarea name="FarmerNotes"
                          class="form-control"
                          rows="3"
                          placeholder="Reason for declining"></textarea>

                <button type="submit"
                        class="action-btn decline">
                    <i class="bi bi-x-lg"></i>
                    Decline Order
                </button>

            </form>

        </div>
    }
    else if (Model.OrderStatus == "Accepted")
    {
        <form asp-controller="FarmerOrders"
              asp-action="MarkReady"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="OrderId"
                   value="@Model.OrderId" />

            <label>Farmer Notes (optional)</label>

            <textarea name="FarmerNotes"
                      class="form-control"
                      rows="3"
                      placeholder="Pickup or preparation notes"></textarea>

            <button type="submit"
                    class="action-btn ready">
                <i class="bi bi-bag-check"></i>
                Mark Ready for Pickup
            </button>

        </form>
    }
    else if (Model.OrderStatus == "Ready for Pickup")
    {
        <form asp-controller="FarmerOrders"
              asp-action="Complete"
              method="post"
              onsubmit="return confirm('Confirm that the customer collected this order?');">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="OrderId"
                   value="@Model.OrderId" />

            <label>Farmer Notes (optional)</label>

            <textarea name="FarmerNotes"
                      class="form-control"
                      rows="3"
                      placeholder="Optional completion notes"></textarea>

            <button type="submit"
                    class="action-btn complete">
                <i class="bi bi-check-circle"></i>
                Mark Completed
            </button>

        </form>
    }
    else
    {
        <div class="no-action">
            No further farmer action is required for this order.
        </div>
    }

</section>

<section class="details-card timeline-card">

    <div class="card-heading">
        <span>ORDER HISTORY</span>
        <h3>Status Timeline</h3>
    </div>

    @if (!Model.History.Any())
    {
        <div class="timeline-empty">
            No status history has been recorded yet.
        </div>
    }
    else
    {
        <div class="timeline">

            @foreach (var item in Model.History)
            {
                <div class="timeline-item">

                    <div class="timeline-dot"></div>

                    <div>
                        <strong>
                            @item.PreviousStatus → @item.NewStatus
                        </strong>

                        <span>
                            @item.ChangedAt.ToString("dd MMM yyyy, hh:mm tt")
                            · @item.ChangedByName
                        </span>

                        @if (!string.IsNullOrWhiteSpace(item.Remarks))
                        {
                            <p>@item.Remarks</p>
                        }
                    </div>

                </div>
            }

        </div>
    }

</section>

@section Styles {
<style>
.details-header{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:20px}
.details-label{color:#14836f;font-size:12px;font-weight:800;letter-spacing:.08em}
.details-header h2{margin:7px 0 5px;font-size:28px;font-weight:800}
.details-header p{margin:0;color:#667085}
.back-link{text-decoration:none;color:#475467;font-size:13px;font-weight:700}
.order-status-banner{display:flex;justify-content:space-between;gap:20px;background:#172033;color:#fff;border-radius:16px;padding:18px 20px;margin-bottom:18px}
.order-status-banner span{display:block;color:#b9c1cc;font-size:10px;text-transform:uppercase;font-weight:800}
.order-status-banner strong{display:block;margin-top:3px;font-size:20px}
.details-grid{display:grid;grid-template-columns:1.4fr .7fr;gap:18px}
.side-column{display:grid;gap:18px}
.details-card,.notes-card,.action-card{background:#fff;border:1px solid #e7ebef;border-radius:16px;overflow:hidden}
.card-heading{padding:15px 17px;border-bottom:1px solid #edf0f4}
.card-heading span{color:#13836e;font-size:10px;font-weight:800;letter-spacing:.08em}
.card-heading h3{margin:3px 0 0;font-size:16px;font-weight:800}
.items-table-wrap{overflow:auto}
.items-table{width:100%;border-collapse:collapse}
.items-table th{padding:11px 14px;background:#f8fafc;color:#667085;font-size:10px;text-transform:uppercase}
.items-table td{padding:14px;border-top:1px solid #edf0f4;font-size:12px}
.items-table td span{display:block;color:#98a2b3;font-size:10px}
.info-list{padding:5px 17px}
.info-list>div{padding:10px 0;border-bottom:1px solid #edf0f4}
.info-list span{display:block;color:#98a2b3;font-size:9px;text-transform:uppercase;font-weight:800}
.info-list strong{display:block;margin-top:3px;color:#344054;font-size:12px}
.notes-card{padding:16px;margin-top:18px}
.notes-card span{color:#13836e;font-size:10px;font-weight:800}
.notes-card p{margin:6px 0 0;color:#475467}
.action-card{margin-top:18px;padding-bottom:17px}
.action-card form{padding:17px}
.action-card label{display:block;margin-bottom:6px;color:#344054;font-size:11px;font-weight:800}
.action-grid{display:grid;grid-template-columns:1fr 1fr}
.action-grid form+form{border-left:1px solid #edf0f4}
.action-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;margin-top:10px;width:100%;border:0;padding:10px 13px;border-radius:9px;font-weight:700}
.action-btn.accept,.action-btn.complete{background:#13836e;color:#fff}
.action-btn.ready{background:#175cd3;color:#fff}
.action-btn.decline{background:#fff1f0;color:#b42318;border:1px solid #f3c8c5}
.no-action{padding:22px;color:#667085;text-align:center}
.timeline-card{margin-top:18px}
.timeline{padding:17px}
.timeline-item{position:relative;display:grid;grid-template-columns:18px 1fr;gap:10px;padding-bottom:18px}
.timeline-item:not(:last-child):before{content:"";position:absolute;left:6px;top:13px;bottom:0;width:2px;background:#e7ebef}
.timeline-dot{width:14px;height:14px;border-radius:50%;background:#13836e;margin-top:2px;z-index:2}
.timeline-item strong{display:block;font-size:12px}
.timeline-item span{display:block;color:#98a2b3;font-size:10px;margin-top:2px}
.timeline-item p{margin:6px 0 0;color:#667085;font-size:11px}
.timeline-empty{padding:30px;color:#667085;text-align:center}
@@media(max-width:900px){.details-grid{grid-template-columns:1fr}}
@@media(max-width:650px){.details-header{align-items:flex-start;flex-direction:column}.order-status-banner{flex-direction:column}.action-grid{grid-template-columns:1fr}.action-grid form+form{border-left:0;border-top:1px solid #edf0f4}}
</style>
}
