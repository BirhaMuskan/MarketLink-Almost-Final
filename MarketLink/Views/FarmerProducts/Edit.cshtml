@model MarketLink.ViewModels.EditFarmerProductViewModel

@{
    ViewData["Title"] = "Edit Product";
    Layout = "~/Views/Shared/_FarmerDashboardLayout.cshtml";
}

<section class="product-form-header">
    <div>
        <span class="products-page-label">
            <i class="bi bi-basket"></i>
            PRODUCTS & STOCK
        </span>
        <h2>Edit Product</h2>
        <p>Update product information, stock, price or availability.</p>
    </div>

    <a asp-controller="FarmerProducts"
       asp-action="Index"
       class="product-back-link">
        <i class="bi bi-arrow-left"></i>
        Back to Products
    </a>
</section>

<section class="product-form-card">

    <form asp-controller="FarmerProducts"
          asp-action="Edit"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <input asp-for="FarmerProductId" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="product-form-grid">

            <div class="product-form-field">
                <label asp-for="ProductName"></label>
                <input asp-for="ProductName"
                       class="form-control"
                       placeholder="e.g. Fresh Tomatoes" />
                <span asp-validation-for="ProductName"
                      class="text-danger"></span>
            </div>

            <div class="product-form-field">
                <label asp-for="CategoryId">Category</label>
                <select asp-for="CategoryId"
                        asp-items="Model.Categories"
                        class="form-select">
                    <option value="0">Select category</option>
                </select>
                <span asp-validation-for="CategoryId"
                      class="text-danger"></span>
            </div>

            <div class="product-form-field">
                <label asp-for="UnitOfMeasureId">Unit</label>
                <select asp-for="UnitOfMeasureId"
                        asp-items="Model.Units"
                        class="form-select">
                    <option value="0">Select unit</option>
                </select>
                <span asp-validation-for="UnitOfMeasureId"
                      class="text-danger"></span>
            </div>

            <div class="product-form-field">
                <label asp-for="FarmerMarketId">Market</label>
                <select asp-for="FarmerMarketId"
                        asp-items="Model.Markets"
                        class="form-select">
                    <option value="0">Select market</option>
                </select>
                <span asp-validation-for="FarmerMarketId"
                      class="text-danger"></span>
            </div>

            <div class="product-form-field">
                <label asp-for="Price">Selling Price</label>
                <div class="price-input-wrap">
                    <span>Rs.</span>
                    <input asp-for="Price"
                           type="number"
                           step="0.01"
                           min="0.01"
                           class="form-control" />
                </div>
                <span asp-validation-for="Price"
                      class="text-danger"></span>
            </div>

            <div class="product-form-field">
                <label asp-for="StockQuantity">
                    Quantity Available
                </label>
                <input asp-for="StockQuantity"
                       type="number"
                       step="0.001"
                       min="0"
                       class="form-control" />
                <span asp-validation-for="StockQuantity"
                      class="text-danger"></span>
            </div>

        </div>

        <div class="product-form-field full">
            <label asp-for="Description"></label>
            <textarea asp-for="Description"
                      rows="4"
                      class="form-control"
                      placeholder="Describe the product..."></textarea>
        </div>

        <div class="product-form-field full">
            <label asp-for="ImageFile">Product Image</label>

            @if (!string.IsNullOrWhiteSpace(Model.ExistingImageUrl))
            {
                <img src="@Model.ExistingImageUrl"
                     class="existing-product-image"
                     alt="Current product image" />
            }

            <input asp-for="ImageFile"
                   type="file"
                   accept=".jpg,.jpeg,.png,.webp"
                   class="form-control" />

            <small class="form-help">
                JPG, PNG or WEBP. Maximum 5 MB.
            </small>

            <span asp-validation-for="ImageFile"
                  class="text-danger"></span>
        </div>

        <div class="availability-box">
            <label>
                <input asp-for="IsAvailable" />
                <span>Available for customers</span>
            </label>
        </div>

        <div class="srs-note">
            <i class="bi bi-info-circle"></i>
            <span>
                Farmer product listings do not require mandatory
                admin pre-approval. Admin can moderate/remove
                inappropriate listings.
            </span>
        </div>

        <div class="product-form-actions">
            <a asp-controller="FarmerProducts"
               asp-action="Index"
               class="btn btn-light">
                Cancel
            </a>

            <button type="submit"
                    class="farmer-primary-button border-0">
                <i class="bi bi-check-lg"></i>
                Save Changes
            </button>
        </div>

    </form>
</section>

@section Styles {
<style>
.product-form-header{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:22px}
.products-page-label{color:#14836f;font-size:12px;font-weight:800;letter-spacing:.08em}
.product-form-header h2{margin:7px 0 5px;font-size:28px;font-weight:800}
.product-form-header p{margin:0;color:#667085}
.product-back-link{text-decoration:none;color:#475467;font-weight:700;font-size:13px}
.product-form-card{background:#fff;border:1px solid #e7ebef;border-radius:18px;padding:24px;box-shadow:0 10px 30px rgba(16,24,40,.06)}
.product-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.product-form-field{margin-bottom:18px}
.product-form-field label{display:block;margin-bottom:7px;color:#344054;font-size:12px;font-weight:800}
.price-input-wrap{position:relative}
.price-input-wrap>span{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#667085;font-size:13px;z-index:2}
.price-input-wrap input{padding-left:42px}
.form-help{display:block;margin-top:6px;color:#98a2b3;font-size:11px}
.availability-box{padding:12px 14px;background:#f8fafc;border:1px solid #e7ebef;border-radius:11px;margin-top:4px}
.availability-box label{display:flex;align-items:center;gap:9px;margin:0}
.srs-note{display:flex;gap:9px;padding:12px 14px;border-radius:11px;background:#eff8ff;color:#175cd3;font-size:12px;margin-top:14px}
.product-form-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:22px;padding-top:18px;border-top:1px solid #edf0f3}
.existing-product-image{width:110px;height:110px;object-fit:cover;border-radius:12px;margin-bottom:10px;display:block}
@@media(max-width:700px){.product-form-header{align-items:flex-start;flex-direction:column}.product-form-grid{grid-template-columns:1fr;gap:0}}
</style>
}
