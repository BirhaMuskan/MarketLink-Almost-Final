@model MarketLink.ViewModels.FarmerProductsPageViewModel

@{
    ViewData["Title"] = "My Products";
    Layout = "~/Views/Shared/_FarmerDashboardLayout.cshtml";
}

<section class="farmer-products-header">
    <div>
        <span class="products-page-label">
            <i class="bi bi-basket"></i>
            PRODUCTS & STOCK
        </span>

        <h2>My Products</h2>

        <p>
            Add, edit, remove and manage the stock availability
            of the products you sell.
        </p>
    </div>

    <a asp-controller="FarmerProducts"
       asp-action="Create"
       class="farmer-primary-button">
        <i class="bi bi-plus-lg"></i>
        Add Product
    </a>
</section>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<section class="product-summary-grid">
    <div class="product-summary-card">
        <span>Total Products</span>
        <strong>@Model.TotalProducts</strong>
    </div>

    <div class="product-summary-card">
        <span>Available</span>
        <strong>@Model.AvailableProducts</strong>
    </div>

    <div class="product-summary-card">
        <span>Sold Out</span>
        <strong>@Model.SoldOutProducts</strong>
    </div>

    <div class="product-summary-card">
        <span>Total Available Qty</span>
        <strong>@Model.TotalAvailableQuantity.ToString("N2")</strong>
    </div>
</section>

<section class="product-management-card">

    <div class="product-toolbar">
        <div class="product-search">
            <i class="bi bi-search"></i>
            <input type="text"
                   id="productSearch"
                   placeholder="Search your products..." />
        </div>
    </div>

    @if (!Model.Products.Any())
    {
        <div class="product-empty-state">
            <i class="bi bi-basket"></i>
            <h3>No products yet</h3>
            <p>Add your first weekly-stock product.</p>

            <a asp-controller="FarmerProducts"
               asp-action="Create"
               class="farmer-primary-button">
                Add Product
            </a>
        </div>
    }
    else
    {
        <div class="product-list">

            @foreach (var item in Model.Products)
            {
                <article class="product-list-row"
                         data-search="@($"{item.ProductName} {item.CategoryName}".ToLowerInvariant())">

                    <div class="product-image">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl"
                                 alt="@item.ProductName" />
                        }
                        else
                        {
                            <i class="bi bi-image"></i>
                        }
                    </div>

                    <div>
                        <div class="product-title-row">
                            <div>
                                <h3>@item.ProductName</h3>
                                <span>
                                    @item.CategoryName · @item.UnitName
                                </span>
                            </div>

                            <div class="product-statuses">
                                @if (!item.IsActive)
                                {
                                    <span class="product-status inactive">
                                        Removed
                                    </span>
                                }
                                else if (item.IsSoldOut)
                                {
                                    <span class="product-status soldout">
                                        Sold Out
                                    </span>
                                }
                                else if (!item.IsAvailable)
                                {
                                    <span class="product-status unavailable">
                                        Unavailable
                                    </span>
                                }
                                else
                                {
                                    <span class="product-status available">
                                        Available
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="product-meta">
                            <div>
                                <span>Price</span>
                                <strong>Rs. @item.Price.ToString("N2")</strong>
                            </div>

                            <div>
                                <span>Available Quantity</span>
                                <strong>
                                    @item.AvailableQuantity.ToString("N3")
                                    @item.UnitName
                                </strong>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.FarmerDescription))
                        {
                            <p class="product-description">
                                @item.FarmerDescription
                            </p>
                        }
                    </div>

                    <div class="product-actions">

                        @if (item.IsActive)
                        {
                            <a asp-controller="FarmerProducts"
                               asp-action="Edit"
                               asp-route-id="@item.FarmerProductId"
                               class="product-action-btn">
                                <i class="bi bi-pencil"></i>
                                Edit
                            </a>

                            <form asp-controller="FarmerProducts"
                                  asp-action="ToggleAvailability"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@item.FarmerProductId" />

                                <button type="submit"
                                        class="product-action-btn">
                                    @(item.IsAvailable
                                        ? "Mark Unavailable"
                                        : "Make Available")
                                </button>
                            </form>

                            <form asp-controller="FarmerProducts"
                                  asp-action="Delete"
                                  method="post"
                                  onsubmit="return confirm('Remove this product from your active catalogue?');">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@item.FarmerProductId" />

                                <button type="submit"
                                        class="product-action-btn danger">
                                    Remove
                                </button>
                            </form>
                        }

                    </div>

                </article>
            }

        </div>
    }

</section>

@section Styles {
<style>
.farmer-products-header{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:22px}
.products-page-label{color:#14836f;font-size:12px;font-weight:800;letter-spacing:.08em}
.farmer-products-header h2{margin:7px 0 5px;font-size:28px;font-weight:800}
.farmer-products-header p{margin:0;color:#667085}
.product-summary-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:18px}
.product-summary-card{background:#fff;border:1px solid #e7ebef;border-radius:16px;padding:17px}
.product-summary-card span{display:block;color:#667085;font-size:12px}
.product-summary-card strong{display:block;margin-top:4px;font-size:27px}
.product-management-card{background:#fff;border:1px solid #e7ebef;border-radius:18px;overflow:hidden}
.product-toolbar{padding:15px 17px;border-bottom:1px solid #edf0f4}
.product-search{max-width:460px;position:relative}
.product-search i{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#98a2b3}
.product-search input{width:100%;padding:10px 12px 10px 40px;border:1px solid #d8dee6;border-radius:11px}
.product-list{padding:12px}
.product-list-row{display:grid;grid-template-columns:90px 1fr auto;gap:16px;align-items:center;padding:15px;border:1px solid #e8ebef;border-radius:14px;margin-bottom:10px}
.product-image{width:90px;height:90px;border-radius:12px;background:#f2f5f3;overflow:hidden;display:grid;place-items:center}
.product-image img{width:100%;height:100%;object-fit:cover}
.product-title-row{display:flex;justify-content:space-between;gap:12px}
.product-title-row h3{margin:0;font-size:17px;font-weight:800}
.product-title-row span{color:#667085;font-size:12px}
.product-statuses{display:flex;gap:5px}
.product-status{padding:5px 8px;border-radius:999px;font-size:10px;font-weight:800}
.product-status.available{background:#dcfae6;color:#067647}
.product-status.soldout{background:#fee4e2;color:#b42318}
.product-status.unavailable,.product-status.inactive{background:#f2f4f7;color:#475467}
.product-meta{display:flex;gap:28px;margin-top:13px}
.product-meta span{display:block;font-size:10px;color:#98a2b3;text-transform:uppercase;font-weight:800}
.product-meta strong{font-size:13px}
.product-description{color:#667085;font-size:12px;margin:10px 0 0}
.product-actions{display:flex;flex-direction:column;gap:7px;min-width:150px}
.product-action-btn{width:100%;border:1px solid #d9dfe5;background:#fff;color:#344054;padding:8px 10px;border-radius:9px;text-decoration:none;font-size:12px;font-weight:700;text-align:center}
.product-action-btn.danger{color:#b42318;border-color:#f3c8c5}
.product-empty-state{text-align:center;padding:70px 20px}
.product-empty-state>i{font-size:35px;color:#13836e}
@@media(max-width:1000px){.product-summary-grid{grid-template-columns:repeat(2,1fr)}.product-list-row{grid-template-columns:75px 1fr}.product-actions{grid-column:1/-1;flex-direction:row}}
@@media(max-width:650px){.farmer-products-header{align-items:stretch;flex-direction:column}.product-summary-grid{grid-template-columns:1fr 1fr}.product-list-row{grid-template-columns:1fr}.product-image{width:100%;height:180px}.product-title-row{flex-direction:column}.product-actions{flex-direction:column}}
</style>
}

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    const search = document.getElementById("productSearch");
    const rows = document.querySelectorAll(".product-list-row");

    search?.addEventListener("input", function () {
        const value = search.value.trim().toLowerCase();

        rows.forEach(row => {
            row.style.display =
                (row.dataset.search || "").includes(value)
                    ? ""
                    : "none";
        });
    });
});
</script>
}
