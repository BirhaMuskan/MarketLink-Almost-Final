</section>



<!-- =========================================
     CTA
========================================= -->

<section class="products-cta">

    <div class="container">

        <div class="products-cta-content">

            <div>

                <span>
                    CONNECT WITH LOCAL FARMERS
                </span>

                <h2>
                    Fresh products are closer than you think.
                </h2>

                <p>
                    Explore local markets and discover
                    quality products from trusted farmers.
                </p>

            </div>


            <div class="products-cta-buttons">

                <a asp-controller="Markets"
                   asp-action="Index"
                   class="products-cta-outline">

                    <i class="bi bi-shop"></i>

                    Explore Markets

                </a>


                <a asp-controller="Home"
                   asp-action="Index"
                   class="products-cta-primary">

                    Go to Home

                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

        </div>

    </div>

</section>



<!-- =========================================
     PAGE CSS
========================================= -->
@section Styles {

    <style>

        /* =========================================================
           MARKETLINK - PRODUCTS BANNER HERO
           Same Design as Markets / Market Details Banner
        ========================================================= */

        .products-banner-hero {
            position: relative;
            width: calc(100% - 56px);
            min-height: 440px;
            margin: 20px auto 0;
            overflow: hidden;
            border-radius: 0 0 28px 28px;
            background: #174d32;
            isolation: isolate;
        }


        /* =========================================================
           BACKGROUND IMAGE
        ========================================================= */

        .products-banner-image {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            /*
               Different image from Markets page
               Fresh fruits and vegetables
            */
            background-image: url("https://images.unsplash.com/photo-1610832958506-aa56368176cf?auto=format&fit=crop&w=1800&q=85");
            background-size: cover;
            background-position: center;
            /*
               Fixed background while scrolling
            */
            background-attachment: fixed;
            z-index: -3;
        }


        /* =========================================================
           DARK GREEN OVERLAY
        ========================================================= */

        .products-banner-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient( 90deg, rgba(0, 66, 40, 0.96) 0%, rgba(0, 77, 45, 0.88) 28%, rgba(0, 78, 46, 0.58) 55%, rgba(0, 55, 34, 0.20) 100% );
            z-index: -2;
        }


        /* =========================================================
           SOFT OVERLAY
        ========================================================= */

        .products-banner-hero::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient( 180deg, rgba(255,255,255,0.02), rgba(0,0,0,0.08) );
            pointer-events: none;
            z-index: -1;
        }


        /* =========================================================
           CONTAINER
        ========================================================= */

        .products-banner-hero .container {
            position: relative;
            min-height: 440px;
            display: flex;
            align-items: center;
            z-index: 5;
        }


        /* =========================================================
           HERO CONTENT
        ========================================================= */

        .products-banner-content {
            width: 100%;
            max-width: 720px;
            padding: 55px 0 55px 62px;
        }


        /* =========================================================
           BREADCRUMB
        ========================================================= */

        .products-banner-breadcrumb {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 11px;
            margin-bottom: 34px;
            font-size: 14px;
            line-height: 1;
        }


            /* Breadcrumb link */

            .products-banner-breadcrumb a {
                color: #ffffff;
                text-decoration: none;
                font-weight: 700;
                transition: color 0.25s ease;
            }


                .products-banner-breadcrumb a:hover {
                    color: #c9e52f;
                }


            /* Breadcrumb arrow */

            .products-banner-breadcrumb i {
                color: #b7d832;
                font-size: 11px;
            }


            /* Current page */

            .products-banner-breadcrumb span {
                color: rgba(255,255,255,0.72);
                font-weight: 500;
            }


        /* =========================================================
           LABEL
        ========================================================= */

        .products-banner-label {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 18px;
            color: #c8e83a;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1.4px;
            text-transform: uppercase;
        }


            /* Label icon */

            .products-banner-label i {
                color: #c8e83a;
                font-size: 17px;
            }


        /* =========================================================
           MAIN TITLE
        ========================================================= */

        .products-banner-content h1 {
            margin: 0;
            color: #ffffff;
            font-family: "Manrope", sans-serif;
            font-size: clamp(54px, 6vw, 78px);
            line-height: 1.02;
            font-weight: 800;
            letter-spacing: -2.5px;
        }


        /* =========================================================
           DESCRIPTION
        ========================================================= */

        .products-banner-content p {
            max-width: 680px;
            margin: 22px 0 0;
            color: rgba(255,255,255,0.88);
            font-size: 17px;
            line-height: 1.75;
            font-weight: 400;
        }


        /* =========================================================
           LARGE DESKTOP
        ========================================================= */

        @@media (min-width: 1400px) {

            .products-banner-hero {
                width: calc(100% - 56px);
                min-height: 470px;
            }


                .products-banner-hero .container {
                    min-height: 470px;
                }


            .products-banner-content {
                padding-left: 65px;
            }


                .products-banner-content h1 {
                    font-size: 82px;
                }
        }


        /* =========================================================
           TABLET
        ========================================================= */

        @@media (max-width: 991px) {

            .products-banner-hero {
                width: calc(100% - 40px);
                min-height: 420px;
                border-radius: 0 0 25px 25px;
            }


                .products-banner-hero .container {
                    min-height: 420px;
                }


            .products-banner-content {
                padding: 50px 30px;
            }


                .products-banner-content h1 {
                    font-size: 58px;
                }


                .products-banner-content p {
                    max-width: 570px;
                    font-size: 16px;
                }
            /*
               Fixed background disabled on tablet/mobile
            */

            .products-banner-image {
                background-attachment: scroll;
            }
        }


        /* =========================================================
           MOBILE
        ========================================================= */

        @@media (max-width: 767px) {

            .products-banner-hero {
                width: calc(100% - 24px);
                min-height: 400px;
                margin-top: 14px;
                border-radius: 0 0 22px 22px;
            }


                .products-banner-hero .container {
                    min-height: 400px;
                    align-items: center;
                }


            .products-banner-content {
                padding: 45px 20px;
            }


            .products-banner-breadcrumb {
                margin-bottom: 28px;
                font-size: 13px;
                gap: 9px;
            }


            .products-banner-label {
                margin-bottom: 14px;
                font-size: 10px;
                letter-spacing: 1.1px;
            }


                .products-banner-label i {
                    font-size: 15px;
                }


            .products-banner-content h1 {
                font-size: 48px;
                letter-spacing: -1.5px;
            }


            .products-banner-content p {
                margin-top: 18px;
                font-size: 15px;
                line-height: 1.65;
            }


            .products-banner-image {
                background-attachment: scroll;
                background-position: center;
            }


            .products-banner-overlay {
                background: linear-gradient( 90deg, rgba(0, 65, 39, 0.94) 0%, rgba(0, 70, 42, 0.80) 65%, rgba(0, 55, 34, 0.48) 100% );
            }
        }


        /* =========================================================
           SMALL MOBILE
        ========================================================= */

        @@media (max-width: 480px) {

            .products-banner-hero {
                width: calc(100% - 16px);
                min-height: 370px;
            }


                .products-banner-hero .container {
                    min-height: 370px;
                }


            .products-banner-content {
                padding: 38px 17px;
            }


            .products-banner-breadcrumb {
                margin-bottom: 25px;
                font-size: 12px;
            }


            .products-banner-content h1 {
                font-size: 42px;
            }


            .products-banner-content p {
                font-size: 14px;
                line-height: 1.6;
            }
        }


