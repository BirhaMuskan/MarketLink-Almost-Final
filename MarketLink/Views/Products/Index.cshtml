<!-- =========================================
     WHY MARKETLINK PRODUCTS
========================================= -->

<section class="why-products">

    <div class="container">

        <div class="products-section-heading centered">

            <span class="products-section-tag">
                WHY MARKETLINK
            </span>

            <h2>
                Freshness You Can Trust
            </h2>

            <p>
                We connect customers with local farmers
                and fresh products in a simple way.
            </p>

        </div>


        <div class="row g-4 mt-2">

            <div class="col-lg-4 col-md-6">

                <div class="why-product-card">

                    <div class="why-product-icon">
                        <i class="bi bi-flower1"></i>
                    </div>

                    <h3>
                        Fresh & Local
                    </h3>

                    <p>
                        Discover products sourced directly
                        from local farms and producers.
                    </p>

                </div>

            </div>


            <div class="col-lg-4 col-md-6">

                <div class="why-product-card">

                    <div class="why-product-icon">
                        <i class="bi bi-person-check"></i>
                    </div>

                    <h3>
                        Trusted Farmers
                    </h3>

                    <p>
                        Connect with local farmers and learn
                        where your products come from.
                    </p>

                </div>

            </div>


            <div class="col-lg-4 col-md-6">

                <div class="why-product-card">

                    <div class="why-product-icon">
                        <i class="bi bi-heart"></i>
                    </div>

                    <h3>
                        Support Local
                    </h3>

                    <p>
                        Every purchase helps support local
                        farming communities.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>



