@model IEnumerable<MarketLink.ViewModels.ProductListingViewModel>

@{
    ViewData["Title"] = "Fresh Products";

    var categories =
        ViewBag.Categories as IEnumerable<MarketLink.ViewModels.ProductCategoryViewModel>
        ?? Enumerable.Empty<MarketLink.ViewModels.ProductCategoryViewModel>();
}

<style>
    /* Product page only: preserves existing card layout and upgrades the buy button */
    .add-to-cart-form {
        display: inline-flex;
        margin: 0;
    }

    .product-add-cart-btn {
        border: 0;
        outline: 0;
        min-height: 42px;
        padding: 10px 17px;
        border-radius: 12px;
        background: #174d36;
        color: #ffffff;
        font-family: inherit;
        font-size: 14px;
        font-weight: 700;
        line-height: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        white-space: nowrap;
        box-shadow: 0 7px 18px rgba(23, 77, 54, 0.16);
        transition:
            transform .18s ease,
            box-shadow .18s ease,
            background-color .18s ease;
    }

    .product-add-cart-btn i {
        font-size: 17px;
        line-height: 1;
    }

    .product-add-cart-btn:hover {
        background: #103d2a;
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 10px 22px rgba(23, 77, 54, 0.22);
    }

    .product-add-cart-btn:active {
        transform: translateY(0);
    }

    .product-add-cart-btn:focus-visible {
        box-shadow:
            0 0 0 3px rgba(255, 255, 255, .95),
            0 0 0 6px rgba(23, 77, 54, .28);
    }

    .product-add-cart-btn:disabled {
        opacity: .55;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    @@media (max-width: 575.98px) {
        .product-add-cart-btn {
            min-height: 40px;
            padding: 9px 14px;
            font-size: 13px;
        }
    }
</style>



<style>
    /* Website product-card action alignment */
    .product-card-bottom {
        align-items: flex-end !important;
        gap: 12px !important;
    }

    .product-card-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
        flex: 0 0 auto;
    }

    .product-card-actions .add-to-cart-form {
        margin: 0;
    }

    .product-card-actions .product-add-cart-btn {
        min-height: 40px;
        padding: 9px 13px;
        border-radius: 11px;
        font-size: 12px;
        box-shadow: none;
    }

    .product-card-actions .product-view-btn {
        flex: 0 0 40px;
        margin: 0;
    }

    @@media (max-width: 575.98px) {
        .product-card-bottom {
            align-items: flex-start !important;
            flex-direction: column;
        }

        .product-card-actions {
            width: 100%;
            justify-content: space-between;
        }

        .product-card-actions .add-to-cart-form {
            flex: 1;
        }

        .product-card-actions .product-add-cart-btn {
            width: 100%;
        }
    }
</style>

<!-- =========================================================
     MARKETLINK - PRODUCTS HERO
========================================================= -->

<section class="products-banner-hero">

    <!-- Background Image -->
    <div class="products-banner-image"></div>

    <!-- Dark Green Overlay -->
    <div class="products-banner-overlay"></div>


    <div class="container">

        <div class="products-banner-content">

            <!-- =================================================
                 BREADCRUMB
            ================================================== -->

            <nav class="products-banner-breadcrumb"
                 aria-label="Breadcrumb">

                <a asp-controller="Home"
                   asp-action="Index">

                    Home

                </a>

                <i class="bi bi-chevron-right"></i>

                <span>Products</span>

            </nav>


            <!-- =================================================
                 LABEL
            ================================================== -->

            <div class="products-banner-label">

                <i class="bi bi-basket3"></i>

                <span>FRESH LOCAL PRODUCTS</span>

            </div>


            <!-- =================================================
                 TITLE
            ================================================== -->

            <h1>
                Fresh Products
            </h1>


            <!-- =================================================
                 DESCRIPTION
            ================================================== -->

            <p>
                Discover fresh fruits, vegetables, organic products
                and locally produced goods from trusted farmers
                through MarketLink.
            </p>

        </div>

    </div>

</section>



<!-- =========================================
     CATEGORY SECTION
========================================= -->

<section class="product-categories">

    <div class="container">

        <div class="products-section-heading">

            <div>

                <span class="products-section-tag">
                    SHOP BY CATEGORY
                </span>

                <h2>
                    Find What You Need
                </h2>

            </div>

            <p>
                Browse products by category and discover
                fresh local produce.
            </p>

        </div>


        <div class="category-scroll-wrapper">

            <button class="category-arrow category-prev"
                    type="button"
                    aria-label="Previous categories">

                <i class="bi bi-chevron-left"></i>

            </button>


            <div class="product-category-list">

                <!-- ALL PRODUCTS -->
                <button type="button"
                        class="product-category active"
                        data-category="all">

                    <span class="product-category-icon">
                        <i class="bi bi-grid-fill"></i>
                    </span>

                    <strong>All Products</strong>

                </button>


                <!-- DYNAMIC CATEGORIES -->
                @foreach (var category in categories)
                {
                    <button type="button"
                            class="product-category"
                            data-category="@category.CategorySlug">

                        <span class="product-category-icon">

                            @if (category.CategorySlug.Contains("vegetable"))
                            {
                                <i class="bi bi-flower1"></i>
                            }
                            else if (category.CategorySlug.Contains("fruit"))
                            {
                                <i class="bi bi-apple"></i>
                            }
                            else if (category.CategorySlug.Contains("dairy"))
                            {
                                <i class="bi bi-cup-hot"></i>
                            }
                            else if (category.CategorySlug.Contains("grain"))
                            {
                                <i class="bi bi-box-seam"></i>
                            }
                            else if (category.CategorySlug.Contains("organic"))
                            {
                                <i class="bi bi-leaf"></i>
                            }
                            else if (category.CategorySlug.Contains("herb"))
                            {
                                <i class="bi bi-tree"></i>
                            }
                            else
                            {
                                <i class="bi bi-basket"></i>
                            }

                        </span>

                        <strong>
                            @category.CategoryName
                        </strong>

                    </button>
                }

            </div>


            <button class="category-arrow category-next"
                    type="button"
                    aria-label="Next categories">

                <i class="bi bi-chevron-right"></i>

            </button>

        </div>

    </div>

</section>



<!-- =========================================
     PRODUCTS SECTION
========================================= -->

<section class="products-section"
         id="products">

    <div class="container">

        <!-- TOP BAR -->

        <div class="products-topbar">

            <div>

                <span class="products-section-tag">
                    FRESH MARKETPLACE
                </span>

                <h2>
                    Fresh Products
                </h2>

                <p id="productResultText">
    @Model.Count() products available
</p>

            </div>


            <div class="products-controls">

                <!-- SEARCH -->

                <div class="product-search">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="productSearch"
                           class="form-control"
                           placeholder="Search products...">

                </div>


                <!-- SORT -->

                <select id="productSort"
                        class="form-select product-sort">

                    <option value="default">
                        Sort By
                    </option>

                    <option value="nameAsc">
                        Name: A - Z
                    </option>

                    <option value="nameDesc">
                        Name: Z - A
                    </option>

                    <option value="priceLow">
                        Price: Low to High
                    </option>

                    <option value="priceHigh">
                        Price: High to Low
                    </option>

                </select>

            </div>

        </div>



        <!-- PRODUCT GRID -->

        <div class="row g-4" id="productsGrid">

    @foreach (var product in Model)
    {
        <div class="col-xl-3 col-lg-4 col-md-6 product-item"
             data-name="@product.ProductName"
             data-category="@product.CategorySlug"
             data-price="@product.Price">

            <div class="product-card">

                <!-- =========================================
                     PRODUCT IMAGE
                ========================================== -->

                <div class="product-image-wrapper">

                    <img src="@product.ImageUrl"
                         alt="@product.ProductName"
                         class="product-image"
                         onerror="this.src='/images/products/default-product.jpg';" />


                    <!-- BADGE -->
                    @if (!string.IsNullOrWhiteSpace(product.BadgeText))
                    {
                        <span class="product-fresh-badge">
                            @product.BadgeText
                        </span>
                    }


                    <!-- FAVORITE -->
                    @if (User.Identity?.IsAuthenticated == true &&
                         User.IsInRole("Customer"))
                    {
                        <form asp-controller="CustomerProducts"
                              asp-action="ToggleFavorite"
                              method="post"
                              style="display:contents;">
                            @Html.AntiForgeryToken()
                            <input type="hidden"
                                   name="farmerProductId"
                                   value="@product.FarmerProductId" />
                            <input type="hidden"
                                   name="returnUrl"
                                   value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit"
                                    class="product-favorite"
                                    aria-label="Add @product.ProductName to favorites">
                                <i class="bi bi-heart"></i>
                            </button>
                        </form>
                    }
                    else
                    {
                        var favoriteLoginUrl =
                            "/Auth/Login?returnUrl=" +
                            Uri.EscapeDataString(
                                Context.Request.Path +
                                Context.Request.QueryString);

                        <button type="button"
                                class="product-favorite"
                                aria-label="Sign in to save @product.ProductName"
                                onclick="window.location.href='@favoriteLoginUrl'">
                            <i class="bi bi-heart"></i>
                        </button>
                    }

                </div>


                <!-- =========================================
                     PRODUCT BODY
                ========================================== -->

                <div class="product-card-body">

                    <!-- CATEGORY -->
                    <span class="product-category-label">
                        @product.CategoryName
                    </span>


                    <!-- PRODUCT NAME -->
                    <h3>
                        @product.ProductName
                    </h3>


                    <!-- =====================================
                         RATING
                    ====================================== -->

                    <div class="product-rating">

                        @if (product.Rating > 0)
                        {
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (product.Rating >= i)
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                else if (product.Rating >= i - 0.5m)
                                {
                                    <i class="bi bi-star-half"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star"></i>
                                }
                            }

                            <span>
                                @product.Rating.ToString("0.0")
                            </span>

                            @if (product.ReviewCount > 0)
                            {
                                <small>
                                    (@product.ReviewCount)
                                </small>
                            }
                        }
                        else
                        {
                            <span>
                                No reviews
                            </span>
                        }

                    </div>


                    <!-- =====================================
                         FARMER
                    ====================================== -->

                    <div class="product-farmer">

                        <i class="bi bi-person-circle"></i>

                        <span>
                            @product.FarmerName
                        </span>

                    </div>


                    <!-- =====================================
                         MARKET
                    ====================================== -->

                    <div class="product-location">

                        <i class="bi bi-geo-alt"></i>

                        <span>
                            @product.MarketName
                        </span>

                    </div>


                    <!-- =====================================
     PRICE + ACTIONS
====================================== -->

<div class="product-card-bottom">

    <!-- PRICE -->

    <div class="product-price">

        <strong>
            Rs. @product.Price.ToString("N0")
        </strong>

        <span>
            / @product.UnitName
        </span>

    </div>


    <!-- ACTIONS -->

    <div class="product-card-actions">

        <!-- ADD TO CART / SIGN IN TO BUY -->

        @if (User.Identity?.IsAuthenticated == true &&
             User.IsInRole("Customer"))
        {
            <form asp-controller="Cart"
                  asp-action="Add"
                  method="post"
                  class="add-to-cart-form">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="FarmerProductId"
                       value="@product.FarmerProductId" />

                <input type="hidden"
                       name="FarmerMarketId"
                       value="@product.FarmerMarketId" />

                <input type="hidden"
                       name="Quantity"
                       value="1" />

                <input type="hidden"
                       name="ReturnUrl"
                       value="/Cart" />

                <button type="submit"
                        class="product-add-cart-btn"
                        title="Add @product.ProductName to cart">

                    <i class="bi bi-cart-plus"></i>

                    <span>Add to Cart</span>

                </button>

            </form>
        }
        else
        {
            var productReturnUrl =
                Url.Action("Details",
                           "Products",
                           new { id = product.FarmerProductId })
                ?? "/Products";

            var productLoginUrl =
                "/Auth/Login?returnUrl=" +
                Uri.EscapeDataString(productReturnUrl);

            <button type="button"
                    class="product-add-cart-btn"
                    title="Sign in to buy @product.ProductName"
                    onclick="window.location.href='@productLoginUrl'">

                <i class="bi bi-box-arrow-in-right"></i>

                <span>Sign In to Buy</span>

            </button>
        }


        <!-- PRODUCT DETAILS -->

        <a asp-controller="Products"
           asp-action="Details"
           asp-route-id="@product.FarmerProductId"
           class="product-view-btn"
           aria-label="View @product.ProductName details"
           title="View product details">

            <i class="bi bi-arrow-right"></i>

        </a>

    </div>

</div>

                </div>

            </div>

        </div>
    }

</div>



        <!-- NO RESULTS -->

        <div id="noProductResults"
     class="no-product-results"
     style="display:none;">

    <div class="no-product-icon">
        <i class="bi bi-search"></i>
    </div>

    <h3>
        No products found
    </h3>

    <p>
        Try another search term or select a different category.
    </p>

    <button type="button"
            id="resetProductFilters"
            class="reset-product-btn">

        Show All Products

    </button>

</div>

    </div>

</section>



<!-- =========================================
     WHY MARKETLINK PRODUCTS
========================================= -->

