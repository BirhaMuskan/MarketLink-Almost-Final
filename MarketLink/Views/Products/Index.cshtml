@{
    ViewData["Title"] = "Fresh Products";
}

<!-- =========================================================
     MARKETLINK - PRODUCTS HERO
========================================================= -->

<section class="products-banner-hero">

    <!-- Background Image -->
    <div class="products-banner-image"></div>

    <!-- Dark Green Overlay -->
    <div class="products-banner-overlay"></div>


    <div class="container">

        <div class="products-banner-content">

            <!-- =================================================
                 BREADCRUMB
            ================================================== -->

            <nav class="products-banner-breadcrumb"
                 aria-label="Breadcrumb">

                <a asp-controller="Home"
                   asp-action="Index">

                    Home

                </a>

                <i class="bi bi-chevron-right"></i>

                <span>Products</span>

            </nav>


            <!-- =================================================
                 LABEL
            ================================================== -->

            <div class="products-banner-label">

                <i class="bi bi-basket3"></i>

                <span>FRESH LOCAL PRODUCTS</span>

            </div>


            <!-- =================================================
                 TITLE
            ================================================== -->

            <h1>
                Fresh Products
            </h1>


            <!-- =================================================
                 DESCRIPTION
            ================================================== -->

            <p>
                Discover fresh fruits, vegetables, organic products
                and locally produced goods from trusted farmers
                through MarketLink.
            </p>

        </div>

    </div>

</section>



<!-- =========================================
     CATEGORY SECTION
========================================= -->

<section class="product-categories">

    <div class="container">

        <div class="products-section-heading">

            <div>

                <span class="products-section-tag">
                    SHOP BY CATEGORY
                </span>

                <h2>
                    Find What You Need
                </h2>

            </div>

            <p>
                Browse products by category and discover
                fresh local produce.
            </p>

        </div>


        <div class="category-scroll-wrapper">

            <button class="category-arrow category-prev"
                    type="button"
                    aria-label="Previous categories">

                <i class="bi bi-chevron-left"></i>

            </button>


            <div class="product-category-list">

                <button type="button"
                        class="product-category active"
                        data-category="all">

                    <span class="product-category-icon">
                        <i class="bi bi-grid-fill"></i>
                    </span>

                    <strong>All Products</strong>

                </button>


                <button type="button"
                        class="product-category"
                        data-category="vegetables">

                    <span class="product-category-icon">
                        <i class="bi bi-flower1"></i>
                    </span>

                    <strong>Vegetables</strong>

                </button>


                <button type="button"
                        class="product-category"
                        data-category="fruits">

                    <span class="product-category-icon">
                        <i class="bi bi-apple"></i>
                    </span>

                    <strong>Fruits</strong>

                </button>


                <button type="button"
                        class="product-category"
                        data-category="dairy">

                    <span class="product-category-icon">
                        <i class="bi bi-cup-hot"></i>
                    </span>

                    <strong>Dairy</strong>

                </button>


                <button type="button"
                        class="product-category"
                        data-category="grains">

                    <span class="product-category-icon">
                        <i class="bi bi-box-seam"></i>
                    </span>

                    <strong>Grains</strong>

                </button>


                <button type="button"
                        class="product-category"
                        data-category="organic">

                    <span class="product-category-icon">
                        <i class="bi bi-leaf"></i>
                    </span>

                    <strong>Organic</strong>

                </button>


                <button type="button"
                        class="product-category"
                        data-category="herbs">

                    <span class="product-category-icon">
                        <i class="bi bi-tree"></i>
                    </span>

                    <strong>Herbs</strong>

                </button>

            </div>


            <button class="category-arrow category-next"
                    type="button"
                    aria-label="Next categories">

                <i class="bi bi-chevron-right"></i>

            </button>

        </div>

    </div>

</section>



<!-- =========================================
     PRODUCTS SECTION
========================================= -->

<section class="products-section"
         id="products">

    <div class="container">

        <!-- TOP BAR -->

        <div class="products-topbar">

            <div>

                <span class="products-section-tag">
                    FRESH MARKETPLACE
                </span>

                <h2>
                    Fresh Products
                </h2>

                <p id="productResultText">
                    Showing all available products
                </p>

            </div>


            <div class="products-controls">

                <!-- SEARCH -->

                <div class="product-search">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="productSearch"
                           class="form-control"
                           placeholder="Search products...">

                </div>


                <!-- SORT -->

                <select id="productSort"
                        class="form-select product-sort">

                    <option value="default">
                        Sort By
                    </option>

                    <option value="nameAsc">
                        Name: A - Z
                    </option>

                    <option value="nameDesc">
                        Name: Z - A
                    </option>

                    <option value="priceLow">
                        Price: Low to High
                    </option>

                    <option value="priceHigh">
                        Price: High to Low
                    </option>

                </select>

            </div>

        </div>



