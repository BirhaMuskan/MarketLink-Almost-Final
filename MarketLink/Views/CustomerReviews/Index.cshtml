@model MarketLink.ViewModels.CustomerReviewsPageViewModel

@{
    ViewData["Title"] = "Reviews";
    Layout = "~/Views/Shared/_CustomerDashboardLayout.cshtml";
}

@section Styles {
<style>
.review-header{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:18px}
.review-label{color:#14836f;font-size:12px;font-weight:800;letter-spacing:.08em}
.review-header h2{margin:7px 0 5px;font-size:28px;font-weight:800}
.review-header p{margin:0;color:#667085}
.review-stats{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-bottom:18px}
.review-stats>div{background:#fff;border:1px solid #e7ebef;border-radius:15px;padding:15px}
.review-stats span{display:block;color:#667085;font-size:11px}
.review-stats strong{display:block;margin-top:3px;font-size:22px}
.section-card{background:#fff;border:1px solid #e7ebef;border-radius:18px;overflow:hidden;margin-bottom:18px}
.section-head{padding:15px 17px;border-bottom:1px solid #edf0f4}
.section-head span{color:#13836e;font-size:10px;font-weight:800;letter-spacing:.08em}
.section-head h3{margin:3px 0 0;font-size:17px}
.orders-list,.history-list{padding:12px}
.order-row{padding:15px;border:1px solid #e8ebef;border-radius:14px;margin-bottom:10px}
.order-top{display:flex;justify-content:space-between;gap:12px}
.order-top h4{margin:0;font-size:15px}
.order-top span{display:block;color:#667085;font-size:10px;margin-top:3px}
.review-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:12px}
.review-btn{display:inline-flex;align-items:center;gap:5px;text-decoration:none;border:1px solid #d0d5dd;color:#344054;background:#fff;padding:7px 9px;border-radius:8px;font-size:10px;font-weight:700}
.review-btn.primary{background:#13836e;color:#fff;border-color:#13836e}
.review-btn.done{background:#f2f4f7;color:#667085;pointer-events:none}
.product-review-group{margin-top:10px;padding-top:10px;border-top:1px solid #edf0f4}
.product-review-group strong{display:block;font-size:11px;margin-bottom:7px}
.history-row{padding:15px;border:1px solid #e8ebef;border-radius:14px;margin-bottom:10px}
.history-head{display:flex;justify-content:space-between;gap:10px}
.history-head h4{margin:0;font-size:14px}
.history-head span{font-size:9px;color:#98a2b3}
.stars{color:#f79009;letter-spacing:1px;margin:5px 0}
.history-row p{margin:7px 0;color:#475467;font-size:11px}
.response-box{margin-top:10px;padding:10px 12px;background:#f8fafc;border-radius:10px;border-left:3px solid #13836e}
.response-box strong{font-size:10px;color:#067647}
.response-box p{margin:4px 0 0}
.empty{padding:50px;text-align:center;color:#667085}
.notice{margin-bottom:14px}
@@media(max-width:650px){.review-header{align-items:flex-start;flex-direction:column}.review-stats{grid-template-columns:1fr}.order-top,.history-head{flex-direction:column}}
</style>
}

<section class="review-header">
    <div>
        <span class="review-label">
            <i class="bi bi-star"></i>
            CUSTOMER FEEDBACK
        </span>

        <h2>Reviews</h2>

        <p>
            Review farmers and products from completed orders.
        </p>
    </div>
</section>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success notice">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger notice">
        @TempData["ErrorMessage"]
    </div>
}

<section class="review-stats">
    <div>
        <span>Completed Orders</span>
        <strong>@Model.CompletedOrders</strong>
    </div>

    <div>
        <span>Reviews Given</span>
        <strong>@Model.ReviewsGiven</strong>
    </div>
</section>

<section class="section-card">

    <div class="section-head">
        <span>ELIGIBLE ORDERS</span>
        <h3>Leave a Review</h3>
    </div>

    <div class="orders-list">

        @if (!Model.Orders.Any())
        {
            <div class="empty">
                You do not have any completed orders available for review yet.
            </div>
        }
        else
        {
            @foreach (var order in Model.Orders)
            {
                <article class="order-row">

                    <div class="order-top">
                        <div>
                            <h4>@order.OrderNo</h4>

                            <span>
                                @order.FarmerName · Pickup @order.PickupDate.ToString("dd MMM yyyy")
                            </span>
                        </div>

                        <div>
                            @if (order.FarmerReviewed)
                            {
                                <span class="review-btn done">
                                    <i class="bi bi-check-circle"></i>
                                    Farmer Reviewed
                                </span>
                            }
                            else
                            {
                                <a asp-controller="CustomerReviews"
                                   asp-action="Create"
                                   asp-route-orderId="@order.OrderId"
                                   asp-route-farmerId="@order.FarmerId"
                                   class="review-btn primary">

                                    <i class="bi bi-star"></i>
                                    Review Farmer
                                </a>
                            }
                        </div>
                    </div>

                    @if (order.Products.Any())
                    {
                        <div class="product-review-group">

                            <strong>Products in this order</strong>

                            <div class="review-actions">

                                @foreach (var product in order.Products)
                                {
                                    @if (product.Reviewed)
                                    {
                                        <span class="review-btn done">
                                            <i class="bi bi-check-circle"></i>
                                            @product.ProductName
                                        </span>
                                    }
                                    else
                                    {
                                        <a asp-controller="CustomerReviews"
                                           asp-action="Create"
                                           asp-route-orderId="@order.OrderId"
                                           asp-route-farmerProductId="@product.FarmerProductId"
                                           class="review-btn">

                                            <i class="bi bi-star"></i>
                                            @product.ProductName
                                        </a>
                                    }
                                }

                            </div>

                        </div>
                    }

                </article>
            }
        }

    </div>

</section>

<section class="section-card">

    <div class="section-head">
        <span>YOUR FEEDBACK</span>
        <h3>Review History</h3>
    </div>

    <div class="history-list">

        @if (!Model.Reviews.Any())
        {
            <div class="empty">
                You have not submitted any reviews yet.
            </div>
        }
        else
        {
            @foreach (var review in Model.Reviews)
            {
                <article class="history-row">

                    <div class="history-head">

                        <div>
                            <h4>@review.TargetName</h4>

                            <span>
                                @review.OrderNo · @review.ReviewDate.ToString("dd MMM yyyy")
                            </span>
                        </div>

                        <a asp-controller="CustomerReviews"
                           asp-action="Edit"
                           asp-route-id="@review.ReviewId"
                           class="review-btn">
                            Edit
                        </a>

                    </div>

                    <div class="stars">
                        @for (var i = 1; i <= 5; i++)
                        {
                            <i class="bi @(i <= review.Rating ? "bi-star-fill" : "bi-star")"></i>
                        }
                    </div>

                    <p>@review.Comment</p>

                    @if (!string.IsNullOrWhiteSpace(review.FarmerResponse))
                    {
                        <div class="response-box">

                            <strong>
                                Farmer Response
                            </strong>

                            <p>@review.FarmerResponse</p>

                            @if (review.RespondedAt.HasValue)
                            {
                                <span style="font-size:9px;color:#98a2b3;">
                                    @review.RespondedAt.Value.ToString("dd MMM yyyy, hh:mm tt")
                                </span>
                            }

                        </div>
                    }

                </article>
            }
        }

    </div>

</section>
