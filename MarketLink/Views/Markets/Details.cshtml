@model MarketLink.Models.Market

@{
    ViewData["Title"] = Model.MarketName + " - Market Details";

    string marketStatus = Model.IsActive ? "Active Market" : "Currently Unavailable";

    string googleMapsUrl = "https://www.google.com/maps";

    if (Model.Latitude.HasValue && Model.Longitude.HasValue)
    {
        googleMapsUrl =
            $"https://www.google.com/maps?q={Model.Latitude.Value},{Model.Longitude.Value}";
    }
}

<!-- =========================================================
     MARKETLINK - MARKET DETAILS HERO / BANNER
========================================================= -->

<section class="market-details-banner">

    <div class="market-details-banner-overlay"></div>

    <div class="container">

        <div class="market-details-banner-content">

            <!-- Breadcrumb -->

            <nav class="market-details-breadcrumb" aria-label="Breadcrumb">

                <a asp-controller="Home"
                   asp-action="Index">
                    Home
                </a>

                <i class="bi bi-chevron-right"></i>

                <a asp-controller="Markets"
                   asp-action="Index">
                    Markets
                </a>

                <i class="bi bi-chevron-right"></i>

                <span>@Model.MarketName</span>

            </nav>


            <!-- Small Label -->

            <span class="market-details-banner-label">

                <i class="bi bi-shop-window"></i>

                LOCAL FARMERS MARKET

            </span>


            <!-- Heading -->

            <h1>
                @Model.MarketName
            </h1>


            <!-- Description -->

            <p>
                @(string.IsNullOrWhiteSpace(Model.Description)
                    ? "Discover fresh products and local farmers at this MarketLink farmers market."
                    : Model.Description)
            </p>

        </div>

    </div>

</section>


<!-- =========================================================
     MARKET INTRODUCTION
========================================================= -->

<section class="market-details-intro-section">

    <div class="container">

        <div class="row align-items-center g-5">

            <!-- LEFT CONTENT -->

            <div class="col-lg-7">

                <span class="market-details-badge">

                    <i class="bi bi-shop"></i>

                    @marketStatus

                </span>


                <h2>

                    @Model.MarketName
                    <span>Market.</span>

                </h2>


                <p class="market-details-intro">

                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "Discover fresh, locally available products and connect with local farmers through MarketLink."
                        : Model.Description)

                </p>


                <!-- QUICK INFORMATION -->

                <div class="market-quick-info">

                    <!-- LOCATION -->

                    <div class="quick-info-item">

                        <i class="bi bi-geo-alt-fill"></i>

                        <div>

                            <small>
                                Location
                            </small>

                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.Address)
                                    ? "Location not available"
                                    : Model.Address)
                            </strong>

                        </div>

                    </div>


                    <!-- MARKET STATUS -->

                    <div class="quick-info-item">

                        <i class="bi bi-shop"></i>

                        <div>

                            <small>
                                Market Status
                            </small>

                            <strong>
                                @(Model.IsActive ? "Active" : "Inactive")
                            </strong>

                        </div>

                    </div>


                    <!-- CREATED DATE -->

                    <div class="quick-info-item">

                        <i class="bi bi-calendar3"></i>

                        <div>

                            <small>
                                Listed Since
                            </small>

                            <strong>
                                @Model.CreatedAt.ToString("dd MMM yyyy")
                            </strong>

                        </div>

                    </div>

                </div>

            </div>


            <!-- RIGHT IMAGE -->

            <div class="col-lg-5">

                <div class="market-details-image-wrapper">

                    <img src="https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=1200&q=85"
                         alt="@Model.MarketName"
                         class="market-details-main-image">

                    <div class="market-open-badge">

                        <span class="status-dot"></span>

                        @(Model.IsActive ? "Active Market" : "Currently Unavailable")

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     MARKET INFORMATION
========================================================= -->

<section class="market-details-section">

    <div class="container">

        <div class="row g-4">

            <!-- =================================================
                 MAIN CONTENT
            ================================================== -->

            <div class="col-lg-8">


                <!-- ABOUT MARKET -->

                <div class="details-card">

                    <div class="details-card-heading">

                        <div class="details-icon">

                            <i class="bi bi-shop-window"></i>

                        </div>

                        <div>

                            <span>
                                About the Market
                            </span>

                            <h2>
                                @Model.MarketName
                            </h2>

                        </div>

                    </div>


                    <p>

                        @(string.IsNullOrWhiteSpace(Model.Description)
                            ? "This market is part of the MarketLink platform where customers can discover local farmers and their products."
                            : Model.Description)

                    </p>


                    <p>

                        MarketLink helps customers discover local markets,
                        explore available products and connect with farmers
                        through one convenient platform.

                    </p>

                </div>


                <!-- =================================================
                     WHAT YOU CAN FIND
                ================================================== -->

                <div class="details-card">

                    <div class="details-card-heading">

                        <div class="details-icon">

                            <i class="bi bi-basket3"></i>

                        </div>

                        <div>

                            <span>
                                Market
                            </span>

                            <h2>
                                Explore Local Products
                            </h2>

                        </div>

                    </div>


                    <div class="product-category-grid">


                        <!-- FRUITS -->

                        <div class="product-category">

                            <div class="category-icon">

                                <i class="bi bi-apple"></i>

                            </div>

                            <h3>
                                Fresh Fruits
                            </h3>

                            <p>
                                Discover fresh products offered by local farmers.
                            </p>

                        </div>


                        <!-- VEGETABLES -->

                        <div class="product-category">

                            <div class="category-icon">

                                <i class="bi bi-flower1"></i>

                            </div>

                            <h3>
                                Fresh Vegetables
                            </h3>

                            <p>
                                Explore seasonal vegetables from local producers.
                            </p>

                        </div>


                        <!-- LOCAL PRODUCTS -->

                        <div class="product-category">

                            <div class="category-icon">

                                <i class="bi bi-basket"></i>

                            </div>

                            <h3>
                                Local Products
                            </h3>

                            <p>
                                Find products available from farmers in this market.
                            </p>

                        </div>


                        <!-- FARM PRODUCTS -->

                        <div class="product-category">

                            <div class="category-icon">

                                <i class="bi bi-leaf"></i>

                            </div>

                            <h3>
                                Farm Products
                            </h3>

                            <p>
                                Support local farmers by exploring their products.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     MARKET FEATURES
                ================================================== -->

                <div class="details-card">

                    <div class="details-card-heading">

                        <div class="details-icon">

                            <i class="bi bi-stars"></i>

                        </div>

                        <div>

                            <span>
                                Market Information
                            </span>

                            <h2>
                                Why Explore This Market?
                            </h2>

                        </div>

                    </div>


                    <div class="highlight-list">

                        <div class="highlight-item">

                            <i class="bi bi-check-circle-fill"></i>

                            <span>
                                Discover products from local farmers
                            </span>

                        </div>


                        <div class="highlight-item">

                            <i class="bi bi-check-circle-fill"></i>

                            <span>
                                Explore fresh local products
                            </span>

                        </div>


                        <div class="highlight-item">

                            <i class="bi bi-check-circle-fill"></i>

                            <span>
                                Connect with the local farming community
                            </span>

                        </div>


                        <div class="highlight-item">

                            <i class="bi bi-check-circle-fill"></i>

                            <span>
                                Find market information in one place
                            </span>

                        </div>


                        <div class="highlight-item">

                            <i class="bi bi-check-circle-fill"></i>

                            <span>
                                Support local farmers
                            </span>

                        </div>


                        <div class="highlight-item">

                            <i class="bi bi-check-circle-fill"></i>

                            <span>
                                Explore products through MarketLink
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 SIDEBAR
            ================================================== -->

            <div class="col-lg-4">


                <!-- MARKET INFORMATION -->

                <div class="details-sidebar-card">

                    <h3>

                        <i class="bi bi-info-circle"></i>

                        Market Information

                    </h3>


                    <div class="sidebar-info-row">

                        <i class="bi bi-shop"></i>

                        <div>

                            <span>
                                Market Name
                            </span>

                            <strong>
                                @Model.MarketName
                            </strong>

                        </div>

                    </div>


                    <div class="sidebar-info-row">

                        <i class="bi bi-geo-alt"></i>

                        <div>

                            <span>
                                Location
                            </span>

                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.Address)
                                    ? "Not available"
                                    : Model.Address)
                            </strong>

                        </div>

                    </div>


                    <div class="sidebar-info-row">

                        <i class="bi bi-toggle-on"></i>

                        <div>

                            <span>
                                Status
                            </span>

                            <strong>
                                @(Model.IsActive ? "Active" : "Inactive")
                            </strong>

                        </div>

                    </div>


                    <div class="sidebar-info-row">

                        <i class="bi bi-calendar3"></i>

                        <div>

                            <span>
                                Added On
                            </span>

                            <strong>
                                @Model.CreatedAt.ToString("dd MMM yyyy")
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     LOCATION
                ================================================== -->

                <div class="details-sidebar-card">

                    <h3>

                        <i class="bi bi-geo-alt"></i>

                        Location

                    </h3>


                    <div class="location-box">

                        <div class="location-map-placeholder">

                            <i class="bi bi-geo-alt-fill"></i>

                            <span>
                                @(string.IsNullOrWhiteSpace(Model.Address)
                                    ? "Location not available"
                                    : Model.Address)
                            </span>

                        </div>

                    </div>


                    <p class="location-address">

                        @(string.IsNullOrWhiteSpace(Model.Address)
                            ? "Address information is not available."
                            : Model.Address)

                    </p>


                    <a href="@googleMapsUrl"
                       target="_blank"
                       class="details-map-btn">

                        <i class="bi bi-map"></i>

                        Open in Google Maps

                    </a>

                </div>


                <!-- =================================================
                     CONTACT
                ================================================== -->

                <div class="details-sidebar-card contact-card">

                    <div class="contact-icon">

                        <i class="bi bi-headset"></i>

                    </div>


                    <h3>
                        Need Help?
                    </h3>


                    <p>

                        Have a question about this market?
                        Get in touch with the MarketLink team.

                    </p>


                    <a asp-controller="Home"
                       asp-action="Contact"
                       class="details-contact-btn">

                        Contact Us

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     CTA
========================================================= -->

<section class="market-details-cta">

    <div class="container">

        <div class="cta-content">

            <div>

                <span class="cta-small">
                    SUPPORT LOCAL FARMERS
                </span>

                <h2>
                    Explore @Model.MarketName
                </h2>

                <p>
                    Discover farmers, products and markets
                    available through MarketLink.
                </p>

            </div>


            <div class="cta-buttons">

                <a asp-controller="Markets"
                   asp-action="Index"
                   class="cta-outline-btn">

                    <i class="bi bi-arrow-left"></i>

                    Back to Markets

                </a>


                <a asp-controller="Home"
                   asp-action="Index"
                   class="cta-primary-btn">

                    Explore MarketLink

                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

        </div>

    </div>

</section>

<!-- =========================================================
     MARKET DETAILS PAGE CSS
========================================================= -->
@section Styles {

    <style>

        /* =========================================================
           MARKET DETAILS BANNER
           SAME STYLE AS MARKETS PAGE
        ========================================================= */

        .market-details-banner {
            position: relative;
            min-height: 445px;
            margin: 20px auto 0;
            width: min(100% - 48px, 1400px);
            border-radius: 0 0 28px 28px;
            overflow: hidden;
            /* DIFFERENT IMAGE FROM MARKETS PAGE */
            background-image: url("https://images.unsplash.com/photo-1464226184884-fa280b87c399?auto=format&fit=crop&w=1800&q=88");
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            display: flex;
            align-items: center;
        }


        /* DARK GREEN OVERLAY */

        .market-details-banner-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient( 90deg, rgba(5, 64, 38, 0.94) 0%, rgba(8, 79, 45, 0.78) 38%, rgba(8, 72, 43, 0.40) 70%, rgba(8, 72, 43, 0.20) 100% );
            z-index: 1;
        }


        /* BANNER CONTENT */

        .market-details-banner .container {
            position: relative;
            z-index: 2;
            width: 100%;
        }


        .market-details-banner-content {
            max-width: 760px;
            padding: 85px 0;
        }


        /* BREADCRUMB */

        .market-details-breadcrumb {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 11px;
            margin-bottom: 32px;
            font-size: 14px;
        }


            .market-details-breadcrumb a {
                color: #ffffff;
                text-decoration: none;
                font-weight: 700;
                transition: 0.3s ease;
            }


                .market-details-breadcrumb a:hover {
                    color: #c4e94b;
                }


            .market-details-breadcrumb i {
                color: #b7d93e;
                font-size: 11px;
            }


            .market-details-breadcrumb span {
                color: rgba(255,255,255,0.72);
                font-weight: 500;
            }


        /* SMALL LABEL */

        .market-details-banner-label {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 15px;
            color: #c5e64e;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1.5px;
        }


            .market-details-banner-label i {
                font-size: 16px;
            }


        /* BANNER HEADING */

        .market-details-banner h1 {
            margin: 0;
            color: #ffffff;
            font-family: "Manrope", sans-serif;
            font-size: clamp(52px, 6vw, 82px);
            font-weight: 800;
            line-height: 1.02;
            letter-spacing: -2px;
        }


        /* BANNER DESCRIPTION */

        .market-details-banner p {
            max-width: 650px;
            margin: 22px 0 0;
            color: rgba(255,255,255,0.82);
            font-size: 17px;
            line-height: 1.75;
        }



        /* =========================================================
           INTRO SECTION
        ========================================================= */

        .market-details-intro-section {
            padding: 90px 0 80px;
            background: #f8f7ef;
        }


        .market-details-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 15px;
            border-radius: 30px;
            background: #e5f1d8;
            color: #397343;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 18px;
        }


        .market-details-intro-section h2 {
            margin: 0 0 22px;
            max-width: 700px;
            color: #123b2b;
            font-family: "Manrope", sans-serif;
            font-size: clamp(40px, 5vw, 64px);
            font-weight: 800;
            line-height: 1.06;
            letter-spacing: -2px;
        }


            .market-details-intro-section h2 span {
                color: #6e9e35;
            }


        .market-details-intro {
            max-width: 650px;
            margin-bottom: 32px;
            color: #68766d;
            font-size: 17px;
            line-height: 1.8;
        }



        /* =========================================================
           QUICK INFO
        ========================================================= */

        .market-quick-info {
            display: flex;
            flex-wrap: wrap;
            gap: 25px;
        }


        .quick-info-item {
            display: flex;
            align-items: center;
            gap: 12px;
        }


            .quick-info-item > i {
                width: 44px;
                height: 44px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 13px;
                background: #ffffff;
                color: #3e7c49;
                box-shadow: 0 8px 25px rgba(0,0,0,0.06);
            }


            .quick-info-item small {
                display: block;
                color: #89938b;
                font-size: 12px;
                margin-bottom: 3px;
            }


            .quick-info-item strong {
                display: block;
                color: #29382f;
                font-size: 14px;
            }



        /* =========================================================
           MAIN IMAGE
        ========================================================= */

        .market-details-image-wrapper {
            position: relative;
        }


        .market-details-main-image {
            display: block;
            width: 100%;
            height: 470px;
            object-fit: cover;
            border-radius: 30px;
            box-shadow: 0 25px 60px rgba(39,71,44,0.16);
        }


        .market-open-badge {
            position: absolute;
            left: 22px;
            bottom: 22px;
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 12px 17px;
            border-radius: 50px;
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(10px);
            color: #294532;
            font-size: 13px;
            font-weight: 700;
            box-shadow: 0 10px 30px rgba(0,0,0,0.12);
        }


        .status-dot {
            width: 9px;
            height: 9px;
            background: #38a169;
            border-radius: 50%;
        }



        /* =========================================================
           DETAILS SECTION
        ========================================================= */

        .market-details-section {
            padding: 90px 0;
            background: #ffffff;
        }


        .details-card {
            background: #ffffff;
            border: 1px solid #edf1ed;
            border-radius: 22px;
            padding: 32px;
            margin-bottom: 25px;
            box-shadow: 0 10px 35px rgba(31,48,36,0.05);
        }


        .details-card-heading {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 22px;
        }


        .details-icon {
            width: 52px;
            height: 52px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #eaf5eb;
            color: #347443;
            border-radius: 15px;
            font-size: 22px;
        }


        .details-card-heading span {
            display: block;
            color: #5b8c63;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 11px;
            font-weight: 800;
            margin-bottom: 4px;
        }


        .details-card-heading h2 {
            margin: 0;
            color: #24352a;
            font-size: 25px;
            font-weight: 750;
        }


        .details-card p {
            color: #69746c;
            line-height: 1.8;
            font-size: 15px;
        }



        /* =========================================================
           PRODUCT CATEGORIES
        ========================================================= */

        .product-category-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }


        .product-category {
            border: 1px solid #edf1ed;
            border-radius: 16px;
            padding: 20px;
            transition: 0.3s ease;
        }


            .product-category:hover {
                transform: translateY(-4px);
                box-shadow: 0 10px 25px rgba(0,0,0,0.06);
            }


        .category-icon {
            width: 43px;
            height: 43px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: #f0f7f0;
            color: #3c7a48;
            font-size: 20px;
            margin-bottom: 12px;
        }


        .product-category h3 {
            font-size: 16px;
            color: #29382e;
            margin-bottom: 6px;
        }


        .product-category p {
            font-size: 13px;
            margin: 0;
        }



        /* =========================================================
           HIGHLIGHTS
        ========================================================= */

        .highlight-list {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }


        .highlight-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            color: #58655c;
            font-size: 14px;
            line-height: 1.5;
        }


            .highlight-item i {
                color: #4d9859;
                font-size: 17px;
                flex-shrink: 0;
            }



        /* =========================================================
           SIDEBAR
        ========================================================= */

        .details-sidebar-card {
            background: #ffffff;
            border: 1px solid #edf1ed;
            border-radius: 22px;
            padding: 27px;
            margin-bottom: 25px;
            box-shadow: 0 10px 35px rgba(31,48,36,0.05);
        }


            .details-sidebar-card h3 {
                font-size: 20px;
                color: #26372c;
                font-weight: 750;
                margin-bottom: 24px;
            }


                .details-sidebar-card h3 i {
                    color: #3d7d49;
                    margin-right: 7px;
                }


        .sidebar-info-row {
            display: flex;
            gap: 13px;
            padding: 15px 0;
            border-bottom: 1px solid #eef1ee;
        }


            .sidebar-info-row:last-child {
                border-bottom: none;
                padding-bottom: 0;
            }


            .sidebar-info-row > i {
                color: #478450;
                font-size: 18px;
                width: 22px;
                margin-top: 2px;
            }


            .sidebar-info-row span {
                display: block;
                font-size: 12px;
                color: #8a948d;
                margin-bottom: 3px;
            }


            .sidebar-info-row strong {
                color: #334138;
                font-size: 14px;
            }



        /* =========================================================
           LOCATION
        ========================================================= */

        .location-map-placeholder {
            height: 190px;
            border-radius: 16px;
            background: linear-gradient( 135deg, #dcebdc, #eef5ed );
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 8px;
            color: #3d7047;
            margin-bottom: 15px;
        }


            .location-map-placeholder i {
                font-size: 35px;
            }


            .location-map-placeholder span {
                font-weight: 700;
                font-size: 14px;
            }


        .location-address {
            color: #68736b;
            font-size: 14px;
            line-height: 1.6;
        }


        .details-map-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            text-decoration: none;
            border: 1px solid #dce8dd;
            color: #397246;
            border-radius: 12px;
            padding: 12px;
            font-size: 14px;
            font-weight: 700;
            transition: 0.3s ease;
        }


            .details-map-btn:hover {
                background: #eff7ef;
                color: #2d6138;
            }



        /* =========================================================
           CONTACT CARD
        ========================================================= */

        .contact-card {
            text-align: center;
            background: #f2f8f2;
            border-color: #e1eee2;
        }


        .contact-icon {
            width: 55px;
            height: 55px;
            margin: 0 auto 15px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #ffffff;
            color: #397447;
            font-size: 23px;
        }


        .contact-card h3 {
            margin-bottom: 10px;
        }


        .contact-card p {
            font-size: 14px;
