@model MarketLink.ViewModels.MarketsViewModel

@{
    ViewData["Title"] = "Markets";
}


<style>
    /* Market cards intentionally do not reserve an image area */
    .markets-page-card-top {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 22px 24px 16px;
        position: relative;
    }

    .markets-page-card-top::after {
        content: "";
        position: absolute;
        left: 24px;
        right: 24px;
        bottom: 0;
        height: 1px;
        background: #edf0ec;
    }

    .markets-page-card-icon {
        width: 52px;
        height: 52px;
        flex: 0 0 52px;
        border-radius: 15px;
        display: grid;
        place-items: center;
        background: #edf7f2;
        color: #13836e;
        font-size: 23px;
    }

    .markets-page-card-heading {
        min-width: 0;
        flex: 1;
    }

    .markets-page-card-heading span {
        display: block;
        color: #6b9b58;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .11em;
        margin-bottom: 4px;
    }

    .markets-page-card-heading strong {
        color: #173c2f;
        font-size: 20px;
        line-height: 1.25;
        display: block;
    }

    .markets-page-status {
        border-radius: 999px;
        background: #f2f8ef;
        color: #4f8f36;
        font-size: 9px;
        font-weight: 800;
        padding: 7px 10px;
        white-space: nowrap;
    }

    @@media (max-width: 575.98px) {
        .markets-page-card-top {
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .markets-page-status {
            margin-left: 65px;
        }
    }
</style>

<!-- =========================================================
     MARKETLINK - MARKETS HERO
========================================================= -->

<section class="markets-banner-hero">

    <div class="markets-banner-image"></div>

    <div class="markets-banner-overlay"></div>

    <div class="container">

        <div class="markets-banner-content">

            <nav class="markets-banner-breadcrumb"
                 aria-label="Breadcrumb">

                <a asp-controller="Home"
                   asp-action="Index">

                    Home

                </a>

                <i class="bi bi-chevron-right"></i>

                <span>Markets</span>

            </nav>


            <div class="markets-banner-label">

                <i class="bi bi-shop-window"></i>

                <span>LOCAL FARMERS MARKETS</span>

            </div>


            <h1>
                Markets
            </h1>


            <p>
                Explore nearby farmers markets, discover fresh
                products, and support local farmers in your community.
            </p>

        </div>

    </div>

</section>


<!-- =========================================================
     SEARCH & FILTERS
========================================================= -->

<section class="market-search-section">

    <div class="container">

        <div class="market-search-box">

            <div class="search-heading">

                <span class="section-tag">

                    <i class="bi bi-search"></i>

                    FIND YOUR MARKET

                </span>


                <h2>
                    Where will you shop today?
                </h2>


                <p>
                    Search markets by name, location, or operating day.
                </p>

            </div>


            <div class="row g-3 align-items-end">

                <!-- SEARCH -->

                <div class="col-lg-5">

                    <label for="marketSearch"
                           class="form-label">

                        Search markets

                    </label>

                    <div class="input-group market-input-group">

                        <span class="input-group-text">

                            <i class="bi bi-search"></i>

                        </span>

                        <input type="text"
                               id="marketSearch"
                               class="form-control"
                               placeholder="Search market name or location..."
                               autocomplete="off">

                    </div>

                </div>


                <!-- LOCATION -->

                <div class="col-md-4 col-lg-3">

                    <label for="locationFilter"
                           class="form-label">

                        Location

                    </label>

                    <select id="locationFilter"
                            class="form-select">

                        <option value="all">
                            All Locations
                        </option>

                        <option value="karachi">
                            Karachi
                        </option>

                        <option value="lahore">
                            Lahore
                        </option>

                        <option value="islamabad">
                            Islamabad
                        </option>

                    </select>

                </div>


                <!-- DAY -->

                <div class="col-md-4 col-lg-2">

                    <label for="dayFilter"
                           class="form-label">

                        Market Day

                    </label>

                    <select id="dayFilter"
                            class="form-select">

                        <option value="all">
                            All Days
                        </option>

                        <option value="saturday">
                            Saturday
                        </option>

                        <option value="sunday">
                            Sunday
                        </option>

                        <option value="friday">
                            Friday
                        </option>

                        <option value="monday">
                            Monday
                        </option>

                        <option value="tuesday">
                            Tuesday
                        </option>

                        <option value="wednesday">
                            Wednesday
                        </option>

                        <option value="thursday">
                            Thursday
                        </option>

                    </select>

                </div>


                <!-- RESET -->

                <div class="col-md-4 col-lg-2">

                    <button type="button"
                            class="btn btn-market w-100"
                            id="resetFilters">

                        <i class="bi bi-arrow-counterclockwise"></i>

                        Reset

                    </button>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     MARKETS LIST
========================================================= -->

<section class="markets-list-section">

    <div class="container">

        <!-- SECTION HEADING -->

        <div class="section-heading-row">

            <div>

                <span class="section-tag">

                    <i class="bi bi-shop"></i>

                    EXPLORE LOCAL MARKETS

                </span>


                <h2>
                    Find your next market
                </h2>

            </div>


            <span class="market-count"
                  id="marketCount">

                @Model.Markets.Count Markets Found

            </span>

        </div>


        <!-- =================================================
             MARKET GRID
        ================================================== -->

        <div class="row g-4"
             id="marketsGrid">

            @if (Model.Markets.Any())
            {
                foreach (var item in Model.Markets)
                {
                    var market = item.Market;

                    <div class="col-md-6 col-xl-4 market-item"
                         data-name="@market.MarketName"
                         data-location="@market.Address"
                         data-address="@market.Address"
                         data-day="@item.AllDays">

                        <article class="market-card">

                            <!-- IMAGE-FREE MARKET HEADER -->

                            <div class="market-card-image market-card-no-image">

                                <div class="market-card-icon-wrap">
                                    <i class="bi bi-shop"></i>
                                </div>

                                <div class="market-card-header-text">
                                    <span>LOCAL MARKET</span>
                                    <strong>@market.MarketName</strong>
                                </div>

                                <span class="market-status">
                                    <i class="bi bi-circle-fill"></i>
                                    Open Weekly
                                </span>

                                @if (User.Identity?.IsAuthenticated == true &&
                                     User.IsInRole("Customer"))
                                {
                                    <form asp-controller="CustomerMarkets"
                                          asp-action="ToggleFavorite"
                                          method="post"
                                          style="display:contents;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden"
                                               name="marketId"
                                               value="@market.MarketId" />
                                        <input type="hidden"
                                               name="returnUrl"
                                               value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit"
                                                class="favorite-market"
                                                aria-label="Save @market.MarketName"
                                                data-market-id="@market.MarketId">
                                            <i class="bi bi-heart"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    var marketLoginUrl =
                                        "/Auth/Login?returnUrl=" +
                                        Uri.EscapeDataString(
                                            Context.Request.Path +
                                            Context.Request.QueryString);

                                    <button type="button"
                                            class="favorite-market"
                                            aria-label="Sign in to save @market.MarketName"
                                            onclick="window.location.href='@marketLoginUrl'">
                                        <i class="bi bi-heart"></i>
                                    </button>
                                }

                            </div>


                            <!-- BODY -->

                            <div class="market-card-body">

                                <span class="market-day">

                                    <i class="bi bi-calendar3"></i>

                                    @if (item.MarketDays.Any())
                                    {
                                        @item.DisplayDays
                                    }
                                    else
                                    {
                                        <span>Schedule not available</span>
                                    }

                                </span>


                                <p class="market-location">

                                    <i class="bi bi-geo-alt"></i>

                                    @market.Address

                                </p>


                                <p class="market-description">

                                    @if (!string.IsNullOrWhiteSpace(market.Description))
                                    {
                                        @market.Description
                                    }
                                    else
                                    {
                                        <span>
                                            Fresh products from local farmers
                                            in your community.
                                        </span>
                                    }

                                </p>


                                <div class="market-info-row">

                                    <span>

                                        <i class="bi bi-people"></i>

                                        @item.FarmerCount Farmers

                                    </span>


                                    <span>

                                        <i class="bi bi-clock"></i>

                                        @item.OperatingTime

                                    </span>

                                </div>


                                <a asp-controller="Markets"
                                   asp-action="Details"
                                   asp-route-id="@market.MarketId"
                                   class="market-outline-btn">

                                    View Market

                                    <i class="bi bi-arrow-right"></i>

                                </a>

                            </div>

                        </article>

                    </div>
                }
            }
            else
            {
                <div class="col-12">

                    <div class="no-markets-message">

                        <i class="bi bi-shop"></i>

                        <h3>
                            No markets available
                        </h3>

                        <p>
                            There are currently no active markets.
                        </p>

                    </div>

                </div>
            }

        </div>


        <!-- NO RESULTS -->

        <div id="noMarkets"
             class="no-markets-message d-none">

            <i class="bi bi-search"></i>

            <h3>
                No markets found
            </h3>

            <p>
                Try changing your search or filters.
            </p>

        </div>

    </div>

</section>


<!-- =========================================================
     MARKET MAP PREVIEW
========================================================= -->

<section class="market-map-section">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-5">

                <span class="section-tag">

                    <i class="bi bi-map"></i>

                    MARKET LOCATIONS

                </span>


                <h2>
                    Find markets on the map.
                </h2>


                <p>
                    Discover market locations and plan your next
                    pickup with convenient location information.
                </p>


                <div class="map-feature-list">

                    <div>

                        <i class="bi bi-check-circle-fill"></i>

                        View market locations

                    </div>


                    <div>

                        <i class="bi bi-check-circle-fill"></i>

                        Discover nearby farmers

                    </div>


                    <div>

                        <i class="bi bi-check-circle-fill"></i>

                        Plan your pickup route

                    </div>

                </div>


                <p class="map-note">

                    <i class="bi bi-info-circle"></i>

                    @Model.Markets.Count(x =>
                        x.Market.Latitude.HasValue &&
                        x.Market.Longitude.HasValue)
                    live market location(s) are available on OpenStreetMap.

                </p>

                <a asp-controller="Markets"
                   asp-action="Map"
                   class="btn btn-market mt-3">

                    Open Full Map

                    <i class="bi bi-arrow-up-right"></i>

                </a>

            </div>


            <div class="col-lg-7">

                <div class="market-map-preview">

                    <div class="map-preview-top">

                        <span>
                            <i class="bi bi-geo-alt-fill"></i>
                            Market Explorer
                        </span>

                        <span class="map-preview-label">
                            Live OpenStreetMap
                        </span>

                    </div>

                    <div id="marketsPreviewMap"
                         style="height:390px;border-radius:0 0 22px 22px;"></div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     CALL TO ACTION
========================================================= -->

<section class="markets-cta-section">

    <div class="container">

        <div class="markets-cta">

            <div>

                <span class="section-tag">

                    <i class="bi bi-leaf-fill"></i>

                    FRESHNESS STARTS HERE

                </span>


                <h2>
                    Find your local market today.
                </h2>


                <p>
                    Discover fresh products and support local farmers.
                </p>

            </div>


            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-light">

                Back to Home

                <i class="bi bi-arrow-up-right"></i>

            </a>

        </div>

    </div>

</section>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("marketSearch");

            const locationFilter =
                document.getElementById("locationFilter");

            const dayFilter =
                document.getElementById("dayFilter");

            const resetButton =
                document.getElementById("resetFilters");

            const marketItems =
                document.querySelectorAll(".market-item");

            const marketCount =
                document.getElementById("marketCount");

            const noMarkets =
                document.getElementById("noMarkets");


            function filterMarkets() {

                const searchValue =
                    searchInput.value.toLowerCase().trim();

                const selectedLocation =
                    locationFilter.value.toLowerCase();

                const selectedDay =
                    dayFilter.value.toLowerCase();

                let visibleMarkets = 0;


                marketItems.forEach(function (item) {

                    const marketName =
                        (item.dataset.name || "").toLowerCase();

                    const marketAddress =
                        (item.dataset.address || "").toLowerCase();

                    const marketLocation =
                        (item.dataset.location || "").toLowerCase();

                    const marketDays =
                        (item.dataset.day || "").toLowerCase();


                    const matchesSearch =
                        marketName.includes(searchValue) ||
                        marketAddress.includes(searchValue);


                    const matchesLocation =
                        selectedLocation === "all" ||
                        marketLocation.includes(selectedLocation);


                    const matchesDay =
                        selectedDay === "all" ||
                        marketDays
                            .split("|")
                            .includes(selectedDay);


                    if (
                        matchesSearch &&
                        matchesLocation &&
                        matchesDay
                    ) {

                        item.classList.remove("d-none");

                        visibleMarkets++;

                    }
                    else {

                        item.classList.add("d-none");

                    }

                });


                marketCount.textContent =
                    visibleMarkets + " Markets Found";


                if (visibleMarkets === 0) {

                    noMarkets.classList.remove("d-none");

                }
                else {

                    noMarkets.classList.add("d-none");

                }

            }


            /* SEARCH */

            if (searchInput) {

                searchInput.addEventListener(
                    "input",
                    filterMarkets
                );

            }


            /* LOCATION */

            if (locationFilter) {

                locationFilter.addEventListener(
                    "change",
                    filterMarkets
                );

            }


            /* DAY */

            if (dayFilter) {

                dayFilter.addEventListener(
                    "change",
                    filterMarkets
                );

            }


            /* RESET */

            if (resetButton) {

                resetButton.addEventListener(
                    "click",
                    function () {

                        searchInput.value = "";

                        locationFilter.value = "all";

                        dayFilter.value = "all";

                        filterMarkets();

                    }
                );

            }


            /* FAVORITES */

            document
                .querySelectorAll(".favorite-market")
                .forEach(function (button) {

                    button.addEventListener(
                        "click",
                        function () {

                            button.classList.toggle("active");

                            const icon =
                                button.querySelector("i");


                            if (
                                button.classList.contains("active")
                            ) {

                                icon.classList.remove(
                                    "bi-heart"
                                );

                                icon.classList.add(
                                    "bi-heart-fill"
                                );

                            }
                            else {

                                icon.classList.remove(
                                    "bi-heart-fill"
                                );

                                icon.classList.add(
                                    "bi-heart"
                                );

                            }

                        }
                    );

                });


            /* INITIAL FILTER */

            filterMarkets();

        });

    </script>

}

@section Styles {
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>

        /* =========================================================
           MARKETLINK - MARKETS BANNER HERO
           Same Style as Market Details Banner
        ========================================================= */

        .markets-banner-hero {
            position: relative;
            width: calc(100% - 56px);
            min-height: 440px;
            margin: 20px auto 0;
            overflow: hidden;
            border-radius: 0 0 28px 28px;
            background: #174d32;
            isolation: isolate;
        }


        /* =========================================================
           BACKGROUND IMAGE
        ========================================================= */

        .markets-banner-image {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            background-image: url("https://images.unsplash.com/photo-1488459716781-31db52582fe9?auto=format&fit=crop&w=1800&q=85");
            background-size: cover;
            background-position: center;
            /*
               Image fixed while page scrolls
               Creates the parallax/fixed image effect
            */
            background-attachment: fixed;
            z-index: -3;
        }


        /* =========================================================
           DARK GREEN OVERLAY
        ========================================================= */

        .markets-banner-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient( 90deg, rgba(0, 66, 40, 0.96) 0%, rgba(0, 77, 45, 0.88) 28%, rgba(0, 78, 46, 0.58) 55%, rgba(0, 55, 34, 0.20) 100% );
            z-index: -2;
        }


        /* =========================================================
           EXTRA SOFT OVERLAY
        ========================================================= */

        .markets-banner-hero::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient( 180deg, rgba(255,255,255,0.02), rgba(0,0,0,0.08) );
            pointer-events: none;
            z-index: -1;
        }


        /* =========================================================
           CONTAINER
        ========================================================= */

        .markets-banner-hero .container {
            position: relative;
            min-height: 440px;
            display: flex;
            align-items: center;
            z-index: 5;
        }


        /* =========================================================
           HERO CONTENT
        ========================================================= */

        .markets-banner-content {
            width: 100%;
            max-width: 720px;
            padding: 55px 0 55px 62px;
        }


        /* =========================================================
           BREADCRUMB
        ========================================================= */

        .markets-banner-breadcrumb {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 11px;
            margin-bottom: 34px;
            font-size: 14px;
            line-height: 1;
        }


            /* Breadcrumb Links */

            .markets-banner-breadcrumb a {
                color: #ffffff;
                text-decoration: none;
                font-weight: 700;
                transition: all 0.25s ease;
            }


                .markets-banner-breadcrumb a:hover {
                    color: #c9e52f;
                }


            /* Breadcrumb Arrow */

            .markets-banner-breadcrumb i {
                color: #b7d832;
                font-size: 11px;
            }


            /* Current Page */

            .markets-banner-breadcrumb span {
                color: rgba(255,255,255,0.72);
                font-weight: 500;
            }


        /* =========================================================
           LABEL
        ========================================================= */

        .markets-banner-label {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 18px;
            color: #c8e83a;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 1.4px;
            text-transform: uppercase;
        }


            /* Label Icon */

            .markets-banner-label i {
                font-size: 17px;
                color: #c8e83a;
            }


        /* =========================================================
           MAIN HEADING
        ========================================================= */

        .markets-banner-content h1 {
            margin: 0;
            color: #ffffff;
            font-family: "Manrope", sans-serif;
            font-size: clamp(54px, 6vw, 78px);
            line-height: 1.02;
            font-weight: 800;
            letter-spacing: -2.5px;
        }


        /* =========================================================
           DESCRIPTION
        ========================================================= */

        .markets-banner-content p {
            max-width: 650px;
            margin: 22px 0 0;
            color: rgba(255,255,255,0.88);
            font-size: 17px;
            line-height: 1.75;
            font-weight: 400;
        }


        /* =========================================================
           DESKTOP LARGE SCREEN
        ========================================================= */

        @@media (min-width: 1400px) {

            .markets-banner-hero {
                width: calc(100% - 56px);
                min-height: 470px;
            }


                .markets-banner-hero .container {
                    min-height: 470px;
                }


            .markets-banner-content {
                padding-left: 65px;
            }


                .markets-banner-content h1 {
                    font-size: 82px;
                }
        }


        /* =========================================================
           TABLET
        ========================================================= */

        @@media (max-width: 991px) {

            .markets-banner-hero {
                width: calc(100% - 40px);
                min-height: 420px;
                border-radius: 0 0 25px 25px;
            }


                .markets-banner-hero .container {
                    min-height: 420px;
                }


            .markets-banner-content {
                padding: 50px 30px;
            }


                .markets-banner-content h1 {
                    font-size: 58px;
                }


                .markets-banner-content p {
                    max-width: 570px;
                    font-size: 16px;
                }


            .markets-banner-image {
                background-attachment: scroll;
            }
        }


        /* =========================================================
           MOBILE
        ========================================================= */

        @@media (max-width: 767px) {

            .markets-banner-hero {
                width: calc(100% - 24px);
                min-height: 400px;
                margin-top: 14px;
                border-radius: 0 0 22px 22px;
            }


                .markets-banner-hero .container {
                    min-height: 400px;
                    align-items: center;
                }


            .markets-banner-content {
                padding: 45px 20px;
            }


            .markets-banner-breadcrumb {
                margin-bottom: 28px;
                font-size: 13px;
                gap: 9px;
            }


            .markets-banner-label {
                margin-bottom: 14px;
                font-size: 10px;
                letter-spacing: 1.1px;
            }


                .markets-banner-label i {
                    font-size: 15px;
                }


            .markets-banner-content h1 {
                font-size: 48px;
                letter-spacing: -1.5px;
            }


            .markets-banner-content p {
                margin-top: 18px;
                font-size: 15px;
                line-height: 1.65;
            }
            /*
               Mobile par fixed background off
               for better mobile browser performance
            */

            .markets-banner-image {
                background-attachment: scroll;
                background-position: center;
            }


            .markets-banner-overlay {
                background: linear-gradient( 90deg, rgba(0, 65, 39, 0.94) 0%, rgba(0, 70, 42, 0.80) 65%, rgba(0, 55, 34, 0.48) 100% );
            }
        }


        /* =========================================================
           SMALL MOBILE
        ========================================================= */

        @@media (max-width: 480px) {

            .markets-banner-hero {
                width: calc(100% - 16px);
                min-height: 370px;
            }


                .markets-banner-hero .container {
                    min-height: 370px;
                }


            .markets-banner-content {
                padding: 38px 17px;
            }


            .markets-banner-breadcrumb {
                margin-bottom: 25px;
                font-size: 12px;
            }


            .markets-banner-content h1 {
                font-size: 42px;
            }


            .markets-banner-content p {
                font-size: 14px;
                line-height: 1.6;
            }
        }


        /* =========================================================
           SEARCH SECTION
        ========================================================= */

        .market-search-section {
            position: relative;
            padding: 65px 0 30px;
            background: #ffffff;
        }


        /* =========================================================
           SEARCH BOX
        ========================================================= */

        .market-search-box {
            padding: 35px;
            background: #f5f8f1;
            border: 1px solid #e5ebdf;
            border-radius: 24px;
        }


        /* =========================================================
           SEARCH HEADING
        ========================================================= */

        .search-heading h2 {
            margin: 10px 0;
            color: #183b2b;
            font-family: "Manrope", sans-serif;
            font-size: 30px;
            font-weight: 800;
        }

        .search-heading p {
            margin-bottom: 28px;
            color: #7a897d;
        }


        /* =========================================================
           FORM LABEL
