            function filterMarkets() {

                const searchValue =
                    searchInput.value.toLowerCase().trim();

                const selectedLocation =
                    locationFilter.value;

                const selectedDay =
                    dayFilter.value;

                let visibleMarkets = 0;


                marketItems.forEach(function (item) {

                    const marketName =
                        (item.dataset.name || "").toLowerCase();

                    const marketAddress =
                        (item.dataset.address || "").toLowerCase();

                    const marketLocation =
                        item.dataset.location || "";

                    const marketDay =
                        item.dataset.day || "";


                    const matchesSearch =
                        marketName.includes(searchValue) ||
                        marketAddress.includes(searchValue);


                    const matchesLocation =
                        selectedLocation === "all" ||
                        marketLocation === selectedLocation;


                    const matchesDay =
                        selectedDay === "all" ||
                        marketDay === selectedDay;


                    if (
                        matchesSearch &&
                        matchesLocation &&
                        matchesDay
                    ) {

                        item.classList.remove("d-none");

                        visibleMarkets++;

                    }
                    else {

                        item.classList.add("d-none");

                    }

                });


                marketCount.textContent =
                    visibleMarkets + " Markets Found";


                if (visibleMarkets === 0) {

                    noMarkets.classList.remove("d-none");

                }
                else {

                    noMarkets.classList.add("d-none");

                }

            }


            /* SEARCH */

            searchInput.addEventListener(
                "input",
                filterMarkets
            );


            /* LOCATION */

            locationFilter.addEventListener(
                "change",
                filterMarkets
            );


            /* DAY */

            dayFilter.addEventListener(
                "change",
                filterMarkets
            );


            /* RESET */

            resetButton.addEventListener(
                "click",
                function () {

                    searchInput.value = "";

                    locationFilter.value = "all";

                    dayFilter.value = "all";

                    filterMarkets();

                }
            );


            /* FAVORITES */

            document
                .querySelectorAll(".favorite-market")
                .forEach(function (button) {

                    button.addEventListener(
                        "click",
                        function () {

                            button.classList.toggle("active");

                            const icon =
                                button.querySelector("i");


                            if (
                                button.classList.contains("active")
                            ) {

                                icon.classList.remove(
                                    "bi-heart"
                                );

                                icon.classList.add(
                                    "bi-heart-fill"
                                );

                            }
                            else {

                                icon.classList.remove(
                                    "bi-heart-fill"
                                );

                                icon.classList.add(
                                    "bi-heart"
                                );

                            }

                        }
                    );

                });


            /* MARKET DETAILS - TEMPORARY */

            document
                .querySelectorAll(".market-details-btn")
                .forEach(function (button) {

                    button.addEventListener(
                        "click",
                        function () {

                            const marketName =
                                button.dataset.market;

                            alert(
                                "Market details for " +
                                marketName +
                                " will be connected next."
                            );

                        }
                    );
                        
                });


            /* INITIAL FILTER */

            filterMarkets();

        });

    </script>

} *@