    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const mapElement =
                document.getElementById("marketsPreviewMap");

            if (!mapElement) {
                return;
            }

            const marketPoints = [
                @foreach (var item in Model.Markets.Where(x =>
                    x.Market.Latitude.HasValue &&
                    x.Market.Longitude.HasValue))
                {
                    <text>
                    {
                        id: @item.Market.MarketId,
                        name: @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(
                                item.Market.MarketName
                            )
                        ),
                        address: @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(
                                item.Market.Address
                            )
                        ),
                        lat: @item.Market.Latitude.Value.ToString(
                            System.Globalization.CultureInfo.InvariantCulture
                        ),
                        lng: @item.Market.Longitude.Value.ToString(
                            System.Globalization.CultureInfo.InvariantCulture
                        )
                    },
                    </text>
                }
            ];

            if (marketPoints.length === 0) {

                mapElement.innerHTML =
                    '<div style="' +
                    'height:100%;display:grid;place-items:center;' +
                    'padding:30px;text-align:center;color:#667085;' +
                    'background:#f7faf8;">' +
                    '<div><strong>No mapped markets yet.</strong><br>' +
                    'Add latitude and longitude to an active market ' +
                    'and it will appear here automatically.</div>' +
                    '</div>';

                return;
            }

            const map = L.map(
                "marketsPreviewMap",
                {
                    scrollWheelZoom: false
                }
            );

            L.tileLayer(
                "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
                {
                    maxZoom: 19,
                    attribution:
                        "&copy; OpenStreetMap contributors"
                }
            ).addTo(map);

            const bounds = [];

            marketPoints.forEach(function (market) {

                const point = [
                    market.lat,
                    market.lng
                ];

                bounds.push(point);

                const popup =
                    '<div style="min-width:160px;">' +
                    '<strong style="color:#173c2f;">' +
                    market.name +
                    '</strong>' +
                    '<div style="' +
                    'font-size:11px;color:#667085;margin-top:4px;">' +
                    (market.address || "Market location") +
                    '</div>' +
                    '<a href="/Markets/Details/' +
                    market.id +
                    '" style="' +
                    'display:inline-block;margin-top:7px;' +
                    'font-size:11px;font-weight:700;' +
                    'color:#13836e;text-decoration:none;">' +
                    'View Market →</a>' +
                    '</div>';

                L.marker(point)
                    .addTo(map)
                    .bindPopup(popup);
            });

            if (bounds.length === 1) {

                map.setView(
                    bounds[0],
                    14
                );

            }
            else {

                map.fitBounds(
                    bounds,
                    {
                        padding: [30, 30],
                        maxZoom: 14
                    }
                );

            }

            // Leaflet sometimes initializes before the card finishes
            // its final layout. Force a size refresh.
            setTimeout(function () {
                map.invalidateSize();
            }, 150);

        });
    </script>

}


