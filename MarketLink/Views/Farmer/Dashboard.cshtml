<!-- =====================================================
     DASHBOARD API
====================================================== -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        loadFarmerDashboard();

    });


    // =====================================================
    // LOAD DASHBOARD
    // =====================================================

    async function loadFarmerDashboard() {

        const token =
            localStorage.getItem("accessToken");


        // No token means user is not logged in

        if (!token) {

            window.location.href = "/Auth/Login";

            return;
        }


        try {

            const response = await fetch(
                "/api/FarmerDashboard",
                {
                    method: "GET",

                    headers: {
                        "Authorization":
                            "Bearer " + token,

                        "Content-Type":
                            "application/json"
                    }
                }
            );


            // =================================================
            // UNAUTHORIZED
            // =================================================

            if (response.status === 401) {

                localStorage.removeItem("accessToken");
                localStorage.removeItem("refreshToken");

                window.location.href =
                    "/Auth/Login";

                return;
            }


            // =================================================
            // FORBIDDEN
            // =================================================

            if (response.status === 403) {

                alert(
                    "You are not authorized to access the farmer dashboard."
                );

                window.location.href = "/";

                return;
            }


            if (!response.ok) {

                throw new Error(
                    "Failed to load dashboard."
                );

            }


            const dashboard =
                await response.json();


            // =================================================
            // BASIC FARMER INFORMATION
            // =================================================

            document.getElementById(
                "welcomeMessage"
            ).textContent =
                "Good morning, " +
                dashboard.businessName +
                "! 👋";


            // =================================================
            // STATISTICS
            // =================================================

            document.getElementById(
                "totalProducts"
            ).textContent =
                dashboard.totalProducts;


            document.getElementById(
                "pendingOrders"
            ).textContent =
                dashboard.pendingOrders;


            document.getElementById(
                "thisMonthSales"
            ).textContent =
                formatCurrency(
                    dashboard.thisMonthSales
                );


            document.getElementById(
                "averageRating"
            ).textContent =
                Number(
                    dashboard.averageRating
                ).toFixed(1);


            document.getElementById(
                "reviewCount"
            ).textContent =
                "From " +
                dashboard.reviewCount +
                " reviews";


            // =================================================
            // ORDERS
            // =================================================

            renderOrders(
                dashboard.incomingOrders
            );


            // =================================================
            // BEST SELLING PRODUCTS
            // =================================================

            renderBestSellingProducts(
                dashboard.bestSellingProducts
            );


            // =================================================
            // INVENTORY
            // =================================================

            renderStock(
                dashboard.stockOverview
            );


            // =================================================
            // LATEST REVIEW
            // =================================================

            renderLatestReview(
                dashboard.latestReview
            );


            // =================================================
            // MARKET
            // =================================================

            renderMarketStatus(
                dashboard.marketStatus
            );

        }

        catch (error) {

            console.error(
                "Dashboard error:",
                error
            );

            showDashboardError();

        }

    }


    // =====================================================
    // ORDERS
    // =====================================================

    function renderOrders(orders) {

        const container =
            document.getElementById(
                "incomingOrders"
            );


        if (!orders || orders.length === 0) {

            container.innerHTML = `
                <div class="farmer-order-item">
                    <div class="farmer-order-info">
                        <strong>No incoming orders</strong>
                        <span>There are no upcoming orders.</span>
                    </div>
                </div>
            `;

            return;
        }


        container.innerHTML =
            orders.map(function (order) {

                const icon =
                    getOrderIcon(order.orderNo);


                const pickupDate =
                    formatPickupDate(
                        order.pickupDate
                    );


                const statusClass =
                    getStatusClass(
                        order.orderStatus
                    );


                return `

                    <div class="farmer-order-item">

                        <div class="farmer-order-icon">

                            <i class="bi ${icon}"></i>

                        </div>


                        <div class="farmer-order-info">

                            <strong>
                                ${escapeHtml(order.orderNo)}
                            </strong>

                            <span>
                                ${order.itemCount} items ·
                                ${pickupDate}
                            </span>

                        </div>


                        <div class="farmer-order-right">

                            <strong>
                                ${formatCurrency(
                                    order.totalAmount
                                )}
                            </strong>

                            <span class="farmer-order-status ${statusClass}">
                                ${escapeHtml(
                                    order.orderStatus
                                )}
                            </span>

                        </div>

                    </div>

                `;

            }).join("");

    }


    // =====================================================
    // BEST SELLING PRODUCTS
    // =====================================================

    function renderBestSellingProducts(products) {

        const container =
            document.getElementById(
                "bestSellingProducts"
            );


        if (!products || products.length === 0) {

            container.innerHTML = `

                <div class="best-product">

                    <div class="best-product-info">

                        <strong>
                            No sales yet
                        </strong>

                        <span>
                            Product sales will appear here.
                        </span>

                    </div>

                </div>

            `;

            return;
        }


        container.innerHTML =
            products.map(function (product, index) {

                const number =
                    String(index + 1).padStart(2, "0");


                const icon =
                    getProductIcon(
                        product.productName
                    );


                const imageClass =
                    getProductImageClass(
                        product.productName
                    );


                return `

                    <div class="best-product">

                        <div class="best-product-number">
                            ${number}
                        </div>


                        <div class="best-product-image ${imageClass}">

                            <i class="bi ${icon}"></i>

                        </div>


                        <div class="best-product-info">

                            <strong>
                                ${escapeHtml(
                                    product.productName
                                )}
                            </strong>

                            <span>
                                ${product.quantitySold}
                                units sold
                            </span>

                        </div>


                        <strong class="best-product-sales">

                            ${formatCurrency(
                                product.revenue
                            )}

                        </strong>

                    </div>

                `;

            }).join("");

    }


    // =====================================================
    // INVENTORY
    // =====================================================

    function renderStock(stockItems) {

        const container =
            document.getElementById(
                "stockOverview"
            );


        const alertBox =
            document.getElementById(
                "inventoryAlert"
            );


        const alertText =
            document.getElementById(
                "inventoryAlertText"
            );


        if (!stockItems ||
            stockItems.length === 0) {

            container.innerHTML = `

                <div class="stock-row">

                    <div class="stock-product">

                        <strong>
                            No inventory available
                        </strong>

                    </div>

                </div>

            `;

            alertBox.style.display = "none";

            return;
        }


        container.innerHTML =
            stockItems.map(function (stock) {

                let dotClass = "good";
                let textClass = "good-text";


                if (stock.isLowStock) {

                    dotClass = "danger";
                    textClass = "danger-text";

                }


                return `

                    <div class="stock-row">

                        <div class="stock-product">

                            <span class="stock-dot ${dotClass}">
                            </span>

                            <strong>
                                ${escapeHtml(
                                    stock.productName
                                )}
                            </strong>

                        </div>


                        <span class="stock-value ${textClass}">

                            ${stock.availableQuantity}
                            ${escapeHtml(
                                stock.unitName
                            )}

                        </span>

                    </div>

                `;

            }).join("");


        const lowStockCount =
            stockItems.filter(
                function (item) {
                    return item.isLowStock;
                }
            ).length;


        if (lowStockCount > 0) {

            alertBox.style.display = "flex";

            alertText.textContent =
                lowStockCount +
                (
                    lowStockCount === 1
                        ? " product is"
                        : " products are"
                ) +
                " running low on stock.";

        }

        else {

            alertBox.style.display = "none";

        }

    }


    // =====================================================
    // LATEST REVIEW
    // =====================================================

    function renderLatestReview(review) {

        const container =
            document.getElementById(
                "latestReview"
            );


        if (!review) {

            container.innerHTML = `

                <div class="review-text">

                    <strong>
                        No reviews yet
                    </strong>

                    <p>
                        Customer reviews will appear here.
                    </p>

                </div>

            `;

            return;
        }


        const firstLetter =
            review.customerName
                ? review.customerName
                    .charAt(0)
                    .toUpperCase()
                : "C";


        container.innerHTML = `

            <div class="review-avatar">
                ${escapeHtml(firstLetter)}
            </div>


            <div class="review-text">

                <div class="review-top">

                    <strong>
                        ${escapeHtml(
                            review.customerName
                        )}
                    </strong>

                    <span>

                        <i class="bi bi-star-fill"></i>

                        ${Number(
                            review.rating
                        ).toFixed(1)}

                    </span>

                </div>


                <p>
                    "${escapeHtml(
                        review.comment
                    )}"
                </p>


                <small>
                    ${formatRelativeDate(
                        review.reviewDate
                    )}
                </small>

            </div>

        `;

    }


    // =====================================================
    // MARKET STATUS
    // =====================================================

    function renderMarketStatus(market) {

        const container =
            document.getElementById(
                "marketStatus"
            );


        if (!market) {

            container.innerHTML = `

                <div class="market-status-icon">

                    <i class="bi bi-shop"></i>

                </div>


                <div>

                    <strong>
                        No active market
                    </strong>

                    <span>
                        You are not currently assigned
                        to an active market day.
                    </span>

                </div>

            `;

            return;
        }


        const statusClass =
            market.status === "Active"
                ? "market-active"
                : "";


        container.innerHTML = `

            <div class="market-status-icon">

                <i class="bi bi-shop"></i>

            </div>


            <div>

                <strong>
                    ${escapeHtml(
                        market.marketName
                    )}
                </strong>

                <span>

                    ${escapeHtml(
                        market.dayName
                    )}
                    ·
                    ${formatTime(
                        market.openingTime
                    )}
                    -
                    ${formatTime(
                        market.closingTime
                    )}

                </span>

            </div>


            <span class="${statusClass}">
                ${escapeHtml(
                    market.status
                )}
            </span>

        `;

    }


    // =====================================================
    // FORMAT CURRENCY
    // =====================================================

    function formatCurrency(value) {

        const amount =
            Number(value || 0);


        return "$" +
            amount.toLocaleString(
                "en-US",
                {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }
            );

    }


    // =====================================================
    // FORMAT PICKUP DATE
    // =====================================================

    function formatPickupDate(dateValue) {

        if (!dateValue) {
            return "";
        }


        const date =
            new Date(dateValue);


        const today =
            new Date();


        today.setHours(0, 0, 0, 0);


        const tomorrow =
            new Date(today);


        tomorrow.setDate(
            tomorrow.getDate() + 1
        );


        const orderDate =
            new Date(date);


        orderDate.setHours(0, 0, 0, 0);


        if (
            orderDate.getTime() ===
            today.getTime()
        ) {

            return "Today";

        }


        if (
            orderDate.getTime() ===
            tomorrow.getTime()
        ) {

            return "Tomorrow";

        }


        return date.toLocaleDateString(
            "en-US",
            {
                month: "short",
                day: "numeric"
            }
        );

    }


    // =====================================================
    // FORMAT TIME
    // =====================================================

    function formatTime(timeValue) {

        if (!timeValue) {
            return "";
        }


        /*
         * TimeSpan from ASP.NET usually arrives as:
         *
         * "08:00:00"
         *
         * or
         *
         * "14:00:00"
         */


        const parts =
            timeValue.split(":");


        const hours =
            parseInt(parts[0]);


        const minutes =
            parseInt(parts[1] || 0);


        const period =
            hours >= 12
                ? "PM"
                : "AM";


        let displayHour =
            hours % 12;


        if (displayHour === 0) {
            displayHour = 12;
        }


        return displayHour +
            ":" +
            String(minutes).padStart(2, "0") +
            " " +
            period;

    }


    // =====================================================
    // RELATIVE REVIEW DATE
    // =====================================================

    function formatRelativeDate(dateValue) {

        if (!dateValue) {
            return "";
        }


        const reviewDate =
            new Date(dateValue);


        const now =
            new Date();


        const difference =
            now.getTime() -
            reviewDate.getTime();


        const minutes =
            Math.floor(
                difference / 60000
            );


        if (minutes < 1) {
            return "Just now";
        }


        if (minutes < 60) {

            return minutes +
                (
                    minutes === 1
                        ? " minute ago"
                        : " minutes ago"
                );

        }


        const hours =
            Math.floor(
                minutes / 60
            );


        if (hours < 24) {

            return hours +
                (
                    hours === 1
                        ? " hour ago"
                        : " hours ago"
                );

        }


        const days =
            Math.floor(
                hours / 24
            );


        if (days < 7) {

            return days +
                (
                    days === 1
                        ? " day ago"
                        : " days ago"
                );

        }


        return reviewDate.toLocaleDateString(
            "en-US",
            {
                month: "short",
                day: "numeric",
                year: "numeric"
            }
        );

    }


    // =====================================================
    // ORDER ICON
    // =====================================================

    function getOrderIcon(orderNo) {

        return "bi-basket";

    }


    // =====================================================
    // ORDER STATUS CLASS
    // =====================================================

    function getStatusClass(status) {

        if (!status) {
            return "pending";
        }


        const normalized =
            status.toLowerCase();


        if (
            normalized === "accepted" ||
            normalized === "confirmed"
        ) {

            return "accepted";

        }


        if (
            normalized === "ready" ||
            normalized === "completed"
        ) {

            return "ready";

        }


        return "pending";

    }


    // =====================================================
    // PRODUCT ICON
    // =====================================================

    function getProductIcon(productName) {

        const name =
            (productName || "")
                .toLowerCase();


        if (
            name.includes("apple") ||
            name.includes("fruit")
        ) {

            return "bi-apple";

        }


        if (
            name.includes("egg")
        ) {

            return "bi-egg";

        }


        if (
            name.includes("herb") ||
            name.includes("vegetable")
        ) {

            return "bi-flower1";

        }


        return "bi-basket";

    }


    // =====================================================
    // PRODUCT IMAGE CLASS
    // =====================================================

    function getProductImageClass(productName) {

        const name =
            (productName || "")
                .toLowerCase();


        if (name.includes("apple")) {
            return "apple";
        }


        if (
            name.includes("herb") ||
            name.includes("vegetable")
        ) {

            return "herbs";

        }


        return "tomato";

    }


    // =====================================================
    // HTML ESCAPE
    // =====================================================

    function escapeHtml(value) {

        if (value === null ||
            value === undefined) {

            return "";

        }


        return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");

    }


    // =====================================================
    // DASHBOARD ERROR
    // =====================================================

    function showDashboardError() {

        const message =
            document.getElementById(
                "welcomeMessage"
            );


        if (message) {

            message.textContent =
                "Unable to load your dashboard.";

        }

    }

</script>