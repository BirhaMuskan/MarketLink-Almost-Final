@model MarketLink.ViewModels.CartViewModel

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="cart-page">

    <!-- =========================================================
         CART HERO
    ========================================================== -->

    <section class="cart-page-hero">

        <div class="cart-hero-overlay"></div>

        <div class="cart-hero-pattern"></div>

        <div class="container">

            <div class="cart-hero-content">

                <div class="cart-breadcrumbs">

                    <a asp-controller="Home"
                       asp-action="Index">
                        Home
                    </a>

                    <i class="bi bi-chevron-right"></i>

                    <span>Cart</span>

                </div>

                <div class="cart-hero-label">

                    <i class="bi bi-basket3-fill"></i>

                    YOUR SHOPPING CART

                </div>

                <h1>
                    Your Cart
                </h1>

                <p>
                    Review your selected fresh products and get
                    everything ready for your next market pickup.
                </p>

            </div>

        </div>

    </section>


    <!-- =========================================================
         CART CONTENT
    ========================================================== -->

    <section class="cart-section">

        <div class="container">

            <div class="row g-4">


                <!-- =================================================
                     CART ITEMS
                ================================================== -->

                <div class="col-lg-8">

                    <div class="cart-main-card">

                        <!-- HEADER -->

                        <div class="cart-card-header">

                            <div>

                                <span class="cart-section-label">

                                    <i class="bi bi-basket2-fill"></i>

                                    YOUR CART

                                </span>

                                <h2>
                                    Shopping Items
                                </h2>

                            </div>

                            <span class="cart-items-count">

                                <span id="cartCount">
                                    @Model.TotalQuantity.ToString("0.###")
                                </span>

                                Items

                            </span>

                        </div>


                        <!-- =================================================
                             CART ITEMS
                        ================================================== -->

                        <div id="cartItems">

                            @if (!Model.IsEmpty)
                            {
                                foreach (var item in Model.Items)
                                {
                                    <div class="cart-item"
                                         data-id="@item.CartItemId"
                                         data-price="@item.UnitPrice">

                                        <!-- IMAGE -->

                                        <div class="cart-product-image">

                                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl"
                                                     alt="@item.ProductName"
                                                     onerror="this.src='https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=400&q=80';" />
                                            }
                                            else
                                            {
                                                <img src="https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=400&q=80"
                                                     alt="@item.ProductName" />
                                            }

                                        </div>


                                        <!-- PRODUCT DETAILS -->

                                        <div class="cart-product-details">

                                            <span class="cart-product-category">
                                                @item.CategoryName
                                            </span>

                                            <h3>
                                                @item.ProductName
                                            </h3>

                                            @if (!string.IsNullOrWhiteSpace(item.ProductDescription))
                                            {
                                                <p>
                                                    @item.ProductDescription
                                                </p>
                                            }

                                            <span class="cart-product-price">

                                                Rs.
                                                @item.UnitPrice.ToString("N2")

                                                @if (!string.IsNullOrWhiteSpace(item.UnitName))
                                                {
                                                    <small>
                                                        / @item.UnitName
                                                    </small>
                                                }

                                            </span>

                                        </div>


                                        <!-- QUANTITY -->

                                        <div class="cart-quantity">

                                            <span class="quantity-label">
                                                Quantity
                                            </span>

                                            <div class="quantity-box">

                                                <button type="button"
                                                        class="quantity-btn minus-btn"
                                                        aria-label="Decrease quantity">

                                                    <i class="bi bi-dash"></i>

                                                </button>

                                                <span class="quantity-value">
                                                    @item.Quantity.ToString("0.###")
                                                </span>

                                                <button type="button"
                                                        class="quantity-btn plus-btn"
                                                        aria-label="Increase quantity">

                                                    <i class="bi bi-plus"></i>

                                                </button>

                                            </div>

                                        </div>


                                        <!-- TOTAL -->

                                        <div class="cart-item-total">

                                            <span class="item-total-label">
                                                Total
                                            </span>

                                            <strong class="item-total-value">

                                                Rs.
                                                @item.TotalPrice.ToString("N2")

                                            </strong>

                                        </div>


                                        <!-- REMOVE -->

                                        <button type="button"
                                                class="remove-item"
                                                aria-label="Remove item">

                                            <i class="bi bi-trash3"></i>

                                        </button>

                                    </div>
                                }
                            }

                        </div>


                        <!-- =================================================
                             EMPTY CART
                        ================================================== -->

                        <div id="emptyCart"
                             class="empty-cart"
                             style="@(Model.IsEmpty ? "" : "display:none;")">

                            <div class="empty-cart-icon">

                                <i class="bi bi-basket"></i>

                            </div>

                            <h3>
                                Your cart is empty
                            </h3>

                            <p>
                                You haven't added any products to your cart yet.
                            </p>

                            <a asp-controller="Products"
                               asp-action="Index"
                               class="continue-shopping-btn">

                                <i class="bi bi-arrow-left"></i>

                                Browse Products

                            </a>

                        </div>


                        <!-- =================================================
                             BOTTOM ACTIONS
                        ================================================== -->

                        <div class="cart-bottom-actions"
                             id="cartBottomActions"
                             style="@(Model.IsEmpty ? "display:none;" : "")">

                            <a asp-controller="Products"
                               asp-action="Index"
                               class="continue-shopping">

                                <i class="bi bi-arrow-left"></i>

                                Continue Shopping

                            </a>

                            <button type="button"
                                    class="clear-cart-btn"
                                    id="clearCartBtn">

                                <i class="bi bi-trash3"></i>

                                Clear Cart

                            </button>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     ORDER SUMMARY
                ================================================== -->

                <div class="col-lg-4">

                    <div class="cart-summary-card"
                         id="cartSummaryCard">

                        <!-- HEADER -->

                        <div class="summary-header">

                            <span class="summary-label">

                                <i class="bi bi-receipt"></i>

                                ORDER SUMMARY

                            </span>

                            <h2>
                                Your Order
                            </h2>

                        </div>


                        <!-- SUMMARY -->

                        <div class="summary-items">

                            <div class="summary-row">

                                <span>
                                    Items
                                </span>

                                <strong id="summaryItems">

                                    @Model.TotalQuantity.ToString("0.###")

                                </strong>

                            </div>


                            <div class="summary-row">

                                <span>
                                    Subtotal
                                </span>

                                <strong id="subtotal">

                                    Rs.
                                    @Model.Subtotal.ToString("N2")

                                </strong>

                            </div>


                            <div class="summary-row">

                                <span>
                                    Pickup
                                </span>

                                <strong class="pickup-free">
                                    Free
                                </strong>

                            </div>

                        </div>


                        <div class="summary-divider"></div>


                        <!-- TOTAL -->

                        <div class="summary-total">

                            <span>
                                Total
                            </span>

                            <strong id="grandTotal">

                                Rs.
                                @Model.GrandTotal.ToString("N2")

                            </strong>

                        </div>


                        <!-- PICKUP NOTICE -->

                        <div class="pickup-notice">

                            <div class="pickup-notice-icon">

                                <i class="bi bi-shop"></i>

                            </div>

                            <div>

                                <strong>
                                    Market Pickup
                                </strong>

                                <p>
                                    Payment is made in person
                                    when you collect your order.
                                </p>

                            </div>

                        </div>


                        <!-- CHECKOUT -->

                        <a asp-controller="Checkout"
                           asp-action="Index"
                           class="checkout-btn"
                           id="checkoutBtn"
                           style="@(Model.IsEmpty ? "pointer-events:none;opacity:.5;" : "")">

                            <span>
                                Continue to Pre-Order
                            </span>

                            <i class="bi bi-arrow-right"></i>

                        </a>


                        <!-- SECURITY -->

                        <div class="secure-checkout">

                            <i class="bi bi-shield-check"></i>

                            Secure MarketLink ordering

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>

</div>


<!-- =========================================================
     ANTI FORGERY TOKEN
========================================================== -->

<form id="cartAntiForgeryForm"
      asp-controller="Cart"
      asp-action="UpdateQuantity"
      method="post"
      style="display:none;">

    @Html.AntiForgeryToken()

</form>


@section Styles {

    <link rel="stylesheet"
          href="~/css/cart.css"
          asp-append-version="true" />
}


@section Scripts {

    <script src="~/js/cart.js"
            asp-append-version="true"></script>
}