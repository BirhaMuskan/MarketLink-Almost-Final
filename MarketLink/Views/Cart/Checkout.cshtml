@model MarketLink.ViewModels.CustomerCheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
<style>
.website-checkout{max-width:1240px;margin:0 auto;padding:42px 20px 72px}
.checkout-top{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:24px}
.checkout-kicker{display:inline-flex;align-items:center;gap:7px;color:#13836e;font-size:11px;font-weight:800;letter-spacing:.1em}
.checkout-top h1{margin:7px 0 5px;color:#173c2f;font-size:clamp(30px,4vw,44px);font-weight:800}
.checkout-top p{margin:0;color:#667085}
.checkout-back{color:#174d36;text-decoration:none;font-size:12px;font-weight:800}
.checkout-grid{display:grid;grid-template-columns:minmax(0,1fr) 365px;gap:22px;align-items:start}
.checkout-panel{background:#fff;border:1px solid #e5e9e7;border-radius:22px;box-shadow:0 14px 38px rgba(16,24,40,.06);overflow:hidden}
.checkout-panel-head{display:flex;align-items:center;gap:13px;padding:20px 22px;border-bottom:1px solid #edf1ef;background:#fbfcfa}
.checkout-panel-icon{width:42px;height:42px;border-radius:12px;background:#edf7f2;color:#13836e;display:grid;place-items:center;font-size:18px}
.checkout-panel-head span{display:block;color:#6b9b58;font-size:9px;font-weight:800;letter-spacing:.12em;margin-bottom:3px}
.checkout-panel-head h3{margin:0;color:#173c2f;font-size:17px}
.checkout-form-body{padding:22px}
.checkout-field{margin-bottom:20px}
.checkout-field label{display:block;margin-bottom:8px;color:#344054;font-size:12px;font-weight:800}
.checkout-field select,.checkout-field textarea{width:100%;border:1px solid #d7ddda;border-radius:13px;padding:13px 14px;background:#fff;color:#25332d;outline:none;transition:.2s}
.checkout-field select:focus,.checkout-field textarea:focus{border-color:#13836e;box-shadow:0 0 0 4px rgba(19,131,110,.08)}
.checkout-help{display:flex;gap:10px;align-items:flex-start;background:#f4f8f5;border:1px solid #e6eee9;border-radius:13px;padding:12px 13px;margin-bottom:20px;color:#667085;font-size:11px;line-height:1.5}
.checkout-help i{color:#13836e;margin-top:1px}
.place-btn{width:100%;border:0;border-radius:13px;padding:14px 18px;background:#13836e;color:#fff;font-weight:800;cursor:pointer;box-shadow:0 8px 20px rgba(19,131,110,.16)}
.place-btn:hover{background:#106f5e}
.no-slots{padding:18px;background:#fff7ed;border:1px solid #fed7aa;color:#9a3412;border-radius:14px;font-size:12px;line-height:1.6}
.order-summary{position:sticky;top:118px}
.order-market{padding:18px 20px;border-bottom:1px solid #edf1ef}
.order-market span{display:block;color:#6b9b58;font-size:9px;font-weight:800;letter-spacing:.12em}
.order-market strong{display:block;margin-top:4px;color:#173c2f;font-size:18px}
.order-market small{display:block;margin-top:3px;color:#667085}
.checkout-items{padding:7px 18px}
.checkout-item{display:flex;justify-content:space-between;gap:16px;padding:14px 2px;border-bottom:1px solid #edf1ef}
.checkout-item:last-child{border-bottom:0}
.checkout-item strong{color:#25332d;font-size:13px}
.checkout-item span{display:block;color:#8a938e;font-size:10px;margin-top:3px}
.checkout-item-price{white-space:nowrap;color:#173c2f!important}
.total-row{display:flex;justify-content:space-between;gap:14px;padding:18px 20px;background:#fbfcfa;border-top:1px solid #edf1ef;color:#173c2f;font-size:15px;font-weight:800}
.payment-note{display:flex;align-items:flex-start;gap:9px;margin-top:14px;padding:12px 13px;border-radius:12px;background:#f8faf9;color:#667085;font-size:10px}
.payment-note i{color:#13836e}
@@media(max-width:900px){.checkout-grid{grid-template-columns:1fr}.order-summary{position:static}.checkout-top{align-items:flex-start;flex-direction:column}}
</style>
}

<div class="website-checkout">

    <div class="checkout-top">
        <div>
            <span class="checkout-kicker">
                <i class="bi bi-bag-check"></i>
                PRE-ORDER CHECKOUT
            </span>

            <h1>Choose your pickup</h1>

            <p>
                @Model.FarmerName · @Model.MarketName
            </p>
        </div>

        <a asp-controller="Cart"
           asp-action="Index"
           class="checkout-back">
            <i class="bi bi-arrow-left"></i>
            Back to Cart
        </a>
    </div>

    <div class="checkout-grid">

        <section class="checkout-panel">

            <div class="checkout-panel-head">
                <div class="checkout-panel-icon">
                    <i class="bi bi-calendar2-check"></i>
                </div>

                <div>
                    <span>PICKUP DETAILS</span>
                    <h3>Select a pickup slot</h3>
                </div>
            </div>

            <div class="checkout-form-body">

                <form asp-controller="Cart"
                      asp-action="Checkout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input asp-for="CartId"
                           type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    @if (!Model.PickupSlots.Any())
                    {
                        <div class="no-slots">
                            <strong>No suitable pickup slots are currently available.</strong><br />
                            The selected slot must have enough dated inventory for every product in this order.
                            Try again later or adjust the cart.
                        </div>
                    }
                    else
                    {
                        <div class="checkout-help">
                            <i class="bi bi-info-circle"></i>
                            <div>
                                Choose the date and time that works for you.
                                The number shown at the end is the remaining pickup capacity.
                            </div>
                        </div>

                        <div class="checkout-field">
                            <label asp-for="PickupSlotId">
                                Pickup date & time
                            </label>

                            <select asp-for="PickupSlotId">
                                <option value="">
                                    Select a pickup slot
                                </option>

                                @foreach (var slot in Model.PickupSlots)
                                {
                                    <option value="@slot.PickupSlotId">
                                        @slot.DisplayText
                                    </option>
                                }
                            </select>

                            <span asp-validation-for="PickupSlotId"
                                  class="text-danger"></span>
                        </div>

                        <div class="checkout-field">
                            <label asp-for="CustomerNotes">
                                Order notes
                            </label>

                            <textarea asp-for="CustomerNotes"
                                      rows="4"
                                      placeholder="Anything the farmer should know about your pickup?"></textarea>

                            <span asp-validation-for="CustomerNotes"
                                  class="text-danger"></span>
                        </div>

                        <button type="submit"
                                class="place-btn">
                            <i class="bi bi-check2-circle"></i>
                            Place Pre-order
                        </button>

                        <div class="payment-note">
                            <i class="bi bi-cash-coin"></i>
                            <span>
                                No online payment is taken. Payment is made when you collect your order.
                            </span>
                        </div>
                    }

                </form>

            </div>

        </section>

        <aside class="checkout-panel order-summary">

            <div class="order-market">
                <span>YOUR ORDER</span>
                <strong>@Model.MarketName</strong>
                <small>@Model.FarmerName</small>
            </div>

            <div class="checkout-items">

                @foreach (var item in Model.Items)
                {
                    <div class="checkout-item">
                        <div>
                            <strong>@item.ProductName</strong>

                            <span>
                                @item.Quantity.ToString("N3")
                                @item.UnitName
                            </span>
                        </div>

                        <strong class="checkout-item-price">
                            Rs. @item.LineTotal.ToString("N2")
                        </strong>
                    </div>
                }

            </div>

            <div class="total-row">
                <span>Estimated Total</span>
                <span>Rs. @Model.EstimatedTotal.ToString("N2")</span>
            </div>

        </aside>

    </div>

</div>
