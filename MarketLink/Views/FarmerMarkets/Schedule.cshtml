@model MarketLink.ViewModels.FarmerMarketSchedulePageViewModel

@{
    ViewData["Title"] = "Pickup Schedule";
    Layout = "~/Views/Shared/_FarmerDashboardLayout.cshtml";
}

<section class="schedule-header">
    <div>
        <span class="schedule-label">
            <i class="bi bi-calendar-week"></i>
            PICKUP SCHEDULE
        </span>

        <h2>@Model.MarketName</h2>
        <p>@Model.Address</p>
    </div>

    <a asp-controller="FarmerMarkets"
       asp-action="Index"
       class="back-link">
        <i class="bi bi-arrow-left"></i>
        Back to My Markets
    </a>
</section>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-warning">
        @TempData["ErrorMessage"]
    </div>
}

<div class="schedule-note">
    <i class="bi bi-info-circle"></i>
    <span>
        The administrator controls the market's operating days and hours.
        You choose which of those days you attend and define your customer
        pickup window and order cutoff.
    </span>
</div>

@if (!Model.Days.Any())
{
    <section class="schedule-card empty">
        <i class="bi bi-calendar-x"></i>
        <h3>No operating days available</h3>
        <p>
            The administrator has not configured any active operating
            days for this market yet.
        </p>
    </section>
}
else
{
    <section class="schedule-list">

        @foreach (var day in Model.Days)
        {
            var openText =
                DateTime.Today.Add(day.MarketOpeningTime)
                    .ToString("hh:mm tt");

            var closeText =
                DateTime.Today.Add(day.MarketClosingTime)
                    .ToString("hh:mm tt");

            <article class="schedule-card">

                <div class="day-heading">
                    <div>
                        <span class="day-name">@day.DayName</span>

                        <strong>
                            Market: @openText - @closeText
                        </strong>
                    </div>

                    @if (day.IsConfigured && day.IsActive)
                    {
                        <span class="configured-badge">
                            Configured
                        </span>
                    }
                </div>

                <form asp-controller="FarmerMarkets"
                      asp-action="SaveDaySchedule"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="FarmerMarketId"
                           value="@Model.FarmerMarketId" />

                    <input type="hidden"
                           name="MarketDayId"
                           value="@day.MarketDayId" />

                    <div class="time-grid">

                        <div class="time-field">
                            <label>Pickup Start</label>

                            <input type="time"
                                   name="PickupStartTime"
                                   value="@day.PickupStartTime.ToString(@"hh\:mm")"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="time-field">
                            <label>Pickup End</label>

                            <input type="time"
                                   name="PickupEndTime"
                                   value="@day.PickupEndTime.ToString(@"hh\:mm")"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="time-field">
                            <label>Order Cutoff</label>

                            <input type="time"
                                   name="OrderCutoffTime"
                                   value="@day.OrderCutoffTime.ToString(@"hh\:mm")"
                                   class="form-control"
                                   required />
                        </div>

                    </div>

                    <div class="schedule-footer">

                        <label class="active-check">
                            <input type="checkbox"
                                   name="IsActive"
                                   value="true"
                                   @(day.IsActive ? "checked" : "") />

                            <span>
                                I attend this market on @day.DayName
                            </span>
                        </label>

                        <button type="submit"
                                class="save-btn">
                            <i class="bi bi-check-lg"></i>
                            Save @day.DayName
                        </button>

                    </div>

                </form>

            </article>
        }

    </section>
}

@section Styles {
<style>
.schedule-header{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:20px}
.schedule-label{color:#14836f;font-size:12px;font-weight:800;letter-spacing:.08em}
.schedule-header h2{margin:7px 0 5px;font-size:28px;font-weight:800}
.schedule-header p{margin:0;color:#667085}
.back-link{text-decoration:none;color:#475467;font-weight:700;font-size:13px}
.schedule-note{display:flex;gap:9px;background:#eff8ff;color:#175cd3;padding:12px 14px;border-radius:11px;margin-bottom:16px;font-size:12px}
.schedule-list{display:grid;gap:13px}
.schedule-card{background:#fff;border:1px solid #e7ebef;border-radius:16px;padding:18px}
.schedule-card.empty{text-align:center;padding:60px 20px;color:#667085}
.schedule-card.empty i{font-size:32px;color:#13836e}
.day-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-bottom:13px;border-bottom:1px solid #edf0f4}
.day-name{display:block;font-size:17px;font-weight:800;color:#172033}
.day-heading strong{display:block;color:#667085;font-size:11px;margin-top:2px}
.configured-badge{background:#dcfae6;color:#067647;padding:5px 9px;border-radius:999px;font-size:10px;font-weight:800}
.time-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;padding-top:15px}
.time-field label{display:block;margin-bottom:6px;color:#344054;font-size:11px;font-weight:800}
.schedule-footer{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:15px}
.active-check{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:700}
.save-btn{border:0;background:#13836e;color:#fff;padding:9px 13px;border-radius:9px;font-size:12px;font-weight:700}
@@media(max-width:700px){.schedule-header{align-items:flex-start;flex-direction:column}.time-grid{grid-template-columns:1fr}.schedule-footer{align-items:stretch;flex-direction:column}.save-btn{width:100%}}
</style>
}
