@model MarketLink.Models.Market

@{
    ViewData["Title"] = "Market Map";
    Layout = "~/Views/Shared/_FarmerDashboardLayout.cshtml";

    string stall = ViewBag.StallNumber as string ?? "";
    string instructions = ViewBag.PickupInstructions as string ?? "";
}

@section Styles {
<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
.map-header{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:20px}
.map-label{color:#14836f;font-size:12px;font-weight:800;letter-spacing:.08em}
.map-header h2{margin:7px 0 5px;font-size:28px;font-weight:800}
.map-header p{margin:0;color:#667085}
.back-link{text-decoration:none;color:#475467;font-weight:700;font-size:13px}
.map-grid{display:grid;grid-template-columns:1.5fr .7fr;gap:18px}
.map-card,.info-card{background:#fff;border:1px solid #e7ebef;border-radius:18px;overflow:hidden}
#farmerMarketMap{height:520px;width:100%}
.info-card{padding:18px}
.info-row{padding:11px 0;border-bottom:1px solid #edf0f4}
.info-row span{display:block;color:#98a2b3;font-size:10px;text-transform:uppercase;font-weight:800}
.info-row strong{display:block;color:#344054;font-size:13px;margin-top:3px}
.map-missing{height:400px;display:grid;place-items:center;text-align:center;color:#667085}
@@media(max-width:900px){.map-grid{grid-template-columns:1fr}}
</style>
}

<section class="map-header">
    <div>
        <span class="map-label">
            <i class="bi bi-map"></i>
            MARKET LOCATION
        </span>

        <h2>@Model.MarketName</h2>
        <p>@Model.Address</p>
    </div>

    <a asp-controller="FarmerMarkets"
       asp-action="Index"
       class="back-link">
        <i class="bi bi-arrow-left"></i>
        Back to My Markets
    </a>
</section>

<div class="map-grid">

    <section class="map-card">
        @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
        {
            <div id="farmerMarketMap"></div>
        }
        else
        {
            <div class="map-missing">
                This market does not have coordinates yet.
            </div>
        }
    </section>

    <section class="info-card">
        <div class="info-row">
            <span>Market</span>
            <strong>@Model.MarketName</strong>
        </div>

        <div class="info-row">
            <span>Address</span>
            <strong>@Model.Address</strong>
        </div>

        <div class="info-row">
            <span>Your Stall</span>
            <strong>
                @(string.IsNullOrWhiteSpace(stall)
                    ? "Not set"
                    : stall)
            </strong>
        </div>

        <div class="info-row">
            <span>Pickup Instructions</span>
            <strong>
                @(string.IsNullOrWhiteSpace(instructions)
                    ? "Not set"
                    : instructions)
            </strong>
        </div>
    </section>

</div>

@if (Model.Latitude.HasValue && Model.Longitude.HasValue)
{
    @section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
    document.addEventListener("DOMContentLoaded", function () {

        const lat = @Model.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        const lng = @Model.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);

        const map = L.map("farmerMarketMap")
            .setView([lat, lng], 16);

        L.tileLayer(
            "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
            {
                maxZoom: 19,
                attribution: "&copy; OpenStreetMap contributors"
            }
        ).addTo(map);

        L.marker([lat, lng])
            .addTo(map)
            .bindPopup(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MarketName)))
            .openPopup();

        setTimeout(function () {
            map.invalidateSize();
        }, 150);
    });
    </script>
    }
}
