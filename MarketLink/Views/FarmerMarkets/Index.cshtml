@model MarketLink.ViewModels.FarmerMarketsPageViewModel

@{
    ViewData["Title"] = "My Markets";
    Layout = "~/Views/Shared/_FarmerDashboardLayout.cshtml";
}

<section class="fm-header">
    <div>
        <span class="fm-label">
            <i class="bi bi-shop"></i>
            FARMER CENTER
        </span>

        <h2>My Markets</h2>

        <p>
            Manage where you sell, your stall details and your pickup schedule.
        </p>
    </div>

    <a asp-controller="FarmerMarkets"
       asp-action="Create"
       class="fm-primary-btn">
        <i class="bi bi-plus-lg"></i>
        Add Market
    </a>
</section>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-warning">
        @TempData["ErrorMessage"]
    </div>
}

<section class="fm-stats">
    <div>
        <span>Total Markets</span>
        <strong>@Model.TotalMarkets</strong>
    </div>

    <div>
        <span>Active Markets</span>
        <strong>@Model.ActiveMarkets</strong>
    </div>

    <div>
        <span>Scheduled Days</span>
        <strong>@Model.ScheduledDays</strong>
    </div>
</section>

<section class="fm-card">

    @if (!Model.Markets.Any())
    {
        <div class="fm-empty">
            <i class="bi bi-shop"></i>
            <h3>No markets selected yet</h3>

            <p>
                Choose an active market created by the administrator,
                then configure your pickup schedule.
            </p>

            <a asp-controller="FarmerMarkets"
               asp-action="Create"
               class="fm-primary-btn">
                Choose Market
            </a>
        </div>
    }
    else
    {
        <div class="fm-list">

            @foreach (var item in Model.Markets)
            {
                <article class="fm-row">

                    <div class="fm-icon">
                        <i class="bi bi-shop"></i>
                    </div>

                    <div class="fm-main">

                        <div class="fm-title-row">
                            <div>
                                <h3>@item.MarketName</h3>

                                <span>
                                    <i class="bi bi-geo-alt"></i>
                                    @item.Address
                                </span>
                            </div>

                            <span class="fm-status @(item.IsActive ? "active" : "inactive")">
                                @(item.IsActive ? "Active" : "Inactive")
                            </span>
                        </div>

                        <div class="fm-meta">
                            <div>
                                <span>Stall</span>
                                <strong>
                                    @(string.IsNullOrWhiteSpace(item.StallNumber)
                                        ? "Not set"
                                        : item.StallNumber)
                                </strong>
                            </div>

                            <div>
                                <span>Market Days</span>
                                <strong>@item.OperatingDaysText</strong>
                            </div>

                            <div>
                                <span>Your Schedule</span>
                                <strong>@item.FarmerScheduleText</strong>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.PickupInstructions))
                        {
                            <p class="fm-instructions">
                                <i class="bi bi-info-circle"></i>
                                @item.PickupInstructions
                            </p>
                        }
                    </div>

                    <div class="fm-actions">

                        <a asp-controller="FarmerMarkets"
                           asp-action="Map"
                           asp-route-id="@item.FarmerMarketId"
                           class="fm-action-btn map">
                            <i class="bi bi-map"></i>
                            View Map
                        </a>

                        <a asp-controller="FarmerMarkets"
                           asp-action="Schedule"
                           asp-route-id="@item.FarmerMarketId"
                           class="fm-action-btn schedule">
                            <i class="bi bi-calendar-week"></i>
                            Pickup Schedule
                        </a>

                        <a asp-controller="FarmerMarkets"
                           asp-action="Edit"
                           asp-route-id="@item.FarmerMarketId"
                           class="fm-action-btn">
                            <i class="bi bi-pencil"></i>
                            Edit Details
                        </a>

                        @if (item.IsActive)
                        {
                            <form asp-controller="FarmerMarkets"
                                  asp-action="Remove"
                                  method="post"
                                  onsubmit="return confirm('Remove this market from your active markets?');">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@item.FarmerMarketId" />

                                <button type="submit"
                                        class="fm-action-btn danger">
                                    Remove
                                </button>
                            </form>
                        }

                    </div>

                </article>
            }

        </div>
    }

</section>

@section Styles {
<style>
.fm-header{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:22px}
.fm-label{color:#14836f;font-size:12px;font-weight:800;letter-spacing:.08em}
.fm-header h2{margin:7px 0 5px;font-size:28px;font-weight:800}
.fm-header p{margin:0;color:#667085}
.fm-primary-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:#13836e;color:#fff;text-decoration:none;padding:10px 15px;border-radius:10px;font-weight:700}
.fm-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:18px}
.fm-stats>div{background:#fff;border:1px solid #e7ebef;border-radius:16px;padding:17px}
.fm-stats span{display:block;color:#667085;font-size:12px}
.fm-stats strong{display:block;margin-top:4px;font-size:27px}
.fm-card{background:#fff;border:1px solid #e7ebef;border-radius:18px;padding:12px}
.fm-row{display:grid;grid-template-columns:58px 1fr 165px;gap:15px;align-items:center;padding:16px;border:1px solid #e8ebef;border-radius:14px;margin-bottom:10px}
.fm-icon{width:50px;height:50px;border-radius:13px;background:#e8f5ef;color:#13836e;display:grid;place-items:center;font-size:20px}
.fm-title-row{display:flex;justify-content:space-between;gap:12px}
.fm-title-row h3{margin:0;font-size:17px;font-weight:800}
.fm-title-row>div>span{color:#667085;font-size:12px}
.fm-status{padding:5px 9px;border-radius:999px;font-size:10px;font-weight:800;height:max-content}
.fm-status.active{background:#dcfae6;color:#067647}
.fm-status.inactive{background:#f2f4f7;color:#475467}
.fm-meta{display:flex;gap:28px;flex-wrap:wrap;margin-top:14px}
.fm-meta span{display:block;color:#98a2b3;font-size:10px;text-transform:uppercase;font-weight:800}
.fm-meta strong{display:block;margin-top:2px;color:#344054;font-size:12px}
.fm-instructions{margin:10px 0 0;color:#667085;font-size:12px}
.fm-actions{display:flex;flex-direction:column;gap:7px}
.fm-action-btn{width:100%;border:1px solid #d9dfe5;background:#fff;color:#344054;padding:8px 10px;border-radius:9px;text-decoration:none;font-size:11px;font-weight:700;text-align:center}
.fm-action-btn.map{color:#067647;border-color:#abefc6;background:#ecfdf3}
.fm-action-btn.schedule{color:#175cd3;border-color:#b2ccff}
.fm-action-btn.danger{color:#b42318;border-color:#f3c8c5}
.fm-empty{text-align:center;padding:65px 20px;color:#667085}
.fm-empty>i{font-size:35px;color:#13836e}
.fm-empty h3{color:#344054;margin-top:10px}
@@media(max-width:900px){.fm-row{grid-template-columns:50px 1fr}.fm-actions{grid-column:1/-1;display:grid;grid-template-columns:repeat(2,1fr)}}
@@media(max-width:650px){.fm-header{align-items:stretch;flex-direction:column}.fm-stats{grid-template-columns:1fr}.fm-row{grid-template-columns:1fr}.fm-actions{display:flex;flex-direction:column}.fm-title-row{flex-direction:column}}
</style>
}
