@model MarketLink.ViewModels.CreateFarmerMarketViewModel

@{
    ViewData["Title"] = "Add Market";
    Layout = "~/Views/Shared/_FarmerDashboardLayout.cshtml";
}

<section class="page-header">
    <div>
        <span class="page-label">
            <i class="bi bi-shop"></i>
            MY MARKETS
        </span>

        <h2>Choose a Market</h2>

        <p>
            Select one of the active markets created by the administrator.
        </p>
    </div>

    <a asp-controller="FarmerMarkets"
       asp-action="Index"
       class="back-link">
        <i class="bi bi-arrow-left"></i>
        Back to My Markets
    </a>
</section>

<section class="form-card">

    <form asp-controller="FarmerMarkets"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="form-field">
            <label asp-for="MarketId"></label>

            <select asp-for="MarketId"
                    asp-items="Model.Markets"
                    class="form-select">

                <option value="0">
                    Select market
                </option>

            </select>

            <span asp-validation-for="MarketId"
                  class="text-danger"></span>

            @if (!Model.Markets.Any())
            {
                <div class="empty-note">
                    There are no additional active markets available.
                </div>
            }
        </div>

        <div class="form-grid">

            <div class="form-field">
                <label asp-for="StallNumber"></label>

                <input asp-for="StallNumber"
                       class="form-control"
                       placeholder="e.g. A-12" />

                <span asp-validation-for="StallNumber"
                      class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="PickupInstructions"></label>

                <input asp-for="PickupInstructions"
                       class="form-control"
                       placeholder="e.g. Collect from the front counter" />
            </div>

        </div>

        <div class="info-note">
            <i class="bi bi-info-circle"></i>

            <span>
                After adding the market, you will configure the days
                you attend and your pickup/cutoff times.
            </span>
        </div>

        <div class="form-actions">
            <a asp-controller="FarmerMarkets"
               asp-action="Index"
               class="btn btn-light">
                Cancel
            </a>

            <button type="submit"
                    class="primary-btn border-0"
                    @(Model.Markets.Any() ? "" : "disabled")>
                <i class="bi bi-check-lg"></i>
                Add Market
            </button>
        </div>

    </form>

</section>

@section Styles {
<style>
.page-header{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:22px}
.page-label{color:#14836f;font-size:12px;font-weight:800;letter-spacing:.08em}
.page-header h2{margin:7px 0 5px;font-size:28px;font-weight:800}
.page-header p{margin:0;color:#667085}
.back-link{text-decoration:none;color:#475467;font-weight:700;font-size:13px}
.form-card{background:#fff;border:1px solid #e7ebef;border-radius:18px;padding:24px;max-width:900px}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.form-field{margin-bottom:18px}
.form-field label{display:block;margin-bottom:7px;font-size:12px;font-weight:800;color:#344054}
.info-note{display:flex;gap:8px;background:#eff8ff;color:#175cd3;padding:12px 14px;border-radius:10px;font-size:12px}
.empty-note{margin-top:7px;color:#b54708;font-size:12px}
.form-actions{display:flex;justify-content:flex-end;gap:10px;border-top:1px solid #edf0f3;margin-top:22px;padding-top:18px}
.primary-btn{display:inline-flex;align-items:center;gap:8px;background:#13836e;color:#fff;padding:10px 15px;border-radius:10px;font-weight:700}
.primary-btn:disabled{opacity:.45}
@@media(max-width:700px){.page-header{align-items:flex-start;flex-direction:column}.form-grid{grid-template-columns:1fr}}
</style>
}
