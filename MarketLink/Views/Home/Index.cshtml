
@model MarketLink.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home";

    var heroMarket = Model.HeroMarket;
    var heroProduct = Model.HeroProduct;

    // Images are only fallback/demo images because

   
    var fallbackProductImage =
        "https://images.unsplash.com/photo-1592924357228-91a4daadcfea?auto=format&fit=crop&w=600&q=85";

    var heroImage =
    "https://images.unsplash.com/photo-1488459716781-31db52582fe9?auto=format&fit=crop&w=1200&q=90";
}


<style>
    /* Home-only horizontal sliders.
       Existing product/market card styling is intentionally left unchanged. */
    .home-slider-shell {
        position: relative;
    }

    .home-card-slider {
        display: flex;
        flex-wrap: nowrap;
        gap: 1.5rem;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-behavior: smooth;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        -ms-overflow-style: none;
        padding: 2px 1px;
    }

    .home-card-slider::-webkit-scrollbar {
        display: none;
    }

    .home-slide-card {
        flex: 0 0 calc((100% - 4.5rem) / 4);
        min-width: 0;
        scroll-snap-align: start;
    }

    .home-slide-card > .fresh-card,
    .home-slide-card > .market-card {
        height: 100%;
    }

    .home-slider-arrow {
        position: absolute;
        top: 50%;
        z-index: 8;
        width: 42px;
        height: 42px;
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.12);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transform: translateY(-50%);
        transition: opacity .2s ease, transform .2s ease;
    }

    .home-slider-arrow:hover {
        transform: translateY(-50%) scale(1.04);
    }

    .home-slider-arrow-left {
        left: -21px;
    }

    .home-slider-arrow-right {
        right: -21px;
    }

    .home-slider-arrow:disabled {
        opacity: .3;
        cursor: default;
    }

    .home-slider-empty {
        flex: 0 0 100%;
    }

    @@media (max-width: 1199.98px) {
        .home-slide-card {
            flex-basis: calc((100% - 1.5rem) / 2);
        }

        .home-slider-arrow-left {
            left: -10px;
        }

        .home-slider-arrow-right {
            right: -10px;
        }
    }

    @@media (max-width: 575.98px) {
        .home-slide-card {
            flex-basis: 88%;
        }

        .home-card-slider {
            gap: 1rem;
        }

        .home-slider-arrow {
            width: 38px;
            height: 38px;
        }

        .home-slider-arrow-left {
            left: 4px;
        }

        .home-slider-arrow-right {
            right: 4px;
        }
    }
</style>



<style>
    /* Home market cards do not require market photographs */
    .home-market-no-image {
        min-height: 165px;
        padding: 22px;
        background:
            radial-gradient(circle at 90% 10%, rgba(255,255,255,.16), transparent 36%),
            linear-gradient(135deg, #174d36, #13836e);
        display: flex;
        align-items: flex-end;
        gap: 13px;
        position: relative;
        overflow: hidden;
    }

    .home-market-symbol {
        width: 52px;
        height: 52px;
        border-radius: 15px;
        background: rgba(255,255,255,.14);
        color: #fff;
        display: grid;
        place-items: center;
        font-size: 24px;
        flex: 0 0 auto;
    }

    .home-market-heading {
        color: #fff;
        min-width: 0;
    }

    .home-market-heading span {
        display: block;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .12em;
        opacity: .76;
        margin-bottom: 3px;
    }

    .home-market-heading strong {
        display: block;
        font-size: 18px;
        line-height: 1.2;
    }
</style>


<style>
    /* Compact market-card treatment: no picture-shaped area */
    .home-market-card-shell .market-card {
        overflow: hidden;
    }

    .home-market-card-top {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 22px 14px;
        background: transparent;
        position: relative;
    }

    .home-market-card-top::after {
        content: "";
        position: absolute;
        left: 22px;
        right: 22px;
        bottom: 0;
        height: 1px;
        background: #edf0ec;
    }

    .home-market-card-icon {
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        background: #edf7f2;
        color: #13836e;
        font-size: 22px;
    }

    .home-market-card-title {
        min-width: 0;
        flex: 1;
    }

    .home-market-card-title span {
        display: block;
        color: #6b9b58;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .11em;
        margin-bottom: 3px;
    }

    .home-market-card-title strong {
        display: block;
        color: #173c2f;
        font-size: 18px;
        line-height: 1.25;
    }

    .home-market-card-status {
        flex: 0 0 auto;
        border-radius: 999px;
        background: #f2f8ef;
        color: #4f8f36;
        font-size: 9px;
        font-weight: 800;
        padding: 7px 10px;
        white-space: nowrap;
    }

    @@media (max-width: 575.98px) {
        .home-market-card-top {
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .home-market-card-status {
            margin-left: 60px;
        }
    }
</style>

<!-- =====================================================
     HERO SECTION
===================================================== -->

<section class="hero-section">

    <div class="container">

        <div class="row align-items-center g-5">

            <!-- LEFT -->

            <div class="col-lg-6">

                <div class="hero-badge">
                    <span class="pulse-dot"></span>
                    Your local market, connected
                </div>


                <h1 class="hero-title">

                    Fresh from your
                    <span>local market.</span>

                </h1>


                <p class="hero-text">

                    Discover local farmers, fresh products and nearby
                    markets. Pre-order what you need and pick it up
                    when it's ready.

                </p>


                <div class="hero-buttons">

                    <a asp-controller="Markets"
                       asp-action="Index"
                       class="btn btn-hero-primary">

                        Explore Markets

                        <i class="bi bi-arrow-up-right"></i>

                    </a>


                    <a asp-controller="Products"
                       asp-action="Index"
                       class="btn btn-hero-secondary">

                        Browse Products

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>


                <!-- Trust -->

                <div class="hero-trust">

                    <div class="avatar-stack">

                        @if (Model.Farmers.Any())
                        {
                            foreach (var farmer in Model.Farmers.Take(3))
                            {
                                <div class="mini-avatar">

                                    @if (!string.IsNullOrWhiteSpace(farmer.ProfileImageUrl))
                                    {
                                        <img src="@farmer.ProfileImageUrl"
                                             alt="@farmer.BusinessName">
                                    }
                                    else
                                    {
                                        <span>
                                            @farmer.BusinessName.FirstOrDefault()
                                        </span>
                                    }

                                </div>
                            }
                        }

                        <div class="mini-avatar">
                            <span>+</span>
                        </div>

                    </div>


                    <div>

                        <div class="stars">
                            ★★★★★
                        </div>

                        <small>
                            Loved by local shoppers
                        </small>

                    </div>

                </div>

            </div>


            <!-- RIGHT -->

            <div class="col-lg-6">

                <div class="hero-visual">


                    <!-- Main Image -->

                    <div class="hero-image-card">

                        <img src="@heroImage"
                             alt="Fresh local market produce">

                    </div>


                    <!-- Floating Market Card -->
                    @if (heroMarket != null)
                    {
                        <div class="floating-market-card">

                            <div class="market-card-icon">
                                <i class="bi bi-shop"></i>
                            </div>

                            <div>

                                <strong>
                                    @heroMarket.MarketName
                                </strong>

                                <span>
                                    <i class="bi bi-geo-alt-fill"></i>
                                    @heroMarket.Address
                                </span>

                            </div>

                            <span class="open-status">
                                @heroMarket.StatusText
                            </span>

                        </div>
                    }


                    <!-- Floating Product Card -->
                    @if (heroProduct != null)
                    {
                        <div class="floating-product-card">

                            <div class="product-mini-image">

                                <img src="@(heroProduct.ImageUrl ?? fallbackProductImage)"
                                     alt="@heroProduct.ProductName">

                            </div>

                            <div>

                                <small>
                                    @heroProduct.AvailabilityText
                                </small>

                                <strong>
                                    @heroProduct.ProductName
                                </strong>

                                <span>
                                    @heroProduct.Price.ToString("0.00")
                                    / @heroProduct.UnitName
                                </span>

                            </div>

                            <button type="button">
                                <i class="bi bi-plus"></i>
                            </button>

                        </div>
                    }


                    <!-- Decorative Shape -->

                    <div class="hero-circle"></div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =====================================================
     MARKET STATS
===================================================== -->

<section class="market-stats">

    <div class="container">

        <div class="stats-wrapper">

            <div class="stat-item">

                <span class="stat-icon">
                    <i class="bi bi-shop-window"></i>
                </span>

                <div>
                    <strong>@Model.TotalMarkets+</strong>
                    <span>Local Markets</span>
                </div>

            </div>


            <div class="stat-item">

                <span class="stat-icon">
                    <i class="bi bi-person-heart"></i>
                </span>

                <div>
                    <strong>@Model.TotalFarmers+</strong>
                    <span>Local Farmers</span>
                </div>

            </div>


            <div class="stat-item">

                <span class="stat-icon">
                    <i class="bi bi-basket2"></i>
                </span>

                <div>
                    <strong>@Model.TotalAvailableProducts+</strong>
                    <span>Fresh Products</span>
                </div>

            </div>


            <div class="stat-item">

                <span class="stat-icon">
                    <i class="bi bi-geo-alt"></i>
                </span>

                <div>
                    <strong>@Model.TotalCategories+</strong>
                    <span>Product Categories</span>
                </div>

            </div>

        </div>

    </div>

</section>



<!-- =====================================================
     MARKET PULSE
===================================================== -->

<section class="pulse-section" id="products">

    <div class="container">

        <div class="section-heading-row">

            <div>

                <span class="section-label">
                    @(Model.IsPersonalizedProducts ? "RECOMMENDED FOR YOU" : "MARKET PULSE")
                </span>

                <h2>
                    @(Model.IsPersonalizedProducts ? "Picked for" : "What's fresh") <span>@(Model.IsPersonalizedProducts ? "you" : "today?")</span>
                </h2>

            </div>

            <a asp-controller="@(Model.IsPersonalizedProducts ? "CustomerRecommendations" : "Products")"
               asp-action="Index"
               class="view-all-link">

                @(Model.IsPersonalizedProducts ? "View all recommendations" : "View all products")

                <i class="bi bi-arrow-up-right"></i>

            </a>

        </div>


        <div class="home-slider-shell">

            <button type="button"
                    class="home-slider-arrow home-slider-arrow-left"
                    data-slider-target="productSlider"
                    data-slider-direction="-1"
                    aria-label="Previous products">
                <i class="bi bi-chevron-left"></i>
            </button>

            <div id="productSlider"
                 class="home-card-slider">

            @if (Model.Products.Any())
            {
                foreach (var product in Model.Products)
                {
                    <div class="home-slide-card home-product-slide">

                        <div class="fresh-card">

                            <div class="fresh-image">

                                <img src="@(product.ImageUrl ?? fallbackProductImage)"
                                     alt="@product.ProductName"
                                     loading="lazy">

                                <span class="availability @product.AvailabilityClass">
                                    ● @product.AvailabilityText
                                </span>

                                <button type="button"
                                        class="favorite-btn">

                                    <i class="bi bi-heart"></i>

                                </button>

                            </div>

                            <div class="fresh-content">

                                <span class="product-category">
                                    @product.CategoryName
                                </span>

                                <h3>
                                    @product.ProductName
                                </h3>

                                <p>
                                    @product.FarmerName
                                </p>

                                <div class="product-bottom">

                                    <strong>
                                        @product.Price.ToString("0.00")
                                        <small>
                                            / @product.UnitName
                                        </small>
                                    </strong>

                                    @if (User.Identity?.IsAuthenticated == true &&
                                         User.IsInRole("Customer") &&
                                         product.FarmerMarketId > 0)
                                    {
                                        <form asp-controller="Cart"
                                              asp-action="Add"
                                              method="post"
                                              style="display:contents;">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="FarmerProductId"
                                                   value="@product.FarmerProductId" />

                                            <input type="hidden"
                                                   name="FarmerMarketId"
                                                   value="@product.FarmerMarketId" />

                                            <input type="hidden"
                                                   name="Quantity"
                                                   value="1" />

                                            <input type="hidden"
                                                   name="ReturnUrl"
                                                   value="@Context.Request.Path@Context.Request.QueryString" />

                                            <button type="submit"
                                                    class="quick-add"
                                                    title="Add @product.ProductName to cart">

                                                <i class="bi bi-plus"></i>

                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        var quickReturnUrl =
                                            Url.Action(
                                                "Details",
                                                "Products",
                                                new { id = product.FarmerProductId })
                                            ?? "/Products";

                                        var quickLoginUrl =
                                            "/Auth/Login?returnUrl=" +
                                            Uri.EscapeDataString(quickReturnUrl);

                                        <button type="button"
                                                class="quick-add"
                                                title="Sign in to buy @product.ProductName"
                                                onclick="window.location.href='@quickLoginUrl'">

                                            <i class="bi bi-plus"></i>

                                        </button>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="home-slider-empty">

                    <div class="text-center py-5">

                        <i class="bi bi-basket fs-1"></i>

                        <h4 class="mt-3">
                            No fresh products available today.
                        </h4>

                        <p>
                            Please check again later.
                        </p>

                    </div>

                </div>
            }

            </div>

            <button type="button"
                    class="home-slider-arrow home-slider-arrow-right"
                    data-slider-target="productSlider"
                    data-slider-direction="1"
                    aria-label="Next products">
                <i class="bi bi-chevron-right"></i>
            </button>

        </div>

    </div>

</section>



<!-- =====================================================
     MARKET EXPLORER
===================================================== -->

<section class="explorer-section" id="market-explorer">

    <div class="container">

        <div class="explorer-box">

            <div class="row align-items-center g-4">

                <div class="col-lg-5">

                    <span class="section-label light-label">
                        MARKET EXPLORER
                    </span>

                    <h2>
                        Find your market.
                        <span>Find your farmers.</span>
                    </h2>

                    <p>
                        Explore local markets around you and discover
                        what's available before you make the trip.
                    </p>


                    <div class="explorer-features">

                        <div>
                            <i class="bi bi-geo-alt-fill"></i>

                            <span>
                                <strong>Nearby markets</strong>
                                Discover markets around your location.
                            </span>
                        </div>

                        <div>
                            <i class="bi bi-pin-map-fill"></i>

                            <span>
                                <strong>Easy pickup</strong>
                                Find the exact farmer and pickup point.
                            </span>
                        </div>

                        <div>
                            <i class="bi bi-basket-fill"></i>

                            <span>
                                <strong>Live availability</strong>
                                See what's currently in stock.
                            </span>
                        </div>

                    </div>


                    <a asp-controller="Markets"
                       asp-action="Map"
                       class="btn explorer-btn">

                        Explore the Map

                        <i class="bi bi-arrow-up-right"></i>

                    </a>

                </div>


                <div class="col-lg-7">

                    <div class="map-preview">

                        <div class="map-grid"></div>


                        <!-- Dynamic Map Pins -->
                        @if (Model.Markets.Any())
                        {
                            var pinIndex = 1;

                            foreach (var market in Model.Markets.Take(4))
                            {
                                <div class="map-pin pin-@pinIndex">

                                    <span>
                                        <i class="bi bi-shop"></i>
                                    </span>

                                </div>

                                pinIndex++;
                            }
                        }


                        <!-- Location Card -->
                        @if (heroMarket != null)
                        {
                            <div class="map-location-card">

                                <div class="location-icon">
                                    <i class="bi bi-geo-alt-fill"></i>
                                </div>

                                <div>

                                    <strong>
                                        @heroMarket.MarketName
                                    </strong>

                                    <span>
                                        @heroMarket.FarmerCount farmers ·
                                        @heroMarket.ProductCount products
                                    </span>

                                </div>

                                <i class="bi bi-chevron-right"></i>

                            </div>
                        }


                        <div class="your-location">
                            <span></span>
                            Your location
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =====================================================
     HOW IT WORKS
===================================================== -->

<section class="how-section" id="how-it-works">

    <div class="container">

        <div class="text-center section-heading">

            <span class="section-label">
                HOW IT WORKS
            </span>

            <h2>
                Local shopping,
                <span>made simple.</span>
            </h2>

            <p>
                From discovering your market to picking up your order,
                MarketLink keeps everything in one place.
            </p>

        </div>


        <div class="row g-4 steps-row">


            <div class="col-md-4">

                <div class="step-card">

                    <div class="step-number">
                        01
                    </div>

                    <div class="step-icon">
                        <i class="bi bi-search"></i>
                    </div>

                    <h3>
                        Discover
                    </h3>

                    <p>
                        Find nearby markets, farmers and fresh products
                        using search and map-based discovery.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="step-card">

                    <div class="step-number">
                        02
                    </div>

                    <div class="step-icon">
                        <i class="bi bi-basket2"></i>
                    </div>

                    <h3>
                        Pre-order
                    </h3>

                    <p>
                        Choose what you need, select a convenient pickup
                        slot and reserve your products before market day.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="step-card">

                    <div class="step-number">
                        03
                    </div>

                    <div class="step-icon">
                        <i class="bi bi-hand-thumbs-up"></i>
                    </div>

                    <h3>
                        Pick up
                    </h3>

                    <p>
                        Visit your selected market, collect your order
                        and enjoy fresh products directly from local farmers.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =====================================================
     FARMER CTA
===================================================== -->

