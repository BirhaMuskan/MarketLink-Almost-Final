</section>



<!-- =====================================================
     AI MARKETMATE
===================================================== -->

<section class="ai-section">

    <div class="container">

        <div class="ai-box">

            <div class="row align-items-center g-5">

                <div class="col-lg-6">

                    <div class="ai-content">

                        <span class="ai-label">
                            <i class="bi bi-stars"></i>
                            MARKETMATE AI
                        </span>

                        <h2>
                            Not sure what
                            you're looking for?
                        </h2>

                        <p>
                            Ask MarketMate to discover products,
                            farmers and markets based on what you need.
                        </p>


                        <div class="ai-question">

                            <i class="bi bi-chat-dots"></i>

                            <span>
                                "Find fresh tomatoes under $5 near me."
                            </span>

                            <i class="bi bi-arrow-right"></i>

                        </div>


                        <a href="#"
                           class="ai-link"
                           onclick="event.preventDefault(); document.getElementById('mlAssistantLauncher')?.click();">

                            Meet MarketMate

                            <i class="bi bi-arrow-up-right"></i>

                        </a>

                    </div>

                </div>


                <div class="col-lg-6">

                    <div class="ai-chat-window">

                        <div class="ai-chat-header">

                            <div class="ai-avatar">
                                <i class="bi bi-stars"></i>
                            </div>

                            <div>
                                <strong>MarketMate</strong>
                                <span>AI Market Assistant</span>
                            </div>

                            <span class="ai-online"></span>

                        </div>


                        <div class="chat-messages">

                            <div class="chat-message bot">

                                Hi! 👋

                                <br>

                                What would you like to
                                find today?

                            </div>


                            <div class="chat-message user">

                                Fresh tomatoes under $5

                            </div>


                            <div class="chat-message bot result-message">

                                <strong>
                                    I found
                                    @(Model.Products.Count)
                                    options near you.
                                </strong>

                                @foreach (var product in Model.Products.Take(2))
                                {
                                    <div class="mini-result">

                                        <span class="result-icon">
                                            🍅
                                        </span>

                                        <span>

                                            @product.FarmerName

                                            <small>
                                                @product.Price.ToString("0.00")
                                                /
                                                @product.UnitName
                                            </small>

                                        </span>

                                    </div>
                                }

                            </div>

                        </div>


                        <div class="ai-input">

                            <span>
                                Ask MarketMate...
                            </span>

                            <button type="button">
                                <i class="bi bi-arrow-up"></i>
                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =========================================================
     MARKETLINK - MARKETS SECTION
========================================================= -->

<section id="markets"
         class="markets-section">

    <div class="container">


        <!-- SECTION HEADER -->

        <div class="section-heading text-center">

            <span class="section-eyebrow">

                <i class="bi bi-geo-alt"></i>

                LOCAL FARMERS MARKETS

            </span>


            <h2>

                Find Your
                <span>Local Market</span>

            </h2>


            <p>

                Discover fresh produce, local farmers, and
                community markets near you.

            </p>

        </div>



        <!-- SEARCH AND FILTERS -->

        <div class="market-filter-box">

            <div class="row g-3 align-items-end">

                <!-- SEARCH -->

                <div class="col-lg-5">

                    <label for="marketSearch"
                           class="market-filter-label">

                        Search Markets

                    </label>

                    <div class="market-search-input">

                        <i class="bi bi-search"></i>

                        <input type="text"
                               id="marketSearch"
                               class="form-control"
                               placeholder="Search market name..." />

                    </div>

                </div>


                <!-- LOCATION -->

                <div class="col-lg-3">

                    <label for="marketLocation"
                           class="market-filter-label">

                        Location

                    </label>

                    <select id="marketLocation"
                            class="form-select">

                        <option value="all">
                            All Locations
                        </option>

                        @foreach (var market in Model.Markets
                            .Where(m => !string.IsNullOrWhiteSpace(m.Address))
                            .Select(m => m.Address)
                            .Distinct())
                        {
                            <option value="@market.ToLowerInvariant()">
                                @market
                            </option>
                        }

                    </select>

                </div>


                <!-- MARKET DAY -->

                <div class="col-lg-3">

                    <label for="marketDay"
                           class="market-filter-label">

                        Market Day

                    </label>

                    <select id="marketDay"
                            class="form-select">

                        <option value="all">
                            All Days
                        </option>

                        @foreach (var day in Model.MarketDays)
                        {
                            <option value="@day.ToLowerInvariant()">
                                @day
                            </option>
                        }

                    </select>

                </div>


                <!-- RESET -->

                <div class="col-lg-1">

                    <button type="button"
                            id="resetMarketFilters"
                            class="market-reset-btn"
                            title="Reset filters">

                        <i class="bi bi-arrow-counterclockwise"></i>

                    </button>

                </div>

            </div>

        </div>



        <!-- MARKET RESULTS -->

        <div class="market-results-header">

            <div>

                <span class="section-eyebrow">

                    <i class="bi bi-shop"></i>

                    EXPLORE MARKETS

                </span>

                <h3>
                    Markets Near You
                </h3>

            </div>


            <span id="marketResultCount"
                  class="market-result-count">

                @Model.Markets.Count Markets Available

            </span>

        </div>



        <!-- MARKET CARDS -->

        <div class="home-slider-shell">

            <button type="button"
                    class="home-slider-arrow home-slider-arrow-left"
                    data-slider-target="marketCards"
                    data-slider-direction="-1"
                    aria-label="Previous markets">
                <i class="bi bi-chevron-left"></i>
            </button>

            <div id="marketCards"
                 class="home-card-slider home-market-slider">

            @if (Model.Markets.Any())
            {
                foreach (var market in Model.Markets)
                {

                    <div class="home-slide-card home-market-slide market-card-item home-market-card-shell"
                         data-name="@market.MarketName"
                         data-location="@market.Address.ToLowerInvariant()"
                         data-days="@market.OperatingDaysText.ToLowerInvariant()">

                        <article class="market-card">

                            <div class="home-market-card-top">

                                <div class="home-market-card-icon">
                                    <i class="bi bi-shop"></i>
                                </div>

                                <div class="home-market-card-title">
                                    <span>LOCAL MARKET</span>
                                    <strong>@market.MarketName</strong>
                                </div>

                                <span class="home-market-card-status">
                                    @market.StatusText
                                </span>

                            </div>

                            <div class="market-card-body">


                                <p class="market-card-address">

                                    <i class="bi bi-geo-alt"></i>

                                    @market.Address

                                </p>


                                <div class="market-card-info">

                                    <div>

                                        <i class="bi bi-calendar3"></i>

                                        <span>
                                            @market.OperatingDaysText
                                        </span>

                                    </div>


                                    <div>

                                        <i class="bi bi-clock"></i>

                                        <span>
                                            @market.OpeningHoursText
                                        </span>

                                    </div>

                                </div>


                                <div class="market-card-footer">

                                    <div class="market-card-stats">

                                        <span>

                                            <i class="bi bi-people"></i>

                                            @market.FarmerCount Farmers

                                        </span>


                                        <span>

                                            <i class="bi bi-basket"></i>

                                            @market.ProductCount Products

                                        </span>

                                    </div>


                                    <a asp-controller="Markets"
                                       asp-action="Details"
                                       asp-route-id="@market.MarketId"
                                       class="market-view-btn"
                                       aria-label="View @market.MarketName">

                                        <i class="bi bi-arrow-up-right"></i>

                                    </a>

                                </div>

                            </div>

                        </article>

                    </div>

                }
            }
            else
            {
                <div class="col-12">

                    <div class="text-center py-5">

                        <i class="bi bi-shop fs-1"></i>

                        <h4 class="mt-3">
                            No Markets Found
                        </h4>

                        <p>
                            There are currently no active markets.
                        </p>

                    </div>

                </div>
            }

            </div>

            <button type="button"
                    class="home-slider-arrow home-slider-arrow-right"
                    data-slider-target="marketCards"
                    data-slider-direction="1"
                    aria-label="Next markets">
                <i class="bi bi-chevron-right"></i>
            </button>

        </div>



        <!-- NO RESULTS -->

        <div id="noMarketResults"
             class="no-market-results d-none">

            <i class="bi bi-search"></i>

            <h4>
                No Markets Found
            </h4>

            <p>
                Try changing your search or filters.
            </p>

        </div>



        <!-- MAP PREVIEW -->

        <div class="market-map-section">

            <div class="row align-items-center g-4">

                <div class="col-lg-5">

                    <span class="section-eyebrow">

                        <i class="bi bi-map"></i>

                        MARKET LOCATIONS

                    </span>


                    <h3>

                        Find Markets
                        <span>Near You</span>

                    </h3>


                    <p>

                        Explore local market locations and discover
                        where your favorite farmers sell fresh produce.

                    </p>


                    <div class="map-feature-list">

                        <div>
                            <i class="bi bi-check-circle-fill"></i>
                            View market locations
                        </div>

                        <div>
                            <i class="bi bi-check-circle-fill"></i>
                            Discover nearby farmers
                        </div>

                        <div>
                            <i class="bi bi-check-circle-fill"></i>
                            Find convenient pickup points
                        </div>

                    </div>


                    <a asp-controller="Markets"
                       asp-action="Index"
                       class="btn btn-market">

                        Explore Map

                        <i class="bi bi-arrow-up-right"></i>

                    </a>

                </div>


                <div class="col-lg-7">

                    <div class="market-map-preview">

                        <div class="map-grid"></div>

                        <div class="map-road map-road-one"></div>
                        <div class="map-road map-road-two"></div>
                        <div class="map-road map-road-three"></div>


                        @{
                            var mapMarkets =
                                Model.Markets.Take(3).ToList();
                        }

                        @if (mapMarkets.Count > 0)
                        {
                            <div class="map-location-marker marker-one">

                                <i class="bi bi-geo-alt-fill"></i>

                                <span>
                                    @mapMarkets[0].MarketName
                                </span>

                            </div>
                        }


                        @if (mapMarkets.Count > 1)
                        {
                            <div class="map-location-marker marker-two">

                                <i class="bi bi-geo-alt-fill"></i>

                                <span>
                                    @mapMarkets[1].MarketName
                                </span>

                            </div>
                        }


                        @if (mapMarkets.Count > 2)
                        {
                            <div class="map-location-marker marker-three">

                                <i class="bi bi-geo-alt-fill"></i>

                                <span>
                                    @mapMarkets[2].MarketName
                                </span>

                            </div>
                        }


                        <div class="map-center-label">

                            <i class="bi bi-compass"></i>

                            MarketLink

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =====================================================
     FINAL CTA
===================================================== -->

<section class="final-cta">

    <div class="container text-center">

        <span class="section-label">
            MARKETLINK
        </span>

        <h2>
            Fresh markets are
            <span>closer than you think.</span>
        </h2>

        <p>
            Discover local farmers, explore fresh products
            and make your next market trip easier.
        </p>

        <a asp-controller="Markets"
           asp-action="Index"
           class="btn btn-hero-primary">

            Explore MarketLink

            <i class="bi bi-arrow-up-right"></i>

        </a>

    </div>

</section>


<script>
    document.addEventListener('DOMContentLoaded', function () {
        const sliderButtons = document.querySelectorAll('[data-slider-target]');

        function visibleCards(slider) {
            return Array.from(slider.children).filter(function (card) {
                return card.offsetParent !== null;
            });
        }

        function updateButtons(slider) {
            const shell = slider.closest('.home-slider-shell');
            if (!shell) return;

            const left = shell.querySelector('[data-slider-direction="-1"]');
            const right = shell.querySelector('[data-slider-direction="1"]');

            const maxScroll = Math.max(0, slider.scrollWidth - slider.clientWidth);
            const tolerance = 4;

            if (left) {
                left.disabled = slider.scrollLeft <= tolerance;
            }

            if (right) {
                right.disabled = slider.scrollLeft >= (maxScroll - tolerance);
            }
        }

        function scrollSlider(slider, direction) {
            const cards = visibleCards(slider);
            if (!cards.length) return;

            const firstCard = cards[0];
            const sliderStyle = window.getComputedStyle(slider);
            const gap = parseFloat(sliderStyle.columnGap || sliderStyle.gap || '0') || 0;
            const amount = firstCard.getBoundingClientRect().width + gap;

            slider.scrollBy({
                left: amount * direction,
                behavior: 'smooth'
            });
        }

        sliderButtons.forEach(function (button) {
            const slider = document.getElementById(button.dataset.sliderTarget);
            if (!slider) return;

            button.addEventListener('click', function () {
                const direction = Number(button.dataset.sliderDirection || 1);
                scrollSlider(slider, direction);
            });

            slider.addEventListener('scroll', function () {
                updateButtons(slider);
            }, { passive: true });

            updateButtons(slider);
        });

        window.addEventListener('resize', function () {
            document.querySelectorAll('.home-card-slider').forEach(updateButtons);
        });

        // Market filters may hide/show cards. Recalculate arrow state after filtering.
        const marketSlider = document.getElementById('marketCards');
        if (marketSlider) {
            const observer = new MutationObserver(function () {
                updateButtons(marketSlider);
            });

            observer.observe(marketSlider, {
                subtree: true,
                attributes: true,
                attributeFilter: ['class', 'style']
            });
        }
    });
</script>

