
@model MarketLink.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home";

    var heroMarket = Model.HeroMarket;
    var heroProduct = Model.HeroProduct;

    // Images are only fallback/demo images because
    // HomeMarketViewModel currently has no ImageUrl property.
    var marketImages = new[]
    {
        "~/images/markets/riverside-market.jpg",
        "~/images/markets/green-valley-market.jpg",
        "~/images/markets/sunrise-market.jpg",
        "~/images/markets/harvest-market.jpg"
    };

   
    var fallbackProductImage =
        "https://images.unsplash.com/photo-1592924357228-91a4daadcfea?auto=format&fit=crop&w=600&q=85";

    var heroImage =
    "https://images.unsplash.com/photo-1488459716781-31db52582fe9?auto=format&fit=crop&w=1200&q=90";
}


<!-- =====================================================
     HERO SECTION
===================================================== -->

<section class="hero-section">

    <div class="container">

        <div class="row align-items-center g-5">

            <!-- LEFT -->

            <div class="col-lg-6">

                <div class="hero-badge">
                    <span class="pulse-dot"></span>
                    Your local market, connected
                </div>


                <h1 class="hero-title">

                    Fresh from your
                    <span>local market.</span>

                </h1>


                <p class="hero-text">

                    Discover local farmers, fresh products and nearby
                    markets. Pre-order what you need and pick it up
                    when it's ready.

                </p>


                <div class="hero-buttons">

                    <a asp-controller="Markets"
                       asp-action="Index"
                       class="btn btn-hero-primary">

                        Explore Markets

                        <i class="bi bi-arrow-up-right"></i>

                    </a>


                    <a asp-controller="Products"
                       asp-action="Index"
                       class="btn btn-hero-secondary">

                        Browse Products

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>


                <!-- Trust -->

                <div class="hero-trust">

                    <div class="avatar-stack">

                        @if (Model.Farmers.Any())
                        {
                            foreach (var farmer in Model.Farmers.Take(3))
                            {
                                <div class="mini-avatar">

                                    @if (!string.IsNullOrWhiteSpace(farmer.ProfileImageUrl))
                                    {
                                        <img src="@farmer.ProfileImageUrl"
                                             alt="@farmer.BusinessName">
                                    }
                                    else
                                    {
                                        <span>
                                            @farmer.BusinessName.FirstOrDefault()
                                        </span>
                                    }

                                </div>
                            }
                        }

                        <div class="mini-avatar">
                            <span>+</span>
                        </div>

                    </div>


                    <div>

                        <div class="stars">
                            ★★★★★
                        </div>

                        <small>
                            Loved by local shoppers
                        </small>

                    </div>

                </div>

            </div>


            <!-- RIGHT -->

            <div class="col-lg-6">

                <div class="hero-visual">


                    <!-- Main Image -->

                    <div class="hero-image-card">

                        <img src="@heroImage"
                             alt="Fresh local market produce">

                    </div>


                    <!-- Floating Market Card -->
                    @if (heroMarket != null)
                    {
                        <div class="floating-market-card">

                            <div class="market-card-icon">
                                <i class="bi bi-shop"></i>
                            </div>

                            <div>

                                <strong>
                                    @heroMarket.MarketName
                                </strong>

                                <span>
                                    <i class="bi bi-geo-alt-fill"></i>
                                    @heroMarket.Address
                                </span>

                            </div>

                            <span class="open-status">
                                @heroMarket.StatusText
                            </span>

                        </div>
                    }


                    <!-- Floating Product Card -->
                    @if (heroProduct != null)
                    {
                        <div class="floating-product-card">

                            <div class="product-mini-image">

                                <img src="@(heroProduct.ImageUrl ?? fallbackProductImage)"
                                     alt="@heroProduct.ProductName">

                            </div>

                            <div>

                                <small>
                                    @heroProduct.AvailabilityText
                                </small>

                                <strong>
                                    @heroProduct.ProductName
                                </strong>

                                <span>
                                    @heroProduct.Price.ToString("0.00")
                                    / @heroProduct.UnitName
                                </span>

                            </div>

                            <button type="button">
                                <i class="bi bi-plus"></i>
                            </button>

                        </div>
                    }


                    <!-- Decorative Shape -->

                    <div class="hero-circle"></div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =====================================================
     MARKET STATS
===================================================== -->

<section class="market-stats">

    <div class="container">

        <div class="stats-wrapper">

            <div class="stat-item">

                <span class="stat-icon">
                    <i class="bi bi-shop-window"></i>
                </span>

                <div>
                    <strong>@Model.TotalMarkets+</strong>
                    <span>Local Markets</span>
                </div>

            </div>


            <div class="stat-item">

                <span class="stat-icon">
                    <i class="bi bi-person-heart"></i>
                </span>

                <div>
                    <strong>@Model.TotalFarmers+</strong>
                    <span>Local Farmers</span>
                </div>

            </div>


            <div class="stat-item">

                <span class="stat-icon">
                    <i class="bi bi-basket2"></i>
                </span>

                <div>
                    <strong>@Model.TotalAvailableProducts+</strong>
                    <span>Fresh Products</span>
                </div>

            </div>


            <div class="stat-item">

                <span class="stat-icon">
                    <i class="bi bi-geo-alt"></i>
                </span>

                <div>
                    <strong>@Model.TotalCategories+</strong>
                    <span>Product Categories</span>
                </div>

            </div>

        </div>

    </div>

</section>



<!-- =====================================================
     MARKET PULSE
===================================================== -->

<section class="pulse-section" id="products">

    <div class="container">

        <div class="section-heading-row">

            <div>

                <span class="section-label">
                    @(Model.IsPersonalizedProducts ? "RECOMMENDED FOR YOU" : "MARKET PULSE")
                </span>

                <h2>
                    @(Model.IsPersonalizedProducts ? "Picked for" : "What's fresh") <span>@(Model.IsPersonalizedProducts ? "you" : "today?")</span>
                </h2>

            </div>

            <a asp-controller="@(Model.IsPersonalizedProducts ? "CustomerRecommendations" : "Products")"
               asp-action="Index"
               class="view-all-link">

                @(Model.IsPersonalizedProducts ? "View all recommendations" : "View all products")

                <i class="bi bi-arrow-up-right"></i>

            </a>

        </div>


        <div class="row g-4">

            @if (Model.Products.Any())
            {
                foreach (var product in Model.Products)
                {
                    <div class="col-sm-6 col-lg-3">

                        <div class="fresh-card">

                            <div class="fresh-image">

                                <img src="@(product.ImageUrl ?? fallbackProductImage)"
                                     alt="@product.ProductName"
                                     loading="lazy">

                                <span class="availability @product.AvailabilityClass">
                                    ● @product.AvailabilityText
                                </span>

                                <button type="button"
                                        class="favorite-btn">

                                    <i class="bi bi-heart"></i>

                                </button>

                            </div>

                            <div class="fresh-content">

                                <span class="product-category">
                                    @product.CategoryName
                                </span>

                                <h3>
                                    @product.ProductName
                                </h3>

                                <p>
                                    @product.FarmerName
                                </p>

                                <div class="product-bottom">

                                    <strong>
                                        @product.Price.ToString("0.00")
                                        <small>
                                            / @product.UnitName
                                        </small>
                                    </strong>

                                    <button type="button"
                                            class="quick-add">

                                        <i class="bi bi-plus"></i>

                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12">

                    <div class="text-center py-5">

                        <i class="bi bi-basket fs-1"></i>

                        <h4 class="mt-3">
                            No fresh products available today.
                        </h4>

                        <p>
                            Please check again later.
                        </p>

                    </div>

                </div>
            }

        </div>

    </div>

</section>



<!-- =====================================================
     MARKET EXPLORER
===================================================== -->

<section class="explorer-section" id="market-explorer">

    <div class="container">

        <div class="explorer-box">

            <div class="row align-items-center g-4">

                <div class="col-lg-5">

                    <span class="section-label light-label">
                        MARKET EXPLORER
                    </span>

                    <h2>
                        Find your market.
                        <span>Find your farmers.</span>
                    </h2>

                    <p>
                        Explore local markets around you and discover
                        what's available before you make the trip.
                    </p>


                    <div class="explorer-features">

                        <div>
                            <i class="bi bi-geo-alt-fill"></i>

                            <span>
                                <strong>Nearby markets</strong>
                                Discover markets around your location.
                            </span>
                        </div>

                        <div>
                            <i class="bi bi-pin-map-fill"></i>

                            <span>
                                <strong>Easy pickup</strong>
                                Find the exact farmer and pickup point.
                            </span>
                        </div>

                        <div>
                            <i class="bi bi-basket-fill"></i>

                            <span>
                                <strong>Live availability</strong>
                                See what's currently in stock.
                            </span>
                        </div>

                    </div>


                    <a asp-controller="Markets"
                       asp-action="Index"
                       class="btn explorer-btn">

                        Explore the Map

                        <i class="bi bi-arrow-up-right"></i>

                    </a>

                </div>


                <div class="col-lg-7">

                    <div class="map-preview">

                        <div class="map-grid"></div>


                        <!-- Dynamic Map Pins -->
                        @if (Model.Markets.Any())
                        {
                            var pinIndex = 1;

                            foreach (var market in Model.Markets.Take(4))
                            {
                                <div class="map-pin pin-@pinIndex">

                                    <span>
                                        <i class="bi bi-shop"></i>
                                    </span>

                                </div>

                                pinIndex++;
                            }
                        }


                        <!-- Location Card -->
                        @if (heroMarket != null)
                        {
                            <div class="map-location-card">

                                <div class="location-icon">
                                    <i class="bi bi-geo-alt-fill"></i>
                                </div>

                                <div>

                                    <strong>
                                        @heroMarket.MarketName
                                    </strong>

                                    <span>
                                        @heroMarket.FarmerCount farmers ·
                                        @heroMarket.ProductCount products
                                    </span>

                                </div>

                                <i class="bi bi-chevron-right"></i>

                            </div>
                        }


                        <div class="your-location">
                            <span></span>
                            Your location
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =====================================================
     HOW IT WORKS
===================================================== -->

<section class="how-section" id="how-it-works">

    <div class="container">

        <div class="text-center section-heading">

            <span class="section-label">
                HOW IT WORKS
            </span>

            <h2>
                Local shopping,
                <span>made simple.</span>
            </h2>

            <p>
                From discovering your market to picking up your order,
                MarketLink keeps everything in one place.
            </p>

        </div>


        <div class="row g-4 steps-row">


            <div class="col-md-4">

                <div class="step-card">

                    <div class="step-number">
                        01
                    </div>

                    <div class="step-icon">
                        <i class="bi bi-search"></i>
                    </div>

                    <h3>
                        Discover
                    </h3>

                    <p>
                        Find nearby markets, farmers and fresh products
                        using search and map-based discovery.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="step-card">

                    <div class="step-number">
                        02
                    </div>

                    <div class="step-icon">
                        <i class="bi bi-basket2"></i>
                    </div>

                    <h3>
                        Pre-order
                    </h3>

                    <p>
                        Choose what you need, select a convenient pickup
                        slot and reserve your products before market day.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="step-card">

                    <div class="step-number">
                        03
                    </div>

                    <div class="step-icon">
                        <i class="bi bi-hand-thumbs-up"></i>
                    </div>

                    <h3>
                        Pick up
                    </h3>

                    <p>
                        Visit your selected market, collect your order
                        and enjoy fresh products directly from local farmers.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =====================================================
     FARMER CTA
===================================================== -->

<section class="farmer-section" id="farmers">
    <div class="container">
        <div class="farmer-box">
            <div class="row align-items-center g-5">

                <div class="col-lg-6">
                    <div class="farmer-image-wrapper">

                        @{
                            var farmerImage =
                                "https://images.unsplash.com/photo-1500937386664-56d1dfef3854?auto=format&fit=crop&w=1200&q=85";
                        }

                        <img src="@farmerImage"
                             alt="Local farmer">

                        <div class="farmer-stat">
                            <i class="bi bi-graph-up-arrow"></i>

                            <div>
                                <strong>Grow your reach</strong>
                                <span>Connect with local shoppers</span>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="col-lg-6">

                    <span class="section-label">
                        FOR LOCAL FARMERS
                    </span>

                    <h2>
                        Your farm.
                        <span>Your customers.</span>
                        One place.
                    </h2>

                    <p>
                        Publish your weekly stock, manage pre-orders,
                        choose pickup slots and build relationships with
                        customers in your community.
                    </p>

                    <div class="farmer-benefits">

                        <div>
                            <i class="bi bi-check-circle-fill"></i>
                            Manage weekly inventory
                        </div>

                        <div>
                            <i class="bi bi-check-circle-fill"></i>
                            Accept pre-orders
                        </div>

                        <div>
                            <i class="bi bi-check-circle-fill"></i>
                            Track your sales
                        </div>

                        <div>
                            <i class="bi bi-check-circle-fill"></i>
                            Build your local customer base
                        </div>

                    </div>

                    <a asp-controller="Auth"
                       asp-action="Register"
                       class="btn btn-dark-market">

                        Become a Farmer
                        <i class="bi bi-arrow-up-right"></i>

                    </a>

                </div>

            </div>
        </div>
    </div>
</section>



<!-- =====================================================
     AI MARKETMATE
===================================================== -->

<section class="ai-section">

    <div class="container">

        <div class="ai-box">

            <div class="row align-items-center g-5">

                <div class="col-lg-6">

                    <div class="ai-content">

                        <span class="ai-label">
                            <i class="bi bi-stars"></i>
                            MARKETMATE AI
                        </span>

                        <h2>
                            Not sure what
                            you're looking for?
                        </h2>

                        <p>
                            Ask MarketMate to discover products,
                            farmers and markets based on what you need.
                        </p>


                        <div class="ai-question">

                            <i class="bi bi-chat-dots"></i>

                            <span>
                                "Find fresh tomatoes under $5 near me."
                            </span>

                            <i class="bi bi-arrow-right"></i>

                        </div>


                        <a asp-controller="MarketMate"
                           asp-action="Index"
                           class="ai-link">

                            Meet MarketMate

                            <i class="bi bi-arrow-up-right"></i>

                        </a>

                    </div>

                </div>


                <div class="col-lg-6">

                    <div class="ai-chat-window">

                        <div class="ai-chat-header">

                            <div class="ai-avatar">
                                <i class="bi bi-stars"></i>
                            </div>

                            <div>
                                <strong>MarketMate</strong>
                                <span>AI Market Assistant</span>
                            </div>

                            <span class="ai-online"></span>

                        </div>


                        <div class="chat-messages">

                            <div class="chat-message bot">

                                Hi! 👋

                                <br>

                                What would you like to
                                find today?

                            </div>


                            <div class="chat-message user">

                                Fresh tomatoes under $5

                            </div>


                            <div class="chat-message bot result-message">

                                <strong>
                                    I found
                                    @(Model.Products.Count)
                                    options near you.
                                </strong>

                                @foreach (var product in Model.Products.Take(2))
                                {
                                    <div class="mini-result">

                                        <span class="result-icon">
                                            🍅
                                        </span>

                                        <span>

                                            @product.FarmerName

                                            <small>
                                                @product.Price.ToString("0.00")
                                                /
                                                @product.UnitName
                                            </small>

                                        </span>

                                    </div>
                                }

                            </div>

                        </div>


                        <div class="ai-input">

                            <span>
                                Ask MarketMate...
                            </span>

                            <button type="button">
                                <i class="bi bi-arrow-up"></i>
                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =========================================================
     MARKETLINK - MARKETS SECTION
========================================================= -->

<section id="markets"
         class="markets-section">

    <div class="container">


        <!-- SECTION HEADER -->

        <div class="section-heading text-center">

            <span class="section-eyebrow">

                <i class="bi bi-geo-alt"></i>

                LOCAL FARMERS MARKETS

            </span>


            <h2>

                Find Your
                <span>Local Market</span>

            </h2>


            <p>

                Discover fresh produce, local farmers, and
                community markets near you.

            </p>

        </div>



        <!-- SEARCH AND FILTERS -->

        <div class="market-filter-box">

            <div class="row g-3 align-items-end">

                <!-- SEARCH -->

                <div class="col-lg-5">

                    <label for="marketSearch"
                           class="market-filter-label">

                        Search Markets

                    </label>

                    <div class="market-search-input">

                        <i class="bi bi-search"></i>

                        <input type="text"
                               id="marketSearch"
                               class="form-control"
                               placeholder="Search market name..." />

                    </div>

                </div>


                <!-- LOCATION -->

                <div class="col-lg-3">

                    <label for="marketLocation"
                           class="market-filter-label">

                        Location

                    </label>

                    <select id="marketLocation"
                            class="form-select">

                        <option value="all">
                            All Locations
                        </option>

                        @foreach (var market in Model.Markets
                            .Where(m => !string.IsNullOrWhiteSpace(m.Address))
                            .Select(m => m.Address)
                            .Distinct())
                        {
                            <option value="@market.ToLowerInvariant()">
                                @market
                            </option>
                        }

                    </select>

                </div>


                <!-- MARKET DAY -->

                <div class="col-lg-3">

                    <label for="marketDay"
                           class="market-filter-label">

                        Market Day

                    </label>

                    <select id="marketDay"
                            class="form-select">

                        <option value="all">
                            All Days
                        </option>

                        @foreach (var day in Model.MarketDays)
                        {
                            <option value="@day.ToLowerInvariant()">
                                @day
                            </option>
                        }

                    </select>

                </div>


                <!-- RESET -->

                <div class="col-lg-1">

                    <button type="button"
                            id="resetMarketFilters"
                            class="market-reset-btn"
                            title="Reset filters">

                        <i class="bi bi-arrow-counterclockwise"></i>

                    </button>

                </div>

            </div>

        </div>



        <!-- MARKET RESULTS -->

        <div class="market-results-header">

            <div>

                <span class="section-eyebrow">

                    <i class="bi bi-shop"></i>

                    EXPLORE MARKETS

                </span>

                <h3>
                    Markets Near You
                </h3>

            </div>


            <span id="marketResultCount"
                  class="market-result-count">

                @Model.Markets.Count Markets Available

            </span>

        </div>



        <!-- MARKET CARDS -->

        <div id="marketCards"
             class="row g-4">

            @if (Model.Markets.Any())
            {
                var marketIndex = 0;

                foreach (var market in Model.Markets)
                {
                    var imageIndex =
                        marketIndex % marketImages.Length;

                    var imagePath =
                        marketImages[imageIndex];

                    <div class="col-md-6 col-xl-3 market-card-item"
                         data-name="@market.MarketName"
                         data-location="@market.Address.ToLowerInvariant()"
                         data-days="@market.OperatingDaysText.ToLowerInvariant()">

                        <article class="market-card">

                            <div class="market-card-image">

                                <img src="@Url.Content(imagePath)"
                                     alt="@market.MarketName"
                                     loading="lazy" />

                                <span class="market-status">

                                    <i class="bi bi-circle-fill"></i>

                                    @market.StatusText

                                </span>

                            </div>


                            <div class="market-card-body">

                                <span class="market-card-category">

                                    LOCAL MARKET

                                </span>


                                <h4>
                                    @market.MarketName
                                </h4>


                                <p class="market-card-address">

                                    <i class="bi bi-geo-alt"></i>

                                    @market.Address

                                </p>


                                <div class="market-card-info">

                                    <div>

                                        <i class="bi bi-calendar3"></i>

                                        <span>
                                            @market.OperatingDaysText
                                        </span>

                                    </div>


                                    <div>

                                        <i class="bi bi-clock"></i>

                                        <span>
                                            @market.OpeningHoursText
                                        </span>

                                    </div>

                                </div>


                                <div class="market-card-footer">

                                    <div class="market-card-stats">

                                        <span>

                                            <i class="bi bi-people"></i>

                                            @market.FarmerCount Farmers

                                        </span>


                                        <span>

                                            <i class="bi bi-basket"></i>

                                            @market.ProductCount Products

                                        </span>

                                    </div>


                                    <a asp-controller="Markets"
                                       asp-action="Details"
                                       asp-route-id="@market.MarketId"
                                       class="market-view-btn"
                                       aria-label="View @market.MarketName">

                                        <i class="bi bi-arrow-up-right"></i>

                                    </a>

                                </div>

                            </div>

                        </article>

                    </div>

                    marketIndex++;
                }
            }
            else
            {
                <div class="col-12">

                    <div class="text-center py-5">

                        <i class="bi bi-shop fs-1"></i>

                        <h4 class="mt-3">
                            No Markets Found
                        </h4>

                        <p>
                            There are currently no active markets.
                        </p>

                    </div>

                </div>
            }

        </div>



        <!-- NO RESULTS -->

        <div id="noMarketResults"
             class="no-market-results d-none">

            <i class="bi bi-search"></i>

            <h4>
                No Markets Found
            </h4>

            <p>
                Try changing your search or filters.
            </p>

        </div>



        <!-- MAP PREVIEW -->

        <div class="market-map-section">

            <div class="row align-items-center g-4">

                <div class="col-lg-5">

                    <span class="section-eyebrow">

                        <i class="bi bi-map"></i>

                        MARKET LOCATIONS

                    </span>


                    <h3>

                        Find Markets
                        <span>Near You</span>

                    </h3>


                    <p>

                        Explore local market locations and discover
                        where your favorite farmers sell fresh produce.

                    </p>


                    <div class="map-feature-list">

                        <div>
                            <i class="bi bi-check-circle-fill"></i>
                            View market locations
                        </div>

                        <div>
                            <i class="bi bi-check-circle-fill"></i>
                            Discover nearby farmers
                        </div>

                        <div>
                            <i class="bi bi-check-circle-fill"></i>
                            Find convenient pickup points
                        </div>

                    </div>


                    <a asp-controller="Markets"
                       asp-action="Index"
                       class="btn btn-market">

                        Explore Map

                        <i class="bi bi-arrow-up-right"></i>

                    </a>

                </div>


                <div class="col-lg-7">

                    <div class="market-map-preview">

                        <div class="map-grid"></div>

                        <div class="map-road map-road-one"></div>
                        <div class="map-road map-road-two"></div>
                        <div class="map-road map-road-three"></div>


                        @{
                            var mapMarkets =
                                Model.Markets.Take(3).ToList();
                        }

                        @if (mapMarkets.Count > 0)
                        {
                            <div class="map-location-marker marker-one">

                                <i class="bi bi-geo-alt-fill"></i>

                                <span>
                                    @mapMarkets[0].MarketName
                                </span>

                            </div>
                        }


                        @if (mapMarkets.Count > 1)
                        {
                            <div class="map-location-marker marker-two">

                                <i class="bi bi-geo-alt-fill"></i>

                                <span>
                                    @mapMarkets[1].MarketName
                                </span>

                            </div>
                        }


                        @if (mapMarkets.Count > 2)
                        {
                            <div class="map-location-marker marker-three">

                                <i class="bi bi-geo-alt-fill"></i>

                                <span>
                                    @mapMarkets[2].MarketName
                                </span>

                            </div>
                        }


                        <div class="map-center-label">

                            <i class="bi bi-compass"></i>

                            MarketLink

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =====================================================
     FINAL CTA
===================================================== -->

<section class="final-cta">

    <div class="container text-center">

        <span class="section-label">
            MARKETLINK
        </span>

        <h2>
            Fresh markets are
            <span>closer than you think.</span>
        </h2>

        <p>
            Discover local farmers, explore fresh products
            and make your next market trip easier.
        </p>

        <a asp-controller="Markets"
           asp-action="Index"
           class="btn btn-hero-primary">

            Explore MarketLink

            <i class="bi bi-arrow-up-right"></i>

        </a>

    </div>

</section>
