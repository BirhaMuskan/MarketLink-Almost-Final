@{
    ViewData["Title"] = "Contact Us";
}

<!-- =========================
     CONTACT HERO
========================= -->

<section class="contact-hero">

    <div class="contact-hero-image">

        <div class="contact-hero-overlay"></div>

        <div class="container">

            <div class="contact-hero-content">

                <!-- BREADCRUMB -->
                <div class="contact-breadcrumb">

                    <a asp-controller="Home"
                       asp-action="Index">
                        Home
                    </a>

                    <i class="bi bi-chevron-right"></i>

                    <span>Contact Us</span>

                </div>


                <!-- HERO CONTENT -->
                <div class="contact-hero-text">

                    <span class="contact-label">
                        <i class="bi bi-envelope-heart-fill"></i>
                        GET IN TOUCH
                    </span>

                    <h1>
                        Contact
                        <strong>MarketLink</strong>
                    </h1>

                    <p>
                        Have a question or need help?
                        We're here to connect you with MarketLink.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =========================
     CONTACT SECTION
========================= -->
<section class="contact-section">

    <div class="container">

        <div class="row g-5 align-items-stretch">

            <!-- CONTACT INFORMATION -->
            <div class="col-lg-5">

                <div class="contact-info-card">

                    <span class="section-mini-title">
                        CONTACT MARKETLINK
                    </span>

                    <h2>
                        Let's Start a
                        <strong>Conversation</strong>
                    </h2>

                    <p class="contact-intro">
                        Whether you need help using MarketLink or want to
                        connect with local farmers and markets, feel free
                        to reach out to us.
                    </p>


                    <!-- INFO ITEM -->
                    <div class="contact-info-item">

                        <div class="contact-icon">
                            <i class="bi bi-geo-alt-fill"></i>
                        </div>

                        <div>
                            <small>Our Location</small>
                            <strong>Karachi, Sindh, Pakistan</strong>
                        </div>

                    </div>


                    <!-- INFO ITEM -->
                    <div class="contact-info-item">

                        <div class="contact-icon">
                            <i class="bi bi-envelope-fill"></i>
                        </div>

                        <div>
                            <small>Email Address</small>
                            <strong>hello@marketlink.com</strong>
                        </div>

                    </div>


                    <!-- INFO ITEM -->
                    <div class="contact-info-item">

                        <div class="contact-icon">
                            <i class="bi bi-telephone-fill"></i>
                        </div>

                        <div>
                            <small>Phone Number</small>
                            <strong>+92 300 1234567</strong>
                        </div>

                    </div>


                    <!-- INFO ITEM -->
                    <div class="contact-info-item">

                        <div class="contact-icon">
                            <i class="bi bi-clock-fill"></i>
                        </div>

                        <div>
                            <small>Support Hours</small>
                            <strong>Mon - Sat, 09:00 AM - 06:00 PM</strong>
                        </div>

                    </div>


                    <!-- SOCIAL -->
                    <div class="contact-social">

                        <span>Follow MarketLink</span>

                        <div class="social-links">

                            <a href="javascript:void(0)">
                                <i class="bi bi-facebook"></i>
                            </a>

                            <a href="javascript:void(0)">
                                <i class="bi bi-instagram"></i>
                            </a>

                            <a href="javascript:void(0)">
                                <i class="bi bi-twitter-x"></i>
                            </a>

                            <a href="javascript:void(0)">
                                <i class="bi bi-linkedin"></i>
                            </a>

                        </div>

                    </div>

                </div>

            </div>


            <!-- CONTACT FORM -->
            <div class="col-lg-7">

                <div class="contact-form-card">

                    <div class="form-heading">

                        <span>DROP US A MESSAGE</span>

                        <h2>
                            How Can We
                            <strong>Help You?</strong>
                        </h2>

                        <p>
                            Fill out the form below and our team will
                            get back to you as soon as possible.
                        </p>

                    </div>


                    <form id="contactForm">

                        <div class="row g-4">

                            <!-- NAME -->
                            <div class="col-md-6">

                                <label for="contactName">
                                    Your Name
                                </label>

                                <div class="input-wrapper">

                                    <i class="bi bi-person"></i>

                                    <input type="text"
                                           id="contactName"
                                           class="form-control"
                                           placeholder="Enter your name"
                                           required />

                                </div>

                            </div>


                            <!-- EMAIL -->
                            <div class="col-md-6">

                                <label for="contactEmail">
                                    Email Address
                                </label>

                                <div class="input-wrapper">

                                    <i class="bi bi-envelope"></i>

                                    <input type="email"
                                           id="contactEmail"
                                           class="form-control"
                                           placeholder="Enter your email"
                                           required />

                                </div>

                            </div>


                            <!-- PHONE -->
                            <div class="col-md-6">

                                <label for="contactPhone">
                                    Phone Number
                                </label>

                                <div class="input-wrapper">

                                    <i class="bi bi-telephone"></i>

                                    <input type="tel"
                                           id="contactPhone"
                                           class="form-control"
                                           placeholder="+92 300 1234567" />

                                </div>

                            </div>


                            <!-- SUBJECT -->
                            <div class="col-md-6">

                                <label for="contactSubject">
                                    Subject
                                </label>

                                <div class="input-wrapper">

                                    <i class="bi bi-chat-left-text"></i>

                                    <input type="text"
                                           id="contactSubject"
                                           class="form-control"
                                           placeholder="How can we help?" />

                                </div>

                            </div>


                            <!-- MESSAGE -->
                            <div class="col-12">

                                <label for="contactMessage">
                                    Your Message
                                </label>

                                <div class="input-wrapper textarea-wrapper">

                                    <i class="bi bi-pencil-square"></i>

                                    <textarea id="contactMessage"
                                              class="form-control"
                                              rows="6"
                                              placeholder="Write your message here..."
                                              required></textarea>

                                </div>

                            </div>


                            <!-- BUTTON -->
                            <div class="col-12">

                                <button type="submit"
                                        class="btn btn-contact-submit"
                                        id="contactSubmit">

                                    <span>Send Message</span>

                                    <i class="bi bi-arrow-right"></i>

                                </button>

                            </div>

                        </div>

                    </form>

                    <div id="contactSuccess"
                         class="contact-success">

                        <i class="bi bi-check-circle-fill"></i>

                        <div>
                            <strong>Message Sent Successfully!</strong>
                            <span>
                                Thank you for contacting MarketLink.
                                We'll get back to you soon.
                            </span>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     FAQ / HELP SECTION
========================= -->
<section class="contact-help-section">

    <div class="container">

        <div class="contact-help-heading">

            <span>NEED MORE HELP?</span>

            <h2>
                We're Here For
                <strong>You</strong>
            </h2>

            <p>
                Find answers to common questions or explore MarketLink
                to discover farmers, markets and fresh products.
            </p>

        </div>


        <div class="row g-4">

            <div class="col-md-4">

                <div class="help-card">

                    <div class="help-icon">
                        <i class="bi bi-shop"></i>
                    </div>

                    <h3>Find Markets</h3>

                    <p>
                        Discover local farmers markets and their
                        opening days and locations.
                    </p>

                    <a asp-controller="Markets"
                       asp-action="Index">

                        Explore Markets
                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>


            <div class="col-md-4">

                <div class="help-card">

                    <div class="help-icon">
                        <i class="bi bi-basket2-fill"></i>
                    </div>

                    <h3>Explore Products</h3>

                    <p>
                        Browse fresh products from local farmers
                        available through MarketLink.
                    </p>

                    <a asp-controller="Products"
                       asp-action="Index">

                        Browse Products
                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>


            <div class="col-md-4">

                <div class="help-card">

                    <div class="help-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>

                    <h3>Meet Farmers</h3>

                    <p>
                        Learn more about local farmers and discover
                        where they sell their products.
                    </p>

                    <a asp-controller="Farmers"
                       asp-action="Index">

                        Meet Farmers
                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     CONTACT CTA
========================= -->
<section class="contact-cta">

    <div class="container">

        <div class="contact-cta-content">

            <div>

                <span>CONNECT WITH LOCAL COMMUNITIES</span>

                <h2>
                    Fresh Products.
                    Local Farmers.
                    One Marketplace.
                </h2>

            </div>

            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-light">

                Explore Products
                <i class="bi bi-arrow-right"></i>

            </a>

        </div>

    </div>

</section>


@section Styles {

    <style>

        /* =========================================================
        CONTACT HERO
        ========================================================= */

        .contact-hero {
            position: relative;
            min-height: 460px;
            overflow: hidden;
        }

        /* =========================================================
        HERO BACKGROUND IMAGE
        ========================================================= */

        .contact-hero-image {
            position: relative;
            min-height: 445px;
            margin: 20px auto 0;
            width: min(100% - 48px, 1400px);
            border-radius: 0 0 28px 28px;
            overflow: hidden;
            background-image: url("https://images.unsplash.com/photo-1488459716781-31db52582fe9?auto=format&fit=crop&w=1800&q=90");
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            display: flex;
            align-items: center;
        }

        /* =========================================================
        DARK GREEN OVERLAY
        ========================================================= */

        .contact-hero-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient( 90deg, rgba(5, 67, 40, 0.92) 0%, rgba(8, 78, 48, 0.78) 40%, rgba(8, 78, 48, 0.38) 72%, rgba(8, 78, 48, 0.12) 100% );
            z-index: 1;
           
        }

        /* =========================================================
        HERO CONTAINER
        ========================================================= */

        .contact-hero-image .container {
            position: relative;
            z-index: 2;
            width: 100%;
        }

        /* =========================================================
        HERO CONTENT
        ========================================================= */

        .contact-hero-content {
            padding: 85px 0 80px;
            max-width: 720px;
        }

        /* =========================================================
        BREADCRUMB
        ========================================================= */

        .contact-breadcrumb {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
             margin-bottom: 38px;
            font-size: 14px;
            
        }

            .contact-breadcrumb a {
                color: #ffffff;
                text-decoration: none;
                font-weight: 600;
                transition: 0.3s ease;
            }

                .contact-breadcrumb a:hover {
                    color: #d8f52d;
                }

            .contact-breadcrumb i {
                color: #d8f52d;
                font-size: 11px;
            }

            .contact-breadcrumb span {
                color: rgba(255, 255, 255, 0.78);
            }

        /* =========================================================
        HERO LABEL
        ========================================================= */

        .contact-label {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 17px;
            color: #c8e83a;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            
        }
        /* Label Icon */

        .contact-label i {
            font-size: 17px;
            color: #c8e83a;
        }

        /* =========================================================
        HERO TITLE
        ========================================================= */

        .contact-hero h1 {
            margin: 0 0 18px;
            color: #ffffff;
            font-size: clamp(44px, 5vw, 72px);
            line-height: 1.05;
            font-weight: 800;
            letter-spacing: -1.5px;
            
        }

            .contact-hero h1 strong {
                display: block;
                color: #d8f52d;
            }

        /* =========================================================
        HERO DESCRIPTION
        ========================================================= */

        .contact-hero-text p {
            max-width: 600px;
            margin: 0;
            color: rgba(255, 255, 255, 0.90);
            font-size: 17px;
            line-height: 1.75;
            
        }

        /* =========================================================
        TABLET
        ========================================================= */

        @@media (max-width: 991px) {

            .contact-hero,
            .contact-hero-image {
                min-height: 430px;
            }

            .contact-hero-image {
                background-attachment: scroll;
            }

            .contact-hero-content {
                padding: 80px 0 70px;
            }

        }

        /* =========================================================
        MOBILE
        ========================================================= */

        @@media (max-width: 576px) {

            .contact-hero,
            .contact-hero-image {
                min-height: 420px;
            }

            .contact-hero-image {
                width: min(100% - 24px, 1400px);
                border-radius: 0 0 22px 22px;
            }

            .contact-hero-content {
                padding: 65px 0 60px;
            }

            .contact-breadcrumb {
                margin-bottom: 30px;
                gap: 9px;
                font-size: 13px;
            }

            .contact-label {
                margin-bottom: 14px;
                font-size: 11px;
            }

            .contact-hero h1 {
                margin-bottom: 15px;
                font-size: 42px;
            }

            .contact-hero-text p {
                font-size: 15px;
                line-height: 1.7;
            }

           
        }



        /* =========================
               CONTACT SECTION
            ========================= */

        .contact-section {
            padding: 95px 0;
            background: #fff;
        }

        .contact-info-card {
            height: 100%;
            padding: 42px;
            background: #f4faf6;
            border: 1px solid #dfeae2;
            border-radius: 24px;
        }

            .contact-info-card h2,
            .form-heading h2 {
                margin: 10px 0 15px;
                color: #193d29;
                font-size: clamp(30px, 4vw, 42px);
                font-weight: 800;
                line-height: 1.2;
            }

                .contact-info-card h2 strong,
                .form-heading h2 strong {
                    color: #2d9955;
                }

        .contact-intro {
            margin-bottom: 32px;
            color: #718078;
            line-height: 1.8;
            font-size: 14px;
        }

        .contact-info-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 17px 0;
            border-bottom: 1px solid #dfeae2;
        }

        .contact-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            width: 45px;
            height: 45px;
            color: #2d9955;
            background: #e5f5e9;
            border-radius: 12px;
            font-size: 18px;
        }

        .contact-info-item small,
        .contact-info-item strong {
            display: block;
        }

        .contact-info-item small {
            margin-bottom: 4px;
            color: #8a968e;
            font-size: 11px;
        }

        .contact-info-item strong {
            color: #345541;
            font-size: 13px;
        }

        .contact-social {
            padding-top: 27px;
        }

            .contact-social > span {
                display: block;
                margin-bottom: 12px;
                color: #50695a;
                font-size: 12px;
                font-weight: 700;
            }

        .social-links {
            display: flex;
            gap: 9px;
        }

            .social-links a {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 39px;
                height: 39px;
                color: #2d9955;
                background: #fff;
                border: 1px solid #d8e8dc;
                border-radius: 10px;
                text-decoration: none;
                transition: .25s;
            }

                .social-links a:hover {
                    color: #fff;
                    background: #2d9955;
                    transform: translateY(-3px);
                }


        /* =========================
               FORM
            ========================= */

        .contact-form-card {
            height: 100%;
            padding: 42px;
            background: #fff;
            border: 1px solid #e2ebe4;
            border-radius: 24px;
            box-shadow: 0 15px 45px rgba(31, 72, 44, .07);
        }

        .form-heading {
            margin-bottom: 30px;
        }

            .form-heading p {
                margin: 0;
                color: #78857d;
                font-size: 14px;
                line-height: 1.7;
            }

        .contact-form-card label {
            display: block;
            margin-bottom: 8px;
            color: #395644;
            font-size: 13px;
            font-weight: 700;
        }

        .input-wrapper {
            position: relative;
        }

            .input-wrapper > i {
                position: absolute;
                top: 50%;
                left: 16px;
                z-index: 2;
                color: #7b9583;
                transform: translateY(-50%);
            }

            .input-wrapper .form-control {
                min-height: 52px;
                padding: 13px 16px 13px 45px;
                color: #314c3a;
                background: #f9fcfa;
                border: 1px solid #dce8df;
                border-radius: 11px;
                box-shadow: none;
            }

                .input-wrapper .form-control:focus {
                    background: #fff;
                    border-color: #55a96f;
                    box-shadow: 0 0 0 4px rgba(45, 153, 85, .08);
                }

        .textarea-wrapper > i {
            top: 19px;
            transform: none;
        }

        .textarea-wrapper textarea {
            resize: vertical;
            min-height: 145px !important;
        }

        .btn-contact-submit {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            min-height: 52px;
            padding: 13px 24px;
            color: #fff;
            background: #2d9955;
            border: 0;
            border-radius: 11px;
            font-weight: 700;
            transition: .25s;
        }

            .btn-contact-submit:hover {
                color: #fff;
                background: #237c44;
                transform: translateY(-2px);
            }

        .contact-success {
            display: none;
            align-items: center;
            gap: 13px;
            margin-top: 20px;
            padding: 15px 17px;
            color: #287044;
            background: #edf9f0;
            border: 1px solid #cde9d4;
            border-radius: 12px;
        }

            .contact-success.show {
                display: flex;
            }

            .contact-success > i {
                font-size: 24px;
            }

            .contact-success strong,
            .contact-success span {
                display: block;
            }

            .contact-success strong {
                margin-bottom: 2px;
                font-size: 13px;
            }

            .contact-success span {
                font-size: 12px;
            }


        /* =========================
               HELP
            ========================= */

        .contact-help-section {
            padding: 95px 0;
            background: #f5faf6;
        }

        .contact-help-heading {
            max-width: 650px;
            margin: 0 auto 45px;
            text-align: center;
        }

            .contact-help-heading h2 {
                margin: 10px 0 12px;
                color: #193d29;
                font-size: clamp(30px, 4vw, 44px);
                font-weight: 800;
            }

                .contact-help-heading h2 strong {
                    color: #2d9955;
                }

            .contact-help-heading p {
                margin: 0;
                color: #75827a;
                line-height: 1.7;
            }

        .help-card {
            height: 100%;
            padding: 32px;
            background: #fff;
            border: 1px solid #e2ece5;
            border-radius: 19px;
            transition: .3s;
        }

            .help-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 16px 35px rgba(32, 71, 45, .09);
            }

        .help-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 52px;
            height: 52px;
            margin-bottom: 20px;
            color: #2d9955;
            background: #e8f6eb;
            border-radius: 14px;
            font-size: 21px;
        }

        .help-card h3 {
            margin-bottom: 10px;
            color: #294936;
            font-size: 19px;
            font-weight: 800;
        }

        .help-card p {
            min-height: 65px;
            margin-bottom: 20px;
            color: #78857d;
            font-size: 13px;
            line-height: 1.7;
        }

        .help-card a {
            color: #2d9955;
            text-decoration: none;
            font-size: 13px;
            font-weight: 700;
        }

            .help-card a i {
                margin-left: 5px;
            }


        /* =========================
               CTA
            ========================= */

        .contact-cta {
            padding: 70px 0;
            background: #216f3d;
        }

        .contact-cta-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 30px;
        }

            .contact-cta-content span {
                color: #a9ddb8;
                font-size: 11px;
                font-weight: 800;
                letter-spacing: 1.7px;
            }

            .contact-cta-content h2 {
                max-width: 700px;
                margin: 10px 0 0;
                color: #fff;
                font-size: clamp(30px, 4vw, 45px);
                font-weight: 800;
                line-height: 1.2;
            }

            .contact-cta-content .btn {
                flex-shrink: 0;
                padding: 13px 21px;
                border-radius: 10px;
                font-weight: 700;
            }


        /* =========================
               RESPONSIVE
            ========================= */

        @@media (max-width: 991.98px) {

            .contact-info-card,
            .contact-form-card {
                padding: 32px;
            }

            .contact-cta-content {
                flex-direction: column;
                align-items: flex-start;
            }
        }


        @@media (max-width: 575.98px) {

            .contact-hero {
                padding: 30px 0 60px;
            }

            .contact-breadcrumb {
                margin-bottom: 35px;
            }

            .contact-section,
            .contact-help-section {
                padding: 65px 0;
            }

            .contact-info-card,
            .contact-form-card {
                padding: 25px 20px;
                border-radius: 18px;
            }

                .contact-info-card h2,
                .form-heading h2 {
                    font-size: 30px;
                }

            .contact-info-item strong {
                font-size: 12px;
            }

            .btn-contact-submit {
                width: 100%;
            }

            .help-card p {
                min-height: auto;
            }

            .contact-cta {
                padding: 55px 0;
            }

            .contact-cta-content h2 {
                font-size: 31px;
            }

            .contact-cta-content .btn {
                width: 100%;
            }
        }

    </style>

}


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const contactForm = document.getElementById("contactForm");
            const successMessage = document.getElementById("contactSuccess");

            contactForm.addEventListener("submit", function (e) {

                e.preventDefault();

                const button = document.getElementById("contactSubmit");

                button.innerHTML =
                    '<i class="bi bi-check-circle-fill"></i> Message Sent';

                button.style.background = "#237c44";

                successMessage.classList.add("show");

                contactForm.reset();

            });

        });

    </script>

}