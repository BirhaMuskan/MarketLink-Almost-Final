@model MarketLink.ViewModels.ContactPageViewModel

@{
    ViewData["Title"] = "Contact Us";
}

<!-- =========================
     CONTACT HERO
========================= -->

<section class="contact-hero">

    <div class="contact-hero-image">

        <div class="contact-hero-overlay"></div>

        <div class="container">

            <div class="contact-hero-content">

                <!-- BREADCRUMB -->
                <div class="contact-breadcrumb">

                    <a asp-controller="Home"
                       asp-action="Index">
                        Home
                    </a>

                    <i class="bi bi-chevron-right"></i>

                    <span>Contact Us</span>

                </div>


                <!-- HERO CONTENT -->
                <div class="contact-hero-text">

                    <span class="contact-label">
                        <i class="bi bi-envelope-heart-fill"></i>
                        GET IN TOUCH
                    </span>

                    <h1>
                        Contact
                        <strong>MarketLink</strong>
                    </h1>

                    <p>
                        Have a question or need help?
                        We're here to connect you with MarketLink.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =========================
     CONTACT SECTION
========================= -->
<section class="contact-section">

    <div class="container">

        <div class="row g-5 align-items-stretch">

            <!-- CONTACT INFORMATION -->
            <div class="col-lg-5">

                <div class="contact-info-card">

                    <span class="section-mini-title">
                        CONTACT MARKETLINK
                    </span>

                    <h2>
                        Let's Start a
                        <strong>Conversation</strong>
                    </h2>

                    <p class="contact-intro">
                        Whether you need help using MarketLink or want to
                        connect with local farmers and markets, feel free
                        to reach out to us.
                    </p>


                    <!-- INFO ITEM -->
                    <div class="contact-info-item">

                        <div class="contact-icon">
                            <i class="bi bi-geo-alt-fill"></i>
                        </div>

                        <div>
                            <small>Our Location</small>
                            <strong>@Model.Location</strong>
                        </div>

                    </div>


                    <!-- INFO ITEM -->
                    <div class="contact-info-item">

                        <div class="contact-icon">
                            <i class="bi bi-envelope-fill"></i>
                        </div>

                        <div>
                            <small>Email Address</small>
                            <strong>
                                <a href="mailto:@Model.SupportEmail"
                                   class="contact-direct-link">
                                    @Model.SupportEmail
                                </a>
                            </strong>
                        </div>

                    </div>


                    <!-- INFO ITEM -->
                    <div class="contact-info-item">

                        <div class="contact-icon">
                            <i class="bi bi-telephone-fill"></i>
                        </div>

                        <div>
                            <small>Phone Number</small>
                            <strong>
                                <a href="tel:@Model.PhoneNumber"
                                   class="contact-direct-link">
                                    @Model.PhoneNumber
                                </a>
                            </strong>
                        </div>

                    </div>


                    <!-- INFO ITEM -->
                    <div class="contact-info-item">

                        <div class="contact-icon">
                            <i class="bi bi-clock-fill"></i>
                        </div>

                        <div>
                            <small>Support Hours</small>
                            <strong>@Model.SupportHours</strong>
                        </div>

                    </div>


                    <!-- SOCIAL -->
                    @if (!string.IsNullOrWhiteSpace(Model.FacebookUrl) ||
                         !string.IsNullOrWhiteSpace(Model.InstagramUrl) ||
                         !string.IsNullOrWhiteSpace(Model.TwitterUrl) ||
                         !string.IsNullOrWhiteSpace(Model.LinkedInUrl))
                    {
                        <div class="contact-social">

                            <span>Follow MarketLink</span>

                            <div class="social-links">

                                @if (!string.IsNullOrWhiteSpace(Model.FacebookUrl))
                                {
                                    <a href="@Model.FacebookUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       aria-label="Facebook">
                                        <i class="bi bi-facebook"></i>
                                    </a>
                                }

                                @if (!string.IsNullOrWhiteSpace(Model.InstagramUrl))
                                {
                                    <a href="@Model.InstagramUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       aria-label="Instagram">
                                        <i class="bi bi-instagram"></i>
                                    </a>
                                }

                                @if (!string.IsNullOrWhiteSpace(Model.TwitterUrl))
                                {
                                    <a href="@Model.TwitterUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       aria-label="Twitter">
                                        <i class="bi bi-twitter-x"></i>
                                    </a>
                                }

                                @if (!string.IsNullOrWhiteSpace(Model.LinkedInUrl))
                                {
                                    <a href="@Model.LinkedInUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       aria-label="LinkedIn">
                                        <i class="bi bi-linkedin"></i>
                                    </a>
                                }

                            </div>

                        </div>
                    }

                </div>

            </div>


            <!-- CONTACT FORM -->
            <div class="col-lg-7">

                <div class="contact-form-card">

                    <div class="form-heading">

                        <span>DROP US A MESSAGE</span>

                        <h2>
                            How Can We
                            <strong>Help You?</strong>
                        </h2>

                        <p>
                            Fill out the form below and our team will
                            get back to you as soon as possible.
                        </p>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
                    {
                        <div class="contact-success show contact-success-server">
                            <i class="bi bi-check-circle-fill"></i>

                            <div>
                                <strong>@Model.SuccessMessage</strong>

                                @if (!string.IsNullOrWhiteSpace(Model.ReferenceNumber))
                                {
                                    <span>
                                        Reference:
                                        <b>@Model.ReferenceNumber</b>
                                    </span>
                                }
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.TargetFarmerName))
                    {
                        <div class="contact-target-banner">
                            <i class="bi bi-person-check-fill"></i>

                            <div>
                                <span>Farmer inquiry</span>
                                <strong>@Model.TargetFarmerName</strong>
                            </div>
                        </div>
                    }

                    <form asp-controller="Contact"
                          asp-action="Index"
                          method="post"
                          id="contactForm">

                        @Html.AntiForgeryToken()

                        <input asp-for="TargetFarmerId"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="contact-validation-summary"></div>

                        <div class="row g-4">

                            <!-- NAME -->
                            <div class="col-md-6">

                                <label asp-for="Name"></label>

                                <div class="input-wrapper">
                                    <i class="bi bi-person"></i>

                                    <input asp-for="Name"
                                           class="form-control"
                                           placeholder="Enter your name" />
                                </div>

                                <span asp-validation-for="Name"
                                      class="contact-field-error"></span>

                            </div>


                            <!-- EMAIL -->
                            <div class="col-md-6">

                                <label asp-for="Email"></label>

                                <div class="input-wrapper">
                                    <i class="bi bi-envelope"></i>

                                    <input asp-for="Email"
                                           class="form-control"
                                           placeholder="Enter your email" />
                                </div>

                                <span asp-validation-for="Email"
                                      class="contact-field-error"></span>

                            </div>


                            <!-- PHONE -->
                            <div class="col-md-6">

                                <label asp-for="Phone"></label>

                                <div class="input-wrapper">
                                    <i class="bi bi-telephone"></i>

                                    <input asp-for="Phone"
                                           class="form-control"
                                           placeholder="+92 300 1234567" />
                                </div>

                                <span asp-validation-for="Phone"
                                      class="contact-field-error"></span>

                            </div>


                            <!-- INQUIRY TYPE -->
                            <div class="col-md-6">

                                <label asp-for="InquiryType"></label>

                                <div class="input-wrapper">
                                    <i class="bi bi-ui-checks-grid"></i>

                                    <select asp-for="InquiryType"
                                            class="form-control">
                                        <option value="General">General</option>
                                        <option value="Order Help">Order Help</option>
                                        <option value="Farmer Inquiry">Farmer Inquiry</option>
                                        <option value="Market Help">Market Help</option>
                                        <option value="Account Help">Account Help</option>
                                        <option value="Technical Issue">Technical Issue</option>
                                        <option value="Partnership">Partnership</option>
                                    </select>
                                </div>

                                <span asp-validation-for="InquiryType"
                                      class="contact-field-error"></span>

                            </div>


                            <!-- SUBJECT -->
                            <div class="col-12">

                                <label asp-for="Subject"></label>

                                <div class="input-wrapper">
                                    <i class="bi bi-chat-left-text"></i>

                                    <input asp-for="Subject"
                                           class="form-control"
                                           placeholder="How can we help?" />
                                </div>

                                <span asp-validation-for="Subject"
                                      class="contact-field-error"></span>

                            </div>


                            <!-- MESSAGE -->
                            <div class="col-12">

                                <label asp-for="Message"></label>

                                <div class="input-wrapper textarea-wrapper">
                                    <i class="bi bi-pencil-square"></i>

                                    <textarea asp-for="Message"
                                              class="form-control"
                                              rows="6"
                                              placeholder="Write your message here..."></textarea>
                                </div>

                                <div class="contact-message-meta">
                                    <span asp-validation-for="Message"
                                          class="contact-field-error"></span>

                                    <span id="contactMessageCount">
                                        0 / 4000
                                    </span>
                                </div>

                            </div>


                            <!-- BUTTON -->
                            <div class="col-12">

                                <button type="submit"
                                        class="btn btn-contact-submit"
                                        id="contactSubmit">

                                    <span>Send Message</span>

                                    <i class="bi bi-arrow-right"></i>

                                </button>

                                <p class="contact-submit-note">
                                    <i class="bi bi-shield-check"></i>
                                    Your inquiry is recorded in MarketLink and routed to the appropriate team.
                                </p>

                            </div>

                        </div>

                    </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     FAQ / HELP SECTION
========================= -->
<section class="contact-help-section">

    <div class="container">

        <div class="contact-help-heading">

            <span>NEED MORE HELP?</span>

            <h2>
                We're Here For
                <strong>You</strong>
            </h2>

            <p>
                Find answers to common questions or explore MarketLink
                to discover farmers, markets and fresh products.
            </p>

        </div>


        <div class="row g-4">

            <div class="col-md-4">

                <div class="help-card">

                    <div class="help-icon">
                        <i class="bi bi-shop"></i>
                    </div>

                    <h3>Find Markets</h3>

                    <p>
                        Discover @Model.ActiveMarketCount active local markets,
                        their opening days and locations.
                    </p>

                    <a asp-controller="Markets"
                       asp-action="Index">

                        Explore Markets
                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>


            <div class="col-md-4">

                <div class="help-card">

                    <div class="help-icon">
                        <i class="bi bi-basket2-fill"></i>
                    </div>

                    <h3>Explore Products</h3>

                    <p>
                        Browse @Model.AvailableProductCount currently available
                        farmer products on MarketLink.
                    </p>

                    <a asp-controller="Products"
                       asp-action="Index">

                        Browse Products
                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>


            <div class="col-md-4">

                <div class="help-card">

                    <div class="help-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>

                    <h3>Meet Farmers</h3>

                    <p>
                        Meet @Model.ActiveFarmerCount approved local farmers
                        and discover where they sell their products.
                    </p>

                    <a asp-controller="Farmers"
                       asp-action="Index">

                        Meet Farmers
                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     CONTACT CTA
========================= -->
<section class="contact-cta">

    <div class="container">

        <div class="contact-cta-content">

            <div>

                <span>CONNECT WITH LOCAL COMMUNITIES</span>

                <h2>
                    Fresh Products.
                    Local Farmers.
                    One Marketplace.
                </h2>

            </div>

            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-light">

                Explore Products
                <i class="bi bi-arrow-right"></i>

            </a>

        </div>

    </div>

</section>


@section Styles {

    <style>

        /* =========================================================
        CONTACT HERO
        ========================================================= */

        .contact-hero {
            position: relative;
            min-height: 460px;
            overflow: hidden;
        }

        /* =========================================================
        HERO BACKGROUND IMAGE
        ========================================================= */

        .contact-hero-image {
            position: relative;
            min-height: 445px;
            margin: 20px auto 0;
            width: min(100% - 48px, 1400px);
            border-radius: 0 0 28px 28px;
            overflow: hidden;
            background-image: url("https://images.unsplash.com/photo-1488459716781-31db52582fe9?auto=format&fit=crop&w=1800&q=90");
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            display: flex;
            align-items: center;
        }

        /* =========================================================
        DARK GREEN OVERLAY
        ========================================================= */

        .contact-hero-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient( 90deg, rgba(5, 67, 40, 0.92) 0%, rgba(8, 78, 48, 0.78) 40%, rgba(8, 78, 48, 0.38) 72%, rgba(8, 78, 48, 0.12) 100% );
            z-index: 1;
           
        }

        /* =========================================================
        HERO CONTAINER
        ========================================================= */

        .contact-hero-image .container {
            position: relative;
            z-index: 2;
            width: 100%;
        }

        /* =========================================================
        HERO CONTENT
        ========================================================= */

        .contact-hero-content {
            padding: 85px 0 80px;
            max-width: 720px;
        }

        /* =========================================================
        BREADCRUMB
        ========================================================= */

        .contact-breadcrumb {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
             margin-bottom: 38px;
            font-size: 14px;
            
        }

            .contact-breadcrumb a {
                color: #ffffff;
                text-decoration: none;
                font-weight: 600;
                transition: 0.3s ease;
            }

                .contact-breadcrumb a:hover {
                    color: #d8f52d;
                }

            .contact-breadcrumb i {
                color: #d8f52d;
                font-size: 11px;
            }

            .contact-breadcrumb span {
                color: rgba(255, 255, 255, 0.78);
            }

        /* =========================================================
        HERO LABEL
        ========================================================= */

        .contact-label {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 17px;
            color: #c8e83a;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            
        }
        /* Label Icon */

        .contact-label i {
            font-size: 17px;
            color: #c8e83a;
        }

        /* =========================================================
        HERO TITLE
        ========================================================= */

        .contact-hero h1 {
            margin: 0 0 18px;
            color: #ffffff;
            font-size: clamp(44px, 5vw, 72px);
            line-height: 1.05;
            font-weight: 800;
            letter-spacing: -1.5px;
            
        }

            .contact-hero h1 strong {
                display: block;
                color: #d8f52d;
            }

        /* =========================================================
        HERO DESCRIPTION
        ========================================================= */

        .contact-hero-text p {
            max-width: 600px;
            margin: 0;
            color: rgba(255, 255, 255, 0.90);
            font-size: 17px;
            line-height: 1.75;
            
        }

        /* =========================================================
        TABLET
        ========================================================= */

        @@media (max-width: 991px) {

            .contact-hero,
            .contact-hero-image {
                min-height: 430px;
            }

            .contact-hero-image {
                background-attachment: scroll;
            }

            .contact-hero-content {
                padding: 80px 0 70px;
            }

        }

        /* =========================================================
        MOBILE
        ========================================================= */

        @@media (max-width: 576px) {

            .contact-hero,
            .contact-hero-image {
                min-height: 420px;
            }

            .contact-hero-image {
                width: min(100% - 24px, 1400px);
                border-radius: 0 0 22px 22px;
            }

            .contact-hero-content {
                padding: 65px 0 60px;
            }

            .contact-breadcrumb {
                margin-bottom: 30px;
                gap: 9px;
                font-size: 13px;
            }

            .contact-label {
                margin-bottom: 14px;
                font-size: 11px;
            }

            .contact-hero h1 {
                margin-bottom: 15px;
                font-size: 42px;
            }

            .contact-hero-text p {
                font-size: 15px;
                line-height: 1.7;
            }

           
        }



        /* =========================
               CONTACT SECTION
            ========================= */

        .contact-section {
            padding: 95px 0;
            background: #fff;
        }

        .contact-info-card {
            height: 100%;
            padding: 42px;
            background: #f4faf6;
            border: 1px solid #dfeae2;
            border-radius: 24px;
        }

            .contact-info-card h2,
            .form-heading h2 {
                margin: 10px 0 15px;
                color: #193d29;
                font-size: clamp(30px, 4vw, 42px);
                font-weight: 800;
                line-height: 1.2;
            }

                .contact-info-card h2 strong,
                .form-heading h2 strong {
                    color: #2d9955;
                }

        .contact-intro {
            margin-bottom: 32px;
            color: #718078;
            line-height: 1.8;
            font-size: 14px;
        }

        .contact-info-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 17px 0;
            border-bottom: 1px solid #dfeae2;
        }

        .contact-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            width: 45px;
            height: 45px;
            color: #2d9955;
            background: #e5f5e9;
            border-radius: 12px;
            font-size: 18px;
        }

        .contact-info-item small,
        .contact-info-item strong {
            display: block;
        }

        .contact-info-item small {
            margin-bottom: 4px;
            color: #8a968e;
            font-size: 11px;
        }

        .contact-info-item strong {
            color: #345541;
            font-size: 13px;
        }

        .contact-social {
            padding-top: 27px;
        }

            .contact-social > span {
                display: block;
                margin-bottom: 12px;
                color: #50695a;
                font-size: 12px;
                font-weight: 700;
            }

        .social-links {
            display: flex;
            gap: 9px;
        }

            .social-links a {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 39px;
                height: 39px;
                color: #2d9955;
                background: #fff;
                border: 1px solid #d8e8dc;
                border-radius: 10px;
                text-decoration: none;
                transition: .25s;
            }

                .social-links a:hover {
                    color: #fff;
                    background: #2d9955;
                    transform: translateY(-3px);
                }


        /* =========================
               FORM
            ========================= */

        .contact-form-card {
            height: 100%;
            padding: 42px;
            background: #fff;
            border: 1px solid #e2ebe4;
            border-radius: 24px;
            box-shadow: 0 15px 45px rgba(31, 72, 44, .07);
        }

        .form-heading {
            margin-bottom: 30px;
        }

            .form-heading p {
                margin: 0;
                color: #78857d;
                font-size: 14px;
                line-height: 1.7;
            }

        .contact-form-card label {
            display: block;
            margin-bottom: 8px;
            color: #395644;
            font-size: 13px;
            font-weight: 700;
        }

        .input-wrapper {
            position: relative;
        }

            .input-wrapper > i {
                position: absolute;
                top: 50%;
                left: 16px;
                z-index: 2;
                color: #7b9583;
                transform: translateY(-50%);
            }

            .input-wrapper .form-control {
                min-height: 52px;
                padding: 13px 16px 13px 45px;
                color: #314c3a;
                background: #f9fcfa;
                border: 1px solid #dce8df;
                border-radius: 11px;
                box-shadow: none;
            }

                .input-wrapper .form-control:focus {
                    background: #fff;
                    border-color: #55a96f;
                    box-shadow: 0 0 0 4px rgba(45, 153, 85, .08);
                }

        .textarea-wrapper > i {
            top: 19px;
            transform: none;
        }

        .textarea-wrapper textarea {
            resize: vertical;
            min-height: 145px !important;
        }

        .btn-contact-submit {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            min-height: 52px;
            padding: 13px 24px;
            color: #fff;
            background: #2d9955;
            border: 0;
            border-radius: 11px;
            font-weight: 700;
            transition: .25s;
        }

            .btn-contact-submit:hover {
                color: #fff;
                background: #237c44;
                transform: translateY(-2px);
            }

        .contact-success {
            display: none;
            align-items: center;
            gap: 13px;
            margin-top: 20px;
            padding: 15px 17px;
            color: #287044;
            background: #edf9f0;
            border: 1px solid #cde9d4;
            border-radius: 12px;
        }

            .contact-success.show {
                display: flex;
            }

            .contact-success > i {
                font-size: 24px;
            }

            .contact-success strong,
            .contact-success span {
                display: block;
            }

            .contact-success strong {
                margin-bottom: 2px;
                font-size: 13px;
            }

            .contact-success span {
                font-size: 12px;
            }


        /* =========================
               HELP
            ========================= */

        .contact-help-section {
            padding: 95px 0;
            background: #f5faf6;
        }

        .contact-help-heading {
            max-width: 650px;
            margin: 0 auto 45px;
            text-align: center;
        }

            .contact-help-heading h2 {
                margin: 10px 0 12px;
                color: #193d29;
                font-size: clamp(30px, 4vw, 44px);
                font-weight: 800;
            }

                .contact-help-heading h2 strong {
                    color: #2d9955;
                }

            .contact-help-heading p {
                margin: 0;
                color: #75827a;
                line-height: 1.7;
            }

        .help-card {
            height: 100%;
            padding: 32px;
            background: #fff;
            border: 1px solid #e2ece5;
            border-radius: 19px;
            transition: .3s;
        }

            .help-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 16px 35px rgba(32, 71, 45, .09);
            }

        .help-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 52px;
            height: 52px;
            margin-bottom: 20px;
            color: #2d9955;
            background: #e8f6eb;
            border-radius: 14px;
            font-size: 21px;
        }

        .help-card h3 {
            margin-bottom: 10px;
            color: #294936;
            font-size: 19px;
            font-weight: 800;
        }

        .help-card p {
            min-height: 65px;
            margin-bottom: 20px;
            color: #78857d;
            font-size: 13px;
            line-height: 1.7;
        }

        .help-card a {
            color: #2d9955;
            text-decoration: none;
            font-size: 13px;
            font-weight: 700;
        }

            .help-card a i {
                margin-left: 5px;
            }


        /* =========================
