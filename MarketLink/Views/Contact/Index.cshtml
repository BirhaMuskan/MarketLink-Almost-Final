                margin: 10px 0 0;
                color: #fff;
                font-size: clamp(30px, 4vw, 45px);
                font-weight: 800;
                line-height: 1.2;
            }

            .contact-cta-content .btn {
                flex-shrink: 0;
                padding: 13px 21px;
                border-radius: 10px;
                font-weight: 700;
            }


        /* =========================
               RESPONSIVE
            ========================= */

        @@media (max-width: 991.98px) {

            .contact-info-card,
            .contact-form-card {
                padding: 32px;
            }

            .contact-cta-content {
                flex-direction: column;
                align-items: flex-start;
            }
        }


        @@media (max-width: 575.98px) {

            .contact-hero {
                padding: 30px 0 60px;
            }

            .contact-breadcrumb {
                margin-bottom: 35px;
            }

            .contact-section,
            .contact-help-section {
                padding: 65px 0;
            }

            .contact-info-card,
            .contact-form-card {
                padding: 25px 20px;
                border-radius: 18px;
            }

                .contact-info-card h2,
                .form-heading h2 {
                    font-size: 30px;
                }

            .contact-info-item strong {
                font-size: 12px;
            }

            .btn-contact-submit {
                width: 100%;
            }

            .help-card p {
                min-height: auto;
            }

            .contact-cta {
                padding: 55px 0;
            }

            .contact-cta-content h2 {
                font-size: 31px;
            }

            .contact-cta-content .btn {
                width: 100%;
            }
        }


        /* =========================
           DYNAMIC / ACTIONABLE FORM
        ========================= */

        .contact-direct-link {
            color: inherit;
            text-decoration: none;
        }

        .contact-direct-link:hover {
            color: #2d9955;
        }

        .input-wrapper select.form-control {
            appearance: none;
            cursor: pointer;
            padding-right: 42px;
        }

        .contact-validation-summary {
            margin-bottom: 18px;
            color: #b42318;
            font-size: 13px;
        }

        .contact-validation-summary ul {
            margin: 0;
            padding-left: 18px;
        }

        .contact-field-error {
            display: block;
            margin-top: 6px;
            color: #b42318;
            font-size: 11px;
        }

        .contact-message-meta {
            display: flex;
            justify-content: space-between;
            gap: 14px;
            margin-top: 5px;
            color: #8a938e;
            font-size: 10px;
        }

        .contact-target-banner {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 0 0 20px;
            padding: 13px 15px;
            border: 1px solid #d7eadf;
            border-radius: 13px;
            background: #f2f9f5;
            color: #174d36;
        }

        .contact-target-banner i {
            font-size: 20px;
            color: #2d9955;
        }

        .contact-target-banner span {
            display: block;
            color: #718078;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .08em;
        }

        .contact-target-banner strong {
            display: block;
            margin-top: 2px;
            font-size: 14px;
        }

        .contact-success-server {
            margin-bottom: 22px;
        }

        .contact-submit-note {
            display: flex;
            align-items: center;
            gap: 7px;
            margin: 10px 0 0;
            color: #8a938e;
            font-size: 10px;
        }

        .btn-contact-submit.is-submitting {
            opacity: .75;
            pointer-events: none;
        }

    </style>

}


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const contactForm =
                document.getElementById("contactForm");

            const message =
                document.getElementById("Message");

            const counter =
                document.getElementById("contactMessageCount");

            const submitButton =
                document.getElementById("contactSubmit");


            function updateCount() {

                if (!message || !counter) {
                    return;
                }

                const length =
                    message.value.length;

                counter.textContent =
                    length + " / 4000";

            }


            if (message) {

                message.addEventListener(
                    "input",
                    updateCount
                );

                updateCount();

            }


            if (contactForm && submitButton) {

                contactForm.addEventListener(
                    "submit",
                    function () {

                        if (!contactForm.checkValidity()) {
                            return;
                        }

                        submitButton.classList.add(
                            "is-submitting"
                        );

                        submitButton.innerHTML =
                            '<span>Sending...</span>' +
                            '<i class="bi bi-arrow-repeat"></i>';

                    }
                );

            }

        });
    </script>

}
