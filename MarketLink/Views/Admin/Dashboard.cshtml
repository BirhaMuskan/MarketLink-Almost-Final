                </span>

            </div>


        </div>

    </section>


    <!-- =================================================
         CUSTOMER OVERVIEW
    ================================================== -->

    <section class="admin-card">


        <div class="admin-card-header">

            <div>

                <span>
                    CUSTOMER ACTIVITY
                </span>

                <h3>Recent Customers</h3>

            </div>


            <a href="#"
               class="admin-view-link">

                View All

                <i class="bi bi-arrow-right"></i>

            </a>

        </div>


        <div class="admin-user-list">


            <div class="admin-user-row">

                <div class="admin-user-avatar purple-avatar">
                    A
                </div>

                <div class="admin-user-info">

                    <strong>
                        Ahmed
                    </strong>

                    <span>
                        8 orders · Active customer
                    </span>

                </div>

                <i class="bi bi-chevron-right admin-row-arrow"></i>

            </div>


            <div class="admin-user-row">

                <div class="admin-user-avatar green-avatar">
