                    </span>

                </div>

                <i class="bi bi-chevron-right admin-row-arrow"></i>

            </div>


        </div>

    </section>

</div>


<!-- =====================================================
     MODERATION ALERTS
====================================================== -->

<section class="admin-card admin-alert-card">


    <div class="admin-card-header">

        <div>

            <span>
                ATTENTION REQUIRED
            </span>

            <h3>Moderation & Approvals</h3>

        </div>

    </div>


    <div class="admin-alerts">


        <div class="admin-alert">

            <div class="admin-alert-icon orange">

                <i class="bi bi-person-check"></i>

            </div>

            <div>

                <strong>
                    3 farmer profiles need review
                </strong>

                <span>
                    Check newly submitted farmer accounts.
                </span>

            </div>

            <a href="#">
                Review
            </a>

        </div>


        <div class="admin-alert">

            <div class="admin-alert-icon red">

                <i class="bi bi-star"></i>

            </div>

            <div>

                <strong>
                    7 reviews awaiting moderation
                </strong>

                <span>
                    Review recently submitted customer feedback.
                </span>

            </div>

            <a href="#">
                Moderate
            </a>

        </div>


        <div class="admin-alert">

            <div class="admin-alert-icon blue">

                <i class="bi bi-shop"></i>

            </div>

            <div>

                <strong>
                    2 market requests
                </strong>

                <span>
                    New market locations require approval.
                </span>

            </div>

            <a href="#">
                Review
            </a>

        </div>


    </div>

</section>


<!-- =====================================================
     ANALYTICS BANNER
====================================================== -->

<section class="admin-analytics-banner">


    <div class="admin-analytics-icon">

        <i class="bi bi-bar-chart-line-fill"></i>

    </div>


    <div>

        <span>
            MARKETPLACE INSIGHTS
        </span>

        <h3>
            Track your marketplace performance
        </h3>

        <p>
            Review orders, users, products and sales activity
            from the Reports & Analytics section.
        </p>

    </div>


    <a href="#"
       class="admin-analytics-button">

        Open Analytics

        <i class="bi bi-arrow-right"></i>

    </a>

</section>
