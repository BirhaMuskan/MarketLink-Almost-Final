@model MarketLink.ViewModels.CustomerOrdersPageViewModel

@{
    ViewData["Title"] = "My Orders";
    Layout = "~/Views/Shared/_CustomerDashboardLayout.cshtml";
}

@section Styles {
<style>
.orders-header{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:18px}
.orders-label{color:#14836f;font-size:12px;font-weight:800;letter-spacing:.08em}
.orders-header h2{margin:7px 0 5px;font-size:28px;font-weight:800}
.orders-header p{margin:0;color:#667085}
.order-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}
.order-stats>div{background:#fff;border:1px solid #e7ebef;border-radius:15px;padding:15px}
.order-stats span{display:block;color:#667085;font-size:11px}
.order-stats strong{display:block;margin-top:3px;font-size:22px}
.orders-card{background:#fff;border:1px solid #e7ebef;border-radius:18px;overflow:hidden}
.order-tabs{display:flex;gap:7px;flex-wrap:wrap;padding:14px 16px;border-bottom:1px solid #edf0f4}
.order-tab{padding:7px 10px;border-radius:8px;text-decoration:none;color:#667085;font-size:10px;font-weight:800}
.order-tab.active{background:#e8f5ef;color:#067647}
.order-list{padding:12px}
.order-row{display:grid;grid-template-columns:1.25fr .85fr .7fr .55fr auto;gap:14px;align-items:center;padding:14px;border:1px solid #e8ebef;border-radius:13px;margin-bottom:10px}
.order-row strong{display:block}
.order-row span{display:block;color:#667085;font-size:10px;margin-top:2px}
.status{display:inline-block!important;padding:5px 8px;border-radius:999px;font-weight:800!important;width:max-content}
.status.placed{background:#eff8ff;color:#175cd3!important}
.status.accepted{background:#eef4ff;color:#3538cd!important}
.status.ready-for-pickup{background:#fff7e6;color:#b54708!important}
.status.completed{background:#dcfae6;color:#067647!important}
.status.cancelled,.status.declined{background:#fee4e2;color:#b42318!important}
.view-btn{display:inline-flex;align-items:center;gap:5px;text-decoration:none;background:#13836e;color:#fff;padding:8px 10px;border-radius:8px;font-size:10px;font-weight:800}
.empty-orders{text-align:center;padding:60px;color:#667085}
.notice{margin-bottom:14px}
@@media(max-width:900px){.order-stats{grid-template-columns:repeat(2,1fr)}.order-row{grid-template-columns:1fr 1fr}.order-row>a{grid-column:1/-1;width:max-content}}
@@media(max-width:550px){.order-stats{grid-template-columns:1fr}.order-row{grid-template-columns:1fr}}
</style>
}

<section class="orders-header">
    <div>
        <span class="orders-label">
            <i class="bi bi-receipt"></i>
            ORDER ACTIVITY
        </span>

        <h2>My Orders</h2>

        <p>
            Track your pre-orders, pickup status and completed purchases.
        </p>
    </div>
</section>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success notice">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger notice">
        @TempData["ErrorMessage"]
    </div>
}

<section class="order-stats">
    <div>
        <span>Total Orders</span>
        <strong>@Model.TotalOrders</strong>
    </div>

    <div>
        <span>Active Orders</span>
        <strong>@Model.ActiveOrders</strong>
    </div>

    <div>
        <span>Completed</span>
        <strong>@Model.CompletedOrders</strong>
    </div>

    <div>
        <span>Cancelled / Declined</span>
        <strong>@Model.CancelledOrders</strong>
    </div>
</section>

<section class="orders-card">

    <div class="order-tabs">
        @foreach (var tab in new[]
        {
            "All",
            "Placed",
            "Accepted",
            "Ready for Pickup",
            "Completed",
            "Cancelled",
            "Declined"
        })
        {
            <a asp-controller="CustomerOrders"
               asp-action="Index"
               asp-route-filter="@(tab == "All" ? null : tab)"
               class="order-tab @(Model.CurrentFilter == tab ? "active" : "")">
                @tab
            </a>
        }
    </div>

    <div class="order-list">

        @if (!Model.Orders.Any())
        {
            <div class="empty-orders">
                <i class="bi bi-receipt"
                   style="font-size:34px;color:#13836e;"></i>

                <h3 style="margin-top:10px;">
                    No orders found
                </h3>

                <p>
                    Your matching orders will appear here.
                </p>
            </div>
        }
        else
        {
            @foreach (var order in Model.Orders)
            {
                var statusClass =
                    order.OrderStatus
                        .ToLowerInvariant()
                        .Replace(" ", "-");

                <article class="order-row">

                    <div>
                        <strong>@order.OrderNo</strong>

                        <span>
                            @order.FarmerName · @order.MarketName
                        </span>
                    </div>

                    <div>
                        <strong>
                            @order.PickupDate.ToString("dd MMM yyyy")
                        </strong>

                        <span>
                            Pickup date
                        </span>
                    </div>

                    <div>
                        <strong>
                            Rs. @order.TotalAmount.ToString("N2")
                        </strong>

                        <span>
                            @order.ItemCount item(s)
                        </span>
                    </div>

                    <div>
                        <span class="status @statusClass">
                            @order.OrderStatus
                        </span>
                    </div>

                    <a asp-controller="CustomerOrders"
                       asp-action="Details"
                       asp-route-id="@order.OrderId"
                       class="view-btn">

                        View Order
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </article>
            }
        }

    </div>

</section>
