@model MarketLink.ViewModels.CustomerProductsPageViewModel

@{
    ViewData["Title"] = "Products";
    Layout = "~/Views/Shared/_CustomerDashboardLayout.cshtml";
}

@section Styles {
<style>
.products-header{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:18px}
.products-label{color:#14836f;font-size:12px;font-weight:800;letter-spacing:.08em}
.products-header h2{margin:7px 0 5px;font-size:28px;font-weight:800}
.products-header p{margin:0;color:#667085}
.product-stats{display:flex;gap:9px}
.product-stats span{background:#fff;border:1px solid #e7ebef;border-radius:11px;padding:9px 11px;color:#667085;font-size:10px}
.product-stats strong{color:#172033;margin-left:4px}
.filters-card{background:#fff;border:1px solid #e7ebef;border-radius:16px;padding:14px;margin-bottom:18px}
.filters-grid{display:grid;grid-template-columns:1.5fr repeat(3,1fr);gap:10px}
.filters-grid input,.filters-grid select{border:1px solid #d0d5dd;border-radius:9px;padding:9px 10px;background:#fff;font-size:12px}
.filter-check{display:flex;align-items:center;gap:6px;color:#475467;font-size:11px;margin-top:10px}
.filter-actions{display:flex;gap:8px;margin-top:10px}
.filter-btn{border:0;background:#13836e;color:#fff;border-radius:9px;padding:9px 14px;font-size:11px;font-weight:700}
.clear-btn{border:1px solid #d0d5dd;background:#fff;color:#475467;border-radius:9px;padding:9px 14px;text-decoration:none;font-size:11px;font-weight:700}
.product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}
.product-card{background:#fff;border:1px solid #e7ebef;border-radius:16px;overflow:hidden}
.product-image{height:180px;background:#f3f6f5;display:grid;place-items:center;color:#13836e;font-size:36px;position:relative}
.product-image img{width:100%;height:100%;object-fit:cover}
.favorite-form{position:absolute;top:10px;right:10px}
.favorite-btn{width:34px;height:34px;border-radius:50%;border:1px solid #e1e6ea;background:#fff;display:grid;place-items:center;color:#b42318}
.product-body{padding:13px}
.category{font-size:9px;color:#13836e;font-weight:800;text-transform:uppercase}
.product-body h3{font-size:15px;margin:3px 0}
.farmer{font-size:10px;color:#667085}
.description{font-size:11px;color:#667085;margin:9px 0;height:33px;overflow:hidden}
.price{font-size:15px;font-weight:800;color:#172033}
.stock{margin-top:4px;font-size:10px}
.stock.available{color:#067647}
.stock.unavailable{color:#b42318}
.market-summary{font-size:9px;color:#98a2b3;margin-top:5px}
.card-actions{display:flex;gap:7px;margin-top:12px}
.card-actions a{flex:1;text-align:center;text-decoration:none;padding:8px;border-radius:8px;font-size:10px;font-weight:700;border:1px solid #d0d5dd;color:#344054}
.card-actions a.primary{background:#13836e;color:#fff;border-color:#13836e}
.empty-products{background:#fff;border:1px solid #e7ebef;border-radius:16px;padding:70px;text-align:center;color:#667085}
@@media(max-width:1100px){.product-grid{grid-template-columns:repeat(3,1fr)}.filters-grid{grid-template-columns:1fr 1fr}}
@@media(max-width:800px){.product-grid{grid-template-columns:repeat(2,1fr)}.products-header{align-items:flex-start;flex-direction:column}}
@@media(max-width:550px){.product-grid,.filters-grid{grid-template-columns:1fr}.product-stats{flex-wrap:wrap}}
</style>
}

<section class="products-header">
    <div>
        <span class="products-label">
            <i class="bi bi-basket"></i>
            FRESH PRODUCTS
        </span>

        <h2>Browse Products</h2>

        <p>
            Search products by category, market, farmer and availability.
        </p>
    </div>

    <div class="product-stats">
        <span>Results <strong>@Model.TotalProducts</strong></span>
        <span>Available <strong>@Model.AvailableProducts</strong></span>
        <span>Favorites <strong>@Model.FavoriteProducts</strong></span>
    </div>
</section>

<section class="filters-card">
    <form asp-controller="CustomerProducts"
          asp-action="Index"
          method="get">

        <div class="filters-grid">
            <input type="text"
                   name="search"
                   value="@Model.Search"
                   placeholder="Search fresh products..." />

            <select name="categoryId">
                <option value="">All Categories</option>
                @foreach (var option in Model.Categories)
                {
                    if (option.Selected)
                    {
                        <option value="@option.Value" selected>@option.Text</option>
                    }
                    else
                    {
                        <option value="@option.Value">@option.Text</option>
                    }
                }
            </select>

            <select name="marketId">
                <option value="">All Markets</option>
                @foreach (var option in Model.Markets)
                {
                    if (option.Selected)
                    {
                        <option value="@option.Value" selected>@option.Text</option>
                    }
                    else
                    {
                        <option value="@option.Value">@option.Text</option>
                    }
                }
            </select>

            <select name="farmerId">
                <option value="">All Farmers</option>
                @foreach (var option in Model.Farmers)
                {
                    if (option.Selected)
                    {
                        <option value="@option.Value" selected>@option.Text</option>
                    }
                    else
                    {
                        <option value="@option.Value">@option.Text</option>
                    }
                }
            </select>
        </div>

        <label class="filter-check">
            @if (Model.AvailableOnly)
            {
                <input type="checkbox"
                       name="availableOnly"
                       value="true"
                       checked />
            }
            else
            {
                <input type="checkbox"
                       name="availableOnly"
                       value="true" />
            }

            Show available products only
        </label>

        <div class="filter-actions">
            <button type="submit"
                    class="filter-btn">
                <i class="bi bi-funnel"></i>
                Apply Filters
            </button>

            <a asp-controller="CustomerProducts"
               asp-action="Index"
               class="clear-btn">
                Clear
            </a>
        </div>
    </form>
</section>

@if (!Model.Products.Any())
{
    <div class="empty-products">
        <i class="bi bi-basket"
           style="font-size:34px;color:#13836e;"></i>

        <h3 style="margin-top:10px;">No products found</h3>

        <p>Try changing your filters or check again later.</p>
    </div>
}
else
{
    <div class="product-grid">
        @foreach (var item in Model.Products)
        {
            <article class="product-card">
                <div class="product-image">
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl"
                             alt="@item.ProductName" />
                    }
                    else
                    {
                        <i class="bi bi-basket"></i>
                    }

                    <form asp-controller="CustomerProducts"
                          asp-action="ToggleFavorite"
                          method="post"
                          class="favorite-form">
                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="farmerProductId"
                               value="@item.FarmerProductId" />

                        <input type="hidden"
                               name="returnUrl"
                               value="@Context.Request.Path@Context.Request.QueryString" />

                        <button type="submit"
                                class="favorite-btn"
                                title="Favorite product">
                            <i class="bi @(item.IsFavorite ? "bi-heart-fill" : "bi-heart")"></i>
                        </button>
                    </form>
                </div>

                <div class="product-body">
                    <div class="category">@item.CategoryName</div>
                    <h3>@item.ProductName</h3>

                    <div class="farmer">
                        <i class="bi bi-person"></i>
                        @item.FarmerName
                    </div>

                    <div class="description">@item.Description</div>

                    <div class="price">
                        Rs. @item.Price.ToString("N2")
                        / @item.UnitName
                    </div>

                    <div class="stock @(item.IsAvailable ? "available" : "unavailable")">
                        @if (item.IsAvailable)
                        {
                            <span>
                                @item.AvailableQuantity.ToString("N3")
                                @item.UnitName available
                            </span>
                        }
                        else
                        {
                            <span>Currently unavailable</span>
                        }
                    </div>

                    <div class="market-summary">
                        @item.MarketSummary
                    </div>

                    <div class="card-actions">
                        <a asp-controller="CustomerProducts"
                           asp-action="Details"
                           asp-route-id="@item.FarmerProductId"
                           class="primary">
                            View Product
                        </a>

                        <a asp-controller="CustomerFarmers"
                           asp-action="Details"
                           asp-route-id="@item.FarmerId">
                            Farmer
                        </a>
                    </div>
                </div>
            </article>
        }
    </div>
}
