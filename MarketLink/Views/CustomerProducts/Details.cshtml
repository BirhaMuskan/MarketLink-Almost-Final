@model MarketLink.ViewModels.CustomerProductDetailsViewModel

@{
    ViewData["Title"] = Model.ProductName;
    Layout = "~/Views/Shared/_CustomerDashboardLayout.cshtml";
}

@section Styles {
<style>
.product-detail-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:20px;margin-bottom:18px}
.detail-card{background:#fff;border:1px solid #e7ebef;border-radius:18px;overflow:hidden}
.main-image{height:420px;background:#f3f6f5;display:grid;place-items:center;color:#13836e;font-size:50px}
.main-image img{width:100%;height:100%;object-fit:cover}
.detail-content{padding:22px}
.category{color:#13836e;font-size:10px;font-weight:800;letter-spacing:.08em}
.detail-content h2{margin:5px 0;font-size:28px;font-weight:800}
.farmer-link{text-decoration:none;color:#667085;font-size:12px}
.detail-description{margin:18px 0;color:#475467}
.detail-price{font-size:24px;font-weight:800;color:#172033}
.detail-actions{display:flex;gap:9px;margin-top:18px;flex-wrap:wrap}
.detail-btn{border:1px solid #d0d5dd;background:#fff;color:#344054;border-radius:9px;padding:9px 12px;text-decoration:none;font-size:11px;font-weight:700}
.detail-btn.favorite{color:#b42318;border-color:#f2c8c5}
.inventory-card{background:#fff;border:1px solid #e7ebef;border-radius:18px;overflow:hidden}
.inventory-head{padding:15px 17px;border-bottom:1px solid #edf0f4}
.inventory-head span{color:#13836e;font-size:10px;font-weight:800}
.inventory-head h3{margin:3px 0 0;font-size:17px}
.inventory-list{padding:10px}
.inventory-row{display:grid;grid-template-columns:1.3fr .7fr .65fr .65fr 170px;gap:14px;align-items:center;padding:13px;border-bottom:1px solid #edf0f4}
.inventory-row:last-child{border-bottom:0}
.inventory-row strong{display:block}
.inventory-row span{display:block;font-size:10px;color:#667085}
.stock-badge{display:inline-block!important;padding:5px 7px;border-radius:999px;font-weight:800!important}
.stock-badge.available{background:#dcfae6;color:#067647!important}
.stock-badge.unavailable{background:#fee4e2;color:#b42318!important}
.add-cart-form{display:flex;gap:6px}
.add-cart-form input{width:68px;border:1px solid #d0d5dd;border-radius:8px;padding:7px}
.add-cart-form button{flex:1;border:0;background:#13836e;color:#fff;border-radius:8px;padding:8px;font-size:10px;font-weight:800}
.sold-btn{width:100%;border:0;background:#f2f4f7;color:#98a2b3;border-radius:8px;padding:8px;font-size:10px;font-weight:800}
.notice{margin-bottom:14px}
@@media(max-width:1000px){.inventory-row{grid-template-columns:1fr 1fr 1fr}.add-cart-form{grid-column:1/-1}}
@@media(max-width:900px){.product-detail-grid{grid-template-columns:1fr}.main-image{height:350px}}
@@media(max-width:650px){.inventory-row{grid-template-columns:1fr 1fr}.detail-actions{flex-wrap:wrap}}
</style>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success notice">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger notice">
        @TempData["ErrorMessage"]
    </div>
}

<div class="product-detail-grid">

    <section class="detail-card">

        <div class="main-image">

            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     alt="@Model.ProductName" />
            }
            else
            {
                <i class="bi bi-basket"></i>
            }

        </div>

    </section>

    <section class="detail-card">

        <div class="detail-content">

            <div class="category">
                @Model.CategoryName
            </div>

            <h2>@Model.ProductName</h2>

            <a asp-controller="CustomerFarmers"
               asp-action="Details"
               asp-route-id="@Model.FarmerId"
               class="farmer-link">

                <i class="bi bi-person"></i>
                Sold by @Model.FarmerName
            </a>

            <p class="detail-description">
                @Model.Description
            </p>

            <div class="detail-price">
                Rs. @Model.BasePrice.ToString("N2")
                / @Model.UnitName
            </div>

            <div class="detail-actions">

                <form asp-controller="CustomerProducts"
                      asp-action="ToggleFavorite"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="farmerProductId"
                           value="@Model.FarmerProductId" />

                    <input type="hidden"
                           name="returnUrl"
                           value="@Context.Request.Path" />

                    <button type="submit"
                            class="detail-btn favorite">

                        <i class="bi @(Model.IsFavorite ? "bi-heart-fill" : "bi-heart")"></i>

                        @(Model.IsFavorite
                            ? "Saved Product"
                            : "Save Product")
                    </button>

                </form>

                <a asp-controller="CustomerCart"
                   asp-action="Index"
                   class="detail-btn">

                    <i class="bi bi-cart3"></i>
                    View Cart
                </a>

                <a asp-controller="CustomerProducts"
                   asp-action="Index"
                   class="detail-btn">

                    <i class="bi bi-arrow-left"></i>
                    Back to Products
                </a>

            </div>

        </div>

    </section>

</div>

<section class="inventory-card">

    <div class="inventory-head">

        <span>PICKUP AVAILABILITY</span>

        <h3>
            Choose a market and add to cart
        </h3>

    </div>

    <div class="inventory-list">

        @if (!Model.Inventory.Any())
        {
            <div style="padding:45px;text-align:center;color:#667085;">
                No current or upcoming inventory is available.
            </div>
        }
        else
        {
            @foreach (var inventory in Model.Inventory)
            {
                <div class="inventory-row">

                    <div>
                        <strong>@inventory.MarketName</strong>
                        <span>@inventory.MarketAddress</span>
                    </div>

                    <div>
                        <strong>
                            @inventory.InventoryDate.ToString("dd MMM yyyy")
                        </strong>
                        <span>Stock date</span>
                    </div>

                    <div>
                        <strong>
                            Rs. @inventory.UnitPrice.ToString("N2")
                        </strong>
                        <span>per @Model.UnitName</span>
                    </div>

                    <div>
                        @if (inventory.IsAvailable)
                        {
                            <span class="stock-badge available">
                                @inventory.AvailableQuantity.ToString("N3")
                                available
                            </span>
                        }
                        else
                        {
                            <span class="stock-badge unavailable">
                                Sold out
                            </span>
                        }
                    </div>

                    <div>
                        @if (inventory.IsAvailable)
                        {
                            <form asp-controller="CustomerCart"
                                  asp-action="Add"
                                  method="post"
                                  class="add-cart-form">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="FarmerProductId"
                                       value="@Model.FarmerProductId" />

                                <input type="hidden"
                                       name="FarmerMarketId"
                                       value="@inventory.FarmerMarketId" />

                                <input type="hidden"
                                       name="ReturnUrl"
                                       value="@Context.Request.Path" />

                                <input type="number"
                                       name="Quantity"
                                       value="1"
                                       min="0.001"
                                       step="0.001"
                                       max="@inventory.AvailableQuantity" />

                                <button type="submit">
                                    <i class="bi bi-cart-plus"></i>
                                    Add to Cart
                                </button>

                            </form>
                        }
                        else
                        {
                            <button type="button"
                                    class="sold-btn"
                                    disabled>
                                Sold Out
                            </button>
                        }
                    </div>

                </div>
            }
        }

    </div>

</section>
