
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - MarketLink</title>


    <!-- =========================================================
         GOOGLE FONTS
    ========================================================== -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap"
          rel="stylesheet">


    <!-- =========================================================
         BOOTSTRAP
    ========================================================== -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">


    <!-- =========================================================
         BOOTSTRAP ICONS
    ========================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

          <link rel="stylesheet" href="~/css/loader.css" />
    <!-- =========================================================
         MARKETLINK CUSTOM CSS
    ========================================================== -->

    <link rel="stylesheet"
          href="~/css/style.css"
          asp-append-version="true" />

          <!-- =========================================================
     MARKETLINK FAVICON
========================================================== -->

<link rel="icon"
      type="image/svg+xml"
      href="~/images/marketlink-favicon.svg" />

<link rel="apple-touch-icon"
      href="~/images/marketlink-favicon.svg" />
    @await RenderSectionAsync("Styles", required: false)

</head>


<body>

    <!-- MARKETLINK PAGE LOADER -->

    <div id="marketLinkLoader">

        <div class="market-loader-content">

            <div class="market-loader-logo">

                <div class="market-loader-leaf"></div>

            </div>


            <h1 class="market-loader-brand">
                Market<span>Link</span>
            </h1>


            <p class="market-loader-tagline">
                Fresh Markets · Local Farmers
            </p>


            <div class="market-loader-dots">

                <span></span>
                <span></span>
                <span></span>

            </div>


            <div class="market-loader-progress">

                <span></span>

            </div>

        </div>

    </div>

    <!-- =========================================================
     NAVBAR
========================================================== -->

<header class="market-header">

    <nav class="navbar navbar-expand-xl market-navbar">

        <div class="container">

            <!-- =========================
                 LOGO
            ========================== -->
            <a class="navbar-brand market-logo"
   asp-controller="Home"
   asp-action="Index">

    <span class="logo-mark">
        <span class="brand-leaf"></span>
    </span>

    <span class="logo-text">
        Market<span>Link</span>
    </span>

</a>


            <!-- =========================
                 MOBILE TOGGLE
            ========================== -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#marketNavbar"
                    aria-controls="marketNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>


            <!-- =========================
                 NAVBAR CONTENT
            ========================== -->
            <div class="collapse navbar-collapse" id="marketNavbar">

                <!-- MAIN NAV LINKS -->
                <div class="market-main-nav">

                    <a class="market-nav-link"
                       asp-controller="Home"
                       asp-action="Index">
                        Home
                    </a>

                    <a class="market-nav-link"
                       asp-controller="Markets"
                       asp-action="Index">
                        Markets
                    </a>

                    <a class="market-nav-link"
                       asp-controller="Products"
                       asp-action="Index">
                        Products
                    </a>

                    <a class="market-nav-link"
                       asp-controller="Farmers"
                       asp-action="Index">
                        Farmers
                    </a>

                    <a class="market-nav-link"
                       asp-controller="HowItWorks"
                       asp-action="Index">
                        How It Works
                    </a>

                    <a class="market-nav-link"
                       asp-controller="About"
                       asp-action="Index">
                        About
                    </a>

                    <a class="market-nav-link"
                       asp-controller="Contact"
                       asp-action="Index">
                        Contact
                    </a>

                </div>


                <!-- =========================
                     RIGHT ACTIONS
                ========================== -->
                <div class="market-actions">

    <!-- Search -->
    <a asp-controller="Products"
       asp-action="Index"
       class="market-action"
       title="Search Products">

        <i class="bi bi-search"></i>
        <span>Search</span>

    </a>


    <!-- MarketMate -->
    <a href="#"
       class="market-action marketmate-action"
       title="MarketMate AI">

        <i class="bi bi-robot"></i>
        <span>MarketMate</span>

    </a>


    <!-- Favorites -->
    <a href="#"
       class="market-action"
       title="Favorites">

        <i class="bi bi-heart"></i>
        <span>Favorites</span>

    </a>


    <!-- Cart -->
    <a asp-controller="Cart"
   asp-action="Index"
       class="market-action"
       title="Shopping Cart">

        <i class="bi bi-cart3"></i>
        <span>Cart</span>

    </a>


    @if (User.Identity?.IsAuthenticated == true)
    {
        var dashboardController =
            User.IsInRole("Admin") ? "Admin" :
            User.IsInRole("Farmer") ? "Farmer" :
            "CustomerDashboard";

        <span class="market-auth-link">
            @User.Identity.Name
        </span>

        <a asp-controller="@dashboardController"
           asp-action="Index"
           class="market-auth-button">
            Dashboard
        </a>

        <form id="marketLogoutForm"
              asp-controller="Auth"
              asp-action="Logout"
              method="post"
              class="d-none">
        </form>

        <a href="#"
           class="market-auth-link"
           onclick="event.preventDefault(); localStorage.removeItem('accessToken'); localStorage.removeItem('refreshToken'); document.getElementById('marketLogoutForm').submit();">
            Logout
        </a>
    }
    else
    {
        <a href="/Auth/Login"
   class="market-auth-link">
    Sign In
</a>

        <a asp-controller="Auth"
           asp-action="Register"
           class="market-auth-button">
            Get Started
        </a>
    }

</div>

            </div>

        </div>

    </nav>

</header>



    <!-- =========================================================
         MAIN CONTENT
    ========================================================== -->

    <main>

        @RenderBody()

    </main>



    <!-- =========================================================
         FOOTER
    ========================================================== -->

    <footer class="market-footer">

        <div class="container">

            <div class="row gy-4">


                <!-- =================================================
                     BRAND / DESCRIPTION
                ================================================== -->

                <div class="col-lg-5">


                   <a class="market-logo footer-logo"
   asp-controller="Home"
   asp-action="Index">

    <span class="logo-icon">
        <span class="brand-leaf"></span>
    </span>

    <span class="logo-text">
        Market<span>Link</span>
    </span>

</a>


                    <p class="footer-description">

                        Connecting local farmers, fresh products and
                        communities — all in one place.

                    </p>


                    <!-- SOCIAL LINKS -->

                    <div class="footer-socials">


                        <a href="#"
                           aria-label="Facebook">

                            <i class="bi bi-facebook"></i>

                        </a>


                        <a href="#"
                           aria-label="Instagram">

                            <i class="bi bi-instagram"></i>

                        </a>


                        <a href="#"
                           aria-label="Twitter">

                            <i class="bi bi-twitter-x"></i>

                        </a>


                        <a href="#"
                           aria-label="LinkedIn">

                            <i class="bi bi-linkedin"></i>

                        </a>

                    </div>

                </div>



                <!-- =================================================
                     EXPLORE
                ================================================== -->

                <div class="col-6 col-lg-2">


                    <h5>
                        Explore
                    </h5>


                    <a href="#markets">
                        Markets
                    </a>


                    <a href="#products">
                        Products
                    </a>


                    <a href="#farmers">
                        Farmers
                    </a>


                    <a href="#how-it-works">
                        How It Works
                    </a>

                </div>



                <!-- =================================================
                     PLATFORM
                ================================================== -->

                <div class="col-6 col-lg-2">


                    <h5>
                        Platform
                    </h5>


                    <a asp-controller="Account"
                       asp-action="Register">

                        Become a Farmer

                    </a>


                    <a href="#">

                        My Orders

                    </a>


                    <a href="#">

                        Favorites

                    </a>


                    <a href="#">

                        MarketMate AI

                    </a>

                </div>



                <!-- =================================================
                     CONTACT / NEWSLETTER
                ================================================== -->

                <div class="col-lg-3">


                    <h5>
                        Stay Connected
                    </h5>


                    <p class="newsletter-text">

                        Get fresh market updates and local finds.

                    </p>


                    <div class="newsletter-box">


                        <input type="email"
                               class="form-control"
                               placeholder="Your email address"
                               aria-label="Your email address" />


                        <button type="button"
                                aria-label="Subscribe">

                            <i class="bi bi-arrow-right"></i>

                        </button>

                    </div>

                </div>

            </div>



            <!-- =================================================
                 FOOTER BOTTOM
            ================================================== -->

            <div class="footer-bottom">


                <span>

                    © @DateTime.Now.Year MarketLink.
                    All rights reserved.

                </span>


                <div>


                    <a href="#">

                        Privacy

                    </a>


                    <a href="#">

                        Terms

                    </a>

                </div>

            </div>

        </div>

    </footer>



    <!-- =========================================================
         BOOTSTRAP JAVASCRIPT
    ========================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


    <!-- =========================================================
         MARKETLINK JAVASCRIPT
    ========================================================== -->

    <script src="~/js/marketlink.js"
            asp-append-version="true"></script>


    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/loader.js"></script>
@await Component.InvokeAsync("AssistantWidget")
</body>

</html>

