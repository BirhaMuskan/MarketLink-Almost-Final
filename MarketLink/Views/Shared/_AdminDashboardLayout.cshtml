@{
    var title = ViewData["Title"] ?? "Admin Dashboard";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - MarketLink</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <link rel="stylesheet"
          href="~/css/admindashboard.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-dashboard-body">

    <div class="admin-overlay" id="adminOverlay"></div>

    <aside class="admin-sidebar" id="adminSidebar">

        <div class="admin-brand">
            <a asp-controller="Home"
               asp-action="Index"
               class="admin-logo">
                <span class="admin-logo-icon">
                    <i class="bi bi-basket-fill"></i>
                </span>
                <span>Market<span>Link</span></span>
            </a>

            <button type="button"
                    class="admin-sidebar-close"
                    id="adminSidebarClose">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="admin-mini-profile">
            <div class="admin-avatar">
                @(User.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "A")
            </div>
            <div>
                <strong>@(User.Identity?.Name ?? "MarketLink Admin")</strong>
                <span>Administrator</span>
            </div>
        </div>

        @await Component.InvokeAsync("AdminSidebar")

        <div class="admin-sidebar-bottom">
            <a asp-controller="Home"
               asp-action="Index"
               class="admin-menu-link">
                <i class="bi bi-box-arrow-left"></i>
                <span>Back to Website</span>
            </a>
        </div>
    </aside>

    <div class="admin-main">

        <header class="admin-topbar">
            <div class="admin-top-left">
                <button type="button"
                        class="admin-sidebar-toggle"
                        id="adminSidebarToggle">
                    <i class="bi bi-list"></i>
                </button>

                <div>
                    <span>Administration</span>
                    <h1>@title</h1>
                </div>
            </div>

            <div class="admin-top-actions">
                <a asp-controller="Notifications"
                   asp-action="Index"
                   class="admin-top-icon"
                   title="Notifications">
                    <i class="bi bi-bell"></i>
                </a>

                <div class="admin-top-user">
                    <div class="admin-top-avatar">
                        @(User.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "A")
                    </div>
                    <div>
                        <strong>Administrator</strong>
                        <small>@(User.Identity?.Name ?? "MarketLink Admin")</small>
                    </div>
                </div>
            </div>
        </header>

        <main class="admin-content">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const sidebar = document.getElementById("adminSidebar");
            const toggle = document.getElementById("adminSidebarToggle");
            const close = document.getElementById("adminSidebarClose");
            const overlay = document.getElementById("adminOverlay");

            const hideSidebar = function () {
                sidebar?.classList.remove("show");
                overlay?.classList.remove("show");
            };

            toggle?.addEventListener("click", function () {
                sidebar?.classList.add("show");
                overlay?.classList.add("show");
            });

            close?.addEventListener("click", hideSidebar);
            overlay?.addEventListener("click", hideSidebar);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
