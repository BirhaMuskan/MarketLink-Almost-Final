@model MarketLink.ViewModels.CustomerCartPageViewModel

@{
    ViewData["Title"] = "My Cart";
    Layout = "~/Views/Shared/_CustomerDashboardLayout.cshtml";
}

@section Styles {
<style>
.cart-header{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:18px}
.cart-label{color:#14836f;font-size:12px;font-weight:800;letter-spacing:.08em}
.cart-header h2{margin:7px 0 5px;font-size:28px;font-weight:800}
.cart-header p{margin:0;color:#667085}
.cart-grid{display:grid;grid-template-columns:1fr 340px;gap:18px}
.cart-card,.summary-card{background:#fff;border:1px solid #e7ebef;border-radius:18px;overflow:hidden}
.cart-card-head,.summary-head{padding:15px 17px;border-bottom:1px solid #edf0f4}
.cart-card-head span,.summary-head span{color:#13836e;font-size:10px;font-weight:800;letter-spacing:.08em}
.cart-card-head h3,.summary-head h3{margin:3px 0 0;font-size:16px}
.cart-list{padding:12px}
.cart-row{display:grid;grid-template-columns:72px 1fr 130px 90px;gap:14px;align-items:center;padding:14px;border-bottom:1px solid #edf0f4}
.cart-row:last-child{border-bottom:0}
.cart-image{width:72px;height:72px;border-radius:12px;overflow:hidden;background:#f3f6f5;display:grid;place-items:center;color:#13836e}
.cart-image img{width:100%;height:100%;object-fit:cover}
.cart-info strong{display:block}
.cart-info span{display:block;color:#667085;font-size:10px;margin-top:3px}
.qty-form{display:flex;gap:6px}
.qty-form input{width:74px;border:1px solid #d0d5dd;border-radius:8px;padding:7px}
.qty-form button,.remove-btn{border:1px solid #d0d5dd;background:#fff;border-radius:8px;padding:7px 9px;font-size:10px;font-weight:700}
.remove-btn{color:#b42318;border-color:#f2c8c5}
.line-total{font-weight:800;text-align:right}
.summary-body{padding:17px}
.summary-row{display:flex;justify-content:space-between;gap:10px;margin-bottom:10px;color:#475467;font-size:12px}
.summary-row.total{border-top:1px solid #edf0f4;padding-top:12px;margin-top:12px;font-size:15px;font-weight:800;color:#172033}
.checkout-btn{display:block;width:100%;text-align:center;background:#13836e;color:#fff;text-decoration:none;padding:11px;border-radius:10px;font-weight:800;margin-top:14px}
.clear-form{margin-top:9px}
.clear-btn{width:100%;border:1px solid #f2c8c5;background:#fff;color:#b42318;padding:10px;border-radius:9px;font-weight:700}
.empty-cart{background:#fff;border:1px solid #e7ebef;border-radius:18px;padding:70px;text-align:center;color:#667085}
.empty-cart i{font-size:38px;color:#13836e}
.alert-box{margin-bottom:14px}
@@media(max-width:950px){.cart-grid{grid-template-columns:1fr}}
@@media(max-width:700px){.cart-row{grid-template-columns:60px 1fr}.qty-form,.line-total,.cart-row>form:last-child{grid-column:2}}
</style>
}

<section class="cart-header">
    <div>
        <span class="cart-label">
            <i class="bi bi-cart3"></i>
            SHOPPING CART
        </span>

        <h2>My Cart</h2>

        <p>
            Review quantities before choosing a pickup slot.
        </p>
    </div>
</section>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-box">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-box">
        @TempData["ErrorMessage"]
    </div>
}

@if (Model.CartId == 0 || !Model.Items.Any())
{
    <div class="empty-cart">
        <i class="bi bi-cart3"></i>
        <h3 style="margin-top:10px;">Your cart is empty</h3>
        <p>Add a product from the product detail page.</p>

        <a asp-controller="CustomerProducts"
           asp-action="Index"
           class="checkout-btn"
           style="max-width:220px;margin:16px auto 0;">
            Browse Products
        </a>
    </div>
}
else
{
    <div class="cart-grid">

        <section class="cart-card">

            <div class="cart-card-head">
                <span>@Model.FarmerName</span>
                <h3>
                    @Model.MarketName
                    @if (!string.IsNullOrWhiteSpace(Model.StallNumber))
                    {
                        <text> · Stall @Model.StallNumber</text>
                    }
                </h3>
            </div>

            <div class="cart-list">

                @foreach (var item in Model.Items)
                {
                    <div class="cart-row">

                        <div class="cart-image">
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl"
                                     alt="@item.ProductName" />
                            }
                            else
                            {
                                <i class="bi bi-basket"></i>
                            }
                        </div>

                        <div class="cart-info">
                            <strong>@item.ProductName</strong>

                            <span>
                                Rs. @item.UnitPrice.ToString("N2")
                                / @item.UnitName
                            </span>

                            <span>
                                Current future stock:
                                @item.AvailableQuantity.ToString("N3")
                                @item.UnitName
                            </span>
                        </div>

                        <form asp-controller="CustomerCart"
                              asp-action="Update"
                              method="post"
                              class="qty-form">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="CartItemId"
                                   value="@item.CartItemId" />

                            <input type="number"
                                   name="Quantity"
                                   value="@item.Quantity"
                                   step="0.001"
                                   min="0.001" />

                            <button type="submit">
                                Update
                            </button>

                        </form>

                        <div class="line-total">
                            Rs. @item.LineTotal.ToString("N2")
                        </div>

                        <form asp-controller="CustomerCart"
                              asp-action="Remove"
                              method="post"
                              onsubmit="return confirm('Remove this product from your cart?');">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@item.CartItemId" />

                            <button type="submit"
                                    class="remove-btn">
                                Remove
                            </button>

                        </form>

                    </div>
                }

            </div>

        </section>

        <aside class="summary-card">

            <div class="summary-head">
                <span>ORDER SUMMARY</span>
                <h3>Pre-order</h3>
            </div>

            <div class="summary-body">

                <div class="summary-row">
                    <span>Farmer</span>
                    <strong>@Model.FarmerName</strong>
                </div>

                <div class="summary-row">
                    <span>Pickup Market</span>
                    <strong>@Model.MarketName</strong>
                </div>

                <div class="summary-row">
                    <span>Items</span>
                    <strong>@Model.Items.Count</strong>
                </div>

                <div class="summary-row total">
                    <span>Estimated Total</span>
                    <strong>
                        Rs. @Model.EstimatedTotal.ToString("N2")
                    </strong>
                </div>

                <small style="color:#667085;">
                    Final prices are validated against the selected pickup-date inventory at checkout.
                </small>

                <a asp-controller="CustomerCart"
                   asp-action="Checkout"
                   class="checkout-btn">
                    Choose Pickup & Checkout
                </a>

                <form asp-controller="CustomerCart"
                      asp-action="Clear"
                      method="post"
                      class="clear-form"
                      onsubmit="return confirm('Clear your cart?');">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="clear-btn">
                        Clear Cart
                    </button>

                </form>

            </div>

        </aside>

    </div>
}
