@model MarketLink.ViewModels.CustomerOrderSuccessViewModel

@{
    ViewData["Title"] = "Order Placed";
    Layout = "~/Views/Shared/_CustomerDashboardLayout.cshtml";
}

@section Styles {
<style>
.success-card{max-width:760px;margin:30px auto;background:#fff;border:1px solid #e7ebef;border-radius:20px;padding:34px;text-align:center}
.success-icon{width:72px;height:72px;border-radius:50%;background:#dcfae6;color:#067647;display:grid;place-items:center;font-size:30px;margin:0 auto 15px}
.success-card h2{font-size:28px;font-weight:800;margin-bottom:7px}
.success-card>p{color:#667085}
.order-box{margin:24px 0;background:#f8fafc;border-radius:14px;padding:18px;text-align:left}
.order-row{display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px solid #e7ebef}
.order-row:last-child{border-bottom:0}
.success-actions{display:flex;justify-content:center;gap:9px;flex-wrap:wrap}
.success-btn{padding:10px 14px;border-radius:9px;text-decoration:none;font-weight:700;font-size:11px;border:1px solid #d0d5dd;color:#344054}
.success-btn.primary{background:#13836e;color:#fff;border-color:#13836e}
</style>
}

<section class="success-card">

    <div class="success-icon">
        <i class="bi bi-check-lg"></i>
    </div>

    <h2>Pre-order placed</h2>

    <p>
        Your order has been sent to the farmer.
    </p>

    <div class="order-box">

        <div class="order-row">
            <span>Order No.</span>
            <strong>@Model.OrderNo</strong>
        </div>

        <div class="order-row">
            <span>Pickup Market</span>
            <strong>@Model.MarketName</strong>
        </div>

        <div class="order-row">
            <span>Pickup Date</span>
            <strong>@Model.PickupDate.ToString("dd MMM yyyy")</strong>
        </div>

        <div class="order-row">
            <span>Pickup Time</span>
            <strong>@Model.PickupTimeText</strong>
        </div>

        <div class="order-row">
            <span>Total</span>
            <strong>
                Rs. @Model.TotalAmount.ToString("N2")
            </strong>
        </div>

        <div class="order-row">
            <span>Payment</span>
            <strong>Pay at pickup</strong>
        </div>

    </div>

    <div class="success-actions">

        <a asp-controller="CustomerProducts"
           asp-action="Index"
           class="success-btn">
            Continue Browsing
        </a>

        <a asp-controller="CustomerOrders"
   asp-action="Index"
   class="success-btn primary">

    My Orders

</a>

    </div>

</section>
