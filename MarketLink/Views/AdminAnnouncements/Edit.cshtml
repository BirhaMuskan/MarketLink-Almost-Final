@model MarketLink.ViewModels.AdminAnnouncementEditViewModel

@{
    var isEdit = Model.AnnouncementId > 0;
    ViewData["Title"] = isEdit ? "Edit Announcement" : "New Announcement";
    Layout = "~/Views/Shared/_AdminDashboardLayout.cshtml";
}

@section Styles {
<style>
.form-head{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;margin-bottom:18px}
.form-label{color:#14836f;font-size:12px;font-weight:800;letter-spacing:.08em}
.form-head h2{margin:7px 0 5px;font-size:27px;font-weight:800}
.form-head p{margin:0;color:#667085}
.back-btn{display:inline-flex;align-items:center;gap:6px;border:1px solid #d0d5dd;color:#344054;text-decoration:none;padding:8px 10px;border-radius:8px;font-size:10px;font-weight:800}
.form-card{max-width:850px;background:#fff;border:1px solid #e7ebef;border-radius:18px;padding:22px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.field{margin-bottom:16px}
.field.full{grid-column:1/-1}
.field label{display:block;margin-bottom:6px;color:#344054;font-size:11px;font-weight:800}
.field input,.field textarea,.field select{width:100%;border:1px solid #d0d5dd;border-radius:10px;padding:10px 11px;font-size:12px}
.field textarea{min-height:150px;resize:vertical}
.active-box{padding:12px;background:#f8fafc;border-radius:10px;margin-bottom:16px}
.actions{display:flex;justify-content:flex-end;gap:8px;border-top:1px solid #edf0f4;padding-top:17px}
.primary-btn{border:0;background:#13836e;color:#fff;padding:9px 14px;border-radius:9px;font-size:11px;font-weight:800}
.secondary-btn{border:1px solid #d0d5dd;background:#fff;color:#344054;text-decoration:none;padding:9px 14px;border-radius:9px;font-size:11px;font-weight:800}
@@media(max-width:650px){.form-head{flex-direction:column}.grid{grid-template-columns:1fr}.field.full{grid-column:auto}}
</style>
}

<section class="form-head">
    <div>
        <span class="form-label">
            ANNOUNCEMENT
        </span>

        <h2>
            @(isEdit ? "Edit Announcement" : "Create Announcement")
        </h2>

        <p>
            Set the audience and publication window.
        </p>
    </div>

    <a asp-controller="AdminAnnouncements"
       asp-action="Index"
       class="back-btn">
        <i class="bi bi-arrow-left"></i>
        Announcements
    </a>
</section>

<section class="form-card">

    <form asp-controller="AdminAnnouncements"
          asp-action="@(isEdit ? "Edit" : "Create")"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="AnnouncementId"
               type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="grid">

            <div class="field full">
                <label asp-for="Title"></label>

                <input asp-for="Title"
                       maxlength="150"
                       placeholder="Announcement title" />

                <span asp-validation-for="Title"
                      class="text-danger"></span>
            </div>

            <div class="field full">
                <label asp-for="Message"></label>

                <textarea asp-for="Message"
                          maxlength="2000"
                          placeholder="Write the announcement message..."></textarea>

                <span asp-validation-for="Message"
                      class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="Audience"></label>

                <select asp-for="Audience">
                    <option value="ALL">All Customers & Farmers</option>
                    <option value="CUSTOMER">Customers Only</option>
                    <option value="FARMER">Farmers Only</option>
                </select>

                <span asp-validation-for="Audience"
                      class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="PublishFrom"></label>

                <input asp-for="PublishFrom"
                       type="datetime-local"
                       value="@Model.PublishFrom.ToString("yyyy-MM-ddTHH:mm")" />

                <span asp-validation-for="PublishFrom"
                      class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="PublishUntil"></label>

                <input asp-for="PublishUntil"
                       type="datetime-local"
                       value="@(Model.PublishUntil.HasValue ? Model.PublishUntil.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />

                <span asp-validation-for="PublishUntil"
                      class="text-danger"></span>
            </div>

        </div>

        <div class="active-box">
            <label>
                <input asp-for="IsActive" />
                Active / publish when the date window is valid
            </label>
        </div>

        <div class="actions">
            <a asp-controller="AdminAnnouncements"
               asp-action="Index"
               class="secondary-btn">
                Cancel
            </a>

            <button type="submit"
                    class="primary-btn">
                @(isEdit ? "Save Changes" : "Create Announcement")
            </button>
        </div>

    </form>

</section>
