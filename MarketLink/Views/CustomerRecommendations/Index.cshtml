@model MarketLink.ViewModels.CustomerRecommendationsPageViewModel

@{
    ViewData["Title"] = "Recommended For You";
    Layout = "~/Views/Shared/_CustomerDashboardLayout.cshtml";
}

@section Styles {
<style>
.rec-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:18px}
.rec-label{color:#14836f;font-size:12px;font-weight:800;letter-spacing:.08em}
.rec-head h2{margin:7px 0 5px;font-size:28px;font-weight:800}
.rec-head p{margin:0;color:#667085}
.rec-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.ai-badge{display:inline-flex;align-items:center;gap:5px;background:#eef4ff;color:#3538cd;padding:6px 9px;border-radius:999px;font-size:9px;font-weight:800}
.refresh-btn{border:0;background:#13836e;color:#fff;padding:9px 12px;border-radius:9px;font-size:10px;font-weight:800}
.summary{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}
.summary-card{background:#fff;border:1px solid #e7ebef;border-radius:15px;padding:15px}
.summary-card span{display:block;color:#667085;font-size:10px}
.summary-card strong{display:block;margin-top:4px;font-size:20px}
.info-box{background:#f0fdf4;border:1px solid #d1fadf;color:#067647;border-radius:12px;padding:12px 14px;margin-bottom:18px;font-size:10px;line-height:1.5}
.rec-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.rec-card{background:#fff;border:1px solid #e7ebef;border-radius:18px;overflow:hidden;display:flex;flex-direction:column}
.rec-image{height:170px;background:#f7faf8;display:flex;align-items:center;justify-content:center;overflow:hidden}
.rec-image img{width:100%;height:100%;object-fit:cover}
.rec-placeholder{font-size:42px;color:#8eb6a6}
.rec-body{padding:15px;display:flex;flex-direction:column;flex:1}
.rec-meta{display:flex;justify-content:space-between;gap:8px;margin-bottom:8px;align-items:center}
.category{font-size:8px;text-transform:uppercase;letter-spacing:.07em;color:#13836e;font-weight:800}
.score{font-size:9px;font-weight:800;color:#3538cd;background:#eef4ff;border-radius:999px;padding:4px 7px}
.rec-card h3{font-size:16px;margin:0 0 4px}
.farmer{font-size:10px;color:#667085;margin-bottom:10px}
.reason{font-size:10px;line-height:1.45;color:#475467;background:#f8fafc;border-radius:9px;padding:9px;margin-bottom:12px}
.price-row{display:flex;justify-content:space-between;align-items:end;gap:10px;margin-top:auto}
.price strong{font-size:15px}
.price span,.stock{display:block;color:#667085;font-size:9px}
.view-btn{display:inline-flex;align-items:center;justify-content:center;gap:5px;background:#13836e;color:#fff;text-decoration:none;padding:8px 10px;border-radius:8px;font-size:9px;font-weight:800}
.favorite{font-size:9px;color:#b42318;margin-top:7px}
.empty{background:#fff;border:1px solid #e7ebef;border-radius:18px;padding:55px;text-align:center;color:#667085}
.notice{margin-bottom:14px}
@@media(max-width:1050px){.rec-grid{grid-template-columns:repeat(2,1fr)}.summary{grid-template-columns:repeat(2,1fr)}}
@@media(max-width:650px){.rec-head{flex-direction:column;align-items:stretch}.rec-grid{grid-template-columns:1fr}.summary{grid-template-columns:1fr}}
</style>
}

<section class="rec-head">
    <div>
        <span class="rec-label">
            <i class="bi bi-stars"></i>
            CUSTOMER INTELLIGENCE
        </span>

        <h2>Recommended For You</h2>

        <p>
            Product suggestions based on your MarketLink purchases, favorites, farmer interests and marketplace activity.
        </p>
    </div>

    <div class="rec-actions">
        <span class="ai-badge">
            <i class="bi bi-cpu"></i>
            Free Local Recommendation Engine
        </span>

        <form asp-controller="CustomerRecommendations"
              asp-action="Refresh"
              method="post">
            @Html.AntiForgeryToken()

            <button type="submit"
                    class="refresh-btn">
                <i class="bi bi-arrow-clockwise"></i>
                Refresh
            </button>
        </form>
    </div>
</section>

@if (TempData["RecommendationMessage"] != null)
{
    <div class="alert alert-success notice">
        @TempData["RecommendationMessage"]
    </div>
}

<section class="summary">

    <div class="summary-card">
        <span>Recommendation Mode</span>
        <strong>@Model.RecommendationMode</strong>
    </div>

    <div class="summary-card">
        <span>Completed Orders</span>
        <strong>@Model.CompletedOrders</strong>
    </div>

    <div class="summary-card">
        <span>Products Purchased</span>
        <strong>@Model.PurchasedProducts</strong>
    </div>

    <div class="summary-card">
        <span>Favorite Products</span>
        <strong>@Model.FavoriteProducts</strong>
    </div>

</section>

<div class="info-box">
    <strong>How recommendations are calculated:</strong>
    MarketLink scores currently available products using category interests from completed orders,
    favorite products/farmers, recent marketplace popularity and product availability.
    No paid AI API or personal data is sent outside MarketLink.
</div>

@if (!Model.Recommendations.Any())
{
    <section class="empty">
        <i class="bi bi-basket"
           style="font-size:38px;color:#13836e;"></i>

        <h3>No recommendations available yet</h3>

        <p>
            Add available products to the marketplace, complete orders, or save favorites to improve recommendations.
        </p>
    </section>
}
else
{
    <section class="rec-grid">

        @foreach (var item in Model.Recommendations)
        {
            <article class="rec-card">

                <div class="rec-image">

                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl"
                             alt="@item.ProductName" />
                    }
                    else
                    {
                        <i class="bi bi-basket2 rec-placeholder"></i>
                    }

                </div>

                <div class="rec-body">

                    <div class="rec-meta">
                        <span class="category">
                            @item.CategoryName
                        </span>

                        <span class="score">
                            Match @(item.Score * 100m).ToString("N0")%
                        </span>
                    </div>

                    <h3>@item.ProductName</h3>

                    <div class="farmer">
                        <i class="bi bi-shop"></i>
                        @item.FarmerName
                    </div>

                    <div class="reason">
                        <i class="bi bi-lightbulb"></i>
                        @item.Reason
                    </div>

                    <div class="price-row">

                        <div class="price">
                            <strong>
                                Rs. @item.Price.ToString("N2")
                            </strong>

                            <span>
                                per @item.UnitName
                            </span>

                            <span class="stock">
                                @item.AvailableQuantity.ToString("N3")
                                available
                            </span>
                        </div>

                        <a asp-controller="CustomerProducts"
                           asp-action="Details"
                           asp-route-id="@item.FarmerProductId"
                           class="view-btn">

                            View Product
                            <i class="bi bi-arrow-right"></i>
                        </a>

                    </div>

                    @if (item.IsFavorite)
                    {
                        <div class="favorite">
                            <i class="bi bi-heart-fill"></i>
                            Saved in your favorites
                        </div>
                    }

                </div>

            </article>
        }

    </section>
}
