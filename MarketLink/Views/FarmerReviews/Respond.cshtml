@model MarketLink.ViewModels.FarmerReviewResponseViewModel

@{
    ViewData["Title"] = "Respond to Review";
    Layout = "~/Views/Shared/_FarmerDashboardLayout.cshtml";
}

<section class="page-header">
    <div>
        <span class="page-label">CUSTOMER REVIEW</span>

        <h2>Respond to Review</h2>

        <p>@Model.CustomerName · @Model.OrderNo</p>
    </div>

    <a asp-controller="FarmerReviews"
       asp-action="Index"
       class="back-link">
        <i class="bi bi-arrow-left"></i>
        Back to Reviews
    </a>
</section>

<section class="response-card">

    <div class="original-review">

        <div class="rating">
            @for (int i = 1; i <= 5; i++)
            {
                <i class="bi @(i <= Model.Rating ? "bi-star-fill" : "bi-star")"></i>
            }
        </div>

        <p>@Model.Comment</p>

    </div>

    <form asp-controller="FarmerReviews"
          asp-action="Respond"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="ReviewId"
               type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="form-field">
            <label asp-for="ResponseText"></label>

            <textarea asp-for="ResponseText"
                      rows="6"
                      class="form-control"
                      placeholder="Write a professional response to the customer..."></textarea>

            <span asp-validation-for="ResponseText"
                  class="text-danger"></span>
        </div>

        <div class="form-actions">
            <a asp-controller="FarmerReviews"
               asp-action="Index"
               class="btn btn-light">
                Cancel
            </a>

            <button type="submit"
                    class="primary-btn border-0">
                Save Response
            </button>
        </div>

    </form>

</section>

@section Styles {
<style>
.page-header{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:22px}
.page-label{color:#14836f;font-size:12px;font-weight:800;letter-spacing:.08em}
.page-header h2{margin:7px 0 5px;font-size:28px;font-weight:800}
.page-header p{margin:0;color:#667085}
.back-link{text-decoration:none;color:#475467;font-weight:700;font-size:13px}
.response-card{background:#fff;border:1px solid #e7ebef;border-radius:18px;padding:24px;max-width:850px}
.original-review{padding:16px;background:#f8fafc;border-radius:12px;margin-bottom:20px}
.rating{color:#f6b73c}
.original-review p{margin:10px 0 0;color:#475467}
.form-field label{display:block;margin-bottom:7px;font-size:12px;font-weight:800;color:#344054}
.form-actions{display:flex;justify-content:flex-end;gap:10px;border-top:1px solid #edf0f3;margin-top:22px;padding-top:18px}
.primary-btn{background:#13836e;color:#fff;padding:10px 15px;border-radius:10px;font-weight:700}
@@media(max-width:650px){.page-header{align-items:flex-start;flex-direction:column}}
</style>
}
